---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingButton from '../components/FloatingButton.astro';

const props = Astro.props.frontmatter || Astro.props;
const { title = "معلومات عنا", icon = "", detailedDescription = [], description = "" } = props;
---

<!DOCTYPE html>
<html lang="ar" dir="rtl">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{title} - للاستثمار والتطوير العقاري</title>
        <meta name="description" content={description || (detailedDescription[0] || "")}>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Almarai:wght@400;700&family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    </head>
    <body>
        <TopBar />
        <Header showMenu={true} />

        <main class="info-page">
            <!-- Dynamic Futuristic Banner (No Static Photos) -->
            <div class="page-banner">
                <div class="banner-mesh"></div>
                <div class="banner-glow banner-glow-1"></div>
                <div class="banner-glow banner-glow-2"></div>
                
                <div class="banner-content">
                    <nav class="breadcrumb-nav">
                        <a href="/"><i class="fas fa-home"></i> الرئيسية</a>
                        <span class="sep">/</span>
                        <a href="/about">معلومات عنا</a>
                        <span class="sep">/</span>
                        <span class="current">{title}</span>
                    </nav>

                    <div class="banner-badge">
                        <span class="badge-dot"></span>
                        <span class="badge-text">رؤية ومعايير ريادية</span>
                    </div>

                    <div class="banner-heading-wrap">
                        {icon && <div class="header-icon-box" set:html={icon} />}
                        <h1 class="page-title">{title}</h1>
                    </div>

                    {description && <p class="banner-subtext">{description}</p>}
                </div>
            </div>

            <!-- Page Main Content & Sidebar Grid -->
            <div class="content-container">
                <div class="page-grid">
                    <!-- Main Body Text -->
                    <article class="main-article glass-card">
                        <div class="article-header">
                            <h2 class="section-heading">تفاصيل وركائز {title}</h2>
                            <div class="heading-line"></div>
                        </div>

                        <div class="article-body">
                            {detailedDescription && detailedDescription.length > 0 ? (
                                detailedDescription.map((p: string) => (
                                    <p class="body-paragraph">{p}</p>
                                ))
                            ) : (
                                <p class="body-paragraph">{description}</p>
                            )}
                            <slot />
                        </div>

                        <div class="article-footer">
                            <a href="/about" class="back-link">
                                <i class="fas fa-arrow-right"></i>
                                العودة إلى قسم معلومات عنا
                            </a>
                        </div>
                    </article>

                    <!-- Sidebar with Quick Highlights and CTA -->
                    <aside class="page-sidebar">
                        <!-- Navigation Quick Links -->
                        <div class="sidebar-card glass-card">
                            <h3 class="sidebar-title">أقسام معلومات عنا</h3>
                            <ul class="subsections-list">
                                <li>
                                    <a href="/about/basic-info" class={title.includes("أساسية") ? "active" : ""}>
                                        <i class="fas fa-building"></i>
                                        <span>معلومات أساسية</span>
                                    </a>
                                </li>
                                <li>
                                    <a href="/about/quality" class={title.includes("الجودة") ? "active" : ""}>
                                        <i class="fas fa-award"></i>
                                        <span>الجودة والتميز</span>
                                    </a>
                                </li>
                                <li>
                                    <a href="/about/innovation" class={title.includes("الابتكار") ? "active" : ""}>
                                        <i class="fas fa-lightbulb"></i>
                                        <span>الابتكار والتطوير</span>
                                    </a>
                                </li>
                                <li>
                                    <a href="/about/transparency" class={title.includes("الشفافية") ? "active" : ""}>
                                        <i class="fas fa-handshake"></i>
                                        <span>الشفافية والمصداقية</span>
                                    </a>
                                </li>
                            </ul>
                        </div>

                        <!-- CTA Box -->
                        <div class="sidebar-card glass-card cta-box">
                            <div class="cta-glow"></div>
                            <div class="cta-icon">
                                <i class="fas fa-headset"></i>
                            </div>
                            <h4 class="cta-title">هل لديك أي استفسار؟</h4>
                            <p class="cta-desc">فريقنا الهندسي والاستثماري جاهز دائماً للإجابة على استفساراتكم ومشاركتكم كافة التفاصيل.</p>
                            <a href="/contact" class="cta-button">
                                <span>تواصل معنا الآن</span>
                                <i class="fas fa-arrow-left"></i>
                            </a>
                        </div>
                    </aside>
                </div>
            </div>
        </main>

        <Footer />
        <FloatingButton />
    </body>
</html>

<style>
    body {
        background: #080d19;
        direction: rtl;
        color: #e2e8f0;
        font-family: 'Cairo', sans-serif;
        margin: 0;
        padding: 0;
    }

    .info-page {
        min-height: 100vh;
        background: radial-gradient(circle at 50% 10%, #0d1627 0%, #080d19 60%, #050812 100%);
        padding-bottom: 90px;
    }

    /* Dynamic Banner */
    .page-banner {
        position: relative;
        padding: 70px 25px 60px;
        background: linear-gradient(180deg, rgba(14, 23, 42, 0.9) 0%, rgba(8, 13, 25, 0.95) 100%);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        overflow: hidden;
    }

    .banner-mesh {
        position: absolute;
        inset: 0;
        background-size: 35px 35px;
        background-image: 
            linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
            linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
        mask-image: radial-gradient(circle at center, black 40%, transparent 85%);
        -webkit-mask-image: radial-gradient(circle at center, black 40%, transparent 85%);
        pointer-events: none;
    }

    .banner-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        pointer-events: none;
        opacity: 0.35;
    }

    .banner-glow-1 {
        width: 450px;
        height: 450px;
        top: -100px;
        right: -50px;
        background: radial-gradient(circle, rgba(56, 189, 248, 0.4) 0%, transparent 70%);
    }

    .banner-glow-2 {
        width: 400px;
        height: 400px;
        bottom: -50px;
        left: -50px;
        background: radial-gradient(circle, rgba(211, 191, 169, 0.3) 0%, transparent 70%);
    }

    .banner-content {
        position: relative;
        z-index: 2;
        max-width: 1200px;
        margin: 0 auto;
    }

    .breadcrumb-nav {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.9rem;
        color: #94a3b8;
        margin-bottom: 25px;
    }

    .breadcrumb-nav a {
        color: #94a3b8;
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .breadcrumb-nav a:hover {
        color: #d3bfa9;
    }

    .breadcrumb-nav .sep {
        opacity: 0.4;
    }

    .breadcrumb-nav .current {
        color: #ffffff;
        font-weight: 700;
    }

    .banner-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 5px 14px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(211, 191, 169, 0.3);
        margin-bottom: 20px;
    }

    .badge-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: #38bdf8;
        box-shadow: 0 0 10px #38bdf8;
    }

    .badge-text {
        font-size: 0.88rem;
        font-weight: 700;
        color: #d3bfa9;
    }

    .banner-heading-wrap {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 15px;
    }

    .header-icon-box {
        width: 55px;
        height: 55px;
        border-radius: 14px;
        background: rgba(211, 191, 169, 0.12);
        border: 1px solid rgba(211, 191, 169, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #d3bfa9;
        flex-shrink: 0;
    }

    .header-icon-box :global(svg) {
        width: 30px;
        height: 30px;
    }

    .page-title {
        font-size: 2.8rem;
        font-weight: 900;
        color: #ffffff;
        margin: 0;
        background: linear-gradient(180deg, #ffffff 40%, #cbd5e1 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .banner-subtext {
        font-family: 'Almarai', sans-serif;
        font-size: 1.15rem;
        color: #94a3b8;
        max-width: 800px;
        line-height: 1.8;
        margin: 0;
    }

    /* Content Layout */
    .content-container {
        max-width: 1200px;
        margin: 45px auto 0;
        padding: 0 25px;
    }

    .page-grid {
        display: grid;
        grid-template-columns: 2.5fr 1fr;
        gap: 35px;
    }

    .glass-card {
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.015) 100%);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    }

    /* Main Article */
    .main-article {
        padding: 40px;
    }

    .article-header {
        margin-bottom: 30px;
    }

    .section-heading {
        font-size: 1.9rem;
        font-weight: 800;
        color: #ffffff;
        margin: 0 0 12px 0;
    }

    .heading-line {
        width: 60px;
        height: 4px;
        border-radius: 2px;
        background: linear-gradient(90deg, #38bdf8, #d3bfa9);
    }

    .body-paragraph {
        font-family: 'Almarai', sans-serif;
        font-size: 1.15rem;
        line-height: 2;
        color: #cbd5e1;
        margin-bottom: 25px;
    }

    .article-footer {
        margin-top: 40px;
        padding-top: 25px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: #d3bfa9;
        text-decoration: none;
        font-weight: 700;
        font-size: 1rem;
        transition: transform 0.3s ease, color 0.3s ease;
    }

    .back-link:hover {
        transform: translateX(-5px);
        color: #ffffff;
    }

    /* Sidebar */
    .page-sidebar {
        display: flex;
        flex-direction: column;
        gap: 30px;
    }

    .sidebar-card {
        padding: 30px 25px;
    }

    .sidebar-title {
        font-size: 1.3rem;
        font-weight: 800;
        color: #ffffff;
        margin: 0 0 20px 0;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .subsections-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .subsections-list a {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        border-radius: 10px;
        color: #94a3b8;
        text-decoration: none;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid transparent;
        transition: all 0.3s ease;
        font-size: 0.95rem;
        font-weight: 600;
    }

    .subsections-list a i {
        color: #38bdf8;
        font-size: 0.95rem;
    }

    .subsections-list a:hover {
        background: rgba(255, 255, 255, 0.06);
        color: #ffffff;
        border-color: rgba(255, 255, 255, 0.12);
        transform: translateX(-4px);
    }

    .subsections-list a.active {
        background: rgba(211, 191, 169, 0.12);
        border-color: rgba(211, 191, 169, 0.3);
        color: #d3bfa9;
        font-weight: 700;
    }

    .subsections-list a.active i {
        color: #d3bfa9;
    }

    /* CTA Box */
    .cta-box {
        position: relative;
        overflow: hidden;
        text-align: center;
        border-color: rgba(211, 191, 169, 0.25);
    }

    .cta-glow {
        position: absolute;
        top: -30px;
        left: -30px;
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(211, 191, 169, 0.3) 0%, transparent 70%);
        pointer-events: none;
    }

    .cta-icon {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: rgba(211, 191, 169, 0.15);
        color: #d3bfa9;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        margin: 0 auto 15px;
    }

    .cta-title {
        font-size: 1.3rem;
        font-weight: 800;
        color: #ffffff;
        margin: 0 0 10px 0;
    }

    .cta-desc {
        font-family: 'Almarai', sans-serif;
        font-size: 0.95rem;
        color: #94a3b8;
        line-height: 1.7;
        margin: 0 0 20px 0;
    }

    .cta-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        padding: 12px 20px;
        border-radius: 10px;
        background: linear-gradient(135deg, #d3bfa9 0%, #b89f84 100%);
        color: #080d19;
        font-weight: 800;
        text-decoration: none;
        font-size: 0.95rem;
        box-shadow: 0 8px 20px rgba(211, 191, 169, 0.25);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .cta-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 25px rgba(211, 191, 169, 0.35);
    }

    /* Responsive */
    @media (max-width: 992px) {
        .page-grid {
            grid-template-columns: 1fr;
        }
        .page-title {
            font-size: 2.3rem;
        }
    }

    @media (max-width: 768px) {
        .page-banner {
            padding: 50px 20px 40px;
        }
        .page-title {
            font-size: 1.9rem;
        }
        .main-article {
            padding: 25px 20px;
        }
        .body-paragraph {
            font-size: 1.05rem;
        }
    }
</style>
