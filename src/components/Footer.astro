---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <!-- Dynamic Ambient Glows & Cyber Pattern -->
  <div class="footer-glow footer-glow-1"></div>
  <div class="footer-glow footer-glow-2"></div>
  <div class="footer-grid-pattern"></div>

  <div class="container">
    <!-- Top Floating Pre-Footer Glass Card -->
    <div class="footer-pre-card">
      <div class="pre-card-glow"></div>
      <div class="pre-card-content">
        <div class="pre-card-badge">
          <span class="badge-dot"></span>
          <span class="badge-text">استشارة مجانية متكاملة</span>
        </div>
        <h3 class="pre-card-title">هل أنت مستعد لبدء استثمارك العقاري القادم؟</h3>
        <p class="pre-card-desc">فريقنا الهندسي والاستثماري جاهز لمناقشة أهدافك ومشاركتك أحدث المخططات ودراسات الجدوى المعتمدة.</p>
      </div>
      <div class="pre-card-actions">
        <a href="/contact" class="pre-btn-primary">
          <span>تواصل مع مستشار عقاري</span>
          <i class="fas fa-arrow-left"></i>
        </a>
        <a href="tel:19000" class="pre-btn-hotline">
          <i class="fas fa-phone-alt"></i>
          <span dir="ltr">19000</span>
        </a>
      </div>
    </div>

    <!-- Main Footer Grid (4 Luxury Columns) -->
    <div class="footer-main-grid">
      <!-- Col 1: Brand & Identity -->
      <div class="footer-col col-brand">
        <div class="brand-header">
          <div class="brand-icon-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 21h18M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16M9 9h1M9 13h1M9 17h1M14 9h1M14 13h1M14 17h1"/>
            </svg>
          </div>
          <div class="brand-title-wrap">
            <h4 class="brand-title">الاستثمار والتطوير العقاري</h4>
            <span class="brand-slogan">هندسة الاستثمار ورؤية المستقبل</span>
          </div>
        </div>

        <p class="brand-desc">
          كيان رائد يبتكر مجتمعات سكنية وتجارية استثنائية، نجمع بين فخامة التصميم الهندسي وأعلى عوائد الأمان الاستثماري المستدام.
        </p>

        <div class="trust-badge">
          <i class="fas fa-shield-alt"></i>
          <span>كيان معتمد في التطوير وإدارة الأصول</span>
        </div>
      </div>

      <!-- Col 2: Quick Links -->
      <div class="footer-col col-links">
        <h4 class="col-heading">روابط سريعة</h4>
        <div class="heading-accent"></div>
        <ul class="footer-links-list">
          <li>
            <a href="/">
              <span class="link-arrow"><i class="fas fa-chevron-left"></i></span>
              <span>الرئيسية</span>
            </a>
          </li>
          <li>
            <a href="/services">
              <span class="link-arrow"><i class="fas fa-chevron-left"></i></span>
              <span>خدماتنا الاستثمارية</span>
            </a>
          </li>
          <li>
            <a href="/achievements">
              <span class="link-arrow"><i class="fas fa-chevron-left"></i></span>
              <span>إنجازاتنا بالأرقام</span>
            </a>
          </li>
          <li>
            <a href="/about">
              <span class="link-arrow"><i class="fas fa-chevron-left"></i></span>
              <span>معلومات عنا ورسالتنا</span>
            </a>
          </li>
          <li>
            <a href="/contact">
              <span class="link-arrow"><i class="fas fa-chevron-left"></i></span>
              <span>قنوات تواصل معنا</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Sectors & Services -->
      <div class="footer-col col-services">
        <h4 class="col-heading">قطاعات الأعمال</h4>
        <div class="heading-accent"></div>
        <ul class="footer-links-list">
          <li>
            <a href="/services/residential-development">
              <span class="link-arrow"><i class="fas fa-chevron-left"></i></span>
              <span>التطوير السكني الذكي</span>
            </a>
          </li>
          <li>
            <a href="/services/commercial-projects">
              <span class="link-arrow"><i class="fas fa-chevron-left"></i></span>
              <span>المشاريع التجارية والإدارية</span>
            </a>
          </li>
          <li>
            <a href="/services/project-management">
              <span class="link-arrow"><i class="fas fa-chevron-left"></i></span>
              <span>إدارة المشاريع والإشراف</span>
            </a>
          </li>
          <li>
            <a href="/services/real-estate-investment">
              <span class="link-arrow"><i class="fas fa-chevron-left"></i></span>
              <span>الاستثمار وتنمية الأصول</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Contact & Socials -->
      <div class="footer-col col-contact">
        <h4 class="col-heading">معلومات الاتصال</h4>
        <div class="heading-accent"></div>

        <!-- Hotline Highlight Box -->
        <a href="tel:19000" class="hotline-box">
          <div class="hotline-icon">
            <i class="fas fa-headset"></i>
          </div>
          <div class="hotline-info">
            <span class="hotline-label">الخط الساخن المباشر</span>
            <span class="hotline-num" dir="ltr">19000</span>
          </div>
          <span class="live-dot" title="متاح حالياً"></span>
        </a>

        <!-- Contact Items -->
        <div class="contact-meta-list">
          <a href="mailto:info@realestate-dev.com" class="meta-item">
            <div class="meta-icon"><i class="far fa-envelope"></i></div>
            <span>info@realestate-dev.com</span>
          </a>
          <a href="/contact" class="meta-item">
            <div class="meta-icon"><i class="fas fa-map-marker-alt"></i></div>
            <span>القاهرة - التجمع الخامس، مصر</span>
          </a>
        </div>

        <!-- Luminous Social Pills -->
        <div class="social-pills-wrap">
          <a href="/contact" aria-label="WhatsApp" class="social-pill whatsapp">
            <i class="fab fa-whatsapp"></i>
          </a>
          <a href="/contact" aria-label="Facebook" class="social-pill facebook">
            <i class="fab fa-facebook-f"></i>
          </a>
          <a href="/contact" aria-label="YouTube" class="social-pill youtube">
            <i class="fab fa-youtube"></i>
          </a>
          <a href="/contact" aria-label="LinkedIn" class="social-pill linkedin">
            <i class="fab fa-linkedin-in"></i>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar (Copyright & Back to top) -->
    <div class="footer-bottom-bar">
      <div class="bottom-copy">
        <p>&copy; {currentYear} جميع الحقوق محفوظة - للاستثمار والتطوير العقاري الحديث.</p>
      </div>

      <div class="bottom-status">
        <span class="status-indicator"></span>
        <span>كافة الأنظمة والخدمات تعمل بكفاءة تامة</span>
      </div>

      <button id="back-to-top-btn" class="back-to-top-btn" aria-label="العودة للأعلى" title="العودة للأعلى">
        <span>للأعلى</span>
        <i class="fas fa-chevron-up"></i>
      </button>
    </div>
  </div>
</footer>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('back-to-top-btn');
    if (btn) {
      btn.addEventListener('click', () => {
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      });
    }
  });
</script>

<style>
  .site-footer {
    position: relative;
    background: radial-gradient(circle at 50% 0%, #0d1627 0%, #080d19 50%, #04060c 100%);
    direction: rtl;
    padding: 80px 0 35px;
    color: #e2e8f0;
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Ambient Glows */
  .footer-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(130px);
    pointer-events: none;
    z-index: 1;
    opacity: 0.28;
  }

  .footer-glow-1 {
    width: 550px;
    height: 550px;
    top: -100px;
    right: -100px;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.45) 0%, transparent 70%);
  }

  .footer-glow-2 {
    width: 500px;
    height: 500px;
    bottom: -80px;
    left: -100px;
    background: radial-gradient(circle, rgba(211, 191, 169, 0.35) 0%, transparent 70%);
  }

  .footer-grid-pattern {
    position: absolute;
    inset: 0;
    background-size: 40px 40px;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    z-index: 1;
    mask-image: radial-gradient(circle at center, black 40%, transparent 85%);
    -webkit-mask-image: radial-gradient(circle at center, black 40%, transparent 85%);
  }

  .container {
    position: relative;
    z-index: 2;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 25px;
  }

  /* Top Pre-Footer Glass Card */
  .footer-pre-card {
    position: relative;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.07) 0%, rgba(255, 255, 255, 0.02) 100%);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 22px;
    padding: 40px 45px;
    margin-bottom: 75px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.15);
    overflow: hidden;
  }

  .pre-card-glow {
    position: absolute;
    top: -50px;
    right: 20%;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.3) 0%, transparent 70%);
    pointer-events: none;
  }

  .pre-card-content {
    max-width: 650px;
  }

  .pre-card-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(211, 191, 169, 0.3);
    margin-bottom: 15px;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #38bdf8;
    box-shadow: 0 0 10px #38bdf8;
    animation: pulseDot 2s infinite;
  }

  @keyframes pulseDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  .badge-text {
    font-family: 'Cairo', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    color: #d3bfa9;
  }

  .pre-card-title {
    font-family: 'Cairo', sans-serif;
    font-size: 1.85rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 10px 0;
    line-height: 1.35;
  }

  .pre-card-desc {
    font-family: 'Almarai', sans-serif;
    font-size: 1.05rem;
    color: #94a3b8;
    line-height: 1.7;
    margin: 0;
  }

  .pre-card-actions {
    display: flex;
    align-items: center;
    gap: 15px;
    flex-shrink: 0;
  }

  .pre-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    border-radius: 12px;
    background: linear-gradient(135deg, #d3bfa9 0%, #b89f84 100%);
    color: #080d19;
    font-family: 'Cairo', sans-serif;
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    box-shadow: 0 10px 25px rgba(211, 191, 169, 0.3);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .pre-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 35px rgba(211, 191, 169, 0.45);
  }

  .pre-btn-hotline {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #ffffff;
    font-family: 'Cairo', sans-serif;
    font-weight: 800;
    font-size: 1.1rem;
    text-decoration: none;
    transition: background-color 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
  }

  .pre-btn-hotline:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(56, 189, 248, 0.4);
    transform: translateY(-2px);
  }

  /* Main Footer Grid */
  .footer-main-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1.2fr 1.4fr;
    gap: 45px;
    padding-bottom: 60px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Col 1: Brand */
  .brand-header {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 20px;
  }

  .brand-icon-wrapper {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(211, 191, 169, 0.12);
    border: 1px solid rgba(211, 191, 169, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #d3bfa9;
    flex-shrink: 0;
  }

  .brand-icon-wrapper svg {
    width: 26px;
    height: 26px;
  }

  .brand-title {
    font-family: 'Cairo', sans-serif;
    font-size: 1.35rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    line-height: 1.3;
  }

  .brand-slogan {
    font-family: 'Almarai', sans-serif;
    font-size: 0.82rem;
    color: #d3bfa9;
    display: block;
    margin-top: 3px;
  }

  .brand-desc {
    font-family: 'Almarai', sans-serif;
    font-size: 0.95rem;
    color: #94a3b8;
    line-height: 1.8;
    margin: 0 0 25px 0;
  }

  .trust-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-family: 'Cairo', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    color: #cbd5e1;
  }

  .trust-badge i {
    color: #38bdf8;
  }

  /* Headings */
  .col-heading {
    font-family: 'Cairo', sans-serif;
    font-size: 1.25rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 10px 0;
  }

  .heading-accent {
    width: 35px;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(90deg, #38bdf8, #d3bfa9);
    margin-bottom: 22px;
  }

  /* Links Lists */
  .footer-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .footer-links-list a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #94a3b8;
    text-decoration: none;
    font-family: 'Almarai', sans-serif;
    font-size: 0.96rem;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .link-arrow {
    font-size: 0.72rem;
    color: #d3bfa9;
    opacity: 0.6;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .footer-links-list a:hover {
    color: #ffffff;
    transform: translateX(-4px);
  }

  .footer-links-list a:hover .link-arrow {
    opacity: 1;
    transform: translateX(-2px);
  }

  /* Col 4: Contact Hotline & Details */
  .hotline-box {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    border-radius: 14px;
    background: linear-gradient(145deg, rgba(211, 191, 169, 0.1) 0%, rgba(211, 191, 169, 0.02) 100%);
    border: 1px solid rgba(211, 191, 169, 0.3);
    text-decoration: none;
    margin-bottom: 22px;
    position: relative;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .hotline-box:hover {
    transform: translateY(-3px);
    border-color: #d3bfa9;
    box-shadow: 0 10px 25px rgba(211, 191, 169, 0.2);
  }

  .hotline-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: #d3bfa9;
    color: #080d19;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .hotline-info {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .hotline-label {
    font-family: 'Cairo', sans-serif;
    font-size: 0.8rem;
    color: #cbd5e1;
    font-weight: 600;
  }

  .hotline-num {
    font-family: 'Cairo', sans-serif;
    font-size: 1.4rem;
    font-weight: 900;
    color: #ffffff;
    line-height: 1.2;
  }

  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 8px #10b981;
    animation: pulseLive 2s infinite;
  }

  @keyframes pulseLive {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  .contact-meta-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 24px;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #94a3b8;
    text-decoration: none;
    font-family: 'Almarai', sans-serif;
    font-size: 0.92rem;
    transition: color 0.3s ease;
  }

  .meta-icon {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #38bdf8;
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .meta-item:hover {
    color: #ffffff;
  }

  /* Social Pills */
  .social-pills-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .social-pill {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #cbd5e1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    text-decoration: none;
    transition: transform 0.3s ease, background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
  }

  .social-pill:hover {
    transform: translateY(-4px);
    color: #ffffff;
  }

  .social-pill.whatsapp:hover {
    background-color: #25d366;
    border-color: #25d366;
  }

  .social-pill.facebook:hover {
    background-color: #1877f2;
    border-color: #1877f2;
  }

  .social-pill.youtube:hover {
    background-color: #ff0000;
    border-color: #ff0000;
  }

  .social-pill.linkedin:hover {
    background-color: #0a66c2;
    border-color: #0a66c2;
  }

  /* Bottom Bar */
  .footer-bottom-bar {
    padding-top: 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }

  .bottom-copy p {
    font-family: 'Almarai', sans-serif;
    font-size: 0.92rem;
    color: #64748b;
    margin: 0;
  }

  .bottom-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    font-family: 'Cairo', sans-serif;
    font-size: 0.82rem;
    color: #94a3b8;
  }

  .status-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 6px #10b981;
  }

  .back-to-top-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #cbd5e1;
    font-family: 'Cairo', sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease, transform 0.3s ease;
  }

  .back-to-top-btn:hover {
    background: #d3bfa9;
    border-color: #d3bfa9;
    color: #080d19;
    transform: translateY(-3px);
  }

  /* Responsive */
  @media (max-width: 1100px) {
    .footer-main-grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 900px) {
    .footer-pre-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 30px 25px;
    }
    .pre-card-actions {
      width: 100%;
      flex-direction: column;
    }
    .pre-btn-primary, .pre-btn-hotline {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .site-footer {
      padding: 60px 0 30px;
    }
    .footer-main-grid {
      grid-template-columns: 1fr;
      gap: 35px;
    }
