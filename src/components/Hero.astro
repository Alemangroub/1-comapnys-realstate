---
const { title, subtitle } = Astro.props;
---

<section class="hero">
    <div class="hero-grid-pattern"></div>
    <div class="hero-glow hero-glow-1"></div>
    <div class="hero-glow hero-glow-2"></div>
    <canvas id="hero-particles" class="hero-canvas"></canvas>
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <h1 id="hero-title" class="typing-effect"></h1>
        <p id="hero-subtitle" class="typing-effect"></p>
    </div>
</section>

<script define:vars={{ title, subtitle }}>
    const titleElement = document.getElementById('hero-title');
    const subtitleElement = document.getElementById('hero-subtitle');

    function typeWriter(element, text, onComplete) {
        let i = 0;
        element.innerHTML = '';
        element.classList.add('typing');
        
        function type() {
            if (i < text.length) {
                element.innerHTML += text.charAt(i);
                i++;
                setTimeout(type, 50);
            } else {
                element.classList.remove('typing');
                if (onComplete) {
                    onComplete();
                }
            }
        }
        type();
    }

    document.addEventListener('DOMContentLoaded', () => {
        setTimeout(() => {
            typeWriter(titleElement, title, () => {
                subtitleElement.style.opacity = '1';
                setTimeout(() => {
                    typeWriter(subtitleElement, subtitle);
                }, 200);
            });
        }, 500);

        // Architectural interactive particle network
        const canvas = document.getElementById('hero-particles');
        if (canvas) {
            const ctx = canvas.getContext('2d');
            let width, height;
            let particles = [];
            const isMobile = window.innerWidth < 768;
            const particleCount = isMobile ? 24 : 50;
            const maxDist = isMobile ? 80 : 120;
            let mouse = { x: null, y: null, radius: 140 };

            function resize() {
                if (!canvas) return;
                width = canvas.width = canvas.offsetWidth;
                height = canvas.height = canvas.offsetHeight;
            }
            window.addEventListener('resize', resize);
            resize();

            window.addEventListener('mousemove', (e) => {
                const rect = canvas.getBoundingClientRect();
                mouse.x = e.clientX - rect.left;
                mouse.y = e.clientY - rect.top;
            });

            window.addEventListener('mouseleave', () => {
                mouse.x = null;
                mouse.y = null;
            });

            for (let i = 0; i < particleCount; i++) {
                particles.push({
                    x: Math.random() * width,
                    y: Math.random() * height,
                    vx: (Math.random() - 0.5) * 0.6,
                    vy: (Math.random() - 0.5) * 0.6,
                    radius: Math.random() * 1.8 + 1,
                    color: Math.random() > 0.4 ? 'rgba(211, 191, 169, 0.75)' : 'rgba(52, 152, 219, 0.75)'
                });
            }

            function draw() {
                ctx.clearRect(0, 0, width, height);

                // Draw connecting geometric links
                for (let i = 0; i < particles.length; i++) {
                    for (let j = i + 1; j < particles.length; j++) {
                        const dx = particles[i].x - particles[j].x;
                        const dy = particles[i].y - particles[j].y;
                        const dist = Math.sqrt(dx * dx + dy * dy);

                        if (dist < maxDist) {
                            ctx.beginPath();
                            ctx.strokeStyle = `rgba(180, 205, 230, ${(1 - dist / maxDist) * 0.22})`;
                            ctx.lineWidth = 0.8;
                            ctx.moveTo(particles[i].x, particles[i].y);
                            ctx.lineTo(particles[j].x, particles[j].y);
                            ctx.stroke();
                        }
                    }
                }

                // Update & draw particles
                particles.forEach(p => {
                    if (mouse.x !== null && mouse.y !== null) {
                        const dx = p.x - mouse.x;
                        const dy = p.y - mouse.y;
                        const dist = Math.sqrt(dx * dx + dy * dy);
                        if (dist < mouse.radius) {
                            const angle = Math.atan2(dy, dx);
                            const force = (mouse.radius - dist) / mouse.radius;
                            p.x += Math.cos(angle) * force * 1.8;
                            p.y += Math.sin(angle) * force * 1.8;
                        }
                    }

                    p.x += p.vx;
                    p.y += p.vy;

                    if (p.x < 0) p.x = width;
                    if (p.x > width) p.x = 0;
                    if (p.y < 0) p.y = height;
                    if (p.y > height) p.y = 0;

                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                    ctx.fillStyle = p.color;
                    ctx.fill();
                });

                requestAnimationFrame(draw);
            }
            draw();
        }
    });
</script>

<style>
    .hero {
        position: relative;
        height: calc(100vh - 125px);
        min-height: 520px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: white;
        overflow: hidden;
        background: radial-gradient(circle at 50% 30%, #152238 0%, #0d1527 50%, #080c16 100%);
    }

    .hero-canvas {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
        pointer-events: none;
    }

    .hero-grid-pattern {
        position: absolute;
        inset: 0;
        background-size: 45px 45px;
        background-image: 
            linear-gradient(to right, rgba(255, 255, 255, 0.025) 1px, transparent 1px),
            linear-gradient(to bottom, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
        z-index: 1;
        mask-image: radial-gradient(circle at center, black 45%, transparent 85%);
        -webkit-mask-image: radial-gradient(circle at center, black 45%, transparent 85%);
    }

    .hero-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(95px);
        pointer-events: none;
        z-index: 1;
        opacity: 0.45;
        animation: floatGlow 14s ease-in-out infinite alternate;
    }

    .hero-glow-1 {
        width: 480px;
        height: 480px;
        top: -10%;
        left: 12%;
        background: radial-gradient(circle, rgba(52, 152, 219, 0.4) 0%, rgba(41, 128, 185, 0) 70%);
    }

    .hero-glow-2 {
        width: 420px;
        height: 420px;
        bottom: -5%;
        right: 12%;
        background: radial-gradient(circle, rgba(211, 191, 169, 0.35) 0%, rgba(211, 191, 169, 0) 70%);
        animation-delay: -7s;
    }

    @keyframes floatGlow {
        0% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(35px, -25px) scale(1.08); }
        100% { transform: translate(-25px, 35px) scale(0.95); }
    }

    .hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: radial-gradient(circle at center, transparent 30%, rgba(8, 12, 22, 0.75) 100%);
        z-index: 2;
    }

    .hero-content {
        position: relative;
        z-index: 3;
        padding: 20px;
        max-width: 950px;
    }

    #hero-title {
        font-family: 'Cairo', sans-serif;
        font-size: 3.2rem;
        font-weight: 800;
        margin: 0;
        direction: rtl;
        letter-spacing: -0.5px;
        text-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }

    #hero-subtitle {
        font-family: 'Almarai', sans-serif;
        font-size: 2rem;
        font-weight: 300;
        margin-top: 18px;
        color: rgba(255, 255, 255, 0.9);
        opacity: 0;
        direction: rtl;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
    }

    .typing-effect.typing::after {
        content: '|';
        display: inline-block;
        margin-right: 5px;
        color: #d3bfa9;
        animation: blink 0.7s infinite;
    }

    @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }

    /* Responsive Styles for Tablet */
    @media (max-width: 768px) {
        .hero {
            height: calc(100vh - 180px);
            min-height: 460px;
        }
        #hero-title {
            font-size: 2.3rem;
        }
        #hero-subtitle {
            font-size: 1.35rem;
        }
    }

    /* Responsive Styles for Mobile */
    @media (max-width: 480px) {
        .hero {
            height: calc(100vh - 220px);
            min-height: 420px;
        }
        #hero-title {
            font-size: 1.85rem;
            line-height: 1.35;
        }
        #hero-subtitle {
            font-size: 1.1rem;
        }
    }
</style>