<script>
  // 1. Live Digital Clock in Arabic
  function initLiveClock() {
    const clockEl = document.getElementById("live-clock");
    const dateEl = document.getElementById("live-date");

    function update() {
      const now = new Date();
      if (clockEl) {
        clockEl.textContent = now.toLocaleTimeString("ar-EG", { hour12: true });
      }
      if (dateEl) {
        dateEl.textContent = now.toLocaleDateString("ar-EG", {
          weekday: "long",
          year: "numeric",
          month: "long",
          day: "numeric"
        });
      }
    }
    update();
    setInterval(update, 1000);
  }
  initLiveClock();

  // 2. Interactive Dynamic Particle Network (Soft Azure/Violet for Light Mode)
  function initCanvasParticles() {
    const canvas = document.getElementById("particles-canvas");
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    let width, height;
    let particles = [];
    const particleCount = 42;
    const maxDistance = 110;
    let mouse = { x: null, y: null, radius: 140 };

    function resize() {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener("resize", resize);

    window.addEventListener("mousemove", (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
    });

    window.addEventListener("mouseleave", () => {
      mouse.x = null;
      mouse.y = null;
    });

    class Particle {
      constructor() {
        this.x = Math.random() * width;
        this.y = Math.random() * height;
        this.vx = (Math.random() - 0.5) * 0.6;
        this.vy = (Math.random() - 0.5) * 0.6;
        this.radius = Math.random() * 2 + 1;
        this.baseColor = Math.random() > 0.5 ? "2, 132, 199" : "99, 102, 241";
      }

      update() {
        this.x += this.vx;
        this.y += this.vy;

        if (this.x < 0 || this.x > width) this.vx *= -1;
        if (this.y < 0 || this.y > height) this.vy *= -1;

        if (mouse.x !== null && mouse.y !== null) {
          const dx = mouse.x - this.x;
          const dy = mouse.y - this.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < mouse.radius) {
            const force = (mouse.radius - dist) / mouse.radius;
            this.x -= (dx / dist) * force * 1.8;
            this.y -= (dy / dist) * force * 1.8;
          }
        }
      }

      draw() {
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${this.baseColor}, 0.55)`;
        ctx.fill();
      }
    }

    for (let i = 0; i < particleCount; i++) {
      particles.push(new Particle());
    }

    function animate() {
      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < maxDistance) {
            const alpha = (1 - dist / maxDistance) * 0.22;
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.strokeStyle = `rgba(2, 132, 199, ${alpha})`;
            ctx.lineWidth = 0.75;
            ctx.stroke();
          }
        }
      }

      particles.forEach((p) => {
        p.update();
        p.draw();
      });

      requestAnimationFrame(animate);
    }
    animate();
  }
  initCanvasParticles();

  // 3. Smooth Interactive Cursor Light Follower (No Tilt - Stable Clean Experience)
  const cursorGlow = document.getElementById("cursor-glow");
  document.addEventListener("mousemove", (e) => {
    if (cursorGlow) {
      cursorGlow.style.left = `${e.clientX}px`;
      cursorGlow.style.top = `${e.clientY}px`;
    }
  });

  // 4. Toggle Password Visibility
  const togglePasswordBtn = document.getElementById("toggle-password");
  const passwordInput = document.getElementById("password");
  const eyeIcon = document.getElementById("eye-icon");

  if (togglePasswordBtn && passwordInput) {
    togglePasswordBtn.addEventListener("click", () => {
      const isPassword = passwordInput.getAttribute("type") === "password";
      passwordInput.setAttribute("type", isPassword ? "text" : "password");
      if (eyeIcon) {
        eyeIcon.innerHTML = isPassword
          ? `<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>`
          : `<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>`;
      }
    });
  }

  // 5. Smart Form Submission
  const loginForm = document.getElementById("login-form");
  const errorBox = document.getElementById("error-message-box");
  const errorMessage = document.getElementById("error-message");

  if (loginForm) {
    loginForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (errorMessage) errorMessage.textContent = "";
      if (errorBox) errorBox.style.display = "none";

      const submitBtn = document.getElementById("submit-btn");
      const btnLabelText = submitBtn?.querySelector(".btn-label-text");
      const btnSpinner = submitBtn?.querySelector(".clean-spinner");

      if (submitBtn) submitBtn.disabled = true;
      if (btnLabelText) btnLabelText.textContent = "جاري التحقق والمصادقة...";
      if (btnSpinner) btnSpinner.style.display = "inline-block";

      const emailInput = document.getElementById("email");

      try {
        const response = await fetch("/api/auth/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: emailInput.value.trim(), password: passwordInput.value })
        });

        const data = await response.json();

        if (response.ok && data.success) {
          if (data.token) {
            localStorage.setItem("auth_token", data.token);
          }
          if (btnLabelText) btnLabelText.textContent = "تم التحقق! جاري نقلك...";
          submitBtn.classList.add("btn-success-green");

          setTimeout(() => {
            const role = data.user?.role;
            if (role === "sales") {
              window.location.href = "/sales-dashboard";
            } else if (role === "accountant") {
              window.location.href = "/accounting-dashboard";
            } else if (role === "supervisor" || role === "engineer") {
              window.location.href = "/engineer-dashboard";
            } else {
              window.location.href = "/crs";
            }
          }, 450);

        } else {
          const errText = data.error || "بيانات الدخول غير صحيحة، يرجى إعادة المحاولة.";
          if (errorMessage) errorMessage.textContent = errText;
          if (errorBox) {
            errorBox.style.display = "flex";
            errorBox.classList.remove("error-shake-effect");
            void errorBox.offsetWidth;
            errorBox.classList.add("error-shake-effect");
          }
          if (submitBtn) submitBtn.disabled = false;
          if (btnLabelText) btnLabelText.textContent = "دخول إلى لوحة التحكم";
          if (btnSpinner) btnSpinner.style.display = "none";
        }
      } catch (error) {
        console.error("Auth error:", error);
        if (errorMessage) errorMessage.textContent = "تعذر الاتصال بالخادم، يرجى التحقق من الشبكة.";
        if (errorBox) errorBox.style.display = "flex";
        if (submitBtn) submitBtn.disabled = false;
        if (btnLabelText) btnLabelText.textContent = "دخول إلى لوحة التحكم";
        if (btnSpinner) btnSpinner.style.display = "none";
      }
    });
  }
</script>

<style>
  * {
    box-sizing: border-box;
  }

  /* Luxurious Light Environment */
  .light-luxury-login-world {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
    direction: rtl;
    font-family: 'Cairo', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: #f8fafc;
    overflow: hidden;
  }

  /* Dynamic Particles Canvas */
  .particles-canvas {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  /* Fluid Ambient Aurora Pastel Blobs */
  .ambient-fluid-aurora {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .aurora-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(95px);
    opacity: 0.65;
    animation: pastelDrift 18s infinite alternate ease-in-out;
  }

  .blob-blue {
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, #bae6fd 0%, #38bdf8 60%, #0284c7 100%);
    top: -150px;
    right: -100px;
  }

  .blob-cyan {
    width: 460px;
    height: 460px;
    background: radial-gradient(circle, #ccfbf1 0%, #5eead4 60%, #0d9488 100%);
    bottom: -120px;
    left: -100px;
    animation-delay: -5s;
  }

  .blob-violet {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, #ede9fe 0%, #c4b5fd 60%, #8b5cf6 100%);
    top: 35%;
    left: 20%;
    opacity: 0.45;
    animation-delay: -9s;
  }

  .blob-amber {
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, #fef3c7 0%, #fde68a 60%, #f59e0b 100%);
    bottom: 10%;
    right: 25%;
    opacity: 0.35;
    animation-delay: -13s;
  }

  @keyframes pastelDrift {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(45px, 35px) scale(1.12); }
    100% { transform: translate(-35px, 20px) scale(0.95); }
  }

  /* Delicate Light Geometric Grid Overlay */
  .light-geometric-grid {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, rgba(14, 165, 233, 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(14, 165, 233, 0.06) 1px, transparent 1px);
    background-size: 38px 38px;
    mask-image: radial-gradient(ellipse at center, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 80%);
    -webkit-mask-image: radial-gradient(ellipse at center, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 80%);
  }

  /* Interactive Cursor Light Spotlight Glow */
  .cursor-light-glow {
    position: absolute;
    width: 550px;
    height: 550px;
    border-radius: 50%;
    pointer-events: none;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(14, 165, 233, 0.14) 0%, rgba(99, 102, 241, 0.06) 45%, transparent 70%);
    z-index: 2;
  }

  /* ================= MASTER CRYSTAL CARD (Stable - No 3D Tilt) ================= */
  .master-crystal-card {
    position: relative;
    z-index: 5;
    width: 100%;
    max-width: 990px;
    margin: 0 auto;
    border-radius: 32px;
  }

  /* Moving Prismatic Iridescent Perimeter Beam */
  .prismatic-border-beam {
    position: absolute;
    inset: -2px;
    border-radius: 34px;
    background: conic-gradient(
      from 0deg,
      transparent 60%,
      rgba(14, 165, 233, 0.85) 75%,
      rgba(99, 102, 241, 0.85) 88%,
      rgba(244, 63, 94, 0.85) 96%,
      rgba(56, 189, 248, 1) 100%
    );
    z-index: -1;
    animation: rotatePrism 9s linear infinite;
    filter: blur(2px);
    opacity: 0.85;
  }

  @keyframes rotatePrism {
    to { transform: rotate(360deg); }
  }

  /* Inner Card Body with Two Columns */
  .crystal-card-content {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(35px) saturate(190%);
    -webkit-backdrop-filter: blur(35px) saturate(190%);
    border-radius: 32px;
    border: 1.5px solid rgba(255, 255, 255, 0.95);
    box-shadow: 
      0 30px 70px -15px rgba(15, 23, 42, 0.12),
      0 10px 30px -5px rgba(14, 165, 233, 0.12),
      inset 0 1px 2px rgba(255, 255, 255, 1);
    overflow: hidden;
    animation: cardFloatEntrance 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes cardFloatEntrance {
    0% { opacity: 0; transform: scale(0.95) translateY(20px); }
    100% { opacity: 1; transform: scale(1) translateY(0); }
  }

  /* ================= RIGHT PANEL: BRAND HERO ================= */
  .brand-showcase-panel {
    position: relative;
    padding: 3.5rem 3rem;
    background: linear-gradient(145deg, rgba(239, 246, 255, 0.75) 0%, rgba(248, 250, 252, 0.95) 100%);
    border-left: 1px solid rgba(226, 232, 240, 0.8);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
  }

  /* Company Crest Badge */
  .company-brand-header {
