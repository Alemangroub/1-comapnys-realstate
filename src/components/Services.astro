---
const services = [
  {
    slug: "residential-development",
    number: "01",
    title: "التطوير السكني",
    description: "نبتكر مجتمعات سكنية عصرية تجمع بين الفخامة المعمارية، جودة البناء، وتوفير كافة سبل الراحة والرفاهية الذكية لجميع أفراد الأسرة.",
    tag: "مجتمعات ذكية",
    gradient: "from-cyan-500 to-blue-600",
    glowColor: "rgba(56, 189, 248, 0.35)",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/><circle cx="12" cy="7" r="1.5"/></svg>`
  },
  {
    slug: "commercial-projects",
    number: "02",
    title: "المشاريع التجارية",
    description: "تطوير وجهات ومجمعات تجارية وإدارية حيوية بمواقع استراتيجية مدروسة، مصممة لتحفيز نمو الأعمال وتوفير بيئات عمل مستقبلية متكاملة.",
    tag: "أبراج ومولات",
    gradient: "from-purple-500 to-indigo-600",
    glowColor: "rgba(168, 85, 247, 0.35)",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="9" y1="6" x2="9" y2="6.01"/><line x1="15" y1="6" x2="15" y2="6.01"/><line x1="9" y1="10" x2="9" y2="10.01"/><line x1="15" y1="10" x2="15" y2="10.01"/><line x1="9" y1="14" x2="9" y2="14.01"/><line x1="15" y1="14" x2="15" y2="14.01"/><path d="M10 22v-4h4v4"/></svg>`
  },
  {
    slug: "project-management",
    number: "03",
    title: "إدارة المشاريع",
    description: "إشراف هندسي ورقابة تنفيذية متقدمة تضمن أدق معايير الجودة والالتزام الصارم بالجدول الزمني والميزانية، من التخطيط حتى التسليم.",
    tag: "إشراف هندسي متكامل",
    gradient: "from-amber-400 to-orange-500",
    glowColor: "rgba(245, 158, 11, 0.35)",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/><circle cx="12" cy="12" r="3.5"/></svg>`
  },
  {
    slug: "real-estate-investment",
    number: "04",
    title: "الاستثمار العقاري",
    description: "فرص استثمارية واعدة مدعومة بتحليلات سوق دقيقة ودراسات جدوى معمقة، تهدف لتعظيم العوائد الرأسمالية وتنمية الأصول بأمان مستدام.",
    tag: "عوائد آمنة ومدروسة",
    gradient: "from-emerald-400 to-teal-600",
    glowColor: "rgba(16, 185, 129, 0.35)",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/><circle cx="8.5" cy="10.5" r="1.5"/><circle cx="13.5" cy="15.5" r="1.5"/></svg>`
  }
];
---

<section id="services" class="services">
    <!-- Ambient Dynamic Glows -->
    <div class="services-glow services-glow-1"></div>
    <div class="services-glow services-glow-2"></div>
    <div class="services-pattern"></div>

    <div class="container">
        <!-- Advanced Top Header -->
        <div class="section-header">
            <div class="service-top-badge">
                <span class="badge-dot"></span>
                <span class="badge-text">حلول عقارية متكاملة وذكية</span>
            </div>
            
            <a href="/services" class="section-title-link">
                <h2 class="section-title">منظومة خدماتنا الاستثمارية</h2>
            </a>

            <p class="section-subtitle">
                نجمع بين الرؤية الهندسية المبتكرة والخبرة المالية لنقدم حلولاً متكاملة تصنع قيمة استثنائية ومستدامة لكل مشروع.
            </p>

            <!-- Quick Highlights Pill Strip -->
            <div class="header-pills">
                <span class="pill-item"><i class="fas fa-check-circle"></i> تخطيط معماري متقدم</span>
                <span class="pill-item"><i class="fas fa-check-circle"></i> كفاءة تنفيذ قياسية</span>
                <span class="pill-item"><i class="fas fa-check-circle"></i> دراسات جدوى معتمدة</span>
                <span class="pill-item"><i class="fas fa-check-circle"></i> إدارة أصول مستدامة</span>
            </div>
        </div>

        <!-- 4 Futuristic Modern Cards (No Photos) -->
        <div class="services-grid">
            {services.map((service, index) => (
                <a 
                    href={`/services/${service.slug}`} 
                    class="service-card-link" 
                    data-index={index}
                    style={`--card-glow: ${service.glowColor};`}
                >
                    <article class="service-card">
                        <!-- Holographic Background Effect -->
                        <div class="card-mesh"></div>
                        <div class="card-radial-light"></div>
                        
                        <!-- Header inside Card -->
                        <div class="card-top">
                            <span class="service-number">{service.number}</span>
                            <span class="card-tag">{service.tag}</span>
                        </div>

                        <!-- 3D Luminous Icon Container -->
                        <div class="card-icon-wrapper" set:html={service.iconSvg}></div>

                        <!-- Card Content -->
                        <div class="card-body">
                            <h3 class="service-title">{service.title}</h3>
                            <p class="service-description">{service.description}</p>
                        </div>

                        <!-- Footer Action CTA -->
                        <div class="card-footer">
                            <span class="cta-label">اكتشف التفاصيل</span>
                            <span class="cta-arrow">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="19" y1="12" x2="5" y2="12"></line>
                                    <polyline points="12 19 5 12 12 5"></polyline>
                                </svg>
                            </span>
                        </div>
                    </article>
                </a>
            ))}
        </div>
    </div>
</section>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const cards = document.querySelectorAll('.service-card-link');

        const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const card = entry.target;
                    const index = card.getAttribute('data-index');
                    card.style.transitionDelay = `${index * 120}ms`;
                    card.classList.add('is-visible');
                    obs.unobserve(card);
                }
            });
        }, { threshold: 0.15 });

        cards.forEach(card => {
            observer.observe(card);
        });
    });
</script>

<style>
    .services {
        position: relative;
        padding: 100px 0 110px;
        background: radial-gradient(circle at 50% 20%, #0e172a 0%, #090e1a 60%, #060913 100%);
        direction: rtl;
        overflow: hidden;
    }

    /* Ambient Background Glows */
    .services-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(110px);
        pointer-events: none;
        z-index: 1;
        opacity: 0.3;
    }

    .services-glow-1 {
        width: 500px;
        height: 500px;
        top: 0;
        left: -100px;
        background: radial-gradient(circle, rgba(56, 189, 248, 0.45) 0%, transparent 70%);
        animation: floatOrb 18s ease-in-out infinite alternate;
    }

    .services-glow-2 {
        width: 450px;
        height: 450px;
        bottom: 5%;
        right: -80px;
        background: radial-gradient(circle, rgba(168, 85, 247, 0.4) 0%, transparent 70%);
        animation: floatOrb 15s ease-in-out infinite alternate-reverse;
    }

    @keyframes floatOrb {
        0% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(40px, 30px) scale(1.1); }
        100% { transform: translate(-30px, -40px) scale(0.95); }
    }

    .services-pattern {
        position: absolute;
        inset: 0;
        background-size: 40px 40px;
        background-image: 
            linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
            linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
        z-index: 1;
        mask-image: radial-gradient(circle at center, black 40%, transparent 85%);
        -webkit-mask-image: radial-gradient(circle at center, black 40%, transparent 85%);
    }

    .container {
        position: relative;
        z-index: 2;
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 25px;
    }

    /* Top Header Section */
    .section-header {
        text-align: center;
        margin-bottom: 70px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .service-top-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 16px;
        border-radius: 30px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(211, 191, 169, 0.3);
        backdrop-filter: blur(10px);
        margin-bottom: 20px;
    }

    .badge-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: #38bdf8;
        box-shadow: 0 0 10px #38bdf8;
        animation: pulseDot 2s infinite;
    }

    @keyframes pulseDot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.8); }
    }

    .badge-text {
        font-family: 'Cairo', sans-serif;
        font-size: 0.95rem;
        font-weight: 700;
        color: #d3bfa9;
        letter-spacing: 0.5px;
    }

    .section-title-link {
        text-decoration: none;
        color: inherit;
        display: inline-block;
        transition: transform 0.3s ease;
    }

    .section-title-link:hover {
        transform: scale(1.02);
    }

    .section-title {
        font-family: 'Cairo', sans-serif;
        font-size: 3rem;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 15px;
        background: linear-gradient(180deg, #ffffff 40%, #cbd5e1 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -0.5px;
    }

    .section-subtitle {
        font-family: 'Almarai', sans-serif;
        font-size: 1.25rem;
        color: #94a3b8;
        max-width: 680px;
        margin: 0 auto 30px;
        line-height: 1.7;
    }

    /* Feature Pills Strip */
    .header-pills {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        margin-top: 10px;
    }

    .pill-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        font-family: 'Cairo', sans-serif;
        font-size: 0.88rem;
        color: #cbd5e1;
        transition: background-color 0.3s ease, border-color 0.3s ease;
    }

    .pill-item i {
        color: #38bdf8;
        font-size: 0.8rem;
    }

    .pill-item:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(56, 189, 248, 0.4);
    }

    /* Cards Grid */
    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
        gap: 30px;
    }

    .service-card-link {
        text-decoration: none;
        color: inherit;
        display: block;
        border-radius: 20px;
        opacity: 0;
        transform: translateY(40px);
        transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .service-card-link.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    /* Futuristic Card Styling */
    .service-card {
        position: relative;
        height: 100%;
        min-height: 380px;
        padding: 35px 28px 25px;
        border-radius: 20px;
        background: linear-gradient(160deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.015) 100%);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        transition: transform 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease, background 0.4s ease;
    }

    .card-mesh {
        position: absolute;
        inset: 0;
        background-size: 24px 24px;
        background-image: 
            radial-gradient(circle, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
        opacity: 0.6;
        pointer-events: none;
        transition: opacity 0.4s ease;
    }

    .card-radial-light {
        position: absolute;
        top: -40px;
        left: -40px;
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background: radial-gradient(circle, var(--card-glow) 0%, transparent 70%);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.5s ease, transform 0.5s ease;
    }

    .service-card-link:hover .service-card {
        transform: translateY(-10px);
        border-color: rgba(255, 255, 255, 0.25);
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.4), 0 0 35px var(--card-glow);
        background: linear-gradient(160deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.03) 100%);
    }

    .service-card-link:hover .card-radial-light {
        opacity: 1;
        transform: scale(1.4);
    }

    /* Card Top */
    .card-top {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .service-number {
        font-family: 'Cairo', monospace;
        font-size: 1.5rem;
        font-weight: 800;
        color: rgba(255, 255, 255, 0.25);
        transition: color 0.3s ease;
    }

    .service-card-link:hover .service-number {
        color: #d3bfa9;
    }

    .card-tag {
        font-family: 'Cairo', sans-serif;
        font-size: 0.78rem;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #94a3b8;
        transition: color 0.3s ease, border-color 0.3s ease;
    }

    .service-card-link:hover .card-tag {
        color: #ffffff;
        border-color: rgba(255, 255, 255, 0.3);
    }

    /* Card Icon */
    .card-icon-wrapper {
        position: relative;
        z-index: 2;
        width: 60px;
        height: 60px;
        border-radius: 14px;
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.03) 100%);
        border: 1px solid rgba(255, 255, 255, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        margin-bottom: 25px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
        transition: transform 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease;
    }

    .card-icon-wrapper :global(svg) {
        width: 30px;
        height: 30px;
        transition: transform 0.4s ease;
    }

    .service-card-link:hover .card-icon-wrapper {
        transform: scale(1.1) rotate(-3deg);
        border-color: rgba(255, 255, 255, 0.4);
        box-shadow: 0 10px 25px var(--card-glow);
    }

    .service-card-link:hover .card-icon-wrapper :global(svg) {
        transform: scale(1.08);
    }

    /* Card Body */
    .card-body {
        position: relative;
        z-index: 2;
        flex-grow: 1;
        margin-bottom: 25px;
    }

    .service-title {
        font-family: 'Cairo', sans-serif;
        font-size: 1.6rem;
        font-weight: 800;
        color: #ffffff;
        margin: 0 0 12px 0;
        line-height: 1.35;
        transition: color 0.3s ease;
    }

    .service-card-link:hover .service-title {
        color: #d3bfa9;
    }

    .service-description {
        font-family: 'Almarai', sans-serif;
        font-size: 0.96rem;
        color: #94a3b8;
        line-height: 1.7;
        margin: 0;
    }

    /* Card Footer Action */
    .card-footer {
        position: relative;
        z-index: 2;
        padding-top: 18px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .cta-label {
        font-family: 'Cairo', sans-serif;
        font-size: 0.95rem;
        font-weight: 700;
        color: #cbd5e1;
        transition: color 0.3s ease;
    }

    .cta-arrow {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #cbd5e1;
        transition: transform 0.3s ease, background-color 0.3s ease, color 0.3s ease;
    }

    .cta-arrow svg {
        width: 14px;
        height: 14px;
    }

    .service-card-link:hover .cta-label {
        color: #ffffff;
    }

    .service-card-link:hover .cta-arrow {
        transform: translateX(-4px);
        background-color: #d3bfa9;
        color: #0c1424;
        border-color: #d3bfa9;
    }

    /* Responsive */
    @media (max-width: 992px) {
        .section-title {
            font-size: 2.5rem;
        }
        .services-grid {
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 25px;
        }
    }

    @media (max-width: 768px) {
        .services {
            padding: 70px 0 80px;
        }
        .section-title {
            font-size: 2.1rem;
        }
        .section-subtitle {
            font-size: 1.05rem;
        }
        .header-pills {
            gap: 8px;
        }
        .pill-item {
            font-size: 0.8rem;
            padding: 5px 11px;
        }
    }
</style>
