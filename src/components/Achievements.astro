---
import achievements from '../data/achievements.json';
const { isTitleLink = false } = Astro.props;
---

<section id="achievements" class="achievements">
    <div class="achievements-glow achievements-glow-1"></div>
    <div class="achievements-glow achievements-glow-2"></div>
    <div class="achievements-geometric-grid"></div>
    <div class="achievements-overlay"></div>
    <div class="container">
        <div class="section-header">
            {isTitleLink ? (
                <a href="/achievements" class="section-title-link">
                    <h2 class="section-title">إنجازاتنا في أرقام</h2>
                </a>
            ) : (
                <h2 class="section-title">إنجازاتنا في أرقام</h2>
            )}
            <p class="section-subtitle">نفخر بما حققناه، والأرقام هي خير دليل على التزامنا بالتميز والجودة.</p>
        </div>
        <div class="achievements-grid">
            {achievements.map((item) => (
                <div class="achievement-item">
                    <div class="achievement-circle">
                        <span class="achievement-value" data-target-value={item.value.replace('+', '')}>0</span>
                    </div>
                    <h3 class="achievement-title">{item.title}</h3>
                    <p class="achievement-description">{item.description}</p>
                </div>
            ))}
        </div>
    </div>
</section>

<script>
    const animatedCounters = new WeakSet();

    const animateValue = (element, start, end, duration) => {
        let startTime = null;
        const step = (currentTime) => {
            if (!startTime) startTime = currentTime;
            const progress = Math.min((currentTime - startTime) / duration, 1);
            const currentValue = Math.floor(progress * (end - start) + start);
            element.textContent = `+${currentValue}`;
            if (progress < 1) {
                window.requestAnimationFrame(step);
            }
        };
        window.requestAnimationFrame(step);
    };

    // Use a specific class or ID to detect if we are on the homepage
    const isHomePage = document.body.classList.contains('homepage-body');

    if (isHomePage) {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting && !animatedCounters.has(entry.target)) {
                    const valueEl = entry.target.querySelector('.achievement-value');
                    const finalValue = parseInt(valueEl.getAttribute('data-target-value'), 10);
                    animateValue(valueEl, 0, finalValue, 2000);
                    animatedCounters.add(entry.target);
                    entry.target.classList.add('is-visible');
                }
            });
        }, { threshold: 0.5 });

        document.querySelectorAll('.achievement-item').forEach(item => {
            observer.observe(item);
        });
    } else {
        // On other pages (like achievements page), show final values immediately
        document.querySelectorAll('.achievement-item').forEach(item => {
            const valueEl = item.querySelector('.achievement-value');
            const finalValue = valueEl.getAttribute('data-target-value');
            valueEl.textContent = `+${finalValue}`;
            item.classList.add('is-visible'); 
        });
    }
</script>

<style>
    :root {
        --color-primary-text: #ffffff;
        --color-secondary-text: #e0e0e0;
        --font-main: 'Cairo', sans-serif;
        --font-secondary: 'Almarai', sans-serif;
    }

    .achievements {
        position: relative;
        padding: 110px 0;
        direction: rtl;
        overflow: hidden;
        background: linear-gradient(135deg, #090f1d 0%, #121c33 50%, #0a1122 100%);
    }

    .achievements-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        pointer-events: none;
        z-index: 1;
        opacity: 0.38;
        animation: pulseGlow 14s ease-in-out infinite alternate;
    }

    .achievements-glow-1 {
        width: 500px;
        height: 500px;
        top: -10%;
        right: 8%;
        background: radial-gradient(circle, rgba(52, 152, 219, 0.45) 0%, transparent 70%);
    }

    .achievements-glow-2 {
        width: 450px;
        height: 450px;
        bottom: -10%;
        left: 8%;
        background: radial-gradient(circle, rgba(211, 191, 169, 0.4) 0%, transparent 70%);
        animation-delay: -7s;
    }

    @keyframes pulseGlow {
        0% { transform: scale(1) translate(0, 0); }
        50% { transform: scale(1.15) translate(30px, -20px); }
        100% { transform: scale(0.95) translate(-20px, 30px); }
    }

    .achievements-geometric-grid {
        position: absolute;
        inset: 0;
        background-size: 48px 48px;
        background-image: 
            radial-gradient(circle, rgba(255, 255, 255, 0.05) 1.5px, transparent 1.5px);
        z-index: 1;
        mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
        -webkit-mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
    }

    .achievements-overlay {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at center, rgba(10, 17, 34, 0.3) 0%, rgba(6, 10, 20, 0.8) 100%);
        z-index: 1;
    }

    .container {
        position: relative;
        z-index: 2;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .section-header {
        text-align: center;
        margin-bottom: 80px;
    }

    .section-title-link {
        text-decoration: none;
        color: inherit;
        display: inline-block;
        transition: transform 0.3s ease;
    }

    .section-title-link:hover {
        transform: scale(1.03);
    }
    
    .section-title-link:hover .section-title {
        color: #d3bfa9;
    }

    .section-title {
        font-family: var(--font-main);
        font-size: 3rem;
        font-weight: 800;
        color: var(--color-primary-text);
        margin-bottom: 10px;
        transition: color 0.3s ease;
    }

    .section-subtitle {
        font-family: var(--font-secondary);
        font-size: 1.3rem;
        color: var(--color-secondary-text);
        max-width: 650px;
        margin: 0 auto;
        line-height: 1.6;
        opacity: 0.9;
    }

    .achievements-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 60px 40px;
    }

    .achievement-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.7s ease-out, transform 0.7s ease-out;
    }

    .achievement-item.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .achievement-circle {
        width: 200px;
        height: 200px;
        border-radius: 50%;
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 2px solid rgba(211, 191, 169, 0.45);
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 25px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35), inset 0 0 20px rgba(211, 191, 169, 0.08);
        transition: transform 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease, background 0.4s ease;
        position: relative;
    }

    .achievement-circle::before {
        content: '';
        position: absolute;
        inset: -6px;
        border-radius: 50%;
        border: 1px dashed rgba(52, 152, 219, 0.35);
        animation: spinSlow 28s linear infinite;
        pointer-events: none;
    }

    @keyframes spinSlow {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    .achievement-item:hover .achievement-circle {
        transform: translateY(-8px) scale(1.06);
        border-color: #d3bfa9;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.4), 0 0 35px rgba(211, 191, 169, 0.3);
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0.05) 100%);
    }

    .achievement-value {
        font-family: var(--font-main);
        font-size: 4.4rem;
        font-weight: 800;
        color: #ffffff;
        background: linear-gradient(180deg, #ffffff 40%, #d3bfa9 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .achievement-title {
        font-family: var(--font-secondary);
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--color-primary-text);
        margin-bottom: 10px;
    }

    .achievement-description {
        font-family: var(--font-secondary);
        font-size: 1rem;
        color: var(--color-secondary-text);
        line-height: 1.6;
        max-width: 240px;
        opacity: 0.9;
    }

    @media (max-width: 768px) {
        .achievements {
            background-attachment: scroll;
            padding: 60px 0;
        }
        .section-title { font-size: 2.5rem; }
        .section-subtitle { font-size: 1.1rem; }
        .achievement-circle { width: 180px; height: 180px; }
        .achievement-value { font-size: 3.8rem; }
        .achievement-title { font-size: 1.4rem; }
    }

    @media (max-width: 576px) {
        .achievements-grid {
            grid-template-columns: 1fr;
            max-width: 320px;
            margin: 0 auto;
        }
    }
</style>
