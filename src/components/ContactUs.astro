---
const { isTitleLink = false } = Astro.props;

const contactChannels = [
  {
    number: "01",
    tag: "اتصال هاتفي مباشر",
    title: "الخط الساخن المباشر",
    subtitle: "متاح طوال ساعات العمل للرد على كافة الاستفسارات",
    value: "19000",
    href: "tel:19000",
    actionText: "اتصل بنا الآن",
    glowColor: "rgba(56, 189, 248, 0.35)",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.63A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`
  },
  {
    number: "02",
    tag: "محادثة فورية",
    title: "خدمة المبيعات والاستشارات",
    subtitle: "تواصل مباشر وفوري مع مستشارينا عبر واتساب",
    value: "محادثة واتساب سريعة",
    href: "/contact",
    actionText: "بدء المحادثة",
    glowColor: "rgba(16, 185, 129, 0.35)",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>`
  },
  {
    number: "03",
    tag: "مراسلات رسمية",
    title: "البريد الإلكتروني الرسمي",
    subtitle: "نستقبل استفساراتكم ومقترحاتكم على مدار الساعة",
    value: "info@realestate-dev.com",
    href: "mailto:info@realestate-dev.com",
    actionText: "إرسال بريد إلكتروني",
    glowColor: "rgba(168, 85, 247, 0.35)",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>`
  },
  {
    number: "04",
    tag: "زيارة المقر",
    title: "المقر الرئيسي للشركة",
    subtitle: "يسعدنا استقبالكم لمناقشة كافة الفرص الاستثمارية",
    value: "القاهرة - التجمع الخامس",
    href: "https://maps.google.com",
    actionText: "عرض الموقع على الخريطة",
    glowColor: "rgba(245, 158, 11, 0.35)",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`
  }
];
---

<section id="contact-us" class="contact-section">
  <!-- Dynamic Ambient Glows -->
  <div class="contact-glow contact-glow-1"></div>
  <div class="contact-glow contact-glow-2"></div>
  <div class="contact-pattern"></div>

  <div class="container">
    <!-- Advanced Section Header -->
    <div class="section-header">
      <div class="contact-top-badge">
        <span class="badge-dot"></span>
        <span class="badge-text">قنوات تواصل متطورة وفورية</span>
      </div>

      {isTitleLink ? (
        <a href="/contact" class="section-title-link">
          <h2 class="section-title">تواصل معنا الآن</h2>
        </a>
      ) : (
        <h2 class="section-title">تواصل معنا الآن</h2>
      )}

      <p class="section-subtitle">
        فريقنا المتخصص في خدمتكم دائماً لتقديم أفضل الاستشارات العقارية ومشاركتكم أحدث الفرص الاستثمارية الواعدة.
      </p>

      <!-- Quick Feature Pills -->
      <div class="header-pills">
        <span class="pill-item"><i class="fas fa-headset"></i> استجابة سريعة ومباشرة</span>
        <span class="pill-item"><i class="fas fa-chart-line"></i> استشارات استثمارية متخصصة</span>
        <span class="pill-item"><i class="fas fa-map-marked-alt"></i> جولات ميدانية للمشاريع</span>
        <span class="pill-item"><i class="fas fa-shield-alt"></i> شفافية وخصوصية تامة</span>
      </div>
    </div>

    <!-- 4 Futuristic Contact Cards -->
    <div class="contact-grid">
      {contactChannels.map((channel, index) => (
        <a 
          href={channel.href} 
          class="contact-card-link" 
          data-index={index}
          target={channel.href.startsWith("http") ? "_blank" : undefined}
          rel={channel.href.startsWith("http") ? "noopener noreferrer" : undefined}
          style={`--card-glow: ${channel.glowColor};`}
        >
          <article class="contact-card">
            <!-- Holographic Mesh & Radial Light -->
            <div class="card-mesh"></div>
            <div class="card-radial-light"></div>

            <!-- Card Top Header -->
            <div class="card-top">
              <span class="card-number">{channel.number}</span>
              <span class="card-tag">{channel.tag}</span>
            </div>

            <!-- 3D Luminous Icon Container -->
            <div class="card-icon-wrapper" set:html={channel.iconSvg}></div>

            <!-- Card Main Body -->
            <div class="card-body">
              <h3 class="channel-title">{channel.title}</h3>
              <p class="channel-subtitle">{channel.subtitle}</p>
              <div class="channel-value" dir={channel.number === "01" ? "ltr" : "auto"}>
                {channel.value}
              </div>
            </div>

            <!-- Card Footer CTA Button -->
            <div class="card-footer">
              <span class="cta-label">{channel.actionText}</span>
              <span class="cta-arrow">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="19" y1="12" x2="5" y2="12"></line>
                  <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
              </span>
            </div>
          </article>
        </a>
      ))}
    </div>

    <!-- Working Hours Bar -->
    <div class="working-hours-strip">
      <div class="hours-icon">
        <i class="far fa-clock"></i>
      </div>
      <div class="hours-text">
        <span class="hours-label">أوقات العمل الرسمية:</span>
        <span class="hours-val">السبت - الخميس: من 9:00 صباحاً حتى 6:00 مساءً</span>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.contact-card-link');

    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const card = entry.target;
          const index = card.getAttribute('data-index');
          card.style.transitionDelay = `${index * 110}ms`;
          card.classList.add('is-visible');
          obs.unobserve(card);
        }
      });
    }, { threshold: 0.15 });

    cards.forEach(card => {
      observer.observe(card);
    });
  });
</script>

<style>
  .contact-section {
    position: relative;
    padding: 100px 0 110px;
    background: radial-gradient(circle at 50% 20%, #0d1627 0%, #080d19 60%, #050812 100%);
    direction: rtl;
    overflow: hidden;
  }

  /* Ambient Dynamic Glows */
  .contact-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;
    z-index: 1;
    opacity: 0.32;
  }

  .contact-glow-1 {
    width: 500px;
    height: 500px;
    top: -50px;
    left: -80px;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.45) 0%, transparent 70%);
    animation: floatOrb 18s ease-in-out infinite alternate;
  }

  .contact-glow-2 {
    width: 480px;
    height: 480px;
    bottom: -50px;
    right: -80px;
    background: radial-gradient(circle, rgba(211, 191, 169, 0.35) 0%, transparent 70%);
    animation: floatOrb 15s ease-in-out infinite alternate-reverse;
  }

  @keyframes floatOrb {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(35px, -25px) scale(1.08); }
    100% { transform: translate(-30px, 30px) scale(0.95); }
  }

  .contact-pattern {
    position: absolute;
    inset: 0;
    background-size: 40px 40px;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    z-index: 1;
    mask-image: radial-gradient(circle at center, black 40%, transparent 85%);
    -webkit-mask-image: radial-gradient(circle at center, black 40%, transparent 85%);
  }

  .container {
    position: relative;
    z-index: 2;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 25px;
  }

  /* Section Header */
  .section-header {
    text-align: center;
    margin-bottom: 70px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .contact-top-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border-radius: 30px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(211, 191, 169, 0.3);
    backdrop-filter: blur(10px);
    margin-bottom: 20px;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #38bdf8;
    box-shadow: 0 0 10px #38bdf8;
    animation: pulseDot 2s infinite;
  }

  @keyframes pulseDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  .badge-text {
    font-family: 'Cairo', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: #d3bfa9;
    letter-spacing: 0.5px;
  }

  .section-title-link {
    text-decoration: none;
    color: inherit;
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .section-title-link:hover {
    transform: scale(1.02);
  }

  .section-title {
    font-family: 'Cairo', sans-serif;
    font-size: 3rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 15px;
    background: linear-gradient(180deg, #ffffff 40%, #cbd5e1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.5px;
  }

  .section-subtitle {
    font-family: 'Almarai', sans-serif;
    font-size: 1.25rem;
    color: #94a3b8;
    max-width: 720px;
    margin: 0 auto 30px;
    line-height: 1.7;
  }

  /* Header Pills Strip */
  .header-pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 5px;
  }

  .pill-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    font-family: 'Cairo', sans-serif;
    font-size: 0.88rem;
    color: #cbd5e1;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .pill-item i {
    color: #38bdf8;
    font-size: 0.82rem;
  }

  .pill-item:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(56, 189, 248, 0.4);
  }

  /* Cards Grid */
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 30px;
    margin-bottom: 50px;
  }

  .contact-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
    border-radius: 20px;
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-card-link.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Futuristic Card */
  .contact-card {
    position: relative;
    height: 100%;
    min-height: 380px;
    padding: 35px 28px 25px;
    border-radius: 20px;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.015) 100%);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    transition: transform 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease, background 0.4s ease;
  }

  .card-mesh {
    position: absolute;
    inset: 0;
    background-size: 24px 24px;
    background-image: 
      radial-gradient(circle, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    opacity: 0.6;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .card-radial-light {
    position: absolute;
    top: -40px;
    left: -40px;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--card-glow) 0%, transparent 70%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .contact-card-link:hover .contact-card {
    transform: translateY(-10px);
    border-color: rgba(255, 255, 255, 0.25);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.4), 0 0 35px var(--card-glow);
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.03) 100%);
  }

  .contact-card-link:hover .card-radial-light {
    opacity: 1;
    transform: scale(1.4);
  }

  /* Card Top */
  .card-top {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
  }

  .card-number {
    font-family: 'Cairo', monospace;
    font-size: 1.5rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.25);
    transition: color 0.3s ease;
  }

  .contact-card-link:hover .card-number {
    color: #d3bfa9;
  }

  .card-tag {
    font-family: 'Cairo', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #94a3b8;
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .contact-card-link:hover .card-tag {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.3);
  }

  /* Card Icon */
  .card-icon-wrapper {
    position: relative;
    z-index: 2;
    width: 60px;
    height: 60px;
    border-radius: 14px;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.03) 100%);
    border: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    margin-bottom: 25px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
    transition: transform 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease;
  }

  .card-icon-wrapper :global(svg) {
    width: 30px;
    height: 30px;
    transition: transform 0.4s ease;
  }

  .contact-card-link:hover .card-icon-wrapper {
    transform: scale(1.1) rotate(-3deg);
    border-color: rgba(255, 255, 255, 0.4);
    box-shadow: 0 10px 25px var(--card-glow);
  }

  .contact-card-link:hover .card-icon-wrapper :global(svg) {
    transform: scale(1.08);
  }

  /* Card Body */
  .card-body {
    position: relative;
    z-index: 2;
    flex-grow: 1;
    margin-bottom: 25px;
  }

  .channel-title {
    font-family: 'Cairo', sans-serif;
    font-size: 1.5rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 10px 0;
    line-height: 1.35;
    transition: color 0.3s ease;
  }

  .contact-card-link:hover .channel-title {
    color: #d3bfa9;
  }

  .channel-subtitle {
    font-family: 'Almarai', sans-serif;
    font-size: 0.92rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0 0 16px 0;
  }

  .channel-value {
    font-family: 'Cairo', sans-serif;
    font-size: 1.25rem;
    font-weight: 800;
    color: #d3bfa9;
    background: rgba(211, 191, 169, 0.1);
    padding: 8px 14px;
    border-radius: 10px;
    border: 1px solid rgba(211, 191, 169, 0.25);
    display: inline-block;
    transition: all 0.3s ease;
  }

  .contact-card-link:hover .channel-value {
    background: #d3bfa9;
    color: #080d19;
    border-color: #d3bfa9;
  }

  /* Card Footer CTA */
  .card-footer {
    position: relative;
    z-index: 2;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cta-label {
    font-family: 'Cairo', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: #cbd5e1;
    transition: color 0.3s ease;
  }

  .cta-arrow {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #cbd5e1;
    transition: transform 0.3s ease, background-color 0.3s ease, color 0.3s ease;
  }

  .cta-arrow svg {
    width: 14px;
    height: 14px;
  }

  .contact-card-link:hover .cta-label {
    color: #ffffff;
  }

  .contact-card-link:hover .cta-arrow {
    transform: translateX(-4px);
    background-color: #d3bfa9;
    color: #0c1424;
    border-color: #d3bfa9;
  }

  /* Working Hours Strip */
  .working-hours-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 20px 30px;
    border-radius: 16px;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.01) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(12px);
    max-width: 750px;
    margin: 0 auto;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
  }

  .hours-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(211, 191, 169, 0.12);
    border: 1px solid rgba(211, 191, 169, 0.25);
    color: #d3bfa9;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    flex-shrink: 0;
  }

  .hours-text {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    font-family: 'Cairo', sans-serif;
  }

  .hours-label {
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
  }

  .hours-val {
    font-family: 'Almarai', sans-serif;
    font-size: 1rem;
    color: #d3bfa9;
    font-weight: 600;
  }

  /* Responsive */
  @media (max-width: 992px) {
    .section-title {
      font-size: 2.5rem;
    }
    .contact-grid {
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 25px;
    }
  }

  @media (max-width: 768px) {
    .contact-section {
      padding: 70px 0 80px;
    }
    .section-title {
      font-size: 2.1rem;
    }
    .section-subtitle {
      font-size: 1.05rem;
    }
    .header-pills {
      gap: 8px;
    }
    .pill-item {
      font-size: 0.8rem;
      padding: 5px 11px;
    }
    .working-hours-strip {
      flex-direction: column;
      text-align: center;
      padding: 20px;
    }
    .hours-text {
      flex-direction: column;
      gap: 5px;
    }
  }
</style>
