</style>

<script>
  import { checkAuth, logout } from '../lib/auth.js';

  let currentSalesUser = null;
  let salesData = null;
  let currentActiveLead = null;
  let currentActiveQuotation = null;

  document.addEventListener('DOMContentLoaded', async () => {
    const authLoading = document.getElementById('auth-loading-message');
    const loginContainer = document.getElementById('admin-login-container');
    const mainContent = document.getElementById('main-content');
    const logoutBtn = document.getElementById('logout-button');

    try {
      const user = await checkAuth();
      if (authLoading) authLoading.style.display = 'none';

      if (user && (user.role === 'sales' || user.role === 'admin')) {
        currentSalesUser = user;
        if (mainContent) mainContent.style.display = 'block';

        const nameElem = document.getElementById('user-display-name');
        const initialElem = document.getElementById('user-avatar-initial');
        if (nameElem && user.name) nameElem.textContent = user.name;
        if (initialElem && user.name) initialElem.textContent = user.name.charAt(0).toUpperCase();

        if (logoutBtn) {
          logoutBtn.addEventListener('click', async () => {
            await logout();
            window.location.href = '/crs';
          });
        }

        initializeSalesDashboard();
      } else {
        window.location.href = '/crs';
      }
    } catch (e) {
      if (authLoading) authLoading.style.display = 'none';
      if (loginContainer) loginContainer.style.display = 'block';
    }
  });

  async function fetchSalesData() {
    try {
      const res = await fetch('/api/erp/sales');
      const data = await res.json();
      if (data.success) {
        salesData = data;
        renderTargetTracker();
        renderMetrics();
        renderPipelineKanban();
        renderLeadsTable();
        renderInventory();
        renderReservations();
        populateModals();
      }
    } catch (err) {
      console.error('Error fetching sales data:', err);
    }
  }

  // ITEM 4: Target & Commission Live Progress Tracker
  function renderTargetTracker() {
    if (!salesData || !salesData.targetMetrics) return;
    const m = salesData.targetMetrics;

    const monthlyTarget = m.monthlyTarget || 3000000;
    const achievedSales = m.totalAchievedSales || 0;
    const remaining = m.remainingTarget || Math.max(0, monthlyTarget - achievedSales);
    const progressPct = m.targetProgressPercent || Math.min(100, Math.round((achievedSales / monthlyTarget) * 100));

    document.getElementById('target-monthly-val').textContent = monthlyTarget.toLocaleString('ar-EG') + ' ج.م';
    document.getElementById('target-achieved-val').textContent = achievedSales.toLocaleString('ar-EG') + ' ج.م';
    document.getElementById('target-remaining-val').textContent = remaining.toLocaleString('ar-EG') + ' ج.م';
    document.getElementById('target-commission-val').textContent = (salesData.totalCommissions || 0).toLocaleString('ar-EG') + ' ج.م';

    const bar = document.getElementById('target-progress-bar');
    const badge = document.getElementById('target-pct-badge');
    if (bar) bar.style.width = progressPct + '%';
    if (badge) badge.textContent = progressPct + '% من التارجت';

    // Populate Target Modal inputs
    const tInput = document.getElementById('t-monthly-val');
    const rInput = document.getElementById('t-rate-val');
    if (tInput) tInput.value = monthlyTarget;
    if (rInput) rInput.value = m.commissionRate || 1.0;
  }

  function renderMetrics() {
    if (!salesData) return;
    document.getElementById('stat-leads-count').textContent = salesData.leads?.length || 0;
    document.getElementById('stat-reservations-count').textContent = salesData.reservations?.length || 0;

    // Follow-ups today & overdue
    let todayCount = 0;
    let overdueCount = 0;
    const now = new Date();
    const todayStr = now.toISOString().split('T')[0];

    salesData.leads?.forEach(l => {
      if (l.nextFollowUp && l.status !== 'won' && l.status !== 'lost') {
        const fDate = new Date(l.nextFollowUp);
        const fDateStr = fDate.toISOString().split('T')[0];
        if (fDateStr === todayStr) todayCount++;
        else if (fDate < now) overdueCount++;
      }
    });

    document.getElementById('stat-today-followups').textContent = todayCount;
    document.getElementById('stat-overdue-followups').textContent = overdueCount + ' متابعة متأخرة';

    let availCount = 0;
    salesData.projects?.forEach(p => {
      p.units?.forEach(u => {
        if (u.status === 'available') availCount++;
      });
    });
    document.getElementById('stat-available-units').textContent = availCount;
  }

  // ITEM 5: 1-Click WhatsApp Helper
  function getWhatsAppUrl(phone, clientName) {
    if (!phone) return '#';
    let clean = phone.replace(/[^0-9]/g, '');
    if (clean.startsWith('0')) clean = '2' + clean; // Egyptian standard +20
    else if (!clean.startsWith('2') && clean.length === 10) clean = '20' + clean;

    const repName = currentSalesUser?.name || 'مسؤول المبيعات';
    const msg = `السلام عليكم أستاذ ${clientName || ''}، معك ${repName} بخصوص اهتمامكم بمشروعاتنا العقارية. يسعدني تقديم المساعدة وتفاصيل الوحدات المتاحة لحضرتك.`;
    return `https://wa.me/${clean}?text=${encodeURIComponent(msg)}`;
  }

  // ITEM 1: Visual Kanban Pipeline
  function renderPipelineKanban() {
    if (!salesData) return;

    const stages = ['new', 'contacted', 'meeting', 'proposal', 'won', 'lost'];
    const buckets = { new: [], contacted: [], meeting: [], proposal: [], won: [], lost: [] };

    salesData.leads?.forEach(lead => {
      const st = lead.status || 'new';
      if (buckets[st]) buckets[st].push(lead);
      else buckets['new'].push(lead);
    });

    stages.forEach(st => {
      const colEl = document.getElementById(`cards-stage-${st}`);
      const countEl = document.getElementById(`count-stage-${st}`);
      if (countEl) countEl.textContent = buckets[st].length;

      if (!colEl) return;
      if (buckets[st].length === 0) {
        colEl.innerHTML = `<div style="text-align:center; padding:1.2rem; color:#94a3b8; font-size:0.75rem;">لا يوجد عملاء هنا</div>`;
        return;
      }

      colEl.innerHTML = buckets[st].map(lead => {
        const clientName = lead.fullName || lead.name || 'عميل محتمل';
        const phone = lead.phone || '-';
        const projName = lead.project?.projectName || 'مشروع عام';
        const budget = lead.budget ? lead.budget.toLocaleString('ar-EG') + ' ج.م' : 'ميزانية غير محددة';
        const waUrl = getWhatsAppUrl(phone, clientName);

        // Follow-up status
        let fuHtml = '';
        if (lead.nextFollowUp) {
          const fuDate = new Date(lead.nextFollowUp);
          const isPast = fuDate < new Date();
          const fuFormatted = fuDate.toLocaleDateString('ar-EG', { month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' });
          fuHtml = `<div class="k-followup-badge ${isPast ? 'fu-urgent' : 'fu-upcoming'}">⏰ متابعة: ${fuFormatted}</div>`;
        } else if (st !== 'won' && st !== 'lost') {
          fuHtml = `<div class="k-followup-badge fu-normal">⚠️ لا يوجد موعد متابعة</div>`;
        }

        // Lost reason banner
        let lostHtml = '';
        if (st === 'lost' && lead.lostReason) {
          lostHtml = `<div style="font-size:0.7rem; color:#b91c1c; background:#fee2e2; padding:0.2rem 0.4rem; border-radius:4px;">سبب الإلغاء: ${lead.lostReason}</div>`;
        }

        return `
          <div class="kanban-lead-card" data-lead-id="${lead.id}">
            <div class="k-card-top">
              <div>
                <h5 class="k-card-name">${clientName}</h5>
                <div class="k-card-proj">${projName}</div>
              </div>
              <span class="k-budget-tag">${budget}</span>
            </div>

            <div class="k-contact-actions">
              <a href="tel:${phone}" class="btn-tel-pill">📞 ${phone}</a>
              <a href="${waUrl}" target="_blank" class="btn-wa-pill" title="محادثة فورية">💬 واتساب</a>
            </div>

            ${fuHtml}
            ${lostHtml}

            <div class="k-card-footer">
              <button type="button" class="btn-open-log open-act-modal-btn" data-lead='${JSON.stringify(lead)}'>
                📝 سجل المتابعة (${lead.activities?.length || 0})
              </button>
              <select class="k-quick-stage-sel stage-changer-dropdown" data-lead-id="${lead.id}">
                <option value="new" ${st === 'new' ? 'selected' : ''}>جديد</option>
                <option value="contacted" ${st === 'contacted' ? 'selected' : ''}>تم التواصل</option>
                <option value="meeting" ${st === 'meeting' ? 'selected' : ''}>معاينة</option>
                <option value="proposal" ${st === 'proposal' ? 'selected' : ''}>عرض سعر</option>
                <option value="won" ${st === 'won' ? 'selected' : ''}>تعاقد 🏆</option>
                <option value="lost" ${st === 'lost' ? 'selected' : ''}>ملغي ❌</option>
              </select>
            </div>
          </div>
        `;
      }).join('');
    });

    attachKanbanListeners();
  }

  function renderLeadsTable() {
    const tbody = document.getElementById('leads-tbody');
    if (!salesData || !salesData.leads || salesData.leads.length === 0) {
      tbody.innerHTML = `<tr><td colspan="7" class="table-loading">لا يوجد عملاء محتملين مسجلين بعد. ابدأ بإضافة عميل جديد!</td></tr>`;
      return;
    }

    const stagesMap = {
      new: 'عميل جديد',
      contacted: 'تم التواصل',
      meeting: 'معاينة ومقابلة',
      proposal: 'عرض سعر وتفاوض',
      won: 'تم التعاقد والبيع',
      lost: 'صفقة ملغاة'
    };

    tbody.innerHTML = salesData.leads.map(lead => {
      const clientName = lead.fullName || lead.name || 'عميل محتمل';
      const phone = lead.phone || '-';
      const waUrl = getWhatsAppUrl(phone, clientName);

      let fuBadge = '-';
      if (lead.nextFollowUp) {
        const d = new Date(lead.nextFollowUp);
        const isPast = d < new Date();
        fuBadge = `<span class="k-followup-badge ${isPast ? 'fu-urgent' : 'fu-upcoming'}">${d.toLocaleDateString('ar-EG', { month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' })}</span>`;
      }

      return `
        <tr>
          <td><strong>${clientName}</strong></td>
          <td>
            <div style="display:flex; align-items:center; gap:0.4rem;">
              <a href="tel:${phone}" style="color:#0f172a; font-weight:700; text-decoration:none;">${phone}</a>
              <a href="${waUrl}" target="_blank" class="btn-wa-pill">💬 واتساب</a>
            </div>
          </td>
          <td>${lead.project?.projectName || 'مشروع عام'}</td>
          <td><span class="role-pill pill-emerald">${stagesMap[lead.status] || lead.status}</span></td>
          <td>${fuBadge}</td>
          <td>${lead.budget ? lead.budget.toLocaleString('ar-EG') + ' ج.م' : '-'}</td>
          <td>
            <button type="button" class="btn-ctrl btn-refresh open-act-modal-btn" data-lead='${JSON.stringify(lead)}' style="padding:0.3rem 0.6rem; font-size:0.75rem;">
              📝 المتابعات (${lead.activities?.length || 0})
            </button>
          </td>
        </tr>
      `;
    }).join('');

    attachTableListeners();
  }

  function attachKanbanListeners() {
    // Stage dropdown quick changer
    document.querySelectorAll('.stage-changer-dropdown').forEach(sel => {
      sel.addEventListener('change', async (e) => {
        const leadId = e.target.dataset.leadId;
        const stage = e.target.value;

        if (stage === 'lost') {
          // Open activity modal to enter lost reason
          const lead = salesData.leads.find(l => l.id === leadId);
          if (lead) openActivityModal(lead, 'lost');
          return;
        }

        try {
          await fetch('/api/erp/sales', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'update_lead_stage', leadId, stage })
          });
          fetchSalesData();
        } catch (err) { alert('خطأ في تحديث المرحلة'); }
      });
    });

    // Open activity modal
    document.querySelectorAll('.open-act-modal-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const lead = JSON.parse(btn.dataset.lead);
        openActivityModal(lead);
      });
    });
  }

  function attachTableListeners() {
    document.querySelectorAll('#leads-tbody .open-act-modal-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const lead = JSON.parse(btn.dataset.lead);
        openActivityModal(lead);
      });
    });
  }

  // ITEM 2: Interaction Hub & Call Log Modal
  function openActivityModal(lead, forceStage = null) {
    currentActiveLead = lead;
    const modal = document.getElementById('lead-activity-modal');
    const clientName = lead.fullName || lead.name || 'العميل';
    document.getElementById('act-modal-client-name').textContent = 'سجل متابعة: ' + clientName;
    document.getElementById('act-modal-client-phone').textContent = 'رقم الهاتف: ' + (lead.phone || '-');
    document.getElementById('act-lead-id').value = lead.id;

    // WhatsApp link
    const waBtn = document.getElementById('act-modal-wa-btn');
    if (waBtn) waBtn.href = getWhatsAppUrl(lead.phone, clientName);

    // Stage dropdown
    const stageSel = document.getElementById('act-stage');
    if (stageSel) {
      stageSel.value = forceStage || lead.status || 'new';
      handleLostFieldVisibility(stageSel.value);
    }

    // Populate timeline
    renderActivitiesTimeline(lead.activities || []);

    modal.style.display = 'flex';
  }

  function handleLostFieldVisibility(stage) {
    const lostField = document.getElementById('lost-reason-field');
    if (lostField) {
      lostField.style.display = stage === 'lost' ? 'flex' : 'none';
    }
  }

  function renderActivitiesTimeline(acts) {
    const list = document.getElementById('act-timeline-list');
    if (!acts || acts.length === 0) {
      list.innerHTML = `<div style="text-align:center; padding:1.5rem; color:#94a3b8; font-size:0.8rem;">لا توجد مكالمات أو أنشطة مسجلة مسبقاً.</div>`;
      return;
    }

    const typeTags = {
      call: '<span class="t-type-tag tag-call">📞 مكالمة</span>',
      meeting: '<span class="t-type-tag tag-meeting">🏢 معاينة ميدانية</span>',
      whatsapp: '<span class="t-type-tag tag-whatsapp">💬 واتساب</span>',
      proposal: '<span class="t-type-tag tag-proposal">📑 عرض سعر</span>',
      note: '<span class="t-type-tag tag-note">📝 ملاحظة</span>'
    };

    list.innerHTML = acts.map(a => `
      <div class="timeline-card">
        <div class="t-card-head">
          ${typeTags[a.type] || '<span class="t-type-tag tag-note">تواصل</span>'}
          <span class="t-date">${new Date(a.createdAt).toLocaleDateString('ar-EG', { month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' })}</span>
        </div>
        <strong style="color:#0f172a;">${a.summary}</strong>
        ${a.details ? `<p style="margin:0.2rem 0 0 0; color:#64748b; font-size:0.78rem;">${a.details}</p>` : ''}
        <div style="font-size:0.7rem; color:#94a3b8; margin-top:0.2rem;">بواسطة: ${a.performedBy || 'مسؤول المبيعات'}</div>
      </div>
    `).join('');
  }

  // ITEM 3: Instant Quotation Modal & Calculator
  function openQuotationModal(preselectedUnitId = null) {
    const modal = document.getElementById('quotation-modal');
    const uSelect = document.getElementById('q-unit-select');

    // Populate units
    let unitOptions = '<option value="">اختر الوحدة من المشروعات...</option>';
    salesData?.projects?.forEach(p => {
      p.units?.forEach(u => {
        const isSelected = preselectedUnitId && u.id === preselectedUnitId;
        unitOptions += `<option value="${u.id}" ${isSelected ? 'selected' : ''}>وحدة ${u.unitNumber} (${u.unitType} - ${u.area}م²) - ${p.projectName} [${u.totalPrice?.toLocaleString('ar-EG')} ج.م]</option>`;
      });
    });
    if (uSelect) uSelect.innerHTML = unitOptions;

    // Date
    document.getElementById('q-out-date').textContent = 'التاريخ: ' + new Date().toLocaleDateString('ar-EG');
    document.getElementById('q-out-rep').textContent = currentSalesUser?.name || 'مسؤول المبيعات';

    modal.style.display = 'flex';
  }

  async function calculateQuotation() {
    const unitId = document.getElementById('q-unit-select').value;
    if (!unitId) return alert('يرجى اختيار الوحدة لحساب العرض');

    const payload = {
      action: 'calculate_quotation',
      unitId,
      clientName: document.getElementById('q-client-name').value || 'عميل محترم',
      downPaymentPercent: parseFloat(document.getElementById('q-dp-pct').value) || 15,
      installmentYears: parseInt(document.getElementById('q-years-select').value) || 5,
      installmentFrequency: document.getElementById('q-freq-select').value || 'quarterly',
      discountPercent: parseFloat(document.getElementById('q-discount-pct').value) || 0,
      maintenancePercent: parseFloat(document.getElementById('q-maint-pct').value) || 5
    };

    try {
      const res = await fetch('/api/erp/sales', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.success && data.quotation) {
        currentActiveQuotation = data.quotation;
        renderQuotationSheet(data.quotation);
      } else {
        alert(data.error || 'فشل حساب عرض السعر');
      }
    } catch (e) {
      alert('خطأ في الاتصال بالخادم');
    }
  }

  function renderQuotationSheet(q) {
    document.getElementById('q-out-client').textContent = q.clientName;
    document.getElementById('q-out-project').textContent = q.unit.projectName || '-';
    document.getElementById('q-out-unit').textContent = `وحدة ${q.unit.unitNumber} (${q.unit.unitType})`;
    document.getElementById('q-out-area').textContent = `${q.unit.area} م² (الدور ${q.unit.floor})`;

    document.getElementById('q-out-price').textContent = q.pricing.netPrice.toLocaleString('ar-EG') + ' ج.م';
    document.getElementById('q-out-dp').textContent = q.pricing.downPaymentAmount.toLocaleString('ar-EG') + ' ج.م';
    document.getElementById('q-out-inst-amt').textContent = q.pricing.installmentAmount.toLocaleString('ar-EG') + ' ج.م';
    document.getElementById('q-out-maint').textContent = q.pricing.maintenanceAmount.toLocaleString('ar-EG') + ' ج.م';

    const tbody = document.getElementById('q-schedule-tbody');
    if (q.schedule && q.schedule.length > 0) {
      tbody.innerHTML = q.schedule.map(s => `
        <tr>
          <td><strong>${s.num}</strong></td>
          <td>${s.title}</td>
          <td>${s.dueDate}</td>
          <td style="color:#059669; font-weight:800;">${s.amount.toLocaleString('ar-EG')} ج.م</td>
        </tr>
      `).join('');
    }
  }

  function renderInventory() {
    const grid = document.getElementById('units-grid');
    const filterVal = document.getElementById('inventory-project-filter').value;
    let allUnits = [];

    salesData?.projects?.forEach(p => {
      if (filterVal === 'all' || p.id === filterVal) {
        p.units?.forEach(u => {
          allUnits.push({ ...u, projectName: p.projectName, paymentPlans: p.paymentPlans });
        });
      }
    });

    if (allUnits.length === 0) {
      grid.innerHTML = `<div style="grid-column: 1/-1; text-align: center; padding: 3rem; background: #fff; border-radius: 16px; color: #94a3b8;">لا توجد وحدات متاحة في هذا المشروع حالياً.</div>`;
      return;
    }

    grid.innerHTML = allUnits.map(unit => {
      const statusClass = unit.status === 'available' ? 'tag-available' : unit.status === 'reserved' ? 'tag-reserved' : 'tag-sold';
      const statusText = unit.status === 'available' ? 'متاحة للبيع' : unit.status === 'reserved' ? 'محجوزة' : 'تم البيع';

      return `
        <div class="unit-card-lux">
          <div>
            <div class="unit-head-row">
              <div>
                <h4>وحدة رقم ${unit.unitNumber}</h4>
                <div class="unit-proj-name">${unit.projectName} · ${unit.building?.name || 'مبنى'}</div>
              </div>
              <span class="u-status-tag ${statusClass}">${statusText}</span>
            </div>

            <div class="unit-props-list" style="margin-top: 1rem;">
              <div class="prop-item"><span>النوع / الدور</span><strong>${unit.unitType} (دور ${unit.floor})</strong></div>
              <div class="prop-item"><span>المساحة</span><strong>${unit.area} م²</strong></div>
              <div class="prop-item"><span>سعر المتر</span><strong>${unit.pricePerMeter?.toLocaleString('ar-EG')} ج.م</strong></div>
              <div class="prop-item"><span>السعر الإجمالي</span><strong style="color:#059669;">${unit.totalPrice?.toLocaleString('ar-EG')} ج.م</strong></div>
            </div>
          </div>

          <div class="unit-card-actions">
            <button class="btn-calc-unit calc-unit-btn" data-unit-id="${unit.id}">
              ⚡ عرض سعر
            </button>
            ${unit.status === 'available' ? `
              <button class="btn-reserve-unit open-res-btn" data-unit='${JSON.stringify(unit)}'>
                حجز وتعاقد ←
              </button>
            ` : `
              <button class="btn-reserve-unit" disabled style="background:#e2e8f0; color:#94a3b8; cursor:not-allowed;">
                غير متاحة
              </button>
            `}
          </div>
        </div>
      `;
    }).join('');

    // Attach handlers
    document.querySelectorAll('.open-res-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const unit = JSON.parse(btn.dataset.unit);
        openReserveModal(unit);
      });
    });

    document.querySelectorAll('.calc-unit-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        openQuotationModal(btn.dataset.unitId);
      });
    });
  }

  function renderReservations() {
    const tbody = document.getElementById('reservations-tbody');
    if (!salesData || !salesData.reservations || salesData.reservations.length === 0) {
      tbody.innerHTML = `<tr><td colspan="7" class="table-loading">لم يتم تسجيل أي تعاقدات بعد.</td></tr>`;
      return;
    }

    tbody.innerHTML = salesData.reservations.map(res => `
      <tr>
        <td><strong>وحدة ${res.unit?.unitNumber}</strong></td>
        <td>${res.project?.projectName}</td>
        <td>${res.clientName}</td>
        <td>${res.totalPrice?.toLocaleString('ar-EG')} ج.م</td>
        <td style="color:#059669; font-weight:800;">${res.downPayment?.toLocaleString('ar-EG')} ج.م</td>
        <td style="color:#d97706; font-weight:800;">${res.commissionAmount?.toLocaleString('ar-EG')} ج.م</td>
        <td>${new Date(res.contractDate).toLocaleDateString('ar-EG')}</td>
      </tr>
    `).join('');
  }

  function populateModals() {
    const pSelect = document.getElementById('m-lead-project');
    const filterSelect = document.getElementById('inventory-project-filter');
    if (!salesData || !salesData.projects) return;

    const options = salesData.projects.map(p => `<option value="${p.id}">${p.projectName}</option>`).join('');
    if (pSelect) pSelect.innerHTML = options;
    if (filterSelect) filterSelect.innerHTML = `<option value="all">جميع المشاريع المسندة</option>` + options;
  }

  function openReserveModal(unit) {
    const modal = document.getElementById('reserve-unit-modal');
    document.getElementById('res-unit-id').value = unit.id;
    document.getElementById('res-project-id').value = unit.projectId || '';

    const banner = document.getElementById('res-unit-banner');
    banner.innerHTML = `
      <div><strong>وحدة ${unit.unitNumber} (${unit.unitType})</strong> - مشروع ${unit.projectName}</div>
      <div>الإجمالي: <strong>${unit.totalPrice?.toLocaleString('ar-EG')} ج.م</strong></div>
    `;

    const planSelect = document.getElementById('res-plan-select');
    if (unit.paymentPlans && unit.paymentPlans.length > 0) {
      planSelect.innerHTML = unit.paymentPlans.map(pl => `
        <option value="${pl.id}" data-dp="${pl.downPaymentPercent}">
          ${pl.name} (مقدم ${pl.downPaymentPercent}% · تقسيط ${pl.installmentYears} سنوات)
        </option>
      `).join('');

      const initialDpPct = unit.paymentPlans[0].downPaymentPercent;
      document.getElementById('res-down-payment').value = Math.round((unit.totalPrice * initialDpPct) / 100);
    } else {
      planSelect.innerHTML = `<option value="">نظام سداد افتراضي</option>`;
      document.getElementById('res-down-payment').value = Math.round(unit.totalPrice * 0.15);
    }

    modal.style.display = 'flex';
  }

  function initializeSalesDashboard() {
    fetchSalesData();

    // Tab switcher
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById(btn.dataset.tab)?.classList.add('active');
      });
    });

    // View Toggle (Kanban vs Table)
    const kanbanBtn = document.getElementById('toggle-kanban-btn');
    const tableBtn = document.getElementById('toggle-table-btn');
    const kanbanBox = document.getElementById('leads-kanban-container');
    const tableBox = document.getElementById('leads-table-container');

    kanbanBtn?.addEventListener('click', () => {
      kanbanBtn.classList.add('active');
      tableBtn.classList.remove('active');
      if (kanbanBox) kanbanBox.style.display = 'grid';
      if (tableBox) tableBox.style.display = 'none';
    });

    tableBtn?.addEventListener('click', () => {
      tableBtn.classList.add('active');
      kanbanBtn.classList.remove('active');
      if (kanbanBox) kanbanBox.style.display = 'none';
      if (tableBox) tableBox.style.display = 'block';
    });

    // Top Quotation Button
    document.getElementById('open-quotation-top-btn')?.addEventListener('click', () => {
      openQuotationModal();
    });

    // Refresh btn
    document.getElementById('refresh-data-btn')?.addEventListener('click', () => {
      fetchSalesData();
    });

    // Target Edit Modal
    const targetModal = document.getElementById('target-modal');
    document.getElementById('edit-target-btn')?.addEventListener('click', () => {
      targetModal.style.display = 'flex';
    });
    document.getElementById('close-target-x')?.addEventListener('click', () => { targetModal.style.display = 'none'; });
    document.getElementById('cancel-target-btn')?.addEventListener('click', () => { targetModal.style.display = 'none'; });

    document.getElementById('target-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const monthlyTarget = parseFloat(document.getElementById('t-monthly-val').value) || 3000000;
      const commissionRate = parseFloat(document.getElementById('t-rate-val').value) || 1.0;

      try {
        await fetch('/api/erp/sales', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'update_sales_target', monthlyTarget, commissionRate })
        });
        targetModal.style.display = 'none';
        fetchSalesData();
      } catch (err) { alert('خطأ في تحديث التارجت'); }
    });

    // Project filter
    document.getElementById('inventory-project-filter')?.addEventListener('change', () => {
      renderInventory();
    });

    // Lead Modal Triggers
    const leadModal = document.getElementById('new-lead-modal');
    document.getElementById('open-lead-modal-btn')?.addEventListener('click', () => {
      leadModal.style.display = 'flex';
    });
    document.getElementById('close-lead-x')?.addEventListener('click', () => { leadModal.style.display = 'none'; });
    document.getElementById('cancel-lead-btn')?.addEventListener('click', () => { leadModal.style.display = 'none'; });

    // Submit Lead Form
    document.getElementById('lead-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const saveBtn = document.getElementById('save-lead-btn');
      saveBtn.disabled = true;

      const payload = {
        action: 'create_lead',
        fullName: document.getElementById('m-lead-name').value,
        phone: document.getElementById('m-lead-phone').value,
        email: document.getElementById('m-lead-email').value,
        projectId: document.getElementById('m-lead-project').value,
        budget: parseFloat(document.getElementById('m-lead-budget').value) || null,
        interestType: 'residential',
        notes: document.getElementById('m-lead-notes').value
      };

      try {
        const res = await fetch('/api/erp/sales', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (res.ok) {
          leadModal.style.display = 'none';
          document.getElementById('lead-form').reset();
          fetchSalesData();
        } else {
          alert('فشل تسجيل العميل المحتمل');
        }
      } catch (err) { alert('خطأ في الاتصال'); }
      finally { saveBtn.disabled = false; }
    });

    // Activity Modal Handlers
    const actModal = document.getElementById('lead-activity-modal');
    document.getElementById('close-act-x')?.addEventListener('click', () => { actModal.style.display = 'none'; });

    document.getElementById('act-stage')?.addEventListener('change', (e) => {
      handleLostFieldVisibility(e.target.value);
    });

    document.getElementById('new-activity-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const leadId = document.getElementById('act-lead-id').value;
      const type = document.getElementById('act-type').value;
      const stage = document.getElementById('act-stage').value;
      const summary = document.getElementById('act-summary').value;
      const details = document.getElementById('act-details').value;
      const nextFollowUp = document.getElementById('act-next-followup').value || null;
      const lostReason = stage === 'lost' ? document.getElementById('act-lost-reason').value : null;

      try {
        // 1. Log activity
        const aRes = await fetch('/api/erp/sales', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'add_lead_activity', leadId, type, summary, details, nextFollowUp })
        });

        // 2. Update stage if changed
        if (stage) {
          await fetch('/api/erp/sales', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'update_lead_stage', leadId, stage, lostReason, nextFollowUp })
          });
        }

        if (aRes.ok) {
          actModal.style.display = 'none';
          document.getElementById('new-activity-form').reset();
          fetchSalesData();
        } else {
          alert('فشل تسجيل النشاط');
        }
      } catch (err) { alert('خطأ في الاتصال بالخادم'); }
    });

    // Quotation Modal Handlers
    const qModal = document.getElementById('quotation-modal');
    document.getElementById('close-quotation-x')?.addEventListener('click', () => { qModal.style.display = 'none'; });

    document.getElementById('quotation-calc-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      calculateQuotation();
    });

    document.getElementById('print-quotation-btn')?.addEventListener('click', () => {
      window.print();
    });

    document.getElementById('share-wa-quotation-btn')?.addEventListener('click', () => {
      if (!currentActiveQuotation) return alert('يرجى حساب وتوليد العرض أولاً');
      const q = currentActiveQuotation;
      const text = `عزيزنا العميل ${q.clientName}،\nيسعدنا تقديم عرض السعر الرسمي لمشروع ${q.unit.projectName}:\nالوحدة: ${q.unit.unitNumber} (${q.unit.unitType} - ${q.unit.area}م²)\nالسعر الإجمالي: ${q.pricing.netPrice.toLocaleString('ar-EG')} ج.م\nالمقدم المطلوب: ${q.pricing.downPaymentAmount.toLocaleString('ar-EG')} ج.م\nالقسط الدوري: ${q.pricing.installmentAmount.toLocaleString('ar-EG')} ج.م على مدار ${q.pricing.installmentYears} سنوات.\nمع تحيات: ${q.salesRep}.`;
      window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, '_blank');
    });

    // Reserve Modal Triggers
    const resModal = document.getElementById('reserve-unit-modal');
    document.getElementById('close-res-x')?.addEventListener('click', () => { resModal.style.display = 'none'; });
    document.getElementById('cancel-res-btn')?.addEventListener('click', () => { resModal.style.display = 'none'; });

    // Submit Reserve Form
    document.getElementById('reserve-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const saveBtn = document.getElementById('save-res-btn');
      saveBtn.disabled = true;

      const payload = {
        action: 'create_reservation',
        projectId: document.getElementById('res-project-id').value,
        unitId: document.getElementById('res-unit-id').value,
        clientName: document.getElementById('res-client-name').value,
        clientPhone: document.getElementById('res-client-phone').value,
        clientNationalId: document.getElementById('res-client-natid').value,
        paymentPlanId: document.getElementById('res-plan-select').value,
        downPayment: parseFloat(document.getElementById('res-down-payment').value) || 0,
        commissionPercent: parseFloat(document.getElementById('res-commission-pct').value) || 1.0
      };

      try {
        const res = await fetch('/api/erp/sales', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await res.json();
        if (res.ok && result.success) {
          alert('✓ تم إتمام الحجز والتعاقد بنجاح وجدولة الأقساط وترحيل المقدم إلى الخزينة!');
          resModal.style.display = 'none';
          document.getElementById('reserve-form').reset();
          fetchSalesData();
        } else {
          alert('فشل التعاقد: ' + (result.error || 'خطأ غير متوقع'));
        }
      } catch (err) { alert('خطأ في الاتصال بالخادم'); }
      finally { saveBtn.disabled = false; }
    });
  }
</script>
