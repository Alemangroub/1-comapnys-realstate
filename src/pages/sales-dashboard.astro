---
import Layout from '../layouts/Layout.astro';
import AdminLogin from '../components/AdminLogin.astro';
---

<Layout title="لوحة تحكم مسؤول المبيعات | منظومة التطوير العقاري">
  <div id="auth-loading-message" class="auth-loading-screen">
    <div class="auth-spinner"></div>
    <p>جارٍ التحقق من صلاحيات المبيعات...</p>
  </div>

  <div id="admin-login-container" class="auth-container" style="display: none;">
    <AdminLogin />
  </div>

  <main id="main-content" class="portal-main-page" style="display: none;">
    
    <!-- Top Executive Header -->
    <header class="role-top-header">
      <div class="header-inner">
        <div class="user-profile-badge">
          <div class="avatar-pod pod-emerald" id="user-avatar-initial">S</div>
          <div>
            <span class="role-pill pill-emerald">مسؤول مبيعات معتمد</span>
            <h1 id="user-display-name" class="user-title">مسؤول المبيعات</h1>
          </div>
        </div>

        <div class="header-controls">
          <button id="open-quotation-top-btn" class="btn-ctrl btn-quotation" title="إنشاء وحساب عرض سعر فوري">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
            <span>⚡ عرض سعر فوري</span>
          </button>
          <button id="refresh-data-btn" class="btn-ctrl btn-refresh" title="تحديث البيانات">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
            <span>تحديث</span>
          </button>
          <a href="/portal" target="_blank" class="btn-ctrl btn-client-portal" title="فتح بوابة العميل للمعاينة">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            <span>بوابة العميل</span>
          </a>
          <button id="logout-button" class="btn-ctrl btn-logout">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            <span>تسجيل الخروج</span>
          </button>
        </div>
      </div>
    </header>

    <div class="content-wrapper">
      
      <!-- ITEM 4: Target & Commission Live Progress Card -->
      <section class="target-tracker-card">
        <div class="tracker-header">
          <div class="tracker-meta">
            <div class="target-icon">🎯</div>
            <div>
              <h3>مستهدف المبيعات والعمولات الشهري (Sales Target Tracker)</h3>
              <p>رصد فوري لنسبة تحقيق التارجت البيعي والعمولات المكتسبة لشهر العمل الحالي</p>
            </div>
          </div>
          <div class="target-numbers-grp">
            <div class="target-stat-item">
              <span class="lbl">التارجت الشهري:</span>
              <strong id="target-monthly-val">3,000,000 ج.م</strong>
              <button type="button" id="edit-target-btn" class="edit-target-link" title="تعديل قيمة التارجت">⚙️ تعديل</button>
            </div>
            <div class="target-stat-item">
              <span class="lbl">المبيعات المحققة:</span>
              <strong class="text-emerald" id="target-achieved-val">0 ج.م</strong>
            </div>
            <div class="target-stat-item">
              <span class="lbl">المتبقي للإنجاز:</span>
              <strong class="text-amber" id="target-remaining-val">3,000,000 ج.م</strong>
            </div>
            <div class="target-stat-item">
              <span class="lbl">عمولاتي المستحقة:</span>
              <strong class="text-purple" id="target-commission-val">0 ج.م</strong>
            </div>
          </div>
        </div>

        <div class="target-progress-wrap">
          <div class="progress-bar-rail">
            <div id="target-progress-bar" class="progress-bar-fill" style="width: 0%;"></div>
          </div>
          <span class="progress-pct-badge" id="target-pct-badge">0% من التارجت</span>
        </div>
      </section>

      <!-- Metrics Ribbon -->
      <section class="metrics-ribbon">
        <div class="metric-card">
          <div class="metric-icon-box box-emerald">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="22" y1="11" x2="16" y2="11"></line></svg>
          </div>
          <div class="metric-info">
            <span class="m-label">إجمالي العملاء (Leads)</span>
            <h3 id="stat-leads-count">0</h3>
            <span class="m-sub">عملاء مسندين لك</span>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon-box box-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          </div>
          <div class="metric-info">
            <span class="m-label">الوحدات المحجوزة والتعاقدات</span>
            <h3 id="stat-reservations-count">0</h3>
            <span class="m-sub">عقود معتمدة تمت بواسطتك</span>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon-box box-amber">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </div>
          <div class="metric-info">
            <span class="m-label">متابعات اليوم العاجلة</span>
            <h3 id="stat-today-followups">0</h3>
            <span class="m-sub" id="stat-overdue-followups">0 متأخرة</span>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-icon-box box-purple">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
          </div>
          <div class="metric-info">
            <span class="m-label">الوحدات المتاحة للبيع</span>
            <h3 id="stat-available-units">0</h3>
            <span class="m-sub">في المشاريع المخصصة لك</span>
          </div>
        </div>
      </section>

      <!-- Main Navigation Tabs -->
      <div class="tabs-nav-bar">
        <button type="button" class="tab-btn active" data-tab="tab-leads">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
          <span>قمع العملاء والمتابعات (Pipeline & Leads)</span>
        </button>
        <button type="button" class="tab-btn" data-tab="tab-inventory">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
          <span>المخزون والوحدات المتاحة</span>
        </button>
        <button type="button" class="tab-btn" data-tab="tab-reservations">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
          <span>عقود الحجز والعمولات</span>
        </button>
      </div>

      <!-- Tab 1: Leads Pipeline & Interaction Hub -->
      <section id="tab-leads" class="tab-panel active">
        <div class="panel-action-bar">
          <div>
            <h2>متابعة العملاء وقمع المبيعات (Sales Pipeline)</h2>
            <p>إدارة دورة حياة العميل وتسجيل المكالمات والتواصل المباشر عبر الواتساب</p>
          </div>

          <div class="pipeline-actions-group">
            <div class="view-toggle-bar">
              <button type="button" id="toggle-kanban-btn" class="view-toggle-btn active">📊 لوحة القمع (Kanban)</button>
              <button type="button" id="toggle-table-btn" class="view-toggle-btn">📋 عرض الجدول (Table)</button>
            </div>
            <button id="open-lead-modal-btn" class="btn-primary-luxury">
              <span>+ تسجيل عميل جديد</span>
            </button>
          </div>
        </div>

        <!-- ITEM 1: Visual Kanban Sales Pipeline View -->
        <div id="leads-kanban-container" class="kanban-pipeline-wrapper">
          <!-- Column 1: New Leads -->
          <div class="kanban-col col-new" data-stage="new">
            <div class="kanban-col-header">
              <span class="col-dot dot-new"></span>
              <h4>عملاء جدد</h4>
              <span class="col-count-badge" id="count-stage-new">0</span>
            </div>
            <div class="kanban-cards-list" id="cards-stage-new"></div>
          </div>

          <!-- Column 2: Contacted -->
          <div class="kanban-col col-contacted" data-stage="contacted">
            <div class="kanban-col-header">
              <span class="col-dot dot-contacted"></span>
              <h4>تم التواصل</h4>
              <span class="col-count-badge" id="count-stage-contacted">0</span>
            </div>
            <div class="kanban-cards-list" id="cards-stage-contacted"></div>
          </div>

          <!-- Column 3: Meetings & Visits -->
          <div class="kanban-col col-meeting" data-stage="meeting">
            <div class="kanban-col-header">
              <span class="col-dot dot-meeting"></span>
              <h4>معاينات ومقابلات</h4>
              <span class="col-count-badge" id="count-stage-meeting">0</span>
            </div>
            <div class="kanban-cards-list" id="cards-stage-meeting"></div>
          </div>

          <!-- Column 4: Proposals & Negotiation -->
          <div class="kanban-col col-proposal" data-stage="proposal">
            <div class="kanban-col-header">
              <span class="col-dot dot-proposal"></span>
              <h4>عروض أسعار وتفاوض</h4>
              <span class="col-count-badge" id="count-stage-proposal">0</span>
            </div>
            <div class="kanban-cards-list" id="cards-stage-proposal"></div>
          </div>

          <!-- Column 5: Closed Won -->
          <div class="kanban-col col-won" data-stage="won">
            <div class="kanban-col-header">
              <span class="col-dot dot-won"></span>
              <h4>تم التعاقد والبيع 🏆</h4>
              <span class="col-count-badge" id="count-stage-won">0</span>
            </div>
            <div class="kanban-cards-list" id="cards-stage-won"></div>
          </div>

          <!-- Column 6: Closed Lost -->
          <div class="kanban-col col-lost" data-stage="lost">
            <div class="kanban-col-header">
              <span class="col-dot dot-lost"></span>
              <h4>صفقات ملغاة ❌</h4>
              <span class="col-count-badge" id="count-stage-lost">0</span>
            </div>
            <div class="kanban-cards-list" id="cards-stage-lost"></div>
          </div>
        </div>

        <!-- Table View Alternative -->
        <div id="leads-table-container" class="leads-table-container" style="display: none;">
          <table class="luxury-table">
            <thead>
              <tr>
                <th>اسم العميل</th>
                <th>الهاتف والواتساب</th>
                <th>المشروع المستهدف</th>
                <th>المرحلة الحالية</th>
                <th>المتابعة القادمة</th>
                <th>الميزانية المتوقعة</th>
                <th>الإجراء والمتابعة</th>
              </tr>
            </thead>
            <tbody id="leads-tbody">
              <tr><td colspan="7" class="table-loading">جارٍ جلب بيانات العملاء...</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Tab 2: Inventory & Available Units -->
      <section id="tab-inventory" class="tab-panel">
        <div class="panel-action-bar">
          <div>
            <h2>مخزون الوحدات المتاحة للبيع</h2>
            <p>تصفح الوحدات المتاحة، حساب عروض الأسعار، وإتمام الحجوزات</p>
          </div>
          <div class="filter-box">
            <select id="inventory-project-filter">
              <option value="all">جميع المشاريع المسندة</option>
            </select>
          </div>
        </div>

        <div id="units-grid" class="units-cards-grid">
          <!-- Rendered via JS -->
        </div>
      </section>

      <!-- Tab 3: Contracts & Reservations -->
      <section id="tab-reservations" class="tab-panel">
        <div class="panel-action-bar">
          <div>
            <h2>سجل تعاقداتك وحجوزات الوحدات</h2>
            <p>تفاصيل الوحدات المحجوزة والعمولات المترتبة عليها وجداول الأقساط</p>
          </div>
        </div>

        <div class="leads-table-container">
          <table class="luxury-table">
            <thead>
              <tr>
                <th>رقم الوحدة</th>
                <th>المشروع</th>
                <th>العميل المتعاقد</th>
                <th>إجمالي السعر</th>
                <th>المقدم المحصل</th>
                <th>عمولتك المستحقة</th>
                <th>تاريخ التعاقد</th>
              </tr>
            </thead>
            <tbody id="reservations-tbody">
              <tr><td colspan="7" class="table-loading">لم يتم تسجيل أي تعاقدات بعد.</td></tr>
            </tbody>
          </table>
        </div>
      </section>

    </div>

    <!-- ========================================================
         MODALS
         ======================================================== -->

    <!-- Modal 1: Add New Lead -->
    <div id="new-lead-modal" class="modal-backdrop" style="display: none;">
      <div class="modal-card">
        <div class="modal-card-header">
          <div>
            <h3>تسجيل عميل محتمل جديد (Lead)</h3>
            <p>إدخال بيانات عميل مهتم بأحد مشاريع الشركة</p>
          </div>
          <button type="button" class="close-modal-x" id="close-lead-x">&times;</button>
        </div>
        <form id="lead-form" class="modal-card-body">
          <div class="field-wrap">
            <label>اسم العميل بالكامل *</label>
            <input type="text" id="m-lead-name" placeholder="مثال: أستاذ حسام حسن" required />
          </div>
          <div class="field-row">
            <div class="field-wrap">
              <label>رقم الهاتف *</label>
              <input type="text" id="m-lead-phone" placeholder="01xxxxxxxxx" required />
            </div>
            <div class="field-wrap">
              <label>البريد الإلكتروني</label>
              <input type="email" id="m-lead-email" placeholder="client@domain.com" />
            </div>
          </div>
          <div class="field-row">
            <div class="field-wrap">
              <label>المشروع المستهدف *</label>
              <select id="m-lead-project" required></select>
            </div>
            <div class="field-wrap">
              <label>الميزانية التقريبية (ج.م)</label>
              <input type="number" id="m-lead-budget" placeholder="1500000" />
            </div>
          </div>
          <div class="field-row">
            <div class="field-wrap">
              <label>المرحلة الأولية</label>
              <select id="m-lead-stage">
                <option value="new" selected>عميل جديد (New)</option>
                <option value="contacted">تم التواصل (Contacted)</option>
                <option value="meeting">معاينة ومقابلة (Meeting)</option>
              </select>
            </div>
            <div class="field-wrap">
              <label>موعد أول اتصال أو متابعة</label>
              <input type="datetime-local" id="m-lead-followup" />
            </div>
          </div>
          <div class="field-wrap">
            <label>ملاحظات واحتياجات العميل</label>
            <textarea id="m-lead-notes" rows="2" placeholder="مساحة مطلوبة، طريقة سداد مفضلة..."></textarea>
          </div>
          <div class="modal-footer-btns">
            <button type="button" class="btn-cancel" id="cancel-lead-btn">إلغاء</button>
            <button type="submit" class="btn-save" id="save-lead-btn">حفظ وتسكين في القمع</button>
          </div>
        </form>
      </div>
    </div>

    <!-- ITEM 2: Interaction Hub & Call Log Modal -->
    <div id="lead-activity-modal" class="modal-backdrop" style="display: none;">
      <div class="modal-card modal-lg">
        <div class="modal-card-header">
          <div>
            <h3 id="act-modal-client-name">سجل المتابعة والتواصل مع العميل</h3>
            <p id="act-modal-client-phone" class="text-muted">-</p>
          </div>
          <div style="display:flex; gap:0.5rem; align-items:center;">
            <a id="act-modal-wa-btn" href="#" target="_blank" class="btn-whatsapp-sm">💬 واتساب مباشر</a>
            <button type="button" class="close-modal-x" id="close-act-x">&times;</button>
          </div>
        </div>

        <div class="activity-modal-layout">
          <!-- Left/Top: Add New Activity Form -->
          <div class="add-act-box">
            <h4>+ تسجيل نشاط أو مكالمة جديدة:</h4>
            <form id="new-activity-form">
              <input type="hidden" id="act-lead-id" />
              
              <div class="field-row">
                <div class="field-wrap">
                  <label>نوع التواصل *</label>
                  <select id="act-type" required>
                    <option value="call">📞 مكالمة هاتفية</option>
                    <option value="whatsapp">💬 محادثة واتساب</option>
                    <option value="meeting">🏢 معاينة ميدانية / مقابلة</option>
                    <option value="proposal">📑 تقديم عرض سعر رسمي</option>
                    <option value="note">📝 ملاحظة وتحديث بيانات</option>
                  </select>
                </div>
                <div class="field-wrap">
                  <label>تحديث مرحلة العميل</label>
                  <select id="act-stage">
                    <option value="new">عملاء جدد</option>
                    <option value="contacted">تم التواصل</option>
                    <option value="meeting">معاينات ومقابلات</option>
                    <option value="proposal">عروض أسعار وتفاوض</option>
                    <option value="won">تم التعاقد والبيع 🏆</option>
                    <option value="lost">صفقة ملغاة ❌</option>
                  </select>
                </div>
              </div>

              <!-- Lost Reason field (shows only if lost) -->
              <div class="field-wrap" id="lost-reason-field" style="display: none;">
                <label style="color:#b91c1c;">سبب إلغاء الصفقة أو فقدان العميل *</label>
                <select id="act-lost-reason">
                  <option value="السعر أعلى من الميزانية">السعر أعلى من الميزانية المتاحة</option>
                  <option value="اشترى من مطور أو كمبوند منافس">اشترى من مطور أو مشروع منافس</option>
                  <option value="الموقع أو المساحات غير مناسبة">الموقع أو المساحات غير مناسبة لطلبه</option>
                  <option value="تأجيل قرار الشراء لوقت لاحق">تأجيل قرار الشراء لوقت لاحق</option>
                  <option value="تعذر التواصل وعدم الرد">تعذر التواصل وعدم الرد المتكرر</option>
                  <option value="أخرى">أخرى (مذكورة في التفاصيل)...</option>
                </select>
              </div>

              <div class="field-wrap">
                <label>ملخص المكالمة أو الإجراء المتخذ *</label>
                <input type="text" id="act-summary" placeholder="مثال: تم الاتصال، العميل مهتم بالشقة 140م وطلب زيارة الموقع الأحد" required />
              </div>

              <div class="field-row">
                <div class="field-wrap">
                  <label>موعد المتابعة القادمة (Next Follow-up)</label>
                  <input type="datetime-local" id="act-next-followup" />
                </div>
                <div class="field-wrap">
                  <label>ملاحظات إضافية وتفاصيل</label>
                  <input type="text" id="act-details" placeholder="ملاحظات هامة إضافية..." />
                </div>
              </div>

              <button type="submit" class="btn-save btn-emerald" style="width:100%; margin-top:0.6rem;">حفظ النشاط وتحديث المتابعة</button>
            </form>
          </div>

          <!-- Right/Bottom: Historical Timeline -->
          <div class="act-timeline-box">
            <h4>سجل المكالمات والتواصل السابق:</h4>
            <div id="act-timeline-list" class="timeline-items">
              <!-- Rendered via JS -->
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ITEM 3: Instant Official Quotation Generator Modal -->
    <div id="quotation-modal" class="modal-backdrop" style="display: none;">
      <div class="modal-card modal-lg quotation-modal-window">
        <div class="modal-card-header no-print">
          <div>
            <h3>⚡ حاسبة ومولد عروض الأسعار الرسمية (Quotation Generator)</h3>
            <p>توليد جدول سداد مفصل وعرض سعر معتمد للعميل للطباعة والمشاركة الفورية</p>
          </div>
          <button type="button" class="close-modal-x" id="close-quotation-x">&times;</button>
        </div>

        <div class="quotation-body">
          <!-- Setup Form (Hidden on Print) -->
          <form id="quotation-calc-form" class="quotation-inputs-panel no-print">
            <div class="field-row">
              <div class="field-wrap">
                <label>اختر الوحدة من المخزون *</label>
                <select id="q-unit-select" required></select>
              </div>
              <div class="field-wrap">
                <label>اسم العميل</label>
                <input type="text" id="q-client-name" placeholder="الاسم ثلاثي" />
              </div>
            </div>

            <div class="field-row">
              <div class="field-wrap">
                <label>نسبة المقدم المدفوع (%) *</label>
                <input type="number" id="q-dp-pct" value="15" min="0" max="90" step="1" required />
              </div>
              <div class="field-wrap">
                <label>مدة التقسيط (سنوات) *</label>
                <select id="q-years-select" required>
                  <option value="1">سنة واحدة</option>
                  <option value="2">سنتان (2)</option>
                  <option value="3">3 سنوات</option>
                  <option value="4">4 سنوات</option>
                  <option value="5" selected>5 سنوات</option>
                  <option value="6">6 سنوات</option>
                  <option value="7">7 سنوات</option>
                </select>
              </div>
            </div>

            <div class="field-row">
              <div class="field-wrap">
                <label>دورية الأقساط *</label>
                <select id="q-freq-select" required>
                  <option value="quarterly" selected>أقساط ربع سنوية (كل 3 شهور)</option>
                  <option value="monthly">أقساط شهرية (كل شهر)</option>
                  <option value="semi_annual">أقساط نصف سنوية (كل 6 شهور)</option>
                  <option value="annual">أقساط سنوية (كل سنة)</option>
                </select>
              </div>
              <div class="field-wrap">
                <label>خصم كاش / خصم خاص (%)</label>
                <input type="number" id="q-discount-pct" value="0" min="0" max="50" step="0.5" />
              </div>
            </div>

            <div class="field-row">
              <div class="field-wrap">
                <label>نسبة وديعة الصيانة (%)</label>
                <input type="number" id="q-maint-pct" value="5" min="0" max="15" step="0.5" />
              </div>
              <div class="field-wrap" style="align-self:flex-end;">
                <button type="submit" class="btn-save btn-emerald" style="width:100%;">⚡ حساب وتوليد العرض</button>
              </div>
            </div>
          </form>

          <!-- Official Printable Sheet -->
          <div id="quotation-sheet-preview" class="quotation-official-sheet">
            <div class="quotation-print-header">
              <div class="q-brand-meta">
                <h2>شركة الاستثمار والتطوير العقاري</h2>
                <p>إدارة المبيعات والتعاقدات الرسمية</p>
              </div>
              <div class="q-doc-badge">
                <span class="badge-title">عرض سعر رسمي مبدئي</span>
                <span class="badge-date" id="q-out-date">التاريخ: --</span>
              </div>
            </div>

            <!-- Client & Unit Banner -->
            <div class="q-client-unit-grid">
              <div class="q-box">
                <span class="q-lbl">العميل المحترم:</span>
                <strong id="q-out-client">--</strong>
              </div>
              <div class="q-box">
                <span class="q-lbl">المشروع العقاري:</span>
                <strong id="q-out-project">--</strong>
              </div>
              <div class="q-box">
                <span class="q-lbl">رقم الوحدة ونوعها:</span>
                <strong id="q-out-unit">--</strong>
              </div>
              <div class="q-box">
                <span class="q-lbl">المساحة والدور:</span>
                <strong id="q-out-area">--</strong>
              </div>
            </div>

            <!-- Financial Summary Cards -->
            <div class="q-financials-ribbon">
              <div class="q-fin-card">
                <span>سعر الوحدة الإجمالي</span>
                <h4 id="q-out-price">0 ج.م</h4>
              </div>
              <div class="q-fin-card fin-highlight">
                <span>المقدم المطلوب</span>
                <h4 id="q-out-dp">0 ج.م</h4>
              </div>
              <div class="q-fin-card">
                <span>قيمة القسط الدوري</span>
                <h4 id="q-out-inst-amt">0 ج.م</h4>
              </div>
              <div class="q-fin-card">
                <span>وديعة الصيانة</span>
                <h4 id="q-out-maint">0 ج.م</h4>
              </div>
            </div>

            <!-- Schedule Table Preview -->
            <div class="q-schedule-wrap">
              <h5>جدول استحقاقات الأقساط المقترح:</h5>
              <div class="q-table-scroll">
                <table class="q-table">
                  <thead>
                    <tr>
                      <th>#</th>
                      <th>البيان</th>
                      <th>تاريخ الاستحقاق</th>
                      <th>القيمة المستحقة</th>
                    </tr>
                  </thead>
                  <tbody id="q-schedule-tbody">
                    <tr><td colspan="4" style="text-align:center; padding:1.5rem; color:#94a3b8;">اضغط على "حساب وتوليد العرض" لعرض جدول الأقساط</td></tr>
                  </tbody>
                </table>
              </div>
            </div>

            <div class="quotation-print-footer">
              <div class="q-terms">
                <p>• هذا العرض سارٍ لمدة 48 ساعة فقط من تاريخ إصداره، والوحدة لا تعتبر محجوزة نهائياً إلا بسداد دفعة الحجز الرسمية.</p>
                <p>• يتم تسليم الوحدة وفقاً للمواصفات ونوع التشطيب الموضح في العقد النهائي للشركة.</p>
              </div>
              <div class="q-signature-box">
                <span>مسؤول المبيعات المعتمد:</span>
                <strong id="q-out-rep">--</strong>
              </div>
            </div>

            <!-- Print Actions Bar (Hidden when printing) -->
            <div class="q-print-actions-bar no-print">
              <button type="button" id="print-quotation-btn" class="btn-ctrl btn-emerald" style="background:#059669;color:#fff;">
                🖨️ طباعة عرض السعر / حفظ PDF
              </button>
              <button type="button" id="share-wa-quotation-btn" class="btn-ctrl btn-whatsapp" style="background:#25D366;color:#fff;">
                💬 إرسال ملخص العرض عبر واتساب للعميل
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Modal: Contract & Reserve Unit -->
    <div id="reserve-unit-modal" class="modal-backdrop" style="display: none;">
      <div class="modal-card modal-lg">
        <div class="modal-card-header">
          <div>
            <h3>حجز وتعاقد وحدة جديدة</h3>
            <p id="modal-unit-subtitle">سيتم ترحيل المقدم تلقائياً للخزينة وجدولة الأقساط</p>
          </div>
          <button type="button" class="close-modal-x" id="close-res-x">&times;</button>
        </div>
        <form id="reserve-form" class="modal-card-body">
          <input type="hidden" id="res-unit-id" />
          <input type="hidden" id="res-project-id" />

          <div class="unit-highlight-banner" id="res-unit-banner"></div>

          <div class="field-row">
            <div class="field-wrap">
              <label>اسم العميل المتعاقد *</label>
              <input type="text" id="res-client-name" placeholder="الاسم رباعي" required />
            </div>
            <div class="field-wrap">
              <label>رقم هاتف العميل *</label>
              <input type="text" id="res-client-phone" placeholder="01xxxxxxxxx" required />
            </div>
          </div>

          <div class="field-row">
            <div class="field-wrap">
              <label>الرقم القومي للعميل</label>
              <input type="text" id="res-client-natid" placeholder="14 رقم" />
            </div>
            <div class="field-wrap">
              <label>نظام وسنوات السداد *</label>
              <select id="res-plan-select" required></select>
            </div>
          </div>

          <div class="field-row">
            <div class="field-wrap">
              <label>المقدم المدفوع الآن (ج.م) *</label>
              <input type="number" id="res-down-payment" required />
            </div>
            <div class="field-wrap">
              <label>نسبة عمولتك %</label>
              <input type="number" id="res-commission-pct" value="1.0" step="0.1" />
            </div>
          </div>

          <div class="modal-footer-btns">
            <button type="button" class="btn-cancel" id="cancel-res-btn">إلغاء</button>
            <button type="submit" class="btn-save btn-emerald" id="save-res-btn">إتمام التعاقد وجدولة الأقساط فوراً</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Edit Monthly Target Modal -->
    <div id="target-modal" class="modal-backdrop" style="display: none;">
      <div class="modal-card">
        <div class="modal-card-header">
          <div>
            <h3>تحديد مستهدف المبيعات والعمولة</h3>
            <p>تحديث التارجت الشهري ونسبة العمولة لمسؤول المبيعات</p>
          </div>
          <button type="button" class="close-modal-x" id="close-target-x">&times;</button>
        </div>
        <form id="target-form" class="modal-card-body">
          <div class="field-wrap">
            <label>قيمة التارجت الشهري المطلوب (ج.م) *</label>
            <input type="number" id="t-monthly-val" min="100000" step="50000" required />
          </div>
          <div class="field-wrap">
            <label>نسبة العمولة الافتراضية (%)</label>
            <input type="number" id="t-rate-val" min="0.1" max="10" step="0.1" required />
          </div>
          <div class="modal-footer-btns">
            <button type="button" class="btn-cancel" id="cancel-target-btn">إلغاء</button>
            <button type="submit" class="btn-save">حفظ التارجت</button>
          </div>
        </form>
      </div>
    </div>

  </main>
</Layout>

