<script>
  import { checkAuth } from '../../lib/auth.js';

  let treasuryData = {
    treasuries: [],
    transactions: [],
    financialSummary: [],
    expenseRequests: [],
    projects: []
  };

  const authLoading = document.getElementById('auth-loading-message');
  const loginContainer = document.getElementById('admin-login-container');
  const mainContent = document.getElementById('main-content');

  // Verify Admin or Finance Auth
  (async () => {
    try {
      const user = await checkAuth();
      if (authLoading) authLoading.style.display = 'none';

      if (user && (user.role === 'admin' || user.role === 'finance' || user.role === 'accountant')) {
        if (mainContent) mainContent.style.display = 'block';
        await loadTreasuryData();
      } else {
        if (loginContainer) loginContainer.style.display = 'block';
      }
    } catch (e) {
      if (authLoading) authLoading.style.display = 'none';
      if (loginContainer) loginContainer.style.display = 'block';
    }
  })();

  // Fetch Full Treasury Data
  async function loadTreasuryData() {
    try {
      const res = await fetch('/api/erp/treasury');
      const data = await res.json();
      if (data.success) {
        treasuryData = data;
        renderSafesOverview();
        populateFilterDropdowns();
        renderTransactions();
        renderExpenseRequests();
        await loadAccountingData();
      } else {
        alert(data.error || 'فشل تحميل بيانات الخزينة');
      }
    } catch (err) {
      console.error('Failed to load treasury data:', err);
    }
  }

  // Render Safes Overview (القسم العلوي: بطاقات الأرصدة)
  function renderSafesOverview() {
    const treasuries = treasuryData.treasuries || [];
    const summaries = treasuryData.financialSummary || [];

    // 1. Main Safe (الخزنة الرئيسية)
    const mainSafe = treasuries.find(t => t.isMain || !t.projectId) || treasuries[0];
    if (mainSafe) {
      document.getElementById('main-safe-name').textContent = mainSafe.name;
      document.getElementById('main-safe-balance').textContent = (mainSafe.balance || 0).toLocaleString('ar-EG') + ' ج.م';
    }

    // 2. Project Safes (خزائن المشروعات الفرعية)
    const projectSafesContainer = document.getElementById('project-safes-container');
    if (!projectSafesContainer) return;

    if (summaries.length === 0) {
      projectSafesContainer.innerHTML = `
        <div class="empty-notice-box">
          <p>لا توجد مشاريع مسجلة بعد لعرض خزائنها.</p>
        </div>
      `;
      return;
    }

    projectSafesContainer.innerHTML = summaries.map(s => {
      return `
        <div class="project-safe-card">
          <div class="proj-safe-head">
            <div>
              <h4 class="proj-safe-title">${s.safeName}</h4>
              <p class="proj-safe-sub">مشروع: ${s.projectName}</p>
            </div>
            <span class="safe-type-tag">خزينة فرعية</span>
          </div>

          <div class="proj-safe-balance-box">
            <span class="lbl">الرصيد النقدي المتوفر:</span>
            <span class="val">${(s.currentBalance || 0).toLocaleString('ar-EG')} ج.م</span>
          </div>

          <div class="proj-mini-stats-grid">
            <div class="stat-cell">
              <span class="s-lbl">إجمالي الإيرادات</span>
              <span class="s-val val-income">+${(s.totalIncome || 0).toLocaleString('ar-EG')}</span>
            </div>
            <div class="stat-cell">
              <span class="s-lbl">إجمالي المصروفات</span>
              <span class="s-val val-expense">-${(s.totalExpense || 0).toLocaleString('ar-EG')}</span>
            </div>
            <div class="stat-cell">
              <span class="s-lbl">صافي الرصيد</span>
              <span class="s-val val-profit">${(s.netProfit || 0).toLocaleString('ar-EG')}</span>
            </div>
          </div>
        </div>
      `;
    }).join('');
  }

  // Populate Filter Selects
  function populateFilterDropdowns() {
    const projFilter = document.getElementById('filter-tx-project');
    const modalTreasury = document.getElementById('modal-treasury-id');
    const modalProject = document.getElementById('modal-tx-project');

    const treasuries = treasuryData.treasuries || [];
    const projects = treasuryData.projects || [];

    // Filter project dropdown
    if (projFilter) {
      projFilter.innerHTML = `<option value="all">جميع المشاريع والخزائن</option>` + 
        projects.map(p => `<option value="${p.id}">مشروع: ${p.name}</option>`).join('');
    }

    // Modal treasury dropdown
    if (modalTreasury) {
      modalTreasury.innerHTML = treasuries.map(t => `
        <option value="${t.id}">${t.isMain ? '🏦 [رئيسية] ' : '🏢 [فرعية] '} ${t.name} (رصيد: ${(t.balance || 0).toLocaleString('ar-EG')} ج.م)</option>
      `).join('');
    }

    // Modal project dropdown
    if (modalProject) {
      modalProject.innerHTML = `<option value="">-- بدون ارتباط بمشروع --</option>` +
        projects.map(p => `<option value="${p.id}">${p.name}</option>`).join('');
    }
  }

  // Filter & Render Transactions (تبويب 1: سجل الحركات المالية)
  function renderTransactions() {
    const projFilter = document.getElementById('filter-tx-project')?.value || 'all';
    const typeFilter = document.getElementById('filter-tx-type')?.value || 'all';
    const catFilter = document.getElementById('filter-tx-category')?.value || 'all';

    const txs = (treasuryData.transactions || []).filter(tx => {
      if (projFilter !== 'all' && tx.projectId !== projFilter) return false;
      if (typeFilter !== 'all' && tx.type !== typeFilter) return false;
      if (catFilter !== 'all' && tx.category !== catFilter) return false;
      return true;
    });

    const tbody = document.getElementById('transactions-table-body');
    const emptyBox = document.getElementById('tx-empty-state');
    const counterBadge = document.getElementById('tx-counter-badge');

    if (counterBadge) counterBadge.textContent = txs.length;

    if (txs.length === 0) {
      if (tbody) tbody.innerHTML = '';
      if (emptyBox) emptyBox.style.display = 'block';
      return;
    }

    if (emptyBox) emptyBox.style.display = 'none';

    const categoryNames = {
      capital_deposit: 'إيداع رأسمال',
      down_payment: 'مقدم حجز',
      installment: 'قسط عميل',
      contractor: 'مستخلص مقاول',
      materials: 'شراء خامات',
      sales_commission: 'عمولة مبيعات',
      general_expense: 'مصروفات ونثريات',
      operational: 'مصروفات تشغيلية'
    };

    if (tbody) {
      tbody.innerHTML = txs.map(tx => {
        const isIncome = tx.type === 'income';
        const typeBadge = isIncome 
          ? `<span class="tx-type-tag tx-income">🟢 إيراد (+)</span>` 
          : `<span class="tx-type-tag tx-expense">🔴 مصروف (-)</span>`;

        const amountClass = isIncome ? 'tx-amount-income' : 'tx-amount-expense';
        const amountSign = isIncome ? '+' : '-';
        const safeName = tx.treasury ? tx.treasury.name : 'الخزينة';

        const dateStr = new Date(tx.createdAt).toLocaleDateString('ar-EG', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        });

        return `
          <tr>
            <td><strong>${tx.description}</strong></td>
            <td>${typeBadge}</td>
            <td><span class="tx-amount-str ${amountClass}">${amountSign}${(tx.amount || 0).toLocaleString('ar-EG')} ج.م</span></td>
            <td>🏦 ${safeName}</td>
            <td><span class="category-pill">${categoryNames[tx.category] || tx.category}</span></td>
            <td>${tx.recordedBy || 'المحاسب'}</td>
            <td>${dateStr}</td>
          </tr>
        `;
      }).join('');
    }
  }

  // Render Expense Requests (تبويب 2: طلبات الصرف المعلقة)
  function renderExpenseRequests() {
    const requests = treasuryData.expenseRequests || [];
    const tbody = document.getElementById('expense-requests-table-body');
    const emptyBox = document.getElementById('requests-empty-state');
    const badge = document.getElementById('pending-counter-badge');

    const pendingCount = requests.filter(r => r.status === 'pending').length;
    if (badge) badge.textContent = `${pendingCount} معلق`;

    if (requests.length === 0) {
      if (tbody) tbody.innerHTML = '';
      if (emptyBox) emptyBox.style.display = 'block';
      return;
    }

    if (emptyBox) emptyBox.style.display = 'none';

    const deptLabels = {
      construction: '🏗️ إنشاءات',
      sales: '💼 مبيعات',
      management: '🏛️ إدارة'
    };

    if (tbody) {
      tbody.innerHTML = requests.map(req => {
        const isPending = req.status === 'pending';
        let statusPill = '';
        if (req.status === 'pending') statusPill = `<span class="req-status-pill req-pending">🟡 قيد المراجعة</span>`;
        else if (req.status === 'approved') statusPill = `<span class="req-status-pill req-approved">🟢 معتمد وتم الصرف</span>`;
        else if (req.status === 'rejected') statusPill = `<span class="req-status-pill req-rejected">🔴 مرفوض</span>`;

        const dateStr = new Date(req.createdAt).toLocaleDateString('ar-EG', {
          year: 'numeric',
          month: 'short',
          day: 'numeric'
        });

        const actionsHtml = isPending ? `
          <div class="action-buttons-group">
            <button class="btn-approve approve-action-btn" data-req-id="${req.id}">
              موافقة وصرف ✓
            </button>
            <button class="btn-reject reject-action-btn" data-req-id="${req.id}">
              رفض ✕
            </button>
          </div>
        ` : `<span style="font-size: 0.8rem; color: #94a3b8; font-weight: 700;">تمت المعالجة</span>`;

        return `
          <tr>
            <td><strong>${req.project ? req.project.projectName : 'مشروع عام'}</strong></td>
            <td><span class="dept-badge">${deptLabels[req.department] || req.department}</span></td>
            <td>
              <strong>${req.title}</strong>
              ${req.description ? `<br><small style="color: #64748b;">${req.description}</small>` : ''}
            </td>
            <td>${req.requesterName || 'مقدم الطلب'}</td>
            <td><strong style="font-size: 1.05rem; color: #dc2626;">${(req.amount || 0).toLocaleString('ar-EG')} ج.م</strong></td>
            <td>${dateStr}</td>
            <td>${statusPill}</td>
            <td>${actionsHtml}</td>
          </tr>
        `;
      }).join('');
    }

    // Attach Approve & Reject Listeners via Event Delegation on table body
    if (tbody && !tbody.dataset.eventsBound) {
      tbody.dataset.eventsBound = 'true';
      tbody.addEventListener('click', (e) => {
        const approveBtn = e.target.closest('.approve-action-btn');
        if (approveBtn) {
          const reqId = approveBtn.getAttribute('data-req-id');
          openExpenseActionModal(reqId, 'approve');
          return;
        }

        const rejectBtn = e.target.closest('.reject-action-btn');
        if (rejectBtn) {
          const reqId = rejectBtn.getAttribute('data-req-id');
          openExpenseActionModal(reqId, 'reject');
          return;
        }
      });
    }
  }

  // Toast Notification System
  let toastTimer = null;
  function showToast(message, type = 'success') {
    const toast = document.getElementById('treasury-toast');
    const toastIcon = document.getElementById('toast-icon');
    const toastText = document.getElementById('toast-text');
    if (!toast) return;

    if (toastTimer) clearTimeout(toastTimer);

    toast.className = 'treasury-toast ' + (type === 'success' ? 'toast-success' : 'toast-error');
    if (toastIcon) toastIcon.textContent = type === 'success' ? '✅' : '⚠️';
    if (toastText) toastText.textContent = message;

    toast.style.display = 'flex';
    toastTimer = setTimeout(() => {
      toast.style.display = 'none';
    }, 4000);
  }

  // Active Request State for Modal
  let activeExpenseReq = null;
  let activeExpenseAction = 'approve';

  const actionModal = document.getElementById('expense-action-modal');
  const confirmActionBtn = document.getElementById('confirm-expense-btn');
  const closeActionBtn = document.getElementById('close-expense-modal');
  const cancelActionBtn = document.getElementById('cancel-expense-btn');

  function openExpenseActionModal(requestId, actionType) {
    const req = (treasuryData.expenseRequests || []).find(r => r.id === requestId);
    if (!req) return;

    activeExpenseReq = req;
    activeExpenseAction = actionType;

    const modalTitle = document.getElementById('expense-modal-title');
    const modalSubtitle = document.getElementById('expense-modal-subtitle');
    const modalIcon = document.getElementById('expense-modal-icon');
    const noticeBox = document.getElementById('expense-modal-notice');
    const noticeText = document.getElementById('expense-notice-text');

    document.getElementById('modal-req-project').textContent = req.project ? req.project.projectName : 'مشروع عام';
    document.getElementById('modal-req-requester').textContent = `${req.requesterName || 'مقدم الطلب'} (${req.department})`;
    document.getElementById('modal-req-amount').textContent = (req.amount || 0).toLocaleString('ar-EG') + ' ج.م';
    document.getElementById('modal-req-title').textContent = req.title + (req.description ? ` (${req.description})` : '');

    if (actionType === 'approve') {
      if (modalTitle) modalTitle.textContent = 'تأكيد اعتماد وصرف الطلب';
      if (modalSubtitle) modalSubtitle.textContent = 'الموافقة المالية والخصم المباشر من خزينة المشروع';
      if (modalIcon) modalIcon.textContent = '⚖️';
      if (noticeBox) {
        noticeBox.className = 'modal-action-notice notice-approve';
      }
      if (noticeText) {
        noticeText.innerHTML = '💡 <strong>أثر الاعتماد المالي:</strong> سيتم خصم هذا المبلغ فورياً من خزينة المشروع، وتسجيل قيد مصروف رسمي في جدول الحركات المالية وتحديث الأرصدة لحظياً.';
      }
      if (confirmActionBtn) {
        confirmActionBtn.textContent = 'تأكيد الموافقة والصرف فوراً ✓';
        confirmActionBtn.className = 'btn btn-primary';
      }
    } else {
      if (modalTitle) modalTitle.textContent = 'تأكيد رفض طلب الصرف';
      if (modalSubtitle) modalSubtitle.textContent = 'لن يتم صرف المبلغ أو خصمه من رصيد الخزينة';
      if (modalIcon) modalIcon.textContent = '🚫';
      if (noticeBox) {
        noticeBox.className = 'modal-action-notice notice-reject';
      }
      if (noticeText) {
        noticeText.innerHTML = '⚠️ <strong>تنبيه:</strong> سيتم تحويل حالة الطلب إلى (مرفوض)، ولن يتم خصم أي مبالغ من خزينة المشروع.';
      }
      if (confirmActionBtn) {
        confirmActionBtn.textContent = 'تأكيد رفض الطلب ✕';
        confirmActionBtn.className = 'btn btn-danger';
      }
    }

    if (actionModal) actionModal.style.display = 'flex';
  }

  function closeExpenseActionModal() {
    if (actionModal) actionModal.style.display = 'none';
    activeExpenseReq = null;
  }

  closeActionBtn?.addEventListener('click', closeExpenseActionModal);
  cancelActionBtn?.addEventListener('click', closeExpenseActionModal);

  // Confirm Expense Action (Approve or Reject)
  confirmActionBtn?.addEventListener('click', async () => {
    if (!activeExpenseReq) return;

    const originalBtnText = confirmActionBtn.textContent;
    confirmActionBtn.textContent = 'جارٍ التنفيذ...';
    confirmActionBtn.disabled = true;

    try {
      const isApprove = activeExpenseAction === 'approve';
      const actionName = isApprove ? 'approve_expense_request' : 'reject_expense_request';

      const res = await fetch('/api/erp/treasury', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: actionName,
          requestId: activeExpenseReq.id
        })
      });

      const data = await res.json();
      if (data.success) {
        const reqAmount = activeExpenseReq ? activeExpenseReq.amount : 0;
        closeExpenseActionModal();
        if (isApprove) {
          showToast(`✅ تم اعتماد الصرف بنجاح! تم خصم ${(reqAmount || 0).toLocaleString('ar-EG')} ج.م من خزينة المشروع وقيد المصروف.`, 'success');
        } else {
          showToast(`⚠️ تم رفض طلب الصرف بنجاح وتحديث حالته إلى (مرفوض).`, 'success');
        }
        await loadTreasuryData();
      } else {
        showToast(data.error || 'فشلت معالجة الطلب', 'error');
      }
    } catch (err) {
      console.error('Expense action error:', err);
      showToast('حدث خطأ في الاتصال بالخادم', 'error');
    } finally {
      confirmActionBtn.textContent = originalBtnText;
      confirmActionBtn.disabled = false;
    }
  });

  // Filter Listeners
  document.getElementById('filter-tx-project')?.addEventListener('change', renderTransactions);
  document.getElementById('filter-tx-type')?.addEventListener('change', renderTransactions);
  document.getElementById('filter-tx-category')?.addEventListener('change', renderTransactions);

  // ========================================================
  // Tabs Switching (5 Tabs: Ledger, Approvals, COA, Journal, Forecast)
  // ========================================================
  const tabConfigs = [
    { btn: 'tab-btn-tx', pane: 'tab-content-tx' },
    { btn: 'tab-btn-approvals', pane: 'tab-content-approvals' },
    { btn: 'tab-btn-coa', pane: 'tab-content-coa' },
    { btn: 'tab-btn-journal', pane: 'tab-content-journal' },
    { btn: 'tab-btn-forecast', pane: 'tab-content-forecast' }
  ];

  function switchTab(activeBtnId) {
    tabConfigs.forEach(tab => {
      const btnEl = document.getElementById(tab.btn);
      const paneEl = document.getElementById(tab.pane);
      if (tab.btn === activeBtnId) {
        btnEl?.classList.add('active');
        if (paneEl) paneEl.style.display = 'block';
      } else {
        btnEl?.classList.remove('active');
        if (paneEl) paneEl.style.display = 'none';
      }
    });
  }

  tabConfigs.forEach(tab => {
    document.getElementById(tab.btn)?.addEventListener('click', () => switchTab(tab.btn));
  });

  // ========================================================
  // Phase 3: Accounting Data State & Handlers
  // ========================================================
  let accountingData = {
    accounts: [],
    journalEntries: [],
    forecast: { currentLiquidity: 0, months: [] }
  };

  async function loadAccountingData() {
    try {
      const res = await fetch('/api/erp/accounting');
      const data = await res.json();
      if (data.success) {
        accountingData = data;
        renderCOASummary();
        renderCOATable();
        populateParentAccountSelect();
        renderJournalEntries();
        renderCashFlowForecast();
      }
    } catch (err) {
      console.error('Accounting data fetch error:', err);
    }
  }

  // 1. Render COA Summary Cards & Badges
  function renderCOASummary() {
    const accounts = accountingData.accounts || [];
    
    // Group totals by type
    const totals = { asset: 0, liability: 0, equity: 0, revenue: 0, expense: 0 };
    accounts.forEach(acc => {
      if (!acc.isParent && acc.balance) {
        const type = acc.accountType;
        if (totals[type] !== undefined) {
          totals[type] += acc.balance;
        }
      }
    });

    const formatEgp = num => (num || 0).toLocaleString('ar-EG') + ' ج.م';
    const elAsset = document.getElementById('coa-assets-total');
    const elLiab = document.getElementById('coa-liabilities-total');
    const elEq = document.getElementById('coa-equity-total');
    const elRev = document.getElementById('coa-revenue-total');
    const elExp = document.getElementById('coa-expense-total');
    const elBadge = document.getElementById('coa-counter-badge');

    if (elAsset) elAsset.textContent = formatEgp(totals.asset);
    if (elLiab) elLiab.textContent = formatEgp(totals.liability);
    if (elEq) elEq.textContent = formatEgp(totals.equity);
    if (elRev) elRev.textContent = formatEgp(totals.revenue);
    if (elExp) elExp.textContent = formatEgp(totals.expense);
    if (elBadge) elBadge.textContent = accounts.length.toString();
  }

  // 2. Render COA Table with Filter & Search
  function renderCOATable() {
    const tbody = document.getElementById('coa-table-body');
    if (!tbody) return;

    const typeFilter = document.getElementById('filter-coa-type')?.value || 'all';
    const searchVal = document.getElementById('search-coa-input')?.value?.toLowerCase().trim() || '';

    const parentLookup = {};
    (accountingData.accounts || []).forEach(a => {
      parentLookup[a.id] = a.nameAr;
    });

    const filtered = (accountingData.accounts || []).filter(acc => {
      if (typeFilter !== 'all' && acc.accountType !== typeFilter) return false;
      if (searchVal) {
        const matchCode = acc.code.toLowerCase().includes(searchVal);
        const matchName = acc.nameAr.toLowerCase().includes(searchVal);
        if (!matchCode && !matchName) return false;
      }
      return true;
    });

    const typeNames = {
      asset: 'أصول (Asset)',
      liability: 'التزامات (Liability)',
      equity: 'حقوق ملكية (Equity)',
      revenue: 'إيرادات (Revenue)',
      expense: 'مصروفات (Expense)'
    };

    if (filtered.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="6" style="text-align:center;padding:2rem;color:#64748b;">
            لا توجد حسابات مطابقة لشروط البحث.
          </td>
        </tr>
      `;
      return;
    }

    tbody.innerHTML = filtered.map(acc => {
      const parentName = acc.parentId ? (parentLookup[acc.parentId] || 'حساب أب') : '— رئيسي —';
      const isDebit = acc.accountType === 'asset' || acc.accountType === 'expense';
      const natureText = isDebit ? '<span style="color:#059669;font-weight:700;">مدين (Debit)</span>' : '<span style="color:#2563eb;font-weight:700;">دائن (Credit)</span>';
      const balanceVal = (acc.balance || 0).toLocaleString('ar-EG') + ' ج.م';

      return `
        <tr style="${acc.isParent ? 'background:#f8fafc;font-weight:800;' : ''}">
          <td>
            <span class="account-code-badge">${acc.code}</span>
          </td>
          <td>
            <span style="${acc.isParent ? 'font-size:0.95rem;color:#0f172a;' : 'color:#334155;'}">
              ${acc.isParent ? '📁 ' : '📄 '} ${acc.nameAr}
            </span>
          </td>
          <td>
            <span class="account-type-pill type-${acc.accountType}">
              ${typeNames[acc.accountType] || acc.accountType}
            </span>
          </td>
          <td style="color:#64748b;font-size:0.8rem;">
            ${parentName}
          </td>
          <td>
            ${natureText}
          </td>
          <td>
            <strong style="color:#0f172a;font-size:0.95rem;">${balanceVal}</strong>
          </td>
        </tr>
      `;
    }).join('');
  }

  // 3. Populate Parent Account Dropdown
  function populateParentAccountSelect() {
    const sel = document.getElementById('acc-modal-parent');
    if (!sel) return;
    const accounts = accountingData.accounts || [];
    sel.innerHTML = '<option value="">-- بدون حساب أب (حساب رئيسي) --</option>' +
      accounts.map(a => `<option value="${a.id}">[${a.code}] ${a.nameAr}</option>`).join('');
  }

  // 4. Render Journal Entries with Nested Line Details
  function renderJournalEntries() {
    const tbody = document.getElementById('journal-table-body');
    const emptyState = document.getElementById('journal-empty-state');
    const counterBadge = document.getElementById('journal-counter-badge');
    if (!tbody) return;

    const searchVal = document.getElementById('search-journal-input')?.value?.toLowerCase().trim() || '';
    const entries = (accountingData.journalEntries || []).filter(e => {
      if (searchVal) {
        const descMatch = (e.description || '').toLowerCase().includes(searchVal);
        const refMatch = (e.reference || '').toLowerCase().includes(searchVal);
        const numMatch = (e.entryNumber || '').toLowerCase().includes(searchVal);
        if (!descMatch && !refMatch && !numMatch) return false;
      }
      return true;
    });

    if (counterBadge) counterBadge.textContent = (accountingData.journalEntries || []).length.toString();

    if (entries.length === 0) {
      tbody.innerHTML = '';
      if (emptyState) emptyState.style.display = 'block';
      return;
    }

    if (emptyState) emptyState.style.display = 'none';

    tbody.innerHTML = entries.map(e => {
      const formattedDate = new Date(e.entryDate).toLocaleDateString('ar-EG', { year: 'numeric', month: 'short', day: 'numeric' });
      const debitStr = (e.totalDebit || 0).toLocaleString('ar-EG') + ' ج.م';
      const creditStr = (e.totalCredit || 0).toLocaleString('ar-EG') + ' ج.م';
      const numCode = e.entryNumber || `JV-${e.id.substring(0, 6).toUpperCase()}`;

      const linesHtml = (e.lines || []).map(l => `
        <tr>
          <td><span class="account-code-badge" style="font-size:0.75rem;">${l.account?.code || '-'}</span> ${l.account?.nameAr || '-'}</td>
          <td style="color:#059669;font-weight:700;">${l.debit > 0 ? (l.debit.toLocaleString('ar-EG') + ' ج.م') : '-'}</td>
          <td style="color:#2563eb;font-weight:700;">${l.credit > 0 ? (l.credit.toLocaleString('ar-EG') + ' ج.م') : '-'}</td>
          <td style="color:#64748b;">${l.memo || '-'}</td>
        </tr>
      `).join('');

      return `
        <tr>
          <td><strong style="color:#4f46e5;">#${numCode}</strong></td>
          <td style="white-space:nowrap;">${formattedDate}</td>
          <td>
            <strong>${e.description}</strong>
          </td>
          <td>
            <span style="color:#64748b;font-size:0.82rem;">${e.reference || '—'}</span>
          </td>
          <td><strong style="color:#059669;">${debitStr}</strong></td>
          <td><strong style="color:#2563eb;">${creditStr}</strong></td>
          <td>
            <span class="balance-tag balanced" style="font-size:0.72rem;">متزن ⚖️</span>
          </td>
          <td>
            <button class="btn btn-sm btn-secondary toggle-lines-btn" data-entry-id="${e.id}" style="font-size:0.75rem;padding:0.25rem 0.6rem;">
              عرض الأطراف (${(e.lines || []).length}) ▾
            </button>
          </td>
        </tr>
        <tr id="lines-row-${e.id}" style="display:none;background:#f8fafc;">
          <td colspan="8" style="padding:0.75rem 1.5rem;">
            <div class="journal-sublines-wrap">
              <table class="journal-sublines-table">
                <thead>
                  <tr>
                    <th>الحساب المحاسبي</th>
                    <th>مدين</th>
                    <th>دائن</th>
                    <th>البيان والملاحظات</th>
                  </tr>
                </thead>
                <tbody>
                  ${linesHtml}
                </tbody>
              </table>
            </div>
          </td>
        </tr>
      `;
    }).join('');

    // Attach expand toggles
    document.querySelectorAll('.toggle-lines-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const entryId = btn.getAttribute('data-entry-id');
        const row = document.getElementById(`lines-row-${entryId}`);
        if (row) {
          const isShown = row.style.display !== 'none';
          row.style.display = isShown ? 'none' : 'table-row';
          btn.textContent = isShown ? `عرض الأطراف ▾` : `إخفاء الأطراف ▴`;
        }
      });
    });
  }

  // 5. Render Cash Flow Forecasting (6 Months)
  function renderCashFlowForecast() {
    const forecast = accountingData.forecast || { currentLiquidity: 0, months: [] };
    const curLiqEl = document.getElementById('forecast-current-liquidity');
    const totalInflowsEl = document.getElementById('forecast-total-inflows');
    const totalOutflowsEl = document.getElementById('forecast-total-outflows');
    const finalLiqEl = document.getElementById('forecast-final-liquidity');
    const cardsContainer = document.getElementById('forecast-months-cards-container');

    const curLiq = forecast.currentLiquidity || 0;
    if (curLiqEl) curLiqEl.textContent = curLiq.toLocaleString('ar-EG') + ' ج.م';

    const months = forecast.months || [];
    const totalIn = months.reduce((s, m) => s + (m.expectedInflow || 0), 0);
    const totalOut = months.reduce((s, m) => s + (m.expectedOutflow || 0), 0);
    const finalLiq = months.length > 0 ? (months[months.length - 1].cumulativePosition || 0) : curLiq;

    if (totalInflowsEl) totalInflowsEl.textContent = totalIn.toLocaleString('ar-EG') + ' ج.م';
    if (totalOutflowsEl) totalOutflowsEl.textContent = totalOut.toLocaleString('ar-EG') + ' ج.م';
    if (finalLiqEl) {
      finalLiqEl.textContent = finalLiq.toLocaleString('ar-EG') + ' ج.م';
      finalLiqEl.style.color = finalLiq >= 0 ? '#059669' : '#dc2626';
    }

    if (!cardsContainer) return;

    if (months.length === 0) {
      cardsContainer.innerHTML = '<div class="empty-notice-box"><p>لا توجد بيانات كافية لإجراء التنبؤ المالي حالياً.</p></div>';
      return;
    }

    cardsContainer.innerHTML = months.map(m => {
      const isPositive = m.netFlow >= 0;
      const netColor = isPositive ? '#16a34a' : '#dc2626';
      const cumColor = m.cumulativePosition >= 0 ? '#0f172a' : '#b91c1c';

      return `
        <div class="forecast-month-card">
          <div class="f-head">
            <h4 class="f-month-title">${m.monthName}</h4>
            <span class="f-month-badge">الشهر ${m.monthIndex}</span>
          </div>

          <div style="display:flex;flex-direction:column;gap:0.6rem;">
            <div class="f-row">
              <span class="f-lbl">📥 التدفقات الداخلة (أقساط وشيكات):</span>
              <span class="f-val" style="color:#16a34a;">+ ${(m.expectedInflow || 0).toLocaleString('ar-EG')} ج.م</span>
            </div>
            <div class="f-row">
              <span class="f-lbl">📤 الالتزامات الخارجة (مستخلصات):</span>
              <span class="f-val" style="color:#dc2626;">- ${(m.expectedOutflow || 0).toLocaleString('ar-EG')} ج.م</span>
            </div>
            <div class="f-row" style="border-top:1px dashed #e2e8f0;padding-top:0.5rem;">
              <span class="f-lbl">📊 صافي التدفق الشهري:</span>
              <span class="f-val" style="color:${netColor};font-weight:900;">
                ${isPositive ? '+' : ''}${(m.netFlow || 0).toLocaleString('ar-EG')} ج.م
              </span>
            </div>
          </div>

          <div class="f-cumulative-box">
            <span class="c-lbl">الرصيد التراكمي في نهاية الشهر:</span>
            <span class="c-val" style="color:${cumColor};">
              ${(m.cumulativePosition || 0).toLocaleString('ar-EG')} ج.م
            </span>
          </div>
        </div>
      `;
    }).join('');
  }

  // Filter Listeners for COA and Journal
  document.getElementById('filter-coa-type')?.addEventListener('change', renderCOATable);
  document.getElementById('search-coa-input')?.addEventListener('input', renderCOATable);
  document.getElementById('search-journal-input')?.addEventListener('input', renderJournalEntries);

  // ========================================================
  // Phase 3 Modals: Account & Journal Entries
  // ========================================================
  const accountModal = document.getElementById('account-modal');
  const journalModal = document.getElementById('journal-modal');

  // Open Account Modal
  function openAccountModal() {
    populateParentAccountSelect();
    if (accountModal) accountModal.style.display = 'flex';
  }
  function closeAccountModal() {
    if (accountModal) accountModal.style.display = 'none';
  }

  document.getElementById('open-new-account-btn')?.addEventListener('click', openAccountModal);
  document.getElementById('open-new-account-btn2')?.addEventListener('click', openAccountModal);
  document.getElementById('close-account-modal')?.addEventListener('click', closeAccountModal);
  document.getElementById('cancel-account-btn')?.addEventListener('click', closeAccountModal);

  // Submit New Account Form
  document.getElementById('new-account-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const saveBtn = document.getElementById('save-account-btn');
    if (saveBtn) saveBtn.textContent = 'جارٍ الحفظ...';

    const code = document.getElementById('acc-modal-code').value.trim();
    const nameAr = document.getElementById('acc-modal-name').value.trim();
    const accountType = document.getElementById('acc-modal-type').value;
    const parentId = document.getElementById('acc-modal-parent').value;
    const description = document.getElementById('acc-modal-desc').value.trim();

    try {
      const res = await fetch('/api/erp/accounting', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'create_account',
          code,
          nameAr,
          accountType,
          parentId: parentId || null,
          description
        })
      });
      const data = await res.json();
      if (data.success) {
        closeAccountModal();
        document.getElementById('new-account-form').reset();
        showToast('✅ تم إضافة الحساب بنجاح إلى شجرة الحسابات', 'success');
        await loadAccountingData();
      } else {
        showToast(data.error || 'فشلت إضافة الحساب', 'error');
      }
    } catch (err) {
      console.error(err);
      showToast('حدث خطأ في الاتصال بالخادم', 'error');
    } finally {
      if (saveBtn) saveBtn.textContent = 'حفظ وتثبيت الحساب في الدليل';
    }
  });

  // Dynamic Journal Lines Builder State
  let currentJournalLines = [
    { accountId: '', debit: 0, credit: 0, memo: '' },
    { accountId: '', debit: 0, credit: 0, memo: '' }
  ];

  function openJournalModal() {
    const dateInput = document.getElementById('journal-modal-date');
    if (dateInput) dateInput.value = new Date().toISOString().split('T')[0];
    currentJournalLines = [
      { accountId: '', debit: 0, credit: 0, memo: '' },
      { accountId: '', debit: 0, credit: 0, memo: '' }
    ];
    renderJournalLinesTable();
    if (journalModal) journalModal.style.display = 'flex';
  }

  function closeJournalModal() {
    if (journalModal) journalModal.style.display = 'none';
  }

  document.getElementById('open-manual-journal-btn')?.addEventListener('click', openJournalModal);
  document.getElementById('open-manual-journal-btn2')?.addEventListener('click', openJournalModal);
  document.getElementById('close-journal-modal')?.addEventListener('click', closeJournalModal);
  document.getElementById('cancel-journal-btn')?.addEventListener('click', closeJournalModal);

  // Render Dynamic Lines for Journal Modal
  function renderJournalLinesTable() {
    const tbody = document.getElementById('journal-lines-tbody');
    if (!tbody) return;

    const accounts = accountingData.accounts || [];
    const accOptionsHtml = accounts.map(a => `
      <option value="${a.id}">[${a.code}] ${a.nameAr} (${a.accountType})</option>
    `).join('');

    tbody.innerHTML = currentJournalLines.map((line, idx) => `
      <tr>
        <td>
          <select class="line-acc-select" data-idx="${idx}" required>
            <option value="">-- اختر الحساب --</option>
            ${accOptionsHtml}
          </select>
        </td>
        <td>
          <input type="number" step="any" min="0" class="line-debit-input" data-idx="${idx}" value="${line.debit || ''}" placeholder="0.00" />
        </td>
        <td>
          <input type="number" step="any" min="0" class="line-credit-input" data-idx="${idx}" value="${line.credit || ''}" placeholder="0.00" />
        </td>
        <td>
          <input type="text" class="line-memo-input" data-idx="${idx}" value="${line.memo || ''}" placeholder="ملاحظة..." />
        </td>
        <td style="text-align:center;">
          ${currentJournalLines.length > 2 ? `
            <button type="button" class="btn-remove-line" data-idx="${idx}">&times;</button>
          ` : '<span style="color:#cbd5e1;">-</span>'}
        </td>
      </tr>
    `).join('');

    // Set selected accounts
    document.querySelectorAll('.line-acc-select').forEach(sel => {
      const idx = sel.getAttribute('data-idx');
      sel.value = currentJournalLines[idx].accountId;
      sel.addEventListener('change', (e) => {
        currentJournalLines[idx].accountId = e.target.value;
      });
    });

    // Attach debit listeners
    document.querySelectorAll('.line-debit-input').forEach(inp => {
      const idx = inp.getAttribute('data-idx');
      inp.addEventListener('input', (e) => {
        currentJournalLines[idx].debit = parseFloat(e.target.value) || 0;
        if (currentJournalLines[idx].debit > 0) {
          currentJournalLines[idx].credit = 0;
          const crInp = document.querySelector(`.line-credit-input[data-idx="${idx}"]`);
          if (crInp) crInp.value = '';
        }
        recalcJournalTotals();
      });
    });

    // Attach credit listeners
    document.querySelectorAll('.line-credit-input').forEach(inp => {
      const idx = inp.getAttribute('data-idx');
      inp.addEventListener('input', (e) => {
        currentJournalLines[idx].credit = parseFloat(e.target.value) || 0;
        if (currentJournalLines[idx].credit > 0) {
          currentJournalLines[idx].debit = 0;
          const dbInp = document.querySelector(`.line-debit-input[data-idx="${idx}"]`);
          if (dbInp) dbInp.value = '';
        }
        recalcJournalTotals();
      });
    });

    // Attach memo listeners
    document.querySelectorAll('.line-memo-input').forEach(inp => {
      const idx = inp.getAttribute('data-idx');
      inp.addEventListener('input', (e) => {
        currentJournalLines[idx].memo = e.target.value;
      });
    });

    // Attach delete listeners
    document.querySelectorAll('.btn-remove-line').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-idx'));
        currentJournalLines.splice(idx, 1);
        renderJournalLinesTable();
        recalcJournalTotals();
      });
    });

    recalcJournalTotals();
  }

  // Add Line Button
  document.getElementById('add-journal-line-btn')?.addEventListener('click', () => {
    currentJournalLines.push({ accountId: '', debit: 0, credit: 0, memo: '' });
    renderJournalLinesTable();
  });

  // Recalculate Journal Totals & Validation
  function recalcJournalTotals() {
    let totalDebit = 0;
    let totalCredit = 0;

    currentJournalLines.forEach(l => {
      totalDebit += (l.debit || 0);
      totalCredit += (l.credit || 0);
    });

    const diff = Math.abs(totalDebit - totalCredit);
    const isBalanced = (diff < 0.001) && (totalDebit > 0);

    const debEl = document.getElementById('journal-total-debit-val');
    const crEl = document.getElementById('journal-total-credit-val');
    const indEl = document.getElementById('journal-balance-indicator');
    const saveBtn = document.getElementById('save-journal-btn');

    if (debEl) debEl.textContent = totalDebit.toLocaleString('ar-EG', { minimumFractionDigits: 2 });
    if (crEl) crEl.textContent = totalCredit.toLocaleString('ar-EG', { minimumFractionDigits: 2 });

    if (indEl) {
      if (isBalanced) {
        indEl.className = 'balance-tag balanced';
        indEl.textContent = 'متوازن تماماً ✓';
      } else {
        indEl.className = 'balance-tag unbalanced';
        indEl.textContent = `⚠️ غير متوازن (الفارق: ${diff.toLocaleString('ar-EG', { minimumFractionDigits: 2 })} ج.م)`;
      }
    }

    if (saveBtn) {
      saveBtn.disabled = !isBalanced;
    }
  }

  // Submit Journal Form
  document.getElementById('new-journal-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const saveBtn = document.getElementById('save-journal-btn');
    if (saveBtn) saveBtn.textContent = 'جارٍ ترحيل القيد...';

    const entryDate = document.getElementById('journal-modal-date').value;
    const description = document.getElementById('journal-modal-desc').value.trim();
    const reference = document.getElementById('journal-modal-ref').value.trim();

    // Filter valid lines
    const validLines = currentJournalLines.filter(l => l.accountId && (l.debit > 0 || l.credit > 0));

    try {
      const res = await fetch('/api/erp/accounting', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'create_journal_entry',
          entryDate,
          description,
          reference: reference || null,
          lines: validLines
        })
      });

      const data = await res.json();
      if (data.success) {
        closeJournalModal();
        document.getElementById('new-journal-form').reset();
        showToast('✅ تم تسجيل وترحيل القيد المحاسبي بنجاح في الدفتر العام', 'success');
        await loadAccountingData();
      } else {
        showToast(data.error || 'فشل حفظ القيد اليومي', 'error');
      }
    } catch (err) {
      console.error(err);
      showToast('حدث خطأ أثناء حفظ القيد', 'error');
    } finally {
      if (saveBtn) saveBtn.textContent = 'تأكيد وترحيل القيد اليومي ✓';
    }
  });

  // Modal Handlers
  const modal = document.getElementById('tx-modal');
  const openModalBtn = document.getElementById('open-manual-tx-btn');
  const closeModalBtn = document.getElementById('close-tx-modal');
  const cancelModalBtn = document.getElementById('cancel-tx-btn');

  function openModal(defaultType = 'income') {
    const typeSelect = document.getElementById('modal-tx-type');
    if (typeSelect) typeSelect.value = defaultType;
    if (modal) modal.style.display = 'flex';
  }

  openModalBtn?.addEventListener('click', () => openModal('income'));
  document.getElementById('open-quick-deposit-btn')?.addEventListener('click', () => openModal('income'));
  document.getElementById('open-quick-expense-btn')?.addEventListener('click', () => openModal('expense'));

  closeModalBtn?.addEventListener('click', () => { if (modal) modal.style.display = 'none'; });
  cancelModalBtn?.addEventListener('click', () => { if (modal) modal.style.display = 'none'; });

  // Submit Manual Transaction Form
  document.getElementById('manual-tx-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const saveBtn = document.getElementById('save-tx-btn');
    if (saveBtn) saveBtn.textContent = 'جارٍ تسجيل الحركة...';

    const treasuryId = document.getElementById('modal-treasury-id').value;
    const type = document.getElementById('modal-tx-type').value;
    const amount = document.getElementById('modal-tx-amount').value;
    const category = document.getElementById('modal-tx-category').value;
    const projectId = document.getElementById('modal-tx-project').value;
    const description = document.getElementById('modal-tx-desc').value;

    try {
      const res = await fetch('/api/erp/treasury', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'manual_transaction',
          treasuryId,
          type,
          amount,
          category,
          projectId: projectId || null,
          description
        })
      });

      const data = await res.json();
      if (data.success) {
        if (modal) modal.style.display = 'none';
        document.getElementById('manual-tx-form').reset();
        await loadTreasuryData();
      } else {
        alert(data.error || 'فشل تسجيل الحركة المالية');
      }
    } catch (err) {
      console.error('Error recording transaction:', err);
    } finally {
      if (saveBtn) saveBtn.textContent = 'تأكيد وقيد الحركة';
    }
  });
</script>
