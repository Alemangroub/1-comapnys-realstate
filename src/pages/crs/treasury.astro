---
import Layout from '../../layouts/Layout.astro';
import AdminLogin from '../../components/AdminLogin.astro';
---

<Layout title="الخزنة والحسابات (القلب المالي) | منظومة التطوير العقاري ERP">
  <div class="treasury-app-root">
    
    <!-- Auth Loading State -->
    <div id="auth-loading-message" class="loading-state">
      <div class="spinner"></div>
      <p>جارٍ التحقق من صلاحيات الإدارة المالية...</p>
    </div>

    <!-- Auth Login Container -->
    <div id="admin-login-container" style="display: none;">
      <AdminLogin />
    </div>

    <!-- Main Container -->
    <main id="main-content" class="erp-container" style="display: none;">
      
      <!-- Top Navigation Header -->
      <header class="erp-topbar">
        <div class="brand-crumb">
          <a href="/crs" class="back-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
            الرئيسية
          </a>
          <span class="sep">/</span>
          <span class="active-crumb">الخزنة والحسابات (القلب المالي للمنظومة)</span>
        </div>

        <div class="topbar-actions">
          <button id="open-manual-tx-btn" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            + تسجيل حركة مالية سريعة
          </button>
          <button id="open-manual-journal-btn" class="btn btn-journal-action">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
            + قيد يومية مزدوج
          </button>
          <button id="open-new-account-btn" class="btn btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            + إضافة حساب مالي
          </button>
        </div>
      </header>

      <!-- Subsystem Executive Banner -->
      <section class="treasury-hero-banner">
        <div class="hero-text-wrap">
          <div class="hero-badge-pill">القلب المالي المركزي 💰</div>
          <h1>إدارة الخزائن، السيولة النقدية، وموافقات الصرف</h1>
          <p>متابعة الخزينة المركزية وخزائن المشاريع المستقلة، الرقابة على طلبات الصرف من المواقع، وتسجيل الإيرادات والمصروفات اللحظية بدقة متناهية.</p>
        </div>
      </section>

      <!-- ========================================================
           القسم العلوي: بطاقات الأرصدة (الخزنة الرئيسية + خزائن المشاريع)
           ======================================================== -->
      <section class="safes-overview-section">
        <div class="safes-grid-layout">
          
          <!-- بطاقة كبيرة لـ (إجمالي رصيد الشركة في الخزنة الرئيسية) -->
          <div class="main-safe-card" id="main-safe-card-wrap">
            <div class="main-safe-header">
              <div class="safe-crest-icon">🏦</div>
              <div>
                <span class="safe-badge-pill">الخزينة المركزية</span>
                <h3 id="main-safe-name">الخزنة الرئيسية للشركة</h3>
              </div>
            </div>
            <div class="main-safe-body">
              <span class="balance-sub-label">إجمالي السيولة المتاحة:</span>
              <div class="balance-big-val" id="main-safe-balance">0 ج.م</div>
              <p class="safe-hint-text">تغذي حسابات المشروعات الاستثمارية ومصروفات الشركة المركزية</p>
            </div>
            <div class="main-safe-footer">
              <span class="safe-status-indicator">
                <span class="pulse-dot"></span>
                حساب نشط وجاهز للتحويلات
              </span>
            </div>
          </div>

          <!-- بطاقات خزائن المشاريع الفرعية على حدة -->
          <div class="project-safes-scroll-wrap" id="project-safes-container">
            <!-- Dynamically populated project safes cards -->
          </div>

        </div>
      </section>

      <!-- ========================================================
           قسم التبويبات الرئيسية (سجل الحركات + طلبات الصرف)
           ======================================================== -->
      <section class="treasury-tabs-section">
        
        <div class="treasury-nav-tabs">
          <button id="tab-btn-tx" class="tab-nav-item active" data-tab="tab-content-tx">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            <span>تبويب 1: سجل الحركات المالية (Ledger)</span>
            <span class="tab-counter-badge" id="tx-counter-badge">0</span>
          </button>

          <button id="tab-btn-approvals" class="tab-nav-item" data-tab="tab-content-approvals">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
            <span>تبويب 2: طلبات الصرف المعلقة (موافقات المدير المالي)</span>
            <span class="tab-counter-badge badge-alert" id="pending-counter-badge">0</span>
          </button>

          <button id="tab-btn-coa" class="tab-nav-item" data-tab="tab-content-coa">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="6" y1="3" x2="6" y2="15"></line><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path></svg>
            <span>تبويب 3: شجرة الحسابات (COA)</span>
            <span class="tab-counter-badge" id="coa-counter-badge">0</span>
          </button>

          <button id="tab-btn-journal" class="tab-nav-item" data-tab="tab-content-journal">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
            <span>تبويب 4: دفتر القيود اليومية (General Journal)</span>
            <span class="tab-counter-badge" id="journal-counter-badge">0</span>
          </button>

          <button id="tab-btn-forecast" class="tab-nav-item" data-tab="tab-content-forecast">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
            <span>تبويب 5: توقعات التدفق النقدي (Cash Flow)</span>
            <span class="tab-counter-badge" style="background:#dcfce7;color:#15803d;font-weight:900">6 أشهر</span>
          </button>
        </div>

        <!-- ========================================================
             تبويب 1: سجل الحركات المالية (إيرادات بالأخضر ومصروفات بالأحمر)
             ======================================================== -->
        <div id="tab-content-tx" class="tab-pane-content active">
          
          <!-- Filters & Action Bar -->
          <div class="ledger-filters-toolbar">
            <div class="filter-controls-row">
              
              <!-- Filter by Project -->
              <div class="filter-box">
                <label>تصفية حسب المشروع:</label>
                <select id="filter-tx-project">
                  <option value="all">جميع المشاريع والخزائن</option>
                </select>
              </div>

              <!-- Filter by Type -->
              <div class="filter-box">
                <label>نوع الحركة:</label>
                <select id="filter-tx-type">
                  <option value="all">الكل (إيرادات ومصروفات)</option>
                  <option value="income">🟢 إيرادات فقط (+)</option>
                  <option value="expense">🔴 مصروفات فقط (-)</option>
                </select>
              </div>

              <!-- Filter by Category -->
              <div class="filter-box">
                <label>تصنيف الحركة:</label>
                <select id="filter-tx-category">
                  <option value="all">جميع التصنيفات</option>
                  <option value="capital_deposit">إيداع رأسمال</option>
                  <option value="down_payment">مقدم حجز</option>
                  <option value="installment">قسط عميل</option>
                  <option value="contractor">مستخلص مقاول</option>
                  <option value="materials">شراء خامات</option>
                  <option value="sales_commission">عمولة مبيعات</option>
                  <option value="general_expense">مصروفات إدارية ونثرية</option>
                </select>
              </div>

            </div>

            <div class="toolbar-side-action">
              <button id="open-quick-deposit-btn" class="btn btn-sm btn-income-action">
                <span>+ إيداع نقدية مباشر</span>
              </button>
              <button id="open-quick-expense-btn" class="btn btn-sm btn-expense-action">
                <span>- صرف نقدية مباشر</span>
              </button>
            </div>
          </div>

          <!-- Transactions Table -->
          <div class="table-card-container">
            <table class="erp-financial-table">
              <thead>
                <tr>
                  <th>البيان والتفاصيل</th>
                  <th>نوع الحركة</th>
                  <th>المبلغ</th>
                  <th>الخزينة المودع / المسحوب منها</th>
                  <th>التصنيف</th>
                  <th>المسجل للحركة</th>
                  <th>التاريخ والوقت</th>
                </tr>
              </thead>
              <tbody id="transactions-table-body">
                <!-- Dynamically rendered -->
              </tbody>
            </table>

            <div id="tx-empty-state" class="empty-notice-box" style="display: none;">
              <p>لا توجد حركات مالية مطابقة لشروط البحث.</p>
            </div>
          </div>

        </div>

        <!-- ========================================================
             تبويب 2: طلبات الصرف المعلقة (موافقات المدير المالي)
             ======================================================== -->
        <div id="tab-content-approvals" class="tab-pane-content" style="display: none;">
          
          <div class="approvals-notice-banner">
            <div class="banner-icon-box">⚖️</div>
            <div class="banner-text">
              <h4>صلاحية الاعتماد المالي والخصم المباشر</h4>
              <p>عند النقر على <strong>(موافقة وصرف)</strong>، يقوم النظام تلقائياً بتحديث حالة الطلب إلى "معتمد"، وخصم المبلغ فورياً من خزينة المشروع، وإدراج قيد مصروف جديد في سجل الحركات المالية.</p>
            </div>
          </div>

          <!-- Expense Requests Table -->
          <div class="table-card-container">
            <table class="erp-financial-table">
              <thead>
                <tr>
                  <th>المشروع</th>
                  <th>القسم الطالب</th>
                  <th>سبب الصرف / البيان</th>
                  <th>مقدم الطلب</th>
                  <th>المبلغ المطلوب</th>
                  <th>تاريخ الطلب</th>
                  <th>الحالة</th>
                  <th>إجراء الاعتماد المالي</th>
                </tr>
              </thead>
              <tbody id="expense-requests-table-body">
                <!-- Dynamically rendered -->
              </tbody>
            </table>

            <div id="requests-empty-state" class="empty-notice-box" style="display: none;">
              <p>لا توجد طلبات صرف معلقة حالياً. جميع الطلبات تم البت فيها.</p>
            </div>
          </div>

        </div>

        <!-- ========================================================
             تبويب 3: شجرة الحسابات والدليل المحاسبي (Chart of Accounts)
             ======================================================== -->
        <div id="tab-content-coa" class="tab-pane-content" style="display: none;">
          <!-- Financial Categories Summary Strip -->
          <div class="coa-summary-cards-grid">
            <div class="coa-stat-card card-asset">
              <div class="stat-icon">🏛️</div>
              <div class="stat-info">
                <span class="stat-label">الأصول (Assets)</span>
                <span class="stat-value" id="coa-assets-total">0 ج.م</span>
                <span class="stat-hint">خزائن، بنوك، أوراق قبض، وأقساط مستحقة</span>
              </div>
            </div>
            <div class="coa-stat-card card-liability">
              <div class="stat-icon">📋</div>
              <div class="stat-info">
                <span class="stat-label">الالتزامات (Liabilities)</span>
                <span class="stat-value" id="coa-liabilities-total">0 ج.م</span>
                <span class="stat-hint">دفعات مقدمة، تأمينات ضمان أعمال 5%</span>
              </div>
            </div>
            <div class="coa-stat-card card-equity">
              <div class="stat-icon">💎</div>
              <div class="stat-info">
                <span class="stat-label">حقوق الملكية (Equity)</span>
                <span class="stat-value" id="coa-equity-total">0 ج.م</span>
                <span class="stat-hint">رأس المال المدفوع والأرباح المرحلة</span>
              </div>
            </div>
            <div class="coa-stat-card card-revenue">
              <div class="stat-icon">📈</div>
              <div class="stat-info">
                <span class="stat-label">إيرادات النشاط (Revenue)</span>
                <span class="stat-value" id="coa-revenue-total">0 ج.م</span>
                <span class="stat-hint">مبيعات الوحدات ورسوم التنازل</span>
              </div>
            </div>
            <div class="coa-stat-card card-expense">
              <div class="stat-icon">📉</div>
              <div class="stat-info">
                <span class="stat-label">المصروفات والتكاليف (Expenses)</span>
                <span class="stat-value" id="coa-expense-total">0 ج.م</span>
                <span class="stat-hint">مستخلصات المقاولين والخامات والتشغيل</span>
              </div>
            </div>
          </div>

          <!-- COA Toolbar -->
          <div class="ledger-filters-toolbar">
            <div class="filter-controls-row">
              <div class="filter-box">
                <label>تصفية حسب التصنيف المالي:</label>
                <select id="filter-coa-type">
                  <option value="all">جميع الحسابات (شجرة كاملة)</option>
                  <option value="asset">الأصول (1)</option>
                  <option value="liability">الالتزامات (2)</option>
                  <option value="equity">حقوق الملكية (3)</option>
                  <option value="revenue">الإيرادات (4)</option>
                  <option value="expense">المصروفات والتكاليف (5)</option>
                </select>
              </div>

              <div class="filter-box">
                <label>بحث برقم الكود أو الاسم:</label>
                <input type="text" id="search-coa-input" placeholder="مثال: 1101 أو شيكات..." style="padding:0.5rem 0.85rem;border-radius:10px;border:1px solid #cbd5e1;font-size:0.85rem;" />
              </div>
            </div>

            <div class="toolbar-side-action">
              <button id="open-new-account-btn2" class="btn btn-sm btn-primary">
                + إضافة حساب جديد للشجرة
              </button>
            </div>
          </div>

          <!-- COA Table -->
          <div class="table-card-container">
            <table class="erp-financial-table">
              <thead>
                <tr>
                  <th>كود الحساب</th>
                  <th>اسم الحساب المحاسبي</th>
                  <th>التصنيف المالي</th>
                  <th>الحساب الأب</th>
                  <th>طبيعة الحساب</th>
                  <th>الرصيد الفعلي المعتمد</th>
                </tr>
              </thead>
              <tbody id="coa-table-body">
                <!-- Dynamically populated -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- ========================================================
             تبويب 4: دفتر القيود اليومية (General Journal)
             ======================================================== -->
        <div id="tab-content-journal" class="tab-pane-content" style="display: none;">
          <div class="journal-hero-strip">
            <div class="hero-strip-text">
              <h4>دفتر القيود اليومية العامة المزدوجة (Double-Entry Ledger)</h4>
              <p>تسجيل العمليات المالية بدقة القيود المزدوجة مع فرض التوازن الحسابي التام (إجمالي المدين = إجمالي الدائن).</p>
            </div>
            <button id="open-manual-journal-btn2" class="btn btn-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              + إنشاء قيد محاسبي جديد
            </button>
          </div>

          <!-- Journal Filters -->
          <div class="ledger-filters-toolbar">
            <div class="filter-controls-row">
              <div class="filter-box">
                <label>بحث في القيود (البيان / المرجع):</label>
                <input type="text" id="search-journal-input" placeholder="بحث بالبيان أو رقم المرجع..." style="padding:0.5rem 0.85rem;border-radius:10px;border:1px solid #cbd5e1;font-size:0.85rem;" />
              </div>
            </div>
          </div>

          <!-- Journal Entries Table -->
          <div class="table-card-container">
            <table class="erp-financial-table">
              <thead>
                <tr>
                  <th>رقم القيد</th>
                  <th>تاريخ القيد</th>
                  <th>البيان والتفاصيل</th>
                  <th>المرجع / المستند</th>
                  <th>إجمالي المدين</th>
                  <th>إجمالي الدائن</th>
                  <th>حالة التوازن</th>
                  <th>تفاصيل الأطراف</th>
                </tr>
              </thead>
              <tbody id="journal-table-body">
                <!-- Dynamically rendered -->
              </tbody>
            </table>

            <div id="journal-empty-state" class="empty-notice-box" style="display: none;">
              <p>لا توجد قيود يومية مسجلة بعد. يمكنك إنشاء قيدك المحاسبي الأول الآن.</p>
            </div>
          </div>
        </div>

        <!-- ========================================================
             تبويب 5: توقعات التدفق النقدي والسيولة (Cash Flow Forecast)
             ======================================================== -->
        <div id="tab-content-forecast" class="tab-pane-content" style="display: none;">
          <!-- Forecast Top Strip -->
          <div class="forecast-metrics-strip">
            <div class="forecast-metric-card metric-current-liquidity">
              <div class="m-icon">💰</div>
              <div>
                <span class="m-label">السيولة النقدية المتوفرة حالياً بالخزائن:</span>
                <h3 class="m-val" id="forecast-current-liquidity">0 ج.م</h3>
                <span class="m-sub">جاهزة لتغطية المستحقات الفورية</span>
              </div>
            </div>

            <div class="forecast-metric-card metric-projected-inflow">
              <div class="m-icon">📥</div>
              <div>
                <span class="m-label">إجمالي التدفقات المتوقعة (6 أشهر):</span>
                <h3 class="m-val" id="forecast-total-inflows">0 ج.م</h3>
                <span class="m-sub">أقساط بيع مستحقة وشيكات قيد التحصيل</span>
              </div>
            </div>

            <div class="forecast-metric-card metric-projected-outflow">
              <div class="m-icon">📤</div>
              <div>
                <span class="m-label">إجمالي الالتزامات المتوقعة (6 أشهر):</span>
                <h3 class="m-val" id="forecast-total-outflows">0 ج.م</h3>
                <span class="m-sub">مستخلصات مقاولين وتكاليف تطوير</span>
              </div>
            </div>

            <div class="forecast-metric-card metric-projected-net">
              <div class="m-icon">📊</div>
              <div>
                <span class="m-label">صافي السيولة التراكمية المتوقعة:</span>
                <h3 class="m-val" id="forecast-final-liquidity">0 ج.م</h3>
                <span class="m-sub">الرصيد التقديري في نهاية الشهر السادس</span>
              </div>
            </div>
          </div>

          <!-- Forecast Guidance Notice -->
          <div class="approvals-notice-banner" style="background:#eff6ff;border-color:#bfdbfe;margin-bottom:1.5rem;">
            <div class="banner-icon-box" style="background:#dbeafe;color:#2563eb;">🔮</div>
            <div class="banner-text">
              <h4 style="color:#1e40af;">محرك التنبؤ المالي الذكي (Real Estate Predictive Engine)</h4>
              <p style="color:#3b82f6;">يقوم النظام بمقارنة تواريخ استحقاق أقساط حجز الوحدات والشيكات البنكية في الخزينة مع تواريخ استحقاق مستخلصات المقاولين المعتمدة، لحساب التدفق النقدي الصافي ومحفظة السيولة لكل شهر مقبل بدقة استباقية.</p>
            </div>
          </div>

          <!-- 6-Month Cards Grid -->
          <div class="forecast-months-grid" id="forecast-months-cards-container">
            <!-- Dynamically populated cards -->
          </div>
        </div>

      </section>

    </main>

    <!-- ========================================================
         MODAL: تسجيل حركة مالية يدوية (إيداع أو صرف)
         ======================================================== -->
    <div id="tx-modal" class="modal-backdrop" style="display: none;">
