          <div class="modal-form-actions">
            <button type="submit" class="btn btn-primary" id="save-tx-btn">تأكيد وقيد الحركة</button>
            <button type="button" class="btn btn-secondary" id="cancel-tx-btn">إلغاء</button>
          </div>
        </form>
      </div>
    </div>

    <!-- ========================================================
