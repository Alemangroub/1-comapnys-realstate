                <option value="">-- بدون ارتباط بمشروع --</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label>البيان والتفاصيل *</label>
            <input type="text" id="modal-tx-desc" placeholder="مثال: إيداع دفعة تشغيل نقدية لحساب المشروع" required />
