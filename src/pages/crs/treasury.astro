         ======================================================== -->
    <div id="expense-action-modal" class="modal-backdrop" style="display: none;">
      <div class="modal-card action-confirm-card">
        <div class="modal-header" id="expense-modal-header">
          <div class="modal-title-wrap">
            <div class="pod-icon" id="expense-modal-icon">⚖️</div>
            <div>
              <h3 id="expense-modal-title">تأكيد اعتماد وصرف الطلب</h3>
              <p id="expense-modal-subtitle">الموافقة المالية والخصم المباشر من خزينة المشروع</p>
            </div>
          </div>
          <button class="close-modal-btn" id="close-expense-modal">&times;</button>
        </div>

        <div class="modal-form-body">
          <div class="expense-details-box">
            <div class="detail-row">
              <span class="detail-lbl">المشروع المستهدف:</span>
              <strong id="modal-req-project" class="detail-val">-</strong>
            </div>
            <div class="detail-row">
              <span class="detail-lbl">القسم ومقدم الطلب:</span>
              <span id="modal-req-requester" class="detail-val">-</span>
            </div>
            <div class="detail-row">
              <span class="detail-lbl">المبلغ المطلوب صرفه:</span>
              <strong id="modal-req-amount" class="detail-val amount-highlight">-</strong>
            </div>
            <div class="detail-row">
              <span class="detail-lbl">بيان وسبب الصرف:</span>
              <span id="modal-req-title" class="detail-val">-</span>
            </div>
          </div>

          <div id="expense-modal-notice" class="modal-action-notice notice-approve">
            <p id="expense-notice-text">💡 <strong>أثر الاعتماد المالي:</strong> سيتم خصم هذا المبلغ فورياً من خزينة المشروع، وتسجيل قيد مصروف رسمي في جدول الحركات المالية وتحديث الأرصدة لحظياً.</p>
          </div>

          <div class="modal-form-actions">
            <button type="button" class="btn btn-primary" id="confirm-expense-btn">تأكيد الموافقة والصرف فوراً ✓</button>
            <button type="button" class="btn btn-secondary" id="cancel-expense-btn">إلغاء وتراجع</button>
          </div>
        </div>
      </div>
    </div>

    <!-- ========================================================
         MODAL: إضافة حساب جديد لشجرة الحسابات (COA)
         ======================================================== -->
    <div id="account-modal" class="modal-backdrop" style="display: none;">
      <div class="modal-card">
        <div class="modal-header">
          <div class="modal-title-wrap">
            <div class="pod-icon" style="background:#f0fdf4;color:#16a34a;">🏛️</div>
            <div>
              <h3>إضافة حساب مالي جديد إلى الدليل المحاسبي</h3>
              <p>توسيع شجرة الحسابات ومراكز التكلفة</p>
            </div>
          </div>
          <button class="close-modal-btn" id="close-account-modal">&times;</button>
        </div>

        <form id="new-account-form" class="modal-form-body">
          <div class="form-row">
            <div class="form-group">
              <label>كود الحساب (Code) *</label>
              <input type="text" id="acc-modal-code" placeholder="مثال: 1105" required />
            </div>

            <div class="form-group">
              <label>التصنيف المالي *</label>
              <select id="acc-modal-type" required>
                <option value="asset">أصول (Assets - 1)</option>
                <option value="liability">الالتزامات (Liabilities - 2)</option>
                <option value="equity">حقوق الملكية (Equity - 3)</option>
                <option value="revenue">الإيرادات (Revenue - 4)</option>
                <option value="expense">المصروفات والتكاليف (Expenses - 5)</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label>اسم الحساب المحاسبي بالعربية *</label>
            <input type="text" id="acc-modal-name" placeholder="مثال: حساب البنك التجاري الدولي CIB" required />
          </div>

          <div class="form-group">
            <label>الحساب الأب (المستوى الأعلى - اختياري)</label>
            <select id="acc-modal-parent">
              <option value="">-- بدون حساب أب (حساب رئيسي) --</option>
            </select>
          </div>

          <div class="form-group">
            <label>الوصف / الملاحظات</label>
            <input type="text" id="acc-modal-desc" placeholder="وصف استخدامات الحساب ومحدداته" />
          </div>

          <div class="modal-form-actions">
            <button type="submit" class="btn btn-primary" id="save-account-btn">حفظ وتثبيت الحساب في الدليل</button>
            <button type="button" class="btn btn-secondary" id="cancel-account-btn">إلغاء</button>
          </div>
        </form>
      </div>
    </div>

    <!-- ========================================================
         MODAL: إنشاء قيد يومية محاسبي مزدوج (Double-Entry Journal)
         ======================================================== -->
    <div id="journal-modal" class="modal-backdrop" style="display: none;">
      <div class="modal-card" style="max-width: 900px; width: 95%;">
        <div class="modal-header">
          <div class="modal-title-wrap">
            <div class="pod-icon" style="background:#eff6ff;color:#2563eb;">⚖️</div>
            <div>
              <h3>إنشاء قيد يومية محاسبي مزدوج متزن</h3>
              <p>تسجيل أطراف القيد مع التحقق التلقائي من توازن المدين والدائن</p>
            </div>
          </div>
          <button class="close-modal-btn" id="close-journal-modal">&times;</button>
        </div>

        <form id="new-journal-form" class="modal-form-body">
          <div class="form-row">
            <div class="form-group" style="flex:1;">
              <label>تاريخ القيد *</label>
              <input type="date" id="journal-modal-date" required />
            </div>

            <div class="form-group" style="flex:1;">
              <label>المرجع / رقم الإشعار المستندي</label>
              <input type="text" id="journal-modal-ref" placeholder="مثال: فاتورة-2026/088 أو شيك #55" />
            </div>
          </div>

          <div class="form-group">
            <label>البيان العام للقيد *</label>
            <input type="text" id="journal-modal-desc" placeholder="مثال: إثبات استحقاق مستخلص رقم 4 لمشروع الأندلس بعد استقطاع ضمان الأعمال" required />
          </div>

          <!-- Dynamic Lines Section -->
          <div class="journal-lines-wrapper">
            <div class="lines-head-row">
              <h4>أطراف القيد المحاسبي (المدين والدائن)</h4>
              <button type="button" id="add-journal-line-btn" class="btn btn-sm btn-secondary">
                + إضافة طرف قيد جديد
              </button>
            </div>

            <div class="journal-lines-table-wrap">
              <table class="journal-lines-table">
                <thead>
                  <tr>
                    <th style="width: 38%;">الحساب المحاسبي</th>
                    <th style="width: 20%;">مدين (جنيه)</th>
                    <th style="width: 20%;">دائن (جنيه)</th>
                    <th style="width: 17%;">ملاحظة الطرف</th>
                    <th style="width: 5%;">حذف</th>
                  </tr>
                </thead>
                <tbody id="journal-lines-tbody">
                  <!-- Populated dynamically via JS -->
                </tbody>
                <tfoot>
                  <tr class="totals-foot-row">
                    <td><strong>الإجمالي والتوازن:</strong></td>
                    <td><strong id="journal-total-debit-val">0.00</strong> ج.م</td>
                    <td><strong id="journal-total-credit-val">0.00</strong> ج.م</td>
                    <td colspan="2">
                      <span id="journal-balance-indicator" class="balance-tag unbalanced">⚠️ غير متوازن (0.00)</span>
                    </td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </div>

          <div class="modal-form-actions">
            <button type="submit" class="btn btn-primary" id="save-journal-btn" disabled>
              تأكيد وترحيل القيد اليومي ✓
            </button>
            <button type="button" class="btn btn-secondary" id="cancel-journal-btn">إلغاء</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Toast Notification Banner -->
    <div id="treasury-toast" class="treasury-toast" style="display: none;">
      <span class="toast-icon" id="toast-icon">✅</span>
      <span class="toast-text" id="toast-text">تمت العملية بنجاح</span>
    </div>

  </div>
</Layout>

<style is:global>
  * {
