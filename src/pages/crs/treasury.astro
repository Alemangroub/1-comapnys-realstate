                <option value="capital_deposit">إيداع رأسمال وتغذية</option>
                <option value="down_payment">مقدم حجز وتعاقد</option>
                <option value="installment">قسط عميل</option>
                <option value="contractor">مستخلص مقاول</option>
                <option value="materials">شراء خامات ومواد</option>
                <option value="sales_commission">عمولة مبيعات</option>
                <option value="general_expense">مصروفات نثرية وإدارية</option>
