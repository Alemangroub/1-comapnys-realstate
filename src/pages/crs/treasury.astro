          <div class="form-row">
            <div class="form-group">
              <label>نوع الحركة *</label>
              <select id="modal-tx-type" required>
                <option value="income">🟢 إيداع / إيراد نقدية (+)</option>
                <option value="expense">🔴 سحب / صرف نقدية (-)</option>
