  .hero-badge { display: inline-block; padding: 0.35rem 0.95rem; border-radius: 20px; background: rgba(255,255,255,0.18); font-size: 0.8rem; font-weight: 800; margin-bottom: 0.75rem; }
  .hero-text h1 { margin: 0 0 0.65rem 0; font-size: 2rem; font-weight: 900; }
