  .hero-stats-row { display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .hero-stat-card { background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2); border-radius: 18px; padding: 1.25rem 1.75rem; text-align: center; min-width: 130px; }
  .hero-stat-card.highlight-card { background: rgba(16, 185, 129, 0.25); border-color: rgba(52, 211, 153, 0.45); }
  .stat-number { display: block; font-size: 2.1rem; font-weight: 900; margin-bottom: 0.3rem; }
