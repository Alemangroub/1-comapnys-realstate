          </div>

          <div class="snag-add-box" style="display: flex; gap: 0.5rem; margin-bottom: 1.5rem;">
            <input type="text" id="new-snag-text" placeholder="إضافة ملاحظة جديدة (مثال: مفصلة شباك غرفة النوم غير محكمة)..." style="flex: 1; padding: 0.65rem 0.85rem; border: 1.5px solid #e2e8f0; border-radius: 10px;" />
            <button type="button" class="btn btn-sm btn-outline" id="btn-add-snag-item">+ إضافة ملاحظة</button>
