            <button type="button" class="btn btn-secondary" id="cancel-add-insp-btn">إلغاء</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal: View & Update Snagging List -->
    <div id="view-snag-modal" class="modal-backdrop" style="display: none;">
      <div class="modal-card modal-large">
        <div class="modal-header">
          <div>
