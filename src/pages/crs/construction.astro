    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .modal-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .modal-title-wrap h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 800;
  }

  .modal-title-wrap p {
    margin: 0;
    font-size: 0.8rem;
    color: #64748b;
  }

  .close-modal-btn {
    background: transparent;
    border: none;
    font-size: 1.8rem;
    cursor: pointer;
    color: #94a3b8;
    line-height: 1;
  }

  .close-modal-btn:hover { color: #0f172a; }

  .modal-form-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .modal-form-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
    margin-top: 0.5rem;
  }

  /* Toast Notification */
  .construction-toast {
    position: fixed;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    background: #065f46;
    color: #ffffff;
    border: 1px solid #10b981;
    padding: 0.85rem 1.6rem;
    border-radius: 50px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
    font-size: 0.92rem;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
    z-index: 10000;
    animation: toastSlideDown 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .construction-toast.toast-error {
    background: #991b1b;
    border-color: #ef4444;
  }

  @keyframes toastSlideDown {
    from { opacity: 0; transform: translate(-50%, -20px); }
    to { opacity: 1; transform: translate(-50%, 0); }
  }

  @media (max-width: 1024px) {
    .strip-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 768px) {
    .form-row { flex-direction: column; }
    .construction-hero-banner { padding: 1.5rem; }
    .erp-topbar { flex-direction: column; align-items: stretch; gap: 0.75rem; }
    .construction-tabs-nav { gap: 0.25rem; }
  }
</style>

<script>
  import { checkAuth } from '../../lib/auth.js';

  let constructionData = {
    projects: [],
    selectedProjectId: null,
    totalProgress: 0,
    stages: [],
    contractors: [],
    materials: [],
    inventoryLogs: [],
    expenseRequests: [],
    boqItems: [],
    contractorInvoices: [],
    unitInspections: [],
    units: []
  };

  const authLoading = document.getElementById('auth-loading-message');
  const loginContainer = document.getElementById('admin-login-container');
  const mainContent = document.getElementById('main-content');
  const projectSelect = document.getElementById('project-select');

  // Verify Auth
  (async () => {
    try {
      const user = await checkAuth();
      if (authLoading) authLoading.style.display = 'none';

      if (user) {
        if (mainContent) mainContent.style.display = 'block';
        await loadConstructionData();
      } else {
        if (loginContainer) loginContainer.style.display = 'block';
      }
    } catch (e) {
      if (authLoading) authLoading.style.display = 'none';
      if (loginContainer) loginContainer.style.display = 'block';
    }
  })();

  // Toast System
  let toastTimer = null;
  function showToast(message, isSuccess = true) {
    const toast = document.getElementById('construction-toast');
    const toastIcon = document.getElementById('c-toast-icon');
    const toastText = document.getElementById('c-toast-text');
    if (!toast) return;

    if (toastTimer) clearTimeout(toastTimer);

    toast.className = 'construction-toast ' + (isSuccess ? '' : 'toast-error');
    if (toastIcon) toastIcon.textContent = isSuccess ? '✅' : '⚠️';
    if (toastText) toastText.textContent = message;

    toast.style.display = 'flex';
    toastTimer = setTimeout(() => {
      toast.style.display = 'none';
    }, 4000);
  }

  // Load Construction Data
  async function loadConstructionData(requestedProjId = null) {
    try {
      let url = '/api/erp/construction';
      if (requestedProjId) {
        url += `?projectId=${requestedProjId}`;
      } else if (constructionData.selectedProjectId) {
        url += `?projectId=${constructionData.selectedProjectId}`;
      }

      const res = await fetch(url);
      const data = await res.json();
      if (data.success) {
        constructionData = data;
        renderTopProjectPicker();
        renderTotalProgress();
        renderPhases();
        renderContractors();
        renderMaterials();
        renderExpensesTab();
        renderBoqTab();
        renderInvoicesTab();
        renderInspectionsTab();
      } else {
        showToast(data.error || 'فشل تحميل بيانات الإنشاءات', false);
      }
    } catch (err) {
      console.error('Error fetching construction data:', err);
    }
  }

  // Render Top Project Picker
  function renderTopProjectPicker() {
    if (!projectSelect) return;
    const projs = constructionData.projects || [];
    projectSelect.innerHTML = projs.map(p => `
      <option value="${p.id}" ${p.id === constructionData.selectedProjectId ? 'selected' : ''}>
        🏢 ${p.projectName}
      </option>
    `).join('');

    const curr = projs.find(p => p.id === constructionData.selectedProjectId);
    const expProjInput = document.getElementById('expense-project-name');
    if (expProjInput && curr) {
      expProjInput.value = curr.projectName;
    }
  }

  projectSelect?.addEventListener('change', async (e) => {
    const newId = e.target.value;
    constructionData.selectedProjectId = newId;
    await loadConstructionData(newId);
  });

  // Render Total Progress
  function renderTotalProgress() {
    const val = constructionData.totalProgress || 0;
    const txt = document.getElementById('total-progress-text');
    const bar = document.getElementById('total-progress-bar');
    if (txt) txt.textContent = `${val}%`;
    if (bar) bar.style.width = `${val}%`;
  }

  // Tab 1: Render Construction Phases (مراحل البناء)
  function renderPhases() {
    const stages = constructionData.stages || [];
    const container = document.getElementById('phases-container');
    const emptyBox = document.getElementById('phases-empty-state');
    const badge = document.getElementById('phases-count-badge');

    if (badge) badge.textContent = stages.length;

    if (stages.length === 0) {
      if (container) container.innerHTML = '';
      if (emptyBox) emptyBox.style.display = 'block';
      return;
    }

    if (emptyBox) emptyBox.style.display = 'none';

    const gradients = [
      'linear-gradient(135deg, #d97706 0%, #b45309 100%)', // الحفر
      'linear-gradient(135deg, #0284c7 0%, #0369a1 100%)', // الأساسات
      'linear-gradient(135deg, #4f46e5 0%, #3730a3 100%)', // الهيكل
      'linear-gradient(135deg, #059669 0%, #047857 100%)'  // التشطيبات
    ];
    const icons = ['🚜', '🏗️', '🏢', '🎨'];

    if (container) {
      container.innerHTML = stages.map((st, idx) => {
        const pVal = Math.round(st.progress || st.percentage || 0);
        const grad = gradients[idx % gradients.length];
        const icon = icons[idx % icons.length];
        
        let statusBadge = '<span class="phase-status-badge badge-pending">🟡 معلقة</span>';
        if (pVal >= 100) statusBadge = '<span class="phase-status-badge badge-completed">🟢 مكتملة 100%</span>';
        else if (pVal > 0) statusBadge = '<span class="phase-status-badge badge-in_progress">🔵 قيد التنفيذ</span>';

        return `
          <div class="phase-card" data-stage-id="${st.id}">
            <div class="phase-photo-wrap" style="background: ${grad}; position: relative; display: flex; align-items: center; justify-content: center; height: 160px; overflow: hidden;">
              <span style="font-size: 4rem; opacity: 0.35; transform: scale(1.1);">${icon}</span>
              ${st.photoUrl ? `<img src="${st.photoUrl}" alt="${st.name}" class="phase-img" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;" onerror="this.style.display='none'" />` : ''}
              ${statusBadge}
            </div>

            <div class="phase-card-body">
              <div class="phase-title-row">
                <h4>${st.name}</h4>
                <span class="phase-order-pill">مرحلة #${st.stageOrder}</span>
              </div>

              ${st.notes ? `<p class="phase-notes-text">${st.notes}</p>` : ''}

              <!-- Interactive Progress Slider -->
              <div class="phase-slider-box">
                <div class="slider-head-row">
                  <span class="slider-lbl">نسبة الإنجاز الفعلية:</span>
                  <span class="slider-val-tag" id="slider-val-${st.id}">${pVal}%</span>
                </div>
                <input 
                  type="range" 
                  min="0" 
                  max="100" 
                  value="${pVal}" 
                  class="phase-range-slider" 
                  data-target-id="${st.id}" 
                />
              </div>

              <div class="phase-card-actions">
                <button type="button" class="btn-save-progress save-stage-btn" data-stage-id="${st.id}">
                  حفظ نسبة الإنجاز ✓
                </button>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    // Attach Slider Live Input Listeners
    container?.querySelectorAll('.phase-range-slider').forEach(slider => {
      slider.addEventListener('input', (e) => {
        const stageId = e.target.getAttribute('data-target-id');
        const valTag = document.getElementById(`slider-val-${stageId}`);
        if (valTag) valTag.textContent = `${e.target.value}%`;
      });
    });

    // Attach Save Progress Button Listeners
    container?.querySelectorAll('.save-stage-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const stageId = e.currentTarget.getAttribute('data-stage-id');
        const card = e.currentTarget.closest('.phase-card');
        const slider = card?.querySelector('.phase-range-slider');
        const progressVal = slider ? slider.value : 0;

        e.currentTarget.textContent = 'جارٍ الحفظ...';
        try {
          const res = await fetch('/api/erp/construction', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'update_phase_progress',
              stageId,
              progress: progressVal
            })
          });

          const data = await res.json();
          if (data.success) {
            showToast(`تم تحديث نسبة إنجاز المرحلة إلى ${progressVal}% بنجاح!`);
            await loadConstructionData();
          } else {
            showToast(data.error || 'فشل تحديث المرحلة', false);
          }
        } catch (err) {
          showToast('حدث خطأ في الاتصال بالخادم', false);
        } finally {
          e.currentTarget.textContent = 'حفظ نسبة الإنجاز ✓';
        }
      });
    });
  }

  // Tab 2: Render Contractors (المقاولين والمستخلصات)
  function renderContractors() {
    const contractors = constructionData.contractors || [];
    const tbody = document.getElementById('contractors-table-body');
    const emptyBox = document.getElementById('contractors-empty-state');
    const badge = document.getElementById('contractors-count-badge');

    if (badge) badge.textContent = contractors.length;

    if (contractors.length === 0) {
      if (tbody) tbody.innerHTML = '';
      if (emptyBox) emptyBox.style.display = 'block';
      return;
    }

    if (emptyBox) emptyBox.style.display = 'none';

    if (tbody) {
      tbody.innerHTML = contractors.map(c => {
        const cAmt = c.contractAmount || 0;
        const pAmt = c.paidAmount || 0;
        const rAmt = c.remainingAmount !== undefined ? c.remainingAmount : Math.max(0, cAmt - pAmt);

        return `
          <tr>
            <td>
              <strong>${c.name}</strong>
              ${c.companyName ? `<br><small style="color: #64748b;">${c.companyName}</small>` : ''}
            </td>
            <td><span class="specialty-pill">${c.specialty}</span></td>
            <td>${c.phone ? `<a href="tel:${c.phone}" style="color: #0284c7; text-decoration: none;">📞 ${c.phone}</a>` : '-'}</td>
            <td><strong>${cAmt.toLocaleString('ar-EG')} ج.م</strong></td>
            <td><strong style="color: #059669;">${pAmt.toLocaleString('ar-EG')} ج.م</strong></td>
            <td><strong style="color: #dc2626;">${rAmt.toLocaleString('ar-EG')} ج.م</strong></td>
            <td>
              <button 
                class="btn btn-sm btn-primary pay-contractor-btn" 
                data-id="${c.id}"
                data-name="${c.name}"
                data-contract="${cAmt}"
                data-remaining="${rAmt}"
              >
                + سداد دفعة
              </button>
            </td>
          </tr>
        `;
      }).join('');
    }

    // Attach Pay Contractor Button Listeners
    tbody?.querySelectorAll('.pay-contractor-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = e.currentTarget.getAttribute('data-id');
        const name = e.currentTarget.getAttribute('data-name');
        const contract = parseFloat(e.currentTarget.getAttribute('data-contract') || 0);
        const remaining = parseFloat(e.currentTarget.getAttribute('data-remaining') || 0);

        document.getElementById('pay-contractor-id').value = id;
        document.getElementById('pay-contractor-name').textContent = name;
        document.getElementById('pay-contractor-total').textContent = `${contract.toLocaleString('ar-EG')} ج.م`;
        document.getElementById('pay-contractor-remaining').textContent = `${remaining.toLocaleString('ar-EG')} ج.م`;
        document.getElementById('pay-amount-input').value = '';

        document.getElementById('pay-contractor-modal').style.display = 'flex';
      });
    });
  }

  // Tab 3: Render Inventory Materials & Logs (المخازن والخامات)
  function renderMaterials() {
    const materials = constructionData.materials || [];
    const logs = constructionData.inventoryLogs || [];
    const container = document.getElementById('materials-container');
    const emptyBox = document.getElementById('materials-empty-state');
    const badge = document.getElementById('materials-count-badge');
    const logsTbody = document.getElementById('inventory-logs-table-body');
    const logsEmpty = document.getElementById('logs-empty-state');
    const logsCountStr = document.getElementById('logs-count-str');

    if (badge) badge.textContent = materials.length;

    // 1. Materials Cards
    if (materials.length === 0) {
      if (container) container.innerHTML = '';
      if (emptyBox) emptyBox.style.display = 'block';
    } else {
      if (emptyBox) emptyBox.style.display = 'none';
      if (container) {
        container.innerHTML = materials.map(m => {
          let icon = '📦';
          if (m.name.includes('حديد')) icon = '🏗️';
          else if (m.name.includes('أسمنت')) icon = '🧱';
          else if (m.name.includes('رمل')) icon = '⏳';
          else if (m.name.includes('طوب')) icon = '🧱';

          return `
            <div class="material-card">
              <div class="mat-card-head">
                <span class="mat-icon">${icon}</span>
                <span class="mat-unit-pill">الوحدة: ${m.unit}</span>
              </div>
              <h4 class="mat-name">${m.name}</h4>
              <div class="mat-stock-val">${(m.currentStock || 0).toLocaleString('ar-EG')} <span style="font-size: 1rem; color: #475569;">${m.unit}</span></div>
              <p class="mat-notes-sub">${m.notes || 'رصيد الخامة المتاح بالمخزن للاستخدام'}</p>
            </div>
          `;
        }).join('');
      }
    }

    // 2. Populate Materials Select in Movement Modal
    const moveSelect = document.getElementById('inv-modal-material-id');
    if (moveSelect) {
      moveSelect.innerHTML = materials.map(m => `
        <option value="${m.id}">${m.name} (المتاح: ${m.currentStock} ${m.unit})</option>
      `).join('');
    }

    // 3. Inventory Logs Table
    if (logsCountStr) logsCountStr.textContent = `${logs.length} حركة مسجلة`;

    if (logs.length === 0) {
      if (logsTbody) logsTbody.innerHTML = '';
      if (logsEmpty) logsEmpty.style.display = 'block';
    } else {
      if (logsEmpty) logsEmpty.style.display = 'none';
      if (logsTbody) {
        logsTbody.innerHTML = logs.map(l => {
          const isIncoming = l.type === 'in';
          const typeBadge = isIncoming 
            ? '<span class="badge-log-in">📥 توريد للمخزن (In)</span>'
            : '<span class="badge-log-out">📤 سحب للموقع (Out)</span>';

          const dateStr = new Date(l.createdAt).toLocaleDateString('ar-EG', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
          });

          return `
            <tr>
              <td><strong>${l.material ? l.material.name : 'خامة'}</strong></td>
              <td>${typeBadge}</td>
              <td><strong style="color: ${isIncoming ? '#059669' : '#ea580c'}; font-size: 1.05rem;">${isIncoming ? '+' : '-'}${l.quantity} ${l.material?.unit || ''}</strong></td>
              <td>${l.engineerName || 'المهندس المشرف'}</td>
              <td>${l.notes || '-'}</td>
              <td>${dateStr}</td>
            </tr>
          `;
        }).join('');
      }
    }
  }

  // Tab 4: Render Expenses Tab (طلبات الصرف للخزنة)
  function renderExpensesTab() {
    const expenses = constructionData.expenseRequests || [];
    const tbody = document.getElementById('construction-expenses-table-body');
    const emptyBox = document.getElementById('expenses-empty-state');

    const catLabels = {
      materials: 'شراء خامات ومواد',
      contractor: 'دفعة مستخلص مقاول',
      labor: 'أجور وعمالة',
      operational: 'مصاريف موقع وتشغيل',
      other: 'أخرى'
    };

    if (expenses.length === 0) {
      if (tbody) tbody.innerHTML = '';
      if (emptyBox) emptyBox.style.display = 'block';
      return;
    }

    if (emptyBox) emptyBox.style.display = 'none';

    if (tbody) {
      tbody.innerHTML = expenses.map(req => {
        let statusBadge = '<span class="req-status-pill req-pending">🟡 قيد المراجعة</span>';
        if (req.status === 'approved') statusBadge = '<span class="req-status-pill req-approved">🟢 معتمد وتم الصرف</span>';
        else if (req.status === 'rejected') statusBadge = '<span class="req-status-pill req-rejected">🔴 مرفوض</span>';

        const dateStr = new Date(req.createdAt).toLocaleDateString('ar-EG', {
          year: 'numeric',
          month: 'short',
          day: 'numeric'
        });

        return `
          <tr>
            <td>
              <strong>${req.title}</strong>
              ${req.description ? `<br><small style="color: #64748b;">${req.description}</small>` : ''}
            </td>
            <td><span class="specialty-pill">${catLabels[req.category] || req.category}</span></td>
            <td><strong style="font-size: 1.05rem; color: #dc2626;">${(req.amount || 0).toLocaleString('ar-EG')} ج.م</strong></td>
            <td>${req.requesterName || 'مهندس الموقع'}</td>
            <td>${dateStr}</td>
            <td>${statusBadge}</td>
          </tr>
        `;
      }).join('');
    }
  }

  // Tab Switching Logic
  const tabButtons = document.querySelectorAll('.c-tab-btn');
  const panes = document.querySelectorAll('.construction-pane');

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      tabButtons.forEach(b => b.classList.remove('active'));
      panes.forEach(p => p.style.display = 'none');

      btn.classList.add('active');
      const targetPaneId = btn.getAttribute('data-pane');
      const targetPane = document.getElementById(targetPaneId);
      if (targetPane) targetPane.style.display = 'block';
    });
  });

  // Quick Action Button: Switch to Expenses Tab
  document.getElementById('quick-expense-req-btn')?.addEventListener('click', () => {
    document.getElementById('tab-btn-expenses')?.click();
    document.getElementById('expense-req-amount')?.focus();
  });

  // Modal 1: Add Construction Phase
  const addPhaseModal = document.getElementById('add-phase-modal');
  document.getElementById('open-add-phase-btn')?.addEventListener('click', () => {
    if (addPhaseModal) addPhaseModal.style.display = 'flex';
  });
  document.getElementById('close-add-phase-modal')?.addEventListener('click', () => {
    if (addPhaseModal) addPhaseModal.style.display = 'none';
  });
  document.getElementById('cancel-phase-btn')?.addEventListener('click', () => {
    if (addPhaseModal) addPhaseModal.style.display = 'none';
  });

  document.getElementById('add-phase-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const saveBtn = document.getElementById('save-phase-btn');
    if (saveBtn) saveBtn.textContent = 'جارٍ الحفظ...';

    const name = document.getElementById('new-phase-name').value;
    const progress = document.getElementById('new-phase-progress').value;
    const photoUrl = document.getElementById('new-phase-photo').value;
    const notes = document.getElementById('new-phase-notes').value;

    try {
      const res = await fetch('/api/erp/construction', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'add_phase',
          projectId: constructionData.selectedProjectId,
          name,
          progress,
          photoUrl,
          notes
        })
      });

      const data = await res.json();
      if (data.success) {
        if (addPhaseModal) addPhaseModal.style.display = 'none';
        document.getElementById('add-phase-form').reset();
        showToast('تمت إضافة مرحلة البناء الجديدة بنجاح!');
        await loadConstructionData();
      } else {
        showToast(data.error || 'فشلت إضافة المرحلة', false);
      }
    } catch (err) {
      showToast('حدث خطأ في الاتصال بالخادم', false);
    } finally {
      if (saveBtn) saveBtn.textContent = 'حفظ المرحلة';
    }
  });

  // Modal 2: Add Contractor
  const addContractorModal = document.getElementById('add-contractor-modal');
  document.getElementById('open-add-contractor-btn')?.addEventListener('click', () => {
    if (addContractorModal) addContractorModal.style.display = 'flex';
  });
  document.getElementById('close-contractor-modal')?.addEventListener('click', () => {
    if (addContractorModal) addContractorModal.style.display = 'none';
  });
  document.getElementById('cancel-contractor-btn')?.addEventListener('click', () => {
    if (addContractorModal) addContractorModal.style.display = 'none';
  });

  document.getElementById('add-contractor-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const saveBtn = document.getElementById('save-contractor-btn');
    if (saveBtn) saveBtn.textContent = 'جارٍ التسجيل...';

    const name = document.getElementById('new-contractor-name').value;
    const specialty = document.getElementById('new-contractor-specialty').value;
    const phone = document.getElementById('new-contractor-phone').value;
    const contractAmount = document.getElementById('new-contractor-contract').value;
    const paidAmount = document.getElementById('new-contractor-paid').value;

    try {
      const res = await fetch('/api/erp/construction', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'add_contractor',
          projectId: constructionData.selectedProjectId,
          name,
          specialty,
          phone,
          contractAmount,
          paidAmount
        })
      });

      const data = await res.json();
      if (data.success) {
        if (addContractorModal) addContractorModal.style.display = 'none';
        document.getElementById('add-contractor-form').reset();
        showToast('تم تسجيل المقاول بنجاح!');
        await loadConstructionData();
      } else {
        showToast(data.error || 'فشل تسجيل المقاول', false);
      }
    } catch (err) {
      showToast('حدث خطأ في الاتصال بالخادم', false);
    } finally {
      if (saveBtn) saveBtn.textContent = 'تسجيل المقاول';
    }
  });

  // Modal 3: Pay Contractor Installment
  const payModal = document.getElementById('pay-contractor-modal');
