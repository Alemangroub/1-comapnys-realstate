---
import Layout from '../../layouts/Layout.astro';
import AdminLogin from '../../components/AdminLogin.astro';
---

<Layout title="إدارة الإنشاءات والمقاولات | منظومة التطوير العقاري ERP">
  <div class="construction-app-root">
    
    <!-- Auth Loading State -->
    <div id="auth-loading-message" class="loading-state">
      <div class="spinner"></div>
      <p>جارٍ التحقق من صلاحيات إدارة المشروعات والمواقع...</p>
    </div>

    <!-- Auth Login Container -->
    <div id="admin-login-container" style="display: none;">
      <AdminLogin />
    </div>

    <!-- Main Container -->
    <main id="main-content" class="erp-container" style="display: none;">
      
      <!-- Top Navigation Header -->
      <header class="erp-topbar">
        <div class="brand-crumb">
          <a href="/crs" class="back-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
            الرئيسية
          </a>
          <span class="sep">/</span>
          <span class="active-crumb">الإنشاءات، المقاولين، والمخازن</span>
        </div>

        <div class="topbar-actions">
          <button id="quick-expense-req-btn" class="btn btn-warning">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
            + طلب صرف نقدية للخزنة
          </button>
        </div>
      </header>

      <!-- Subsystem Executive Banner -->
      <section class="construction-hero-banner">
        <div class="hero-text-wrap">
          <div class="hero-badge-pill">المتابعة الميدانية والمواقع 🏗️</div>
          <h1>إدارة الإنشاءات، المقاولين، والمخازن</h1>
          <p>متابعة نسب التنفيذ الدقيقة لمراحل البناء، إدارة مستخلصات المقاولين والموردين، رقابة مخزون الحديد والأسمنت اللحظي، وربط طلبات الصرف المالي بالخزينة المركزية.</p>
        </div>
      </section>

      <!-- ========================================================
           القسم العلوي: اختيار المشروع + شريط إجمالي نسبة الإنجاز
           ======================================================== -->
      <section class="project-summary-strip">
        <div class="strip-grid">
          
          <!-- قائمة اختيار المشروع -->
          <div class="project-picker-box">
            <label for="project-select" class="picker-label">
              <span>🏢 المشروع النشط للمتابعة:</span>
            </label>
            <div class="select-wrapper">
              <select id="project-select" class="erp-main-select">
                <option value="">جارٍ تحميل المشاريع...</option>
              </select>
            </div>
          </div>

          <!-- شريط إجمالي نسبة إنجاز المشروع الكلية -->
          <div class="total-progress-box">
            <div class="progress-info-row">
              <span class="prog-title">إجمالي نسبة إنجاز المشروع الكلية:</span>
              <strong class="prog-val" id="total-progress-text">0%</strong>
            </div>
            <div class="progress-bar-track">
              <div class="progress-bar-fill" id="total-progress-bar" style="width: 0%;"></div>
            </div>
            <span class="prog-subtitle">متوسط نسب الإنجاز المئوية لجميع مراحل التنفيذ المعتمدة</span>
          </div>

        </div>
      </section>

      <!-- ========================================================
           أقسام الإنشاءات: 4 تبويبات رئيسية
           ======================================================== -->
      <section class="construction-tabs-section">
        
        <!-- شريط أزرار التبويبات -->
        <div class="construction-tabs-nav">
          <button class="c-tab-btn active" id="tab-btn-phases" data-pane="pane-phases">
            <span class="tab-icon">🏗️</span>
            <span>مراحل البناء والتحديثات</span>
            <span class="tab-badge" id="phases-count-badge">0</span>
          </button>
          
          <button class="c-tab-btn" id="tab-btn-contractors" data-pane="pane-contractors">
            <span class="tab-icon">👷‍♂️</span>
            <span>المقاولين والعقود</span>
            <span class="tab-badge" id="contractors-count-badge">0</span>
          </button>

          <button class="c-tab-btn" id="tab-btn-boq" data-pane="pane-boq">
            <span class="tab-icon">📐</span>
            <span>مقايسة الكميات (BOQ)</span>
            <span class="tab-badge" id="boq-count-badge">0</span>
          </button>

          <button class="c-tab-btn" id="tab-btn-invoices" data-pane="pane-invoices">
            <span class="tab-icon">📑</span>
            <span>المستخلصات والاستقطاعات</span>
            <span class="tab-badge" id="invoices-count-badge">0</span>
          </button>

          <button class="c-tab-btn" id="tab-btn-inventory" data-pane="pane-inventory">
            <span class="tab-icon">📦</span>
            <span>المخازن والخامات</span>
            <span class="tab-badge" id="materials-count-badge">0</span>
          </button>

          <button class="c-tab-btn" id="tab-btn-inspections" data-pane="pane-inspections">
            <span class="tab-icon">🔑</span>
            <span>الفحص والتسليم (Snagging)</span>
            <span class="tab-badge" id="inspections-count-badge">0</span>
          </button>
          
          <button class="c-tab-btn" id="tab-btn-expenses" data-pane="pane-expenses">
            <span class="tab-icon">💵</span>
            <span>طلب صرف نقدية للخزنة</span>
          </button>
        </div>

        <!-- ========================================================
             تبويب 1: مراحل البناء والتحديثات (Phases)
             ======================================================== -->
        <div id="pane-phases" class="construction-pane active">
          <div class="pane-action-bar">
            <div>
              <h3>مراحل تنفيذ المشروع ونسب الإنجاز الفعلية</h3>
              <p>قم بسحب شريط النسبة (Slider) للمرحلة وتحديث صورتها الميدانية لتوثيق تقدم البناء</p>
            </div>
            <button id="open-add-phase-btn" class="btn btn-primary">
              + إضافة مرحلة بناء جديدة
            </button>
          </div>

          <div class="phases-cards-grid" id="phases-container">
            <!-- Rendered dynamically via JavaScript -->
          </div>

          <div id="phases-empty-state" class="empty-notice-box" style="display: none;">
            <p>لا توجد مراحل بناء مسجلة لهذا المشروع بعد. اضغط على "+ إضافة مرحلة بناء جديدة" للبدء.</p>
          </div>
        </div>

        <!-- ========================================================
             تبويب 2: المقاولين والمستخلصات (Contractors)
             ======================================================== -->
        <div id="pane-contractors" class="construction-pane" style="display: none;">
          <div class="pane-action-bar">
            <div>
              <h3>دليل المقاولين والموردين ومستخلصاتهم</h3>
              <p>متابعة التزامات العقود والمبالغ المدفوعة والمتبقية لكل مقاول بالمشروع</p>
            </div>
            <button id="open-add-contractor-btn" class="btn btn-primary">
              + إضافة مقاول جديد
            </button>
          </div>

          <div class="table-card">
            <div class="table-responsive">
              <table class="erp-table">
                <thead>
                  <tr>
                    <th>اسم المقاول / الشركة</th>
                    <th>التخصص</th>
                    <th>رقم الهاتف</th>
                    <th>إجمالي قيمة العقد</th>
                    <th>المدفوع حتى الآن</th>
                    <th>المتبقي المستحق</th>
                    <th>إجراءات</th>
                  </tr>
                </thead>
                <tbody id="contractors-table-body">
                  <!-- Rendered dynamically via JavaScript -->
                </tbody>
              </table>
            </div>

            <div id="contractors-empty-state" class="empty-notice-box" style="display: none;">
              <p>لا يوجد مقاولين مسجلين لهذا المشروع بعد.</p>
            </div>
          </div>
        </div>

        <!-- ========================================================
             تبويب 3: المخازن والخامات (Inventory)
             ======================================================== -->
        <div id="pane-inventory" class="construction-pane" style="display: none;">
          
          <div class="pane-action-bar">
            <div>
              <h3>أرصدة الخامات ومواد البناء بالموقع</h3>
              <p>جرد كميات الحديد والأسمنت والرمال والطوب المسجلة وحركات الوارد والمنصرف</p>
            </div>
            <div class="action-buttons-wrap">
              <button id="open-material-in-btn" class="btn btn-success">
                + توريد خامة للمخزن (In)
              </button>
              <button id="open-material-out-btn" class="btn btn-warning">
                - سحب خامة للموقع (Out)
              </button>
              <button id="open-add-material-btn" class="btn btn-secondary">
                + تعريف خامة جديدة
              </button>
            </div>
          </div>

          <!-- بطاقات أرصدة الخامات -->
          <div class="materials-stocks-grid" id="materials-container">
            <!-- Rendered dynamically via JavaScript -->
          </div>

          <div id="materials-empty-state" class="empty-notice-box" style="display: none;">
            <p>لا توجد خامات مسجلة بمخزن هذا المشروع حالياً.</p>
          </div>

          <!-- جدول سجل حركات المخزن -->
          <div class="inventory-logs-section">
            <div class="logs-header">
              <h4>سجل حركات المخزن الأخيرة (التوريد والاستهلاك الميداني)</h4>
              <span class="sub-counter" id="logs-count-str">0 حركة مسجلة</span>
            </div>

            <div class="table-card">
              <div class="table-responsive">
                <table class="erp-table">
                  <thead>
                    <tr>
                      <th>الخامة</th>
                      <th>نوع الحركة</th>
                      <th>الكمية</th>
                      <th>اسم المهندس</th>
                      <th>البيان والملاحظات</th>
                      <th>تاريخ ووقت الحركة</th>
                    </tr>
                  </thead>
                  <tbody id="inventory-logs-table-body">
                    <!-- Rendered dynamically via JavaScript -->
                  </tbody>
                </table>
              </div>
              <div id="logs-empty-state" class="empty-notice-box" style="display: none;">
                <p>لا توجد حركات توريد أو سحب مسجلة في هذا المخزن بعد.</p>
              </div>
            </div>
          </div>

        </div>

        <!-- ========================================================
             تبويب 4: طلب صرف نقدية للخزنة (Expense Request)
             ======================================================== -->
        <div id="pane-expenses" class="construction-pane" style="display: none;">
          
          <div class="expense-form-container">
            <div class="expense-form-card">
              <div class="form-card-head">
                <div class="pod-icon">💵</div>
                <div>
                  <h3>رفع طلب صرف نقدية إلى الخزينة المركزية</h3>
                  <p>سيتم إدراج هذا الطلب مباشرة بحالة "قيد المراجعة" للمحاسب والمدير المالي في قسم الخزنة لاعتماده وصرفه</p>
                </div>
              </div>

              <form id="construction-expense-form" class="erp-compact-form">
                
                <div class="form-row">
                  <div class="form-group">
                    <label>المشروع المرتبط بالصرف *</label>
                    <input type="text" id="expense-project-name" readonly class="input-readonly" value="-" />
                  </div>

                  <div class="form-group">
                    <label>المبلغ المطلوب صرفه (جنيه مصري) *</label>
                    <input type="number" id="expense-req-amount" min="1" step="any" placeholder="مثال: 50000" required />
                  </div>
                </div>

                <div class="form-row">
                  <div class="form-group">
                    <label>تصنيف / سبب الصرف *</label>
                    <select id="expense-req-category" required>
                      <option value="materials">شراء خامات ومواد بناء (حديد / أسمنت / خرسانة)</option>
                      <option value="contractor">دفعة تحت حساب مقاول / مستخلص أعمال</option>
                      <option value="labor">أجور ومصنعيات عمالة يومية</option>
                      <option value="operational">مصاريف حفر، نقل تربة ومعدات موقع</option>
                      <option value="other">مصاريف نثرية وطارئة بالموقع</option>
                    </select>
                  </div>

                  <div class="form-group">
                    <label>اسم المهندس مقدم الطلب *</label>
                    <input type="text" id="expense-req-requester" placeholder="اسم المهندس المشرف بالموقع" required />
                  </div>
                </div>

                <div class="form-group">
                  <label>عنوان / سبب الصرف الرئيسي *</label>
                  <input type="text" id="expense-req-title" placeholder="مثال: شراء 10 طن حديد تسليح عز لمرحلة القواعد" required />
                </div>

                <div class="form-group">
                  <label>شرح وتفاصيل إضافية (اختياري)</label>
                  <textarea id="expense-req-desc" rows="3" placeholder="اكتب تفاصيل إضافية عن الحاجة للصرف، أرقام الفواتير، أو اسم المقاول المستفيد..."></textarea>
                </div>

                <div class="form-submit-row">
                  <button type="submit" class="btn btn-warning btn-lg" id="submit-expense-req-btn">
                    <span>🚀 إرسال الطلب للخزنة للاعتماد والصرف</span>
                  </button>
                </div>
              </form>
            </div>
          </div>

          <!-- جدول طلبات الصرف السابقة للمشروع -->
          <div class="project-past-expenses">
            <div class="pane-action-bar">
              <div>
                <h4>سجل طلبات الصرف المالي الخاصة بقسم الإنشاءات</h4>
                <p>متابعة حالة اعتماد وصرف الطلبات المحولة للخزينة المركزية</p>
              </div>
            </div>

            <div class="table-card">
              <div class="table-responsive">
                <table class="erp-table">
                  <thead>
                    <tr>
                      <th>سبب الصرف / العنوان</th>
                      <th>التصنيف</th>
                      <th>المبلغ المطلوب</th>
                      <th>مقدم الطلب</th>
                      <th>تاريخ الطلب</th>
                      <th>الحالة في الخزينة</th>
                    </tr>
                  </thead>
                  <tbody id="construction-expenses-table-body">
                    <!-- Rendered dynamically via JavaScript -->
                  </tbody>
                </table>
              </div>
              <div id="expenses-empty-state" class="empty-notice-box" style="display: none;">
                <p>لا توجد طلبات صرف مرسلة من هذا المشروع حتى الآن.</p>
              </div>
            </div>
          </div>

        </div>

        <!-- ========================================================
             تبويب 5: مقايسة بنود الأعمال وجداول الكميات (BOQ)
             ======================================================== -->
        <div id="pane-boq" class="construction-pane" style="display: none;">
          <div class="kpi-boq-strip" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
            <div class="kpi-card" style="background: white; border: 1.5px solid #e2e8f0; border-radius: 16px; padding: 1.25rem; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
              <span style="font-size: 0.82rem; font-weight: 700; color: #64748b;">إجمالي ميزانية المقايسة المعتمدة (Budget)</span>
              <strong id="boq-total-budget" style="display: block; font-size: 1.45rem; font-weight: 900; color: #0284c7; margin-top: 0.25rem;">0 ج.م</strong>
            </div>
            <div class="kpi-card" style="background: white; border: 1.5px solid #e2e8f0; border-radius: 16px; padding: 1.25rem; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
              <span style="font-size: 0.82rem; font-weight: 700; color: #64748b;">إجمالي المنصرف الفعلي حتى الآن</span>
              <strong id="boq-total-spent" style="display: block; font-size: 1.45rem; font-weight: 900; color: #d97706; margin-top: 0.25rem;">0 ج.م</strong>
            </div>
            <div class="kpi-card" style="background: white; border: 1.5px solid #e2e8f0; border-radius: 16px; padding: 1.25rem; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
              <span style="font-size: 0.82rem; font-weight: 700; color: #64748b;">انحراف التكلفة والمتبقي (Cost Variance)</span>
              <strong id="boq-variance" style="display: block; font-size: 1.45rem; font-weight: 900; color: #059669; margin-top: 0.25rem;">0 ج.م</strong>
            </div>
          </div>

          <div class="pane-action-bar">
            <div>
              <h3>جدول كميات وبنود الأعمال الإنشائية (Bill of Quantities)</h3>
              <p>رصد ومقارنة تكلفة كل بند هندسي بالميزانية التقديرية المعتمدة واكتشاف أي انحراف مالي مبكراً</p>
            </div>
            <button id="open-add-boq-btn" class="btn btn-primary">
              + إضافة بند مقايسة جديد
            </button>
          </div>

          <div class="table-card">
            <div class="table-responsive">
              <table class="erp-table">
                <thead>
                  <tr>
                    <th>كود البند</th>
                    <th>التصنيف</th>
                    <th>بيان ووصف البند</th>
                    <th>الوحدة</th>
                    <th>الكمية التقديرية</th>
                    <th>سعر الوحدة</th>
                    <th>الميزانية المعتمدة</th>
                    <th>المنصرف الفعلي</th>
                    <th>الانحراف والحالة</th>
                    <th>الإجراء</th>
                  </tr>
                </thead>
                <tbody id="boq-table-body">
                  <!-- Rendered dynamically -->
                </tbody>
              </table>
            </div>
            <div id="boq-empty-state" class="empty-notice-box" style="display: none;">
              <p>لا توجد بنود مقايسة مسجلة لهذا المشروع بعد. اضغط على "+ إضافة بند مقايسة جديد" لإدخال المقايسة.</p>
            </div>
          </div>
        </div>

        <!-- ========================================================
             تبويب 6: المستخلصات الهندسية والاستقطاعات (Contractor Invoices)
             ======================================================== -->
        <div id="pane-invoices" class="construction-pane" style="display: none;">
          <div class="kpi-invoices-strip" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
            <div class="kpi-card" style="background: white; border: 1.5px solid #e2e8f0; border-radius: 16px; padding: 1.25rem; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
              <span style="font-size: 0.82rem; font-weight: 700; color: #64748b;">إجمالي الأعمال المنفذة (Gross)</span>
              <strong id="inv-total-gross" style="display: block; font-size: 1.45rem; font-weight: 900; color: #1e293b; margin-top: 0.25rem;">0 ج.م</strong>
            </div>
            <div class="kpi-card" style="background: white; border: 1.5px solid #e2e8f0; border-radius: 16px; padding: 1.25rem; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
              <span style="font-size: 0.82rem; font-weight: 700; color: #64748b;">تأمينات أعمال محتجزة (Retention 5%)</span>
              <strong id="inv-total-retention" style="display: block; font-size: 1.45rem; font-weight: 900; color: #d97706; margin-top: 0.25rem;">0 ج.م</strong>
            </div>
            <div class="kpi-card" style="background: white; border: 1.5px solid #e2e8f0; border-radius: 16px; padding: 1.25rem; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
              <span style="font-size: 0.82rem; font-weight: 700; color: #64748b;">استقطاعات دفعات وضرائب</span>
              <strong id="inv-total-deductions" style="display: block; font-size: 1.45rem; font-weight: 900; color: #ef4444; margin-top: 0.25rem;">0 ج.م</strong>
            </div>
            <div class="kpi-card" style="background: white; border: 1.5px solid #e2e8f0; border-radius: 16px; padding: 1.25rem; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
              <span style="font-size: 0.82rem; font-weight: 700; color: #64748b;">صافي المبالغ المستحقة للصرف (Net)</span>
              <strong id="inv-total-net" style="display: block; font-size: 1.45rem; font-weight: 900; color: #059669; margin-top: 0.25rem;">0 ج.م</strong>
            </div>
          </div>

          <div class="pane-action-bar">
            <div>
              <h3>سجل المستخلصات الهندسية والاستقطاعات المالية للمقاولين</h3>
              <p>تطبيق استقطاعات تأمين الأعمال (Retention) واستهلاك الدفعات المقدمة والاعتماد الاستشاري قبل الصرف من الخزينة</p>
            </div>
            <button id="open-create-invoice-btn" class="btn btn-primary">
              + إصدار مستخلص هندسي جديد
            </button>
          </div>

          <div class="table-card">
            <div class="table-responsive">
              <table class="erp-table">
                <thead>
                  <tr>
                    <th>رقم المستخلص</th>
                    <th>المقاول والتخصص</th>
                    <th>بيان الأعمال المنفذة</th>
                    <th>إجمالي الأعمال (Gross)</th>
                    <th>تأمين الأعمال (5%)</th>
                    <th>استقطاعات أخرى</th>
