  // =========================================================
  // BOQ Tab (مقايسة الكميات ومراقبة التكاليف)
  // =========================================================
  function renderBoqTab() {
    const items = constructionData.boqItems || [];
    const totalBudget = constructionData.totalBoqBudget || 0;
    const totalSpent = constructionData.totalBoqSpent || 0;
    const variance = constructionData.boqVariance || 0;

    const badge = document.getElementById('boq-count-badge');
    if (badge) badge.textContent = items.length;

    const elBudget = document.getElementById('boq-total-budget');
    if (elBudget) elBudget.textContent = `${totalBudget.toLocaleString()} ج.م`;

    const elSpent = document.getElementById('boq-total-spent');
    if (elSpent) elSpent.textContent = `${totalSpent.toLocaleString()} ج.م`;

    const elVar = document.getElementById('boq-variance');
    if (elVar) {
      const isPositive = variance >= 0;
      elVar.textContent = `${Math.abs(variance).toLocaleString()} ج.م (${isPositive ? 'وفر بالميزانية' : 'عجز / تجاوز ⚠️'})`;
      elVar.style.color = isPositive ? '#059669' : '#dc2626';
    }

    const tbody = document.getElementById('boq-table-body');
    const emptyBox = document.getElementById('boq-empty-state');
    if (items.length === 0) {
      if (tbody) tbody.innerHTML = '';
      if (emptyBox) emptyBox.style.display = 'block';
      return;
    }

    if (emptyBox) emptyBox.style.display = 'none';
    if (tbody) {
      const catLabels = {
        earthworks: 'أعمال ترابية',
        concrete: 'خرسانات',
        masonry: 'مباني',
        finishes: 'تشطيبات',
        mep: 'كهروميكانيك MEP',
        other: 'أخرى'
      };

      tbody.innerHTML = items.map(item => {
        const budget = item.totalBudget || 0;
        const spent = item.actualCostSpent || 0;
        const isOver = spent > budget;
        const pct = budget > 0 ? Math.round((spent / budget) * 100) : 0;

        return `
          <tr>
            <td><strong style="font-family: monospace; color: #0284c7;">${item.itemCode}</strong></td>
            <td><span class="specialty-pill">${catLabels[item.category] || item.category}</span></td>
            <td><strong>${item.description}</strong></td>
            <td>${item.unit}</td>
            <td>${(item.estimatedQty || 0).toLocaleString()}</td>
            <td>${(item.unitCost || 0).toLocaleString()} ج.م</td>
            <td><strong style="color: #0284c7;">${budget.toLocaleString()} ج.م</strong></td>
            <td><strong style="color: ${isOver ? '#dc2626' : '#d97706'};">${spent.toLocaleString()} ج.م</strong></td>
            <td>
              <span class="status-badge" style="background: ${isOver ? '#fee2e2' : '#ecfdf5'}; color: ${isOver ? '#991b1b' : '#065f46'}; font-weight: 800;">
                ${isOver ? `⚠️ تجاوز (${pct}%)` : `✅ ضمن الميزانية (${pct}%)`}
              </span>
            </td>
            <td>
              <button class="btn btn-sm btn-outline open-update-boq-btn" data-id="${item.id}" data-code="${item.itemCode}" data-desc="${item.description}">
                + تسجيل منصرف
              </button>
            </td>
          </tr>
        `;
      }).join('');

      document.querySelectorAll('.open-update-boq-btn').forEach(btn => {
        btn.onclick = (e) => {
          const id = e.currentTarget.getAttribute('data-id');
          const code = e.currentTarget.getAttribute('data-code');
          const desc = e.currentTarget.getAttribute('data-desc');

          document.getElementById('update-boq-id').value = id;
          document.getElementById('update-boq-item-info').textContent = `بند: ${code} - ${desc}`;
          document.getElementById('update-boq-modal').style.display = 'flex';
        };
      });
    }
  }

