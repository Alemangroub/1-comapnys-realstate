  // =========================================================
  // Invoices Tab (المستخلصات الهندسية والاستقطاعات)
  // =========================================================
  function renderInvoicesTab() {
    const invoices = constructionData.contractorInvoices || [];
    const badge = document.getElementById('invoices-count-badge');
    if (badge) badge.textContent = invoices.length;

    let totalGross = 0;
    let totalRetention = 0;
    let totalDeductions = 0;
    let totalNet = 0;

    invoices.forEach(inv => {
      totalGross += (inv.grossAmount || 0);
      totalRetention += (inv.retentionAmount || 0);
      totalDeductions += ((inv.advanceDeducted || 0) + (inv.taxDeducted || 0));
      totalNet += (inv.netAmountPayable || inv.amount || 0);
    });

    const elGross = document.getElementById('inv-total-gross');
    if (elGross) elGross.textContent = `${totalGross.toLocaleString()} ج.م`;

    const elRet = document.getElementById('inv-total-retention');
    if (elRet) elRet.textContent = `${totalRetention.toLocaleString()} ج.م`;

    const elDed = document.getElementById('inv-total-deductions');
    if (elDed) elDed.textContent = `${totalDeductions.toLocaleString()} ج.م`;

    const elNet = document.getElementById('inv-total-net');
    if (elNet) elNet.textContent = `${totalNet.toLocaleString()} ج.م`;

    // Populate contractor select in create invoice modal
    const contSelect = document.getElementById('inv-contractor-select');
    if (contSelect && constructionData.contractors) {
      contSelect.innerHTML = '<option value="">-- اختر المقاول --</option>' +
        constructionData.contractors.map(c => `
          <option value="${c.id}">${c.name} (${c.specialty})</option>
        `).join('');
    }

    const tbody = document.getElementById('invoices-table-body');
    const emptyBox = document.getElementById('invoices-empty-state');
    if (invoices.length === 0) {
      if (tbody) tbody.innerHTML = '';
      if (emptyBox) emptyBox.style.display = 'block';
      return;
    }

    if (emptyBox) emptyBox.style.display = 'none';
    if (tbody) {
      tbody.innerHTML = invoices.map(inv => {
        const gross = inv.grossAmount || 0;
        const ret = inv.retentionAmount || 0;
        const otherDed = (inv.advanceDeducted || 0) + (inv.taxDeducted || 0);
        const net = inv.netAmountPayable || inv.amount || 0;
        const isApproved = inv.consultantApproval;
        const isPaid = inv.status === 'paid';

        return `
          <tr>
            <td><strong style="color: #0284c7;">${inv.invoiceNumber}</strong></td>
            <td>
              <strong>${inv.contractor?.name || 'مقاول'}</strong>
              <br><small style="color: #64748b;">${inv.contractor?.specialty || ''}</small>
            </td>
            <td>${inv.stageDescription}</td>
            <td><strong>${gross.toLocaleString()} ج.م</strong></td>
            <td><span style="color: #d97706; font-weight: 700;">-${ret.toLocaleString()} ج.م</span></td>
            <td><span style="color: #ef4444; font-weight: 700;">-${otherDed.toLocaleString()} ج.م</span></td>
            <td><strong style="color: #059669; font-size: 1.05rem;">${net.toLocaleString()} ج.م</strong></td>
            <td>
              ${isApproved ? `
                <span class="status-badge" style="background: #ecfdf5; color: #047857; font-weight: 800;">معتمد ✅</span>
              ` : `
                <button class="btn btn-sm btn-outline btn-approve-inv" data-id="${inv.id}">
                  اعتماد الاستشاري ⏳
                </button>
              `}
            </td>
            <td>
              <span class="status-badge ${isPaid ? 'badge-paid' : inv.status === 'approved' ? 'badge-safe' : 'badge-pending'}">
                ${isPaid ? 'تم الصرف 💵' : inv.status === 'approved' ? 'معتمد للصرف' : 'قيد المراجعة'}
              </span>
            </td>
            <td>
              ${isPaid ? `
                <small style="color: #64748b;">إيصال: ${inv.receiptNumber || 'نظامي'}</small>
              ` : isApproved ? `
                <button class="btn btn-sm btn-success btn-pay-inv" data-id="${inv.id}">
                  صرف من الخزينة 💳
                </button>
              ` : `
                <span style="color: #94a3b8; font-size: 0.8rem;">يتطلب الاعتماد أولاً</span>
              `}
            </td>
          </tr>
        `;
      }).join('');

      // Attach events for invoice approvals & payouts
      document.querySelectorAll('.btn-approve-inv').forEach(btn => {
        btn.onclick = async (e) => {
          const id = e.currentTarget.getAttribute('data-id');
          if (!confirm('هل توافق على اعتماد الاستشاري الهندسي لهذا المستخلص وجاهزيته للصرف؟')) return;

          try {
            const res = await fetch('/api/erp/construction', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'approve_contractor_invoice', invoiceId: id })
            });
            const data = await res.json();
            if (data.success) {
              showToast('تم اعتماد المستخلص بنجاح!');
              await loadConstructionData();
            } else {
              showToast(data.error || 'فشل الاعتماد', false);
            }
          } catch (err) {
            showToast('خطأ في الاتصال', false);
          }
        };
      });

      document.querySelectorAll('.btn-pay-inv').forEach(btn => {
        btn.onclick = async (e) => {
          const id = e.currentTarget.getAttribute('data-id');
          if (!confirm('تأكيد صرف المستخلص الآن من الخزينة وتسجيل حركة مصروف وخصمها من رصيد المقاول؟')) return;

          try {
            const res = await fetch('/api/erp/construction', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'pay_contractor_invoice', invoiceId: id })
            });
            const data = await res.json();
            if (data.success) {
              showToast(`تم صرف المستخلص بنجاح! رقم الإيصال: ${data.receiptNumber}`);
              await loadConstructionData();
            } else {
              showToast(data.error || 'فشل الصرف', false);
            }
          } catch (err) {
            showToast('خطأ في الاتصال', false);
          }
        };
      });
    }
  }

  // Invoice Calculator live updates
  const calcInvoiceNet = () => {
    const gross = parseFloat(document.getElementById('inv-gross-amount')?.value || 0);
    const retRate = parseFloat(document.getElementById('inv-retention-rate')?.value || 5);
    const adv = parseFloat(document.getElementById('inv-advance-deducted')?.value || 0);
    const tax = parseFloat(document.getElementById('inv-tax-deducted')?.value || 0);

    const retAmount = Math.round((gross * (retRate / 100)) * 100) / 100;
    const net = Math.max(0, Math.round((gross - retAmount - adv - tax) * 100) / 100);

    const netEl = document.getElementById('inv-net-preview');
    if (netEl) netEl.textContent = `${net.toLocaleString()} ج.م`;

    const retEl = document.getElementById('inv-ret-amount-preview');
    if (retEl) retEl.textContent = `${retAmount.toLocaleString()} ج.م (${retRate}%)`;
  };

  document.getElementById('inv-gross-amount')?.addEventListener('input', calcInvoiceNet);
  document.getElementById('inv-retention-rate')?.addEventListener('input', calcInvoiceNet);
  document.getElementById('inv-advance-deducted')?.addEventListener('input', calcInvoiceNet);
  document.getElementById('inv-tax-deducted')?.addEventListener('input', calcInvoiceNet);

