    border-radius: 12px;
    padding: 0.85rem 1rem;
    border: 1px solid #e2e8f0;
  }
  .limit-lbl { font-size: 0.75rem; color: #64748b; font-weight: 700; display: block; }
  .limit-val { font-size: 1.2rem; font-weight: 900; color: #0f172a; display: block; margin-top: 0.2rem; }

  .tier-permissions-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    font-size: 0.84rem;
    color: #334155;
    font-weight: 600;
  }
</style>

<script>
  import { checkAuth, logout, getAuthHeaders } from '../../lib/auth.js';

  let adminUser = null;
  let allUsers = [];
  let usersCache = {};
  let currentFilter = 'all';
  let searchQuery = '';

  document.addEventListener('DOMContentLoaded', async () => {
    const authLoadingMessage = document.getElementById('auth-loading-message');
    const loginContainer = document.getElementById('admin-login-container');
    const pageContent = document.getElementById('page-content');

    try {
      const user = await checkAuth();
      if (authLoadingMessage) authLoadingMessage.style.display = 'none';

      if (user && user.role === 'admin') {
        adminUser = user;
        if (pageContent) pageContent.style.display = 'block';
        if (loginContainer) loginContainer.style.display = 'none';

        const logoutButton = document.getElementById('logout-button');
        if (logoutButton) {
          logoutButton.addEventListener('click', async () => { await logout(); });
        }

        initializePage();
      } else {
        if (pageContent) pageContent.style.display = 'none';
        if (loginContainer) loginContainer.style.display = 'block';
      }
    } catch (e) {
      if (authLoadingMessage) authLoadingMessage.style.display = 'none';
      if (loginContainer) loginContainer.style.display = 'block';
    }
  });

  function updateMetrics(users) {
    const totalElem = document.getElementById('stat-total-users');
    const salesElem = document.getElementById('stat-sales-users');
    const accElem = document.getElementById('stat-accountant-users');
    const supElem = document.getElementById('stat-supervisor-users');

    if (totalElem) totalElem.textContent = users.length;
    if (salesElem) salesElem.textContent = users.filter(u => u.role === 'sales').length;
    if (accElem) accElem.textContent = users.filter(u => u.role === 'accountant').length;
    if (supElem) supElem.textContent = users.filter(u => u.role === 'supervisor' || u.role === 'engineer').length;
  }

  function renderFilteredUsers() {
    const usersList = document.getElementById('users-list');
    const noUsersMessage = document.getElementById('no-users-message');

    let filtered = allUsers.filter(u => u.id !== adminUser?.userId);

    // Filter by role
    if (currentFilter !== 'all') {
      filtered = filtered.filter(u => u.role === currentFilter);
    }

    // Filter by search query
    if (searchQuery.trim()) {
      const q = searchQuery.toLowerCase();
      filtered = filtered.filter(u => 
        (u.name && u.name.toLowerCase().includes(q)) || 
        (u.email && u.email.toLowerCase().includes(q))
      );
    }

    if (filtered.length === 0) {
      if (noUsersMessage) {
        noUsersMessage.style.display = 'flex';
        noUsersMessage.querySelector('h3').textContent = 'لا توجد نتائج مطابقة للبحث';
        noUsersMessage.querySelector('p').textContent = 'جرّب تغيير عبارة البحث أو اختيار صلاحية أخرى';
      }
      usersList.innerHTML = '';
      return;
    }

    if (noUsersMessage) noUsersMessage.style.display = 'none';

    usersList.innerHTML = filtered.map(user => {
      const initial = user.name ? user.name.charAt(0).toUpperCase() : '?';
      const role = user.role || 'N/A';

      const roleConfig = {
        sales: { label: 'مسؤول مبيعات (Sales)', tagClass: 'tag-sales', avatarClass: 'avatar-sales' },
        accountant: { label: 'محاسب / تحصيل (Accountant)', tagClass: 'tag-accountant', avatarClass: 'avatar-accountant' },
        supervisor: { label: 'مشرف ميداني / مهندس', tagClass: 'tag-supervisor', avatarClass: 'avatar-supervisor' },
        admin: { label: 'مالك / مدير عام (Admin)', tagClass: 'tag-admin', avatarClass: 'avatar-admin' },
      }[role] || { label: role, tagClass: 'tag-default', avatarClass: 'avatar-default' };

      return `
        <div class="user-card-luxury" data-id="${user.id}">
          <div class="card-top-row">
            <div class="user-avatar-pod ${roleConfig.avatarClass}">${initial}</div>
            <div class="user-primary-info">
              <h3 title="${user.name}">${user.name}</h3>
              <p title="${user.email || '-'}">${user.email || '-'}</p>
            </div>
          </div>

          <div class="card-role-section">
            <span class="role-indicator-tag ${roleConfig.tagClass}">
              ${roleConfig.label}
            </span>
            <span class="status-live-dot">
              <span class="live-dot"></span>
              نشط
            </span>
          </div>

          <div class="card-action-btns">
            <button type="button" class="btn-card-edit edit-btn" title="تعديل المستخدم">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
              <span>تعديل</span>
            </button>
            <button type="button" class="btn-card-delete delete-btn" title="حذف المستخدم">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              <span>حذف</span>
            </button>
          </div>
        </div>
      `;
    }).join('');
  }

  async function fetchAndRenderUsers() {
    const noUsersMessage = document.getElementById('no-users-message');
    try {
      const response = await fetch('/api/users/list', { headers: getAuthHeaders() });
      const users = await response.json();
      allUsers = users;
      usersCache = {};
      users.forEach(u => { usersCache[u.id] = u; });

      updateMetrics(users);
      renderFilteredUsers();
    } catch (error) {
      console.error("Error fetching users:", error);
      if (noUsersMessage) {
        noUsersMessage.style.display = 'flex';
        noUsersMessage.querySelector('h3').textContent = 'حدث خطأ أثناء تحميل المستخدمين';
      }
    }
  }

  function initializePage() {
    const addUserForm = document.getElementById('add-user-form');
    const addUserBtn = document.getElementById('add-user-btn');
    const feedbackMessage = document.getElementById('add-user-feedback');
    const usersList = document.getElementById('users-list');
    const searchInput = document.getElementById('user-search-input');
    const filterPills = document.querySelectorAll('.filter-pill');

    const deleteModal = document.getElementById('delete-confirm-modal');
    const modalConfirmBtn = document.getElementById('modal-confirm-btn');
    const modalCancelBtn = document.getElementById('modal-cancel-btn');
    let userIdToDelete = null;

    const editModal = document.getElementById('edit-user-modal');
    const editForm = document.getElementById('edit-user-form');
    const editCancelBtn = document.getElementById('edit-modal-cancel-btn');
    const editXBtn = document.getElementById('edit-modal-x-btn');
    const editSaveBtn = document.getElementById('edit-modal-save-btn');
    const editFeedback = document.getElementById('edit-user-feedback');

    // Search Input Listener
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value;
        renderFilteredUsers();
      });
    }

    // Role Filter Pills
    filterPills.forEach(pill => {
      pill.addEventListener('click', () => {
        filterPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        currentFilter = pill.dataset.role;
        renderFilteredUsers();
      });
    });

    // Add User Form Submission
    addUserForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      addUserBtn.disabled = true;
      feedbackMessage.style.display = 'none';

      const name = document.getElementById('user-name').value;
      const email = document.getElementById('user-email').value;
      const password = document.getElementById('user-password').value;
      const role = document.getElementById('user-role').value;

      try {
        const res = await fetch('/api/users/create', {
          method: 'POST',
          headers: getAuthHeaders({ 'Content-Type': 'application/json' }),
          body: JSON.stringify({ name, email, password, role })
        });
        const result = await res.json();

        if (res.ok) {
          feedbackMessage.textContent = '✓ تم إنشاء وتفعيل حساب المستخدم بنجاح!';
          feedbackMessage.className = 'feedback-banner success';
          feedbackMessage.style.display = 'block';
          addUserForm.reset();
          fetchAndRenderUsers();
        } else {
          feedbackMessage.textContent = result.error || 'فشل إنشاء المستخدم.';
          feedbackMessage.className = 'feedback-banner error';
          feedbackMessage.style.display = 'block';
        }
      } catch (err) {
        feedbackMessage.textContent = 'حدث خطأ في الاتصال بالخادم.';
        feedbackMessage.className = 'feedback-banner error';
        feedbackMessage.style.display = 'block';
      } finally {
        addUserBtn.disabled = false;
        setTimeout(() => { feedbackMessage.style.display = 'none'; }, 6000);
      }
    });

    fetchAndRenderUsers();

    // User Cards Click Delegation (Edit / Delete)
    usersList.addEventListener('click', (e) => {
      const deleteBtn = e.target.closest('.delete-btn');
      if (deleteBtn) {
        userIdToDelete = deleteBtn.closest('.user-card-luxury').dataset.id;
        deleteModal.style.display = 'flex';
      }

      const editBtn = e.target.closest('.edit-btn');
      if (editBtn) {
        const userId = editBtn.closest('.user-card-luxury').dataset.id;
        const userData = usersCache[userId];
        if (userData) {
          document.getElementById('edit-user-id').value = userId;
          document.getElementById('edit-user-name').value = userData.name;
          document.getElementById('edit-user-email').value = userData.email || '';
          document.getElementById('edit-user-role').value = userData.role;
          document.getElementById('edit-user-password').value = '';
          editFeedback.style.display = 'none';
          editModal.style.display = 'flex';
        }
      }
    });

    // Modal Close Triggers
    const closeEdit = () => { editModal.style.display = 'none'; };
    if (editCancelBtn) editCancelBtn.addEventListener('click', closeEdit);
    if (editXBtn) editXBtn.addEventListener('click', closeEdit);

    if (modalCancelBtn) {
      modalCancelBtn.addEventListener('click', () => {
        deleteModal.style.display = 'none';
        userIdToDelete = null;
      });
    }

    // Confirm Delete
    modalConfirmBtn.addEventListener('click', async () => {
      if (!userIdToDelete) return;
      modalConfirmBtn.disabled = true;
      modalConfirmBtn.textContent = 'جاري الحذف...';

      try {
        const res = await fetch('/api/users/delete', {
          method: 'POST',
          headers: getAuthHeaders({ 'Content-Type': 'application/json' }),
          body: JSON.stringify({ id: userIdToDelete })
        });
        if (res.ok) {
          fetchAndRenderUsers();
        } else {
          const r = await res.json();
          alert('فشل الحذف: ' + r.error);
        }
      } catch (err) {
        alert('حدث خطأ: ' + err.message);
      } finally {
        deleteModal.style.display = 'none';
        modalConfirmBtn.disabled = false;
        modalConfirmBtn.textContent = 'تأكيد الحذف النهائي';
        userIdToDelete = null;
      }
    });

    // Save Edit Form
    editForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      editSaveBtn.disabled = true;
      editFeedback.style.display = 'none';

      const id = document.getElementById('edit-user-id').value;
      const name = document.getElementById('edit-user-name').value;
      const email = document.getElementById('edit-user-email').value;
      const role = document.getElementById('edit-user-role').value;
      const password = document.getElementById('edit-user-password').value;

      const payload = { id, name, email, role };
      if (password) payload.password = password;

      try {
        const res = await fetch('/api/users/update', {
          method: 'POST',
          headers: getAuthHeaders({ 'Content-Type': 'application/json' }),
          body: JSON.stringify(payload)
        });

        if (res.ok) {
          editFeedback.textContent = '✓ تم حفظ التعديلات بنجاح!';
          editFeedback.className = 'feedback-banner success';
          editFeedback.style.display = 'block';
          fetchAndRenderUsers();
          setTimeout(() => { editModal.style.display = 'none'; }, 1500);
        } else {
          const r = await res.json();
          throw new Error(r.error || 'فشل التحديث');
        }
      } catch (err) {
        editFeedback.textContent = 'فشل: ' + err.message;
        editFeedback.className = 'feedback-banner error';
        editFeedback.style.display = 'block';
      }
    });

    // ========================================================
    // PHASE 4: TABS SWITCHING & AUDIT TRAIL LOGIC
    // ========================================================
    const userTabs = [
      { btn: 'tab-btn-users', pane: 'pane-users' },
      { btn: 'tab-btn-audit', pane: 'pane-audit' },
      { btn: 'tab-btn-policy', pane: 'pane-policy' }
    ];

    function switchUserTab(activeBtnId) {
      userTabs.forEach(t => {
        const btn = document.getElementById(t.btn);
        const pane = document.getElementById(t.pane);
        if (t.btn === activeBtnId) {
          btn?.classList.add('active');
          if (pane) pane.style.display = 'block';
        } else {
          btn?.classList.remove('active');
          if (pane) pane.style.display = 'none';
        }
      });

      if (activeBtnId === 'tab-btn-audit') {
        fetchAndRenderAuditLogs();
      }
    }

    userTabs.forEach(t => {
      document.getElementById(t.btn)?.addEventListener('click', () => switchUserTab(t.btn));
    });

    // Load Audit Logs
    async function fetchAndRenderAuditLogs() {
      const entity = document.getElementById('filter-audit-entity')?.value || 'all';
      const action = document.getElementById('filter-audit-action')?.value || 'all';
      const search = document.getElementById('search-audit-input')?.value || '';

      const queryParams = new URLSearchParams({ entity, action, search });

      try {
        const res = await fetch(`/api/erp/audit?${queryParams.toString()}`, {
          headers: getAuthHeaders()
        });
        const data = await res.json();
        if (data.success) {
          renderAuditUI(data);
        }
      } catch (err) {
        console.error('Failed to fetch audit logs:', err);
      }
    }

    function renderAuditUI(data) {
      const logs = data.logs || [];
      const stats = data.stats || { totalCount: 0, todayCount: 0, financialCount: 0 };

      // Update KPI Ribbon
      const totalEl = document.getElementById('audit-total-val');
      const todayEl = document.getElementById('audit-today-val');
      const finEl = document.getElementById('audit-financial-val');
      const badgeCountEl = document.getElementById('audit-badge-count');

      if (totalEl) totalEl.textContent = stats.totalCount.toString();
      if (todayEl) todayEl.textContent = stats.todayCount.toString();
      if (finEl) finEl.textContent = stats.financialCount.toString();
      if (badgeCountEl) badgeCountEl.textContent = stats.totalCount.toString();

      // Render Table
      const tbody = document.getElementById('audit-logs-tbody');
      const emptyState = document.getElementById('audit-empty-state');
      if (!tbody) return;

      if (logs.length === 0) {
        tbody.innerHTML = '';
        if (emptyState) emptyState.style.display = 'block';
        return;
      }

      if (emptyState) emptyState.style.display = 'none';

      tbody.innerHTML = logs.map(log => {
        const timeStr = new Date(log.timestamp).toLocaleString('ar-EG', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        });

        const actionTranslations = {
          CREATE: 'إنشاء (+)',
          UPDATE: 'تعديل (✎)',
          DELETE: 'حذف (✕)',
          APPROVE: 'اعتماد (✓)',
          TRANSFER: 'تنازل (⇆)',
          BOUNCE: 'ارتداد (⚠️)',
          RESCHEDULE: 'جدولة (🔄)',
          LOGIN: 'دخول (🔑)'
        };

        const actionText = actionTranslations[log.action] || log.action;

        return `
          <tr>
            <td style="white-space:nowrap;font-size:0.82rem;color:#475569;">${timeStr}</td>
            <td>
              <strong>${log.userName || 'مستخدم النظام'}</strong>
              <span style="font-size:0.75rem;color:#64748b;display:block;">${log.userRole || '-'}</span>
            </td>
            <td>
              <span class="audit-badge badge-${log.action}">
                ${actionText}
              </span>
            </td>
            <td>
              <span style="font-size:0.8rem;background:#f1f5f9;padding:0.2rem 0.55rem;border-radius:6px;font-weight:700;color:#334155;">
                ${log.entity}
              </span>
            </td>
            <td style="max-width:380px;">
              <span style="font-weight:600;color:#1e293b;">${log.details || '-'}</span>
            </td>
            <td>
              <code style="font-size:0.78rem;background:#f8fafc;padding:0.2rem 0.45rem;border-radius:4px;border:1px solid #e2e8f0;color:#64748b;">
                ${log.ipAddress || '127.0.0.1'}
              </code>
            </td>
          </tr>
        `;
      }).join('');
    }

    // Audit Filters Event Listeners
    document.getElementById('filter-audit-entity')?.addEventListener('change', fetchAndRenderAuditLogs);
    document.getElementById('filter-audit-action')?.addEventListener('change', fetchAndRenderAuditLogs);
    document.getElementById('search-audit-input')?.addEventListener('input', fetchAndRenderAuditLogs);
    document.getElementById('refresh-audit-btn')?.addEventListener('click', fetchAndRenderAuditLogs);

    document.getElementById('export-audit-csv-btn')?.addEventListener('click', () => {
      const entity = document.getElementById('filter-audit-entity')?.value || 'all';
      const action = document.getElementById('filter-audit-action')?.value || 'all';
      const search = document.getElementById('search-audit-input')?.value || '';
      const queryParams = new URLSearchParams({ entity, action, search, export: 'csv' });
      window.open(`/api/erp/audit?${queryParams.toString()}`, '_blank');
    });

    // Handle Direct URL Tab Linking (e.g. /crs/users?tab=audit)
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('tab') === 'audit') {
      switchUserTab('tab-btn-audit');
    } else {
      // Initial audit fetch in background
      fetchAndRenderAuditLogs();
    }
  }
</script>