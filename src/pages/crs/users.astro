  .kpi-lbl { font-size: 0.8rem; color: #64748b; font-weight: 700; display: block; }
  .kpi-val { font-size: 1.75rem; font-weight: 900; color: #0f172a; margin: 0.2rem 0; }
  .kpi-sub { font-size: 0.72rem; color: #94a3b8; }

  /* Audit Filters Bar */
