---
import Layout from '../../layouts/Layout.astro';
import AdminLogin from '../../components/AdminLogin.astro';
---

<Layout title="إدارة المستخدمين وفريق العمل | منظومة التطوير العقاري">
  <div id="auth-loading-message" class="auth-loading-screen">
    <div class="auth-spinner"></div>
    <p>جارٍ التحقق من صلاحيات الإدارة...</p>
  </div>

  <div id="admin-login-container" class="auth-container" style="display: none;">
    <AdminLogin />
  </div>

  <main id="page-content" class="user-management-page" style="display: none;">
    
    <!-- Top Executive Header -->
    <header class="executive-top-header">
      <div class="header-inner">
        <div class="title-meta">
          <div class="meta-icon-badge">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </div>
          <div>
            <h1>إدارة المستخدمين وفريق العمل</h1>
            <p>التحكم المركزي في حسابات مسؤولي المبيعات، المحاسبين، والمشرفين الميدانيين</p>
          </div>
        </div>

        <div class="header-actions">
          <a href="/crs" class="btn-action btn-back">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            <span>لوحة التحكم الرئيسية</span>
          </a>
          <button id="logout-button" class="btn-action btn-logout" title="تسجيل الخروج">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            <span>خروج</span>
          </button>
        </div>
      </div>
    </header>

    <div class="management-container">
      
      <!-- Live Metrics Cards -->
      <section class="metrics-row">
        <div class="stat-glass-card">
          <div class="stat-icon-pod pod-indigo">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </div>
          <div class="stat-details">
            <span class="stat-label">إجمالي فريق العمل</span>
            <h3 id="stat-total-users">0</h3>
            <span class="stat-footnote">حسابات نشطة مسجلة</span>
          </div>
        </div>

        <div class="stat-glass-card">
          <div class="stat-icon-pod pod-emerald">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="22" y1="11" x2="16" y2="11"></line></svg>
          </div>
          <div class="stat-details">
            <span class="stat-label">مسؤولو المبيعات</span>
            <h3 id="stat-sales-users">0</h3>
            <span class="stat-footnote">مكلفون بالتعاقدات</span>
          </div>
        </div>

        <div class="stat-glass-card">
          <div class="stat-icon-pod pod-amber">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
          </div>
          <div class="stat-details">
            <span class="stat-label">الحسابات والتحصيل</span>
            <h3 id="stat-accountant-users">0</h3>
            <span class="stat-footnote">الخزينة والأقساط</span>
          </div>
        </div>

        <div class="stat-glass-card">
          <div class="stat-icon-pod pod-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20h20"></path><path d="M5 20V8l7-5 7 5v12"></path><rect x="9" y="12" width="6" height="8"></rect></svg>
          </div>
          <div class="stat-details">
            <span class="stat-label">المشرفون والمهندسون</span>
            <h3 id="stat-supervisor-users">0</h3>
            <span class="stat-footnote">متابعة المواقع والمستخلصات</span>
          </div>
        </div>
      </section>

      <!-- Navigation Tabs: Users Directory / Audit Trail / Approvals Policy -->
      <div class="user-tabs-bar">
        <button id="tab-btn-users" class="user-tab-btn active" data-pane="pane-users">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          <span>دليل المستخدمين والصلاحيات</span>
        </button>
        <button id="tab-btn-audit" class="user-tab-btn" data-pane="pane-audit">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          <span>سجل التدقيق والرقابة الأمني (Audit Trail)</span>
          <span class="tab-badge" id="audit-badge-count">0</span>
        </button>
        <button id="tab-btn-policy" class="user-tab-btn" data-pane="pane-policy">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          <span>مصفوفة سلاسل الاعتمادات المالية</span>
        </button>
      </div>

      <!-- Pane 1: Users Directory -->
      <div id="pane-users" class="user-pane active">
        <!-- Main Layout Grid: Add User Panel + Users Directory -->
        <div class="management-grid">
        
        <!-- Left/Top: Add User Luxury Glass Form -->
        <section class="creation-panel">
          <div class="panel-card-crystal">
            <div class="panel-card-header">
              <div class="header-icon-pod">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="22" y1="11" x2="16" y2="11"></line></svg>
              </div>
              <div>
                <h2>إنشاء حساب مستخدم جديد</h2>
                <p>إصدار بيانات اعتماد فورية لأحد أفراد المنظومة</p>
              </div>
            </div>

            <form id="add-user-form" class="crystal-form">
              
              <div class="form-field-box">
                <label for="user-name">
                  <span>اسم المستخدم الكامل</span>
                  <span class="required-star">*</span>
                </label>
                <div class="input-icon-wrap">
                  <span class="input-svg">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                  </span>
                  <input type="text" id="user-name" placeholder="مثال: م. أحمد عبد العزيز" required />
                </div>
              </div>

              <div class="form-field-box">
                <label for="user-email">
                  <span>البريد الإلكتروني للعمل</span>
                  <span class="required-star">*</span>
                </label>
                <div class="input-icon-wrap">
                  <span class="input-svg">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                  </span>
                  <input type="email" id="user-email" placeholder="name@company.com" required />
                </div>
              </div>

              <div class="form-field-box">
                <label for="user-password">
                  <span>كلمة المرور الابتدائية</span>
                  <span class="required-star">*</span>
                </label>
                <div class="input-icon-wrap">
                  <span class="input-svg">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                  </span>
                  <input type="password" id="user-password" placeholder="•••••••• (6 أحرف على الأقل)" required minlength="6" />
                </div>
              </div>

              <div class="form-field-box">
                <label for="user-role">
                  <span>الدور الوظيفي والصلاحية</span>
                  <span class="required-star">*</span>
                </label>
                <div class="input-icon-wrap select-wrap">
                  <span class="input-svg">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                  </span>
                  <select id="user-role" required>
                    <option value="" disabled selected>اختر الصلاحية والمسؤولية...</option>
                    <option value="sales">مسؤول مبيعات (Sales)</option>
                    <option value="accountant">محاسب / مسؤول تحصيل (Accountant)</option>
                    <option value="supervisor">مشرف ميداني / مهندس (Supervisor)</option>
                    <option value="admin">مالك / مدير عام (Admin)</option>
                  </select>
                </div>
              </div>

              <button type="submit" id="add-user-btn" class="btn-submit-luxury">
                <span class="btn-text">+ إنشاء الحساب وتفعيله فوراً</span>
                <span class="btn-loader" style="display: none;">جارٍ إنشاء الحساب...</span>
              </button>

              <div id="add-user-feedback" class="feedback-banner" style="display: none;"></div>
            </form>
          </div>
        </section>

        <!-- Right/Main: Users Directory & Search Bar -->
        <section class="directory-panel">
          
          <div class="directory-header-bar">
            <div class="search-input-box">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <input type="text" id="user-search-input" placeholder="بحث بالاسم أو البريد الإلكتروني..." />
            </div>

            <!-- Role Filter Pills -->
            <div class="filter-pills-bar">
              <button type="button" class="filter-pill active" data-role="all">الكل</button>
              <button type="button" class="filter-pill" data-role="sales">مبيعات</button>
              <button type="button" class="filter-pill" data-role="accountant">محاسبين</button>
              <button type="button" class="filter-pill" data-role="supervisor">مشرفين</button>
              <button type="button" class="filter-pill" data-role="admin">إدارة</button>
            </div>
          </div>

          <!-- Users Grid -->
          <div id="users-list" class="users-luxury-grid"></div>

          <!-- Empty / Loading States -->
          <div id="no-users-message" class="empty-state-luxury">
            <div class="empty-icon-circle">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
            </div>
            <h3>جارٍ تحميل قائمة المستخدمين...</h3>
            <p>يتم جلب الحسابات المسجلة من قاعدة البيانات</p>
          </div>

        </section>

        </div>
      </div>

      <!-- Pane 2: Audit Trail (سجل الرقابة والتدقيق الأمني) -->
      <div id="pane-audit" class="user-pane" style="display: none;">
        <!-- Audit KPI Ribbon -->
        <div class="audit-kpis-grid">
          <div class="audit-kpi-card">
            <div class="kpi-icon-box" style="background:#ecfdf5;color:#059669;">🛡️</div>
            <div>
              <span class="kpi-lbl">إجمالي العمليات الموثقة</span>
              <h3 class="kpi-val" id="audit-total-val">0</h3>
              <span class="kpi-sub">كل حركة مسجلة بالدقيقة والـ IP</span>
            </div>
          </div>

          <div class="audit-kpi-card">
            <div class="kpi-icon-box" style="background:#eff6ff;color:#2563eb;">⚡</div>
            <div>
              <span class="kpi-lbl">عمليات اليوم اللحظية</span>
              <h3 class="kpi-val" id="audit-today-val">0</h3>
              <span class="kpi-sub">نشاط اليوم النشط</span>
            </div>
          </div>

          <div class="audit-kpi-card">
            <div class="kpi-icon-box" style="background:#fffbeb;color:#b45309;">⚖️</div>
            <div>
              <span class="kpi-lbl">العمليات المالية الحساسة</span>
              <h3 class="kpi-val" id="audit-financial-val">0</h3>
              <span class="kpi-sub">اعتمادات صرف، شيكات، وتنازلات</span>
            </div>
          </div>
        </div>

        <!-- Audit Filters Bar -->
        <div class="audit-filters-bar">
          <div class="filter-group">
            <label>تصفية حسب نوع الكيان:</label>
            <select id="filter-audit-entity">
              <option value="all">جميع الكيانات (Projects, Units, Cheques...)</option>
              <option value="Project">المشروعات (Project)</option>
              <option value="Unit">الوحدات (Unit)</option>
              <option value="Reservation">الحجوزات والتعاقدات (Reservation)</option>
              <option value="BankCheque">محفظة الشيكات (BankCheque)</option>
              <option value="Invoice">المستخلصات والمقاولين (Invoice)</option>
              <option value="Treasury">الخزينة والحسابات (Treasury)</option>
              <option value="User">المستخدمين (User)</option>
              <option value="JournalEntry">القيود اليومية (JournalEntry)</option>
            </select>
          </div>

          <div class="filter-group">
            <label>نوع العملية (Action):</label>
            <select id="filter-audit-action">
              <option value="all">جميع الحركات (All Actions)</option>
              <option value="CREATE">إنشاء وإضافة (CREATE)</option>
              <option value="UPDATE">تعديل بيانات (UPDATE)</option>
              <option value="DELETE">حذف وإلغاء (DELETE)</option>
              <option value="APPROVE">اعتماد مالي / هندسي (APPROVE)</option>
              <option value="TRANSFER">تنازل ونقل ملكية (TRANSFER)</option>
              <option value="BOUNCE">شيك مرتد (BOUNCE)</option>
              <option value="RESCHEDULE">إعادة جدولة (RESCHEDULE)</option>
            </select>
          </div>

          <div class="filter-group" style="flex:1;">
            <label>بحث في البيان أو اسم المستخدم:</label>
            <input type="text" id="search-audit-input" placeholder="اكتب للبحث في سجل العمليات..." />
          </div>

          <button id="refresh-audit-btn" class="btn-action" style="background:#f1f5f9;color:#334155;align-self:flex-end;">
            🔄 تحديث السجل
          </button>

          <button id="export-audit-csv-btn" class="btn-action" style="background:#059669;color:#ffffff;align-self:flex-end;" title="تحميل تقرير كامل بصيغة CSV">
            📥 تصدير تقرير (CSV)
          </button>
        </div>

        <!-- Audit Trail Table -->
        <div class="table-container-luxury">
          <table class="audit-log-table">
            <thead>
              <tr>
                <th>التاريخ والوقت</th>
                <th>المستخدم المسؤول</th>
                <th>نوع الحركة</th>
                <th>الكيان المستهدف</th>
                <th>البيان والتفاصيل الإجرائية</th>
                <th>عنوان IP</th>
              </tr>
            </thead>
            <tbody id="audit-logs-tbody">
              <!-- Dynamically populated -->
            </tbody>
          </table>

          <div id="audit-empty-state" class="empty-state-luxury" style="display: none;">
            <p>لا توجد حركات تدقيق مطابقة لشروط البحث.</p>
          </div>
        </div>
      </div>

      <!-- Pane 3: Approvals Policy (مصفوفة سلاسل الاعتمادات المالية) -->
      <div id="pane-policy" class="user-pane" style="display: none;">
        <div class="policy-hero-card">
          <div class="policy-icon">🏛️</div>
          <div>
            <h3>مصفوفة الحوكمة والاعتمادات المالية متعددة المستويات (Approval Governance Matrix)</h3>
            <p>تنظيم صلاحيات التوقيع والصرف وتحديد المسؤوليات المالية لكل مستوى إداري منعاً للتجاوزات وضماناً للنزاهة المالية للشركة.</p>
          </div>
        </div>

        <div class="approval-tiers-grid">
          <!-- Tier 1 -->
          <div class="approval-tier-card tier-site">
            <div class="tier-header">
              <span class="tier-badge">المستوى الأول (الميداني)</span>
              <h4>مهندس الموقع ومدير المشروع</h4>
            </div>
            <div class="tier-limit-box">
              <span class="limit-lbl">الحد الأقصى للصرف المباشر:</span>
              <strong class="limit-val">حتى 20,000 ج.م</strong>
            </div>
            <ul class="tier-permissions-list">
              <li>✓ اعتماد مشتريات خامات عاجلة للموقع</li>
              <li>✓ طلب صرف نثريات ووقود معدات</li>
              <li>✓ تسجيل نسب إنجاز المقاولين الميدانية</li>
              <li>✕ لا يحق له اعتماد مستخلصات رئيسية أو خصومات بيع</li>
            </ul>
          </div>

          <!-- Tier 2 -->
          <div class="approval-tier-card tier-finance">
            <div class="tier-header">
              <span class="tier-badge">المستوى الثاني (المالي)</span>
              <h4>المدير المالي ورئيس الحسابات</h4>
            </div>
            <div class="tier-limit-box">
              <span class="limit-lbl">حد الاعتماد والصرف:</span>
              <strong class="limit-val">من 20,000 إلى 100,000 ج.م</strong>
            </div>
            <ul class="tier-permissions-list">
              <li>✓ اعتماد مستخلصات المقاولين الدورية وخصم تأمين 5%</li>
              <li>✓ تحصيل وتسليم الشيكات البنكية وإيداعها في الخزينة</li>
              <li>✓ صرف عمولات شركات البروكرز المعتمدة</li>
              <li>✓ إعادة جدولة أقساط العملاء في حدود اللائحة</li>
            </ul>
          </div>

          <!-- Tier 3 -->
          <div class="approval-tier-card tier-exec">
            <div class="tier-header">
              <span class="tier-badge">المستوى الثالث (السيادي)</span>
              <h4>العضو المنتدب والمدير العام</h4>
            </div>
            <div class="tier-limit-box">
              <span class="limit-lbl">صلاحية الصرف والقرارات:</span>
              <strong class="limit-val">أكثر من 100,000 ج.م (مفتوح)</strong>
            </div>
            <ul class="tier-permissions-list">
              <li>✓ اعتماد أوامر الصرف الكبرى وتغذية الخزائن الرئيسية</li>
              <li>✓ اعتماد التنازلات ونقل الملكية وإلغاء التعاقدات</li>
              <li>✓ منح نسب خصم استثنائية فوق 5% في عقود البيع</li>
              <li>✓ توقيع عقود مقاولات الأعمال المتكاملة وتحديد خطط السداد</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Edit User Modal (Crystal Glassmorphism) -->
    <div id="edit-user-modal" class="modal-backdrop-luxury" style="display: none;">
      <div class="modal-window-luxury">
