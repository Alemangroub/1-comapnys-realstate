---
import Layout from '../../layouts/Layout.astro';
import AdminLogin from '../../components/AdminLogin.astro';
---

<Layout title="نظام التطوير العقاري">
  <div id="auth-loading-message" class="loading-state">
    <div class="spinner"></div>
    <p>جارٍ التحقق من الصلاحيات...</p>
  </div>

  <div id="admin-login-container" style="display: none;">
    <AdminLogin />
  </div>

  <main id="main-content" class="erp-container" style="display: none;">
    
    <!-- Top Navigation Bar -->
    <header class="erp-topbar">
      <div class="brand-crumb">
        <a href="/crs" class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
          الرئيسية
        </a>
        <span class="sep">/</span>
        <span class="active-crumb">نظام التطوير العقاري</span>
      </div>

      <div class="topbar-actions">
        <button id="open-new-project-modal" class="btn btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          + مشروع جديد
        </button>
      </div>
    </header>

    <!-- Quick Stats Row -->
    <section class="hero-stats-row">
      <div class="hero-stat-card">
        <span class="stat-number" id="total-projects-count">0</span>
        <span class="stat-title">إجمالي المشاريع</span>
      </div>
      <div class="hero-stat-card">
        <span class="stat-number stat-active" id="active-projects-count">0</span>
        <span class="stat-title">المشاريع النشطة</span>
      </div>
      <div class="hero-stat-card">
        <span class="stat-number stat-archived" id="archived-projects-count">0</span>
        <span class="stat-title">المشاريع المؤرشفة</span>
      </div>
      <div class="hero-stat-card">
        <span class="stat-number" id="total-units-count">0</span>
        <span class="stat-title">إجمالي الوحدات</span>
      </div>
    </section>

    <!-- Projects Grid & Details Viewer -->
    <section class="projects-section">
      <div class="section-controls-bar">
        <div class="section-title-wrap">
          <h2>المشاريع القائمة وشجرة التفريع</h2>
          <span class="badge-count" id="active-projects-badge">0 مشاريع</span>
        </div>

        <div class="section-filter-actions">
          <div class="filter-pills-nav">
            <button class="filter-pill-btn active" data-filter="active">
              <span>المشاريع النشطة</span>
              <span class="pill-counter" id="filter-active-count">0</span>
            </button>
            <button class="filter-pill-btn" data-filter="archived">
              <span>المؤرشفة</span>
              <span class="pill-counter" id="filter-archived-count">0</span>
            </button>
            <button class="filter-pill-btn" data-filter="all">
              <span>جميع المشاريع</span>
              <span class="pill-counter" id="filter-all-count">0</span>
            </button>
          </div>

          <div class="project-search-box">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" id="project-search-input" placeholder="بحث باسم المشروع أو الموقع..." />
          </div>
        </div>
      </div>

      <div class="projects-grid" id="projects-grid-container">
        <!-- Dynamically rendered project cards -->
      </div>
    </section>

    <!-- Modal: New Project Creation -->
    <div id="project-modal" class="modal-backdrop" style="display: none;">
      <div class="modal-card modal-large">
        <div class="modal-header">
          <div>
            <h3>إضافة مشروع جديد</h3>
            <p class="modal-sub">تسجيل بيانات المشروع وتخصيص فريق العمل (سيلز، مهندسين، محاسبين)</p>
          </div>
          <button class="close-modal-btn" id="close-project-modal">&times;</button>
        </div>
        <form id="new-project-form" class="modal-form">
          <div class="form-group">
            <label>اسم المشروع *</label>
            <input type="text" id="proj-name" placeholder="مثال: كمبوند درة النخيل" required />
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>نوع المشروع</label>
              <select id="proj-type-select">
                <option value="مشروع سكني">مشروع سكني</option>
                <option value="مول تجاري">مول تجاري</option>
                <option value="مبنى إداري">مبنى إداري</option>
                <option value="other">أخرى (تحديد يدوي)...</option>
              </select>
              <input type="text" id="proj-type-custom" placeholder="اكتب نوع المشروع..." style="display: none; margin-top: 0.5rem;" />
            </div>

            <div class="form-group">
              <label>الموقع الجغرافي / العنوان</label>
              <input type="text" id="proj-address" placeholder="مثال: التجمع الخامس، القاهرة" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>تاريخ البدء</label>
              <input type="date" id="proj-start-date" />
            </div>
            <div class="form-group">
              <label>تاريخ الانتهاء المتوقع</label>
              <input type="date" id="proj-end-date" />
            </div>
          </div>

          <!-- Team Allocation Section (تخصيص الكوادر وفريق العمل) -->
          <div class="team-allocation-box">
            <div class="team-allocation-header">
              <div class="team-header-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                <span>تخصيص فريق العمل والمسؤولين عن المشروع</span>
              </div>
              <span class="team-header-hint">اختر الموظفين المسموح لهم بإدارة ومتابعة هذا المشروع</span>
            </div>

            <div class="roles-allocation-grid">
              <!-- Role 1: Sales -->
              <div class="role-selector-pod">
                <div class="role-pod-title">
                  <span class="role-icon-tag tag-sales">👔 مسؤولو المبيعات (Sales)</span>
                  <span class="selected-badge" id="new-sales-count-badge">0 محدد</span>
                </div>
                <div class="staff-checkbox-list" id="new-proj-sales-list">
                  <div class="loading-users-shimmer">جاري تحميل مسؤولي المبيعات...</div>
                </div>
              </div>

              <!-- Role 2: Engineers -->
              <div class="role-selector-pod">
                <div class="role-pod-title">
                  <span class="role-icon-tag tag-engineer">👷‍♂️ المهندسون والمشرفون (Engineers)</span>
                  <span class="selected-badge" id="new-engineers-count-badge">0 محدد</span>
                </div>
                <div class="staff-checkbox-list" id="new-proj-engineers-list">
                  <div class="loading-users-shimmer">جاري تحميل المهندسين...</div>
                </div>
              </div>

              <!-- Role 3: Accountants -->
              <div class="role-selector-pod">
                <div class="role-pod-title">
                  <span class="role-icon-tag tag-finance">💼 المحاسبون والإدارة المالية (Finance)</span>
                  <span class="selected-badge" id="new-accountants-count-badge">0 محدد</span>
                </div>
                <div class="staff-checkbox-list" id="new-proj-accountants-list">
                  <div class="loading-users-shimmer">جاري تحميل المحاسبين...</div>
                </div>
              </div>
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary" id="save-proj-btn">تأكيد وبدء التفريع</button>
            <button type="button" class="btn btn-secondary" id="cancel-proj-btn">إلغاء</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal: Edit Project -->
    <div id="edit-project-modal" class="modal-backdrop" style="display: none;">
      <div class="modal-card modal-large">
        <div class="modal-header">
          <div>
            <h3>تعديل بيانات المشروع</h3>
            <p class="modal-sub">تحديث البيانات الأساسية وحالة المشروع وتعيين فريق العمل المخصص</p>
          </div>
          <button class="close-modal-btn" id="close-edit-modal">&times;</button>
        </div>
        <form id="edit-project-form" class="modal-form">
          <input type="hidden" id="edit-proj-id" />
          <div class="form-group">
            <label>اسم المشروع *</label>
            <input type="text" id="edit-proj-name" placeholder="مثال: كمبوند درة النخيل" required />
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>نوع المشروع</label>
              <select id="edit-proj-type-select">
                <option value="مشروع سكني">مشروع سكني</option>
                <option value="مول تجاري">مول تجاري</option>
                <option value="مبنى إداري">مبنى إداري</option>
                <option value="other">أخرى (تحديد يدوي)...</option>
              </select>
              <input type="text" id="edit-proj-type-custom" placeholder="اكتب نوع المشروع..." style="display: none; margin-top: 0.5rem;" />
            </div>

            <div class="form-group">
              <label>الموقع الجغرافي / العنوان</label>
              <input type="text" id="edit-proj-address" placeholder="مثال: التجمع الخامس، القاهرة" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>حالة المشروع</label>
              <select id="edit-proj-status">
                <option value="under_development">قيد التطوير والاستثمار</option>
                <option value="under_construction">قيد الإنشاء والتشييد</option>
                <option value="completed">مكتمل ومسلّم</option>
                <option value="archived">مؤرشف</option>
              </select>
            </div>
            <div class="form-group">
              <label>إحداثيات الموقع (GPS / الخريطة)</label>
              <input type="text" id="edit-proj-coordinates" placeholder="مثال: 30.0444, 31.2357" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>تاريخ البدء</label>
              <input type="date" id="edit-proj-start-date" />
            </div>
            <div class="form-group">
              <label>تاريخ الانتهاء المتوقع</label>
              <input type="date" id="edit-proj-end-date" />
            </div>
          </div>

          <!-- Team Allocation Section for Edit Modal -->
          <div class="team-allocation-box">
            <div class="team-allocation-header">
              <div class="team-header-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                <span>تخصيص وتعديل فريق العمل والمسؤولين</span>
              </div>
              <span class="team-header-hint">حدد الموظفين المسؤولين عن هذا المشروع بالتحديد</span>
            </div>

            <div class="roles-allocation-grid">
              <!-- Role 1: Sales -->
              <div class="role-selector-pod">
                <div class="role-pod-title">
                  <span class="role-icon-tag tag-sales">👔 مسؤولو المبيعات (Sales)</span>
                  <span class="selected-badge" id="edit-sales-count-badge">0 محدد</span>
                </div>
                <div class="staff-checkbox-list" id="edit-proj-sales-list">
                  <div class="loading-users-shimmer">جاري تحميل مسؤولي المبيعات...</div>
                </div>
              </div>

              <!-- Role 2: Engineers -->
              <div class="role-selector-pod">
                <div class="role-pod-title">
                  <span class="role-icon-tag tag-engineer">👷‍♂️ المهندسون والمشرفون (Engineers)</span>
                  <span class="selected-badge" id="edit-engineers-count-badge">0 محدد</span>
                </div>
                <div class="staff-checkbox-list" id="edit-proj-engineers-list">
                  <div class="loading-users-shimmer">جاري تحميل المهندسين...</div>
                </div>
              </div>

              <!-- Role 3: Accountants -->
              <div class="role-selector-pod">
                <div class="role-pod-title">
                  <span class="role-icon-tag tag-finance">💼 المحاسبون والإدارة المالية (Finance)</span>
                  <span class="selected-badge" id="edit-accountants-count-badge">0 محدد</span>
                </div>
                <div class="staff-checkbox-list" id="edit-proj-accountants-list">
                  <div class="loading-users-shimmer">جاري تحميل المحاسبين...</div>
                </div>
              </div>
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary" id="save-edit-proj-btn">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
              حفظ التعديلات
            </button>
            <button type="button" class="btn btn-secondary" id="cancel-edit-proj-btn">إلغاء</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal: Delete Project Confirmation -->
    <div id="delete-project-modal" class="modal-backdrop" style="display: none;">
      <div class="modal-card modal-danger">
        <div class="modal-header">
          <div class="danger-header-wrap">
            <div class="danger-header-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            </div>
            <div>
              <h3>تأكيد حذف المشروع</h3>
              <p class="modal-sub">تحذير أمني: هذا الإجراء يحذف المشروع نهائياً</p>
            </div>
          </div>
          <button class="close-modal-btn" id="close-delete-modal">&times;</button>
        </div>

        <div class="delete-modal-body">
          <p class="delete-warning-text">
            أنت على وشك حذف المشروع: <strong id="delete-proj-name" class="highlight-name">...</strong>
          </p>
          <div class="delete-info-box">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
            <span>سيتم حذف شجرة المشروع بما فيها المباني والوحدات وخطط السداد غير المحجوزة. إذا كان المشروع يحتوي على تعاقدات عملاء، يُفضل <strong>الأرشفة</strong> بدلاً من الحذف للحفاظ على السجلات المالية.</span>
          </div>
          <input type="hidden" id="delete-proj-id" />
        </div>

        <div class="form-actions">
          <button type="button" class="btn btn-danger" id="confirm-delete-proj-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            تأكيد الحذف النهائي
          </button>
          <button type="button" class="btn btn-secondary" id="cancel-delete-proj-btn">تراجع وإلغاء</button>
        </div>
      </div>
    </div>

    <!-- Toast Notifications Container -->
    <div id="toast-container" class="toast-container"></div>



  </main>
</Layout>

<script>
  import { checkAuth } from '../../lib/auth.js';

  let allProjects = [];
  let allSystemUsers = [];
  let currentFilter = 'active'; // 'active' | 'archived' | 'all'
  let searchQuery = '';
  let countsData = { active: 0, archived: 0, total: 0 };

  const authLoading = document.getElementById('auth-loading-message');
  const loginContainer = document.getElementById('admin-login-container');
  const mainContent = document.getElementById('main-content');

  // Toast Notification System
  function showToast(message, type = 'success') {
    const container = document.getElementById('toast-container');
    if (!container) return;
    const toast = document.createElement('div');
    toast.className = `erp-toast toast-${type}`;
    const icon = type === 'success'
      ? `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>`
      : `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>`;
    
    toast.innerHTML = `
      <div class="toast-body">
        <span class="toast-icon">${icon}</span>
        <span class="toast-text">${message}</span>
      </div>
      <button class="toast-close-btn" type="button">&times;</button>
    `;
    container.appendChild(toast);
    const closeBtn = toast.querySelector('.toast-close-btn');
    if (closeBtn) closeBtn.onclick = () => toast.remove();
    setTimeout(() => {
      toast.classList.add('toast-fadeout');
      setTimeout(() => toast.remove(), 300);
    }, 4500);
  }

  // Load All System Users for Team Allocation
  async function loadSystemUsers() {
    try {
      const res = await fetch('/api/users/list');
      if (res.ok) {
        allSystemUsers = await res.json();
      }
    } catch (e) {
      console.error('Failed to load system users list:', e);
    }
  }

  // Filter users by role categories
  function filterUsersByRoleCategory(users, category) {
    if (!Array.isArray(users)) return [];
    if (category === 'sales') {
      return users.filter(u => u.role === 'sales' || u.role === 'marketing');
    }
    if (category === 'engineer') {
      return users.filter(u => u.role === 'engineer' || u.role === 'supervisor');
    }
    if (category === 'accountant') {
      return users.filter(u => u.role === 'accountant' || u.role === 'finance');
    }
    return [];
  }

  // Render Checkbox List for Team Allocation
  function renderTeamCheckboxes(containerId, countBadgeId, users, selectedIds = []) {
    const container = document.getElementById(containerId);
    const badge = document.getElementById(countBadgeId);
    if (!container) return;

    if (!users || users.length === 0) {
      container.innerHTML = `
        <div class="empty-staff-msg">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          <span>لا يوجد موظفون بهذه الصفة مسجلون حالياً</span>
        </div>
      `;
      if (badge) badge.textContent = '0 محدد';
      return;
    }

    const selectedSet = new Set((selectedIds || []).map(id => String(id)));

    container.innerHTML = users.map(u => {
      const isChecked = selectedSet.has(String(u.id));
      const initials = (u.name || 'م').trim().substring(0, 2);
      return `
        <label class="staff-checkbox-item ${isChecked ? 'is-selected' : ''}">
          <input type="checkbox" name="assigned-user" value="${u.id}" ${isChecked ? 'checked' : ''} class="staff-check-input" />
          <div class="staff-avatar-mini">${initials}</div>
          <div class="staff-info-col">
            <span class="staff-name-text">${u.name}</span>
            <span class="staff-email-sub">${u.email || ''}</span>
          </div>
        </label>
      `;
    }).join('');

    // Update count badge
    const updateBadge = () => {
      const checkedCount = container.querySelectorAll('input.staff-check-input:checked').length;
      if (badge) badge.textContent = `${checkedCount} محدد`;
    };
    updateBadge();

    // Attach listener to update styling and counter on change
    container.querySelectorAll('input.staff-check-input').forEach(chk => {
      chk.addEventListener('change', (e) => {
        const item = e.target.closest('.staff-checkbox-item');
        if (item) {
          if (e.target.checked) item.classList.add('is-selected');
          else item.classList.remove('is-selected');
        }
        updateBadge();
      });
    });
  }

  // Shared Helper: Populate all three team role lists
  function populateModalTeams(prefix, assignedIds = []) {
    const isNew = prefix === 'new-proj';
    const badgePrefix = isNew ? 'new' : 'edit';
    const salesUsers = filterUsersByRoleCategory(allSystemUsers, 'sales');
    const engUsers = filterUsersByRoleCategory(allSystemUsers, 'engineer');
    const accUsers = filterUsersByRoleCategory(allSystemUsers, 'accountant');
    renderTeamCheckboxes(`${prefix}-sales-list`, `${badgePrefix}-sales-count-badge`, salesUsers, assignedIds);
    renderTeamCheckboxes(`${prefix}-engineers-list`, `${badgePrefix}-engineers-count-badge`, engUsers, assignedIds);
    renderTeamCheckboxes(`${prefix}-accountants-list`, `${badgePrefix}-accountants-count-badge`, accUsers, assignedIds);
  }

  // Shared Helper: Bind toggle for custom project type
  function bindCustomTypeToggle(selectEl, customInputEl) {
    if (!selectEl || !customInputEl) return;
    selectEl.addEventListener('change', () => {
      const isOther = selectEl.value === 'other';
      customInputEl.style.display = isOther ? 'block' : 'none';
      if (isOther) customInputEl.focus();
      else customInputEl.value = '';
    });
  }

  // Shared Helper: Read project type value
  function getSelectedTypeValue(selectEl, customInputEl) {
    if (selectEl && selectEl.value === 'other') {
      return customInputEl?.value.trim() || 'أخرى';
    }
    return selectEl ? selectEl.value : '';
  }

  // Shared Helper: Extract selected staff IDs
  function getSelectedStaffIds(modalSelector) {
    return Array.from(document.querySelectorAll(`${modalSelector} input[name="assigned-user"]:checked`)).map(cb => cb.value);
  }

  // Verify Admin Auth
  (async () => {
    try {
      const user = await checkAuth();
      if (authLoading) authLoading.style.display = 'none';

      if (user && user.role === 'admin') {
        if (mainContent) mainContent.style.display = 'block';
        loadDevelopmentProjects();
        loadSystemUsers();
      } else {
        if (loginContainer) loginContainer.style.display = 'block';
      }
    } catch (e) {
      if (authLoading) authLoading.style.display = 'none';
      if (loginContainer) loginContainer.style.display = 'block';
    }
  })();

  // Fetch Projects with Archive Filter & Counts
  async function loadDevelopmentProjects() {
    try {
      let filterParam = 'false';
      if (currentFilter === 'archived') filterParam = 'true';
      else if (currentFilter === 'all') filterParam = 'all';

      const res = await fetch(`/api/erp/development?archived=${filterParam}`);
      const data = await res.json();
      if (data.success) {
        allProjects = data.projects || [];
        if (data.counts) {
          countsData = data.counts;
          updateCounters();
        }
        renderProjects();
      }
    } catch (err) {
      console.error('Failed to load development projects:', err);
      showToast('تعذر تحميل بيانات المشاريع من الخادم', 'error');
    }
  }

  function updateCounters() {
    const totalProj = document.getElementById('total-projects-count');
    const activeProj = document.getElementById('active-projects-count');
    const archivedProj = document.getElementById('archived-projects-count');
    const filterActive = document.getElementById('filter-active-count');
    const filterArchived = document.getElementById('filter-archived-count');
    const filterAll = document.getElementById('filter-all-count');

    if (totalProj) totalProj.textContent = countsData.total;
    if (activeProj) activeProj.textContent = countsData.active;
    if (archivedProj) archivedProj.textContent = countsData.archived;
    if (filterActive) filterActive.textContent = countsData.active;
    if (filterArchived) filterArchived.textContent = countsData.archived;
    if (filterAll) filterAll.textContent = countsData.total;
  }

  function getProjectStatusPill(status, archived) {
    if (archived) {
      return `
        <span class="status-archived-pill">
          <span class="dot-archived"></span>
          مشروع مؤرشف
        </span>
      `;
    }
    if (status === 'under_construction') {
      return `
        <span class="status-const-pill">
          <span class="dot-pulse-blue"></span>
          قيد الإنشاء والتشييد
        </span>
      `;
    }
    if (status === 'completed') {
      return `
        <span class="status-comp-pill">
          <span class="dot-pulse-purple"></span>
          مكتمل ومسلّم
        </span>
      `;
    }
    return `
      <span class="status-live-pill">
        <span class="dot-pulse-green"></span>
        قيد التطوير والاستثمار
      </span>
    `;
  }

  function renderProjects() {
    const grid = document.getElementById('projects-grid-container');
    const badge = document.getElementById('active-projects-badge');
    const totalUnitsEl = document.getElementById('total-units-count');

    if (!grid) return;

    let unitsSum = 0;
    allProjects.forEach(p => { unitsSum += p.units ? p.units.length : 0; });
    if (totalUnitsEl) totalUnitsEl.textContent = unitsSum;

    // Filter projects based on search query
    const filteredProjects = allProjects.filter(p => {
      if (!searchQuery) return true;
      const nameMatch = p.projectName && p.projectName.toLowerCase().includes(searchQuery);
      const addrMatch = p.projectAddress && p.projectAddress.toLowerCase().includes(searchQuery);
      return nameMatch || addrMatch;
    });

    if (badge) badge.textContent = `${filteredProjects.length} مشاريع`;

    if (filteredProjects.length === 0) {
      grid.innerHTML = `
        <div class="empty-state-card">
          <div class="empty-icon">📁</div>
          <h3>لا توجد مشاريع مطابقة</h3>
          <p>${searchQuery ? 'لم يتم العثور على أي مشروع يطابق عبارة البحث الحالية.' : (currentFilter === 'archived' ? 'لا توجد مشاريع مؤرشفة حالياً.' : 'لا يوجد مشاريع مسجلة حالياً. انقر على "+ مشروع جديد" لبدء التفريع.')}</p>
        </div>
      `;
      return;
    }

    grid.innerHTML = filteredProjects.map(proj => {
      const units = proj.units || [];
      const unitsCount = units.length;
      const bldCount = proj.buildings ? proj.buildings.length : 0;
      const plansCount = proj.paymentPlans ? proj.paymentPlans.length : 0;
      const stages = proj.constructionStages || [];
      
      let availUnits = 0;
      let resUnits = 0;
      let soldUnits = 0;
      units.forEach(u => {
        const s = u.status || 'available';
        if (s === 'available') availUnits++;
        else if (s === 'reserved') resUnits++;
        else if (s === 'sold') soldUnits++;
      });

      // Calculate weighted construction percentage
      let totalWeight = 0;
      let weightedProgress = 0;
      stages.forEach(st => {
        const w = st.weight || 1;
        totalWeight += w;
        weightedProgress += (st.percentage || 0) * w;
      });
      const progressPct = totalWeight > 0 ? Math.round(weightedProgress / totalWeight) : 0;

      // Calculate team allocations and names for this project
      const assignments = proj.salesAssignments || [];
      const salesNames = [];
      const engNames = [];
      const accNames = [];

      assignments.forEach(a => {
        if (!a.user) return;
        const role = a.user.role;
        const name = a.user.name;
        if (role === 'sales' || role === 'marketing') salesNames.push(name);
        else if (role === 'engineer' || role === 'supervisor') engNames.push(name);
        else if (role === 'accountant' || role === 'finance') accNames.push(name);
      });

      const totalAssignedStaff = salesNames.length + engNames.length + accNames.length;

      return `
        <div class="project-tree-card ${proj.archived ? 'card-is-archived' : ''}" data-project-id="${proj.id}">
          <!-- Card Top Bar & Crest with Management Icons -->
          <div class="card-crest-banner">
            <div class="crest-actions-group">
              <div class="project-crest-icon ${proj.archived ? 'icon-archived' : ''}">
                ${proj.archived ? '📦' : '🏢'}
              </div>

              <!-- Quick Project Management Buttons (تعديل - أرشفة / استعادة - وحذف فقط للمؤرشف) -->
              <div class="project-card-actions">
                <button type="button" class="btn-card-ctrl btn-edit-proj" title="تعديل بيانات المشروع" data-id="${proj.id}">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                </button>
                <button type="button" class="btn-card-ctrl ${proj.archived ? 'btn-restore-proj' : 'btn-archive-proj'}" title="${proj.archived ? 'استعادة من الأرشيف' : 'أرشفة المشروع'}" data-id="${proj.id}" data-archived="${proj.archived ? 'true' : 'false'}" data-name="${proj.projectName}">
                  ${proj.archived
                    ? `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>`
                    : `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="21 8 21 21 3 21 3 8"></polyline><rect x="1" y="3" width="22" height="5"></rect><line x1="10" y1="12" x2="14" y2="12"></line></svg>`
                  }
                </button>
                ${proj.archived ? `
                <button type="button" class="btn-card-ctrl btn-delete-proj text-danger" title="حذف المشروع نهائياً" data-id="${proj.id}" data-name="${proj.projectName}">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                </button>
                ` : ''}
              </div>
            </div>

            <div class="crest-status-wrap">
              ${proj.projectType ? `<span class="proj-type-chip">${proj.projectType}</span>` : ''}
              ${getProjectStatusPill(proj.status, proj.archived)}
            </div>
          </div>

          <!-- Project Title & Location -->
          <div class="card-title-section">
            <h3 class="proj-title">${proj.projectName}</h3>
            <p class="proj-loc">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              <span>${proj.projectAddress || 'الموقع الجغرافي قيد التحديث'}</span>
            </p>
          </div>

          <!-- Construction Progress Micro-bar -->
          <div class="construction-progress-pod">
            <div class="progress-lbl-row">
              <span class="prog-title">نسبة الإنجاز الإنشائي:</span>
              <span class="prog-val">${progressPct}%</span>
            </div>
            <div class="progress-track">
              <div class="progress-fill" style="width: ${progressPct}%"></div>
            </div>
          </div>

          <!-- Units Status Breakdown Pills -->
          <div class="units-breakdown-row">
            <div class="u-pill pill-available">
              <span class="u-dot dot-available"></span>
              <span class="u-num">${availUnits}</span>
              <span class="u-lbl">متاحة</span>
            </div>
            <div class="u-pill pill-reserved">
              <span class="u-dot dot-reserved"></span>
              <span class="u-num">${resUnits}</span>
              <span class="u-lbl">محجوزة</span>
            </div>
            <div class="u-pill pill-sold">
              <span class="u-dot dot-sold"></span>
              <span class="u-num">${soldUnits}</span>
              <span class="u-lbl">مباعة</span>
            </div>
          </div>

          <!-- Tree Metrics 4-Cell Grid -->
          <div class="tree-metrics-bar">
            <div class="metric-cell">
              <span class="m-val">${bldCount}</span>
              <span class="m-lbl">مباني</span>
            </div>
            <div class="metric-cell">
              <span class="m-val">${unitsCount}</span>
              <span class="m-lbl">وحدات</span>
            </div>
            <div class="metric-cell">
              <span class="m-val">${plansCount}</span>
              <span class="m-lbl">خطط سداد</span>
            </div>
            <div class="metric-cell">
              <span class="m-val">${stages.length}</span>
              <span class="m-lbl">مراحل بناء</span>
            </div>
          </div>

          <!-- Assigned Team Box (أسماء المهندس، السيلز، المحاسب) -->
          <div class="card-assigned-team-box">
            <div class="team-box-header">
              <div class="team-box-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                <span>فريق عمل المشروع</span>
              </div>
              <span class="team-total-badge ${totalAssignedStaff > 0 ? 'badge-has-team' : 'badge-no-team'}">
                ${totalAssignedStaff > 0 ? `${totalAssignedStaff} مخصص` : 'غير محدد'}
              </span>
            </div>

            <div class="team-members-list">
              <!-- Engineer -->
              <div class="team-member-row ${engNames.length > 0 ? 'row-assigned' : 'row-empty'}">
                <div class="role-identity">
                  <span class="role-tag-badge badge-eng">👷‍♂️ المهندس</span>
                </div>
                <div class="member-display" title="${engNames.join('، ') || 'لم يتم تعيين مهندس بعد'}">
                  ${engNames.length > 0 
                    ? `<span class="member-name-text">${engNames.join('، ')}</span>`
                    : `<span class="member-unassigned-text">غير معين</span>`
                  }
                </div>
              </div>

              <!-- Sales -->
              <div class="team-member-row ${salesNames.length > 0 ? 'row-assigned' : 'row-empty'}">
                <div class="role-identity">
                  <span class="role-tag-badge badge-sales">👔 السيلز</span>
                </div>
                <div class="member-display" title="${salesNames.join('، ') || 'لم يتم تعيين سيلز بعد'}">
                  ${salesNames.length > 0 
                    ? `<span class="member-name-text">${salesNames.join('، ')}</span>`
                    : `<span class="member-unassigned-text">غير معين</span>`
                  }
                </div>
              </div>

              <!-- Accountant -->
              <div class="team-member-row ${accNames.length > 0 ? 'row-assigned' : 'row-empty'}">
                <div class="role-identity">
                  <span class="role-tag-badge badge-acc">💼 المحاسب</span>
                </div>
                <div class="member-display" title="${accNames.join('، ') || 'لم يتم تعيين محاسب بعد'}">
                  ${accNames.length > 0 
                    ? `<span class="member-name-text">${accNames.join('، ')}</span>`
                    : `<span class="member-unassigned-text">غير معين</span>`
                  }
                </div>
              </div>
            </div>
          </div>

          <!-- Action Footer Bar -->
          <div class="tree-card-footer">
            <a href="/crs/development/project?id=${proj.id}" class="btn-card-manage">
              <span>إدارة المباني والوحدات</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
            <div class="card-quick-actions">
              <a href="/crs/sales" class="btn-sub-action">المبيعات CRM</a>
              <a href="/crs/construction" class="btn-sub-action">الإنشاءات</a>
              <a href="/crs/development/project?id=${proj.id}#plans" class="btn-sub-action">خطط السداد</a>
            </div>
          </div>
        </div>
      `;
    }).join('');

    // Attach click handlers for Edit Project
    document.querySelectorAll('.btn-edit-proj').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = e.currentTarget.getAttribute('data-id');
        openEditProjectModal(id);
      });
    });

    // Attach click handlers for Archive / Restore Project
    document.querySelectorAll('.btn-archive-proj, .btn-restore-proj').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const id = e.currentTarget.getAttribute('data-id');
        const isArchived = e.currentTarget.getAttribute('data-archived') === 'true';
        const name = e.currentTarget.getAttribute('data-name');
        
        const confirmMsg = isArchived
          ? `هل ترغب في استعادة مشروع "${name}" من الأرشيف إلى قائمة المشاريع النشطة؟`
          : `هل ترغب في أرشفة مشروع "${name}"؟ (يمكنك استعادته في أي وقت لاحقاً)`;
          
        if (!confirm(confirmMsg)) return;

        try {
          const res = await fetch('/api/erp/development', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'archive_project',
              projectId: id,
              archived: !isArchived
            })
          });
          const data = await res.json();
          if (data.success) {
            showToast(data.message || (isArchived ? 'تم استعادة المشروع بنجاح' : 'تمت أرشفة المشروع بنجاح'), 'success');
            loadDevelopmentProjects();
          } else {
            showToast(data.error || 'فشلت عملية الأرشفة', 'error');
          }
        } catch (err) {
          showToast('حدث خطأ أثناء الاتصال بالخادم', 'error');
        }
      });
    });

    // Attach click handlers for Delete Project
    document.querySelectorAll('.btn-delete-proj').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = e.currentTarget.getAttribute('data-id');
        const name = e.currentTarget.getAttribute('data-name');
        openDeleteProjectModal(id, name);
      });
    });
  }

  // Open Edit Project Modal
  function openEditProjectModal(projectId) {
    const proj = allProjects.find(p => p.id === projectId);
    if (!proj) return;

    const modal = document.getElementById('edit-project-modal');
    document.getElementById('edit-proj-id').value = proj.id;
    document.getElementById('edit-proj-name').value = proj.projectName || '';

    const editTypeSelect = document.getElementById('edit-proj-type-select');
    const editTypeCustom = document.getElementById('edit-proj-type-custom');
    const standardTypes = ['مشروع سكني', 'مول تجاري', 'مبنى إداري'];
    if (!proj.projectType) {
      if (editTypeSelect) editTypeSelect.value = 'مشروع سكني';
      if (editTypeCustom) { editTypeCustom.value = ''; editTypeCustom.style.display = 'none'; }
    } else if (standardTypes.includes(proj.projectType)) {
      if (editTypeSelect) editTypeSelect.value = proj.projectType;
      if (editTypeCustom) { editTypeCustom.value = ''; editTypeCustom.style.display = 'none'; }
    } else {
      if (editTypeSelect) editTypeSelect.value = 'other';
      if (editTypeCustom) { editTypeCustom.value = proj.projectType; editTypeCustom.style.display = 'block'; }
    }

    document.getElementById('edit-proj-address').value = proj.projectAddress || '';
    document.getElementById('edit-proj-status').value = proj.status || 'under_development';
    document.getElementById('edit-proj-coordinates').value = proj.locationCoordinates || '';
    
    // Format dates for HTML date input YYYY-MM-DD
    const startInput = document.getElementById('edit-proj-start-date');
    const endInput = document.getElementById('edit-proj-end-date');
    if (startInput) startInput.value = proj.startDate ? proj.startDate.split('T')[0] : '';
    if (endInput) endInput.value = proj.expectedEndDate ? proj.expectedEndDate.split('T')[0] : '';

    // Populate team checkboxes with assigned staff
    const assignedIds = (proj.salesAssignments || []).map(a => a.userId || a.user?.id).filter(Boolean);
    populateModalTeams('edit-proj', assignedIds);

    if (modal) modal.style.display = 'flex';
  }

  // Open Delete Project Confirmation Modal
  function openDeleteProjectModal(projectId, projectName) {
    const proj = allProjects.find(p => p.id === projectId);
    if (proj && !proj.archived) {
      showToast('لا يمكن حذف المشروع إلا بعد أرشفته أولاً', 'error');
      return;
    }
    const modal = document.getElementById('delete-project-modal');
    document.getElementById('delete-proj-id').value = projectId;
    document.getElementById('delete-proj-name').textContent = projectName || 'المشروع المحدد';
    if (modal) modal.style.display = 'flex';
  }

  // Modals & Tabs toggles
  const newProjModal = document.getElementById('project-modal');
  const openProjBtn = document.getElementById('open-new-project-modal');
  const closeProjBtn = document.getElementById('close-project-modal');
  const cancelProjBtn = document.getElementById('cancel-proj-btn');

  const editProjModal = document.getElementById('edit-project-modal');
  const closeEditBtn = document.getElementById('close-edit-modal');
  const cancelEditBtn = document.getElementById('cancel-edit-proj-btn');
  const editProjForm = document.getElementById('edit-project-form');

  const deleteProjModal = document.getElementById('delete-project-modal');
  const closeDeleteBtn = document.getElementById('close-delete-modal');
  const cancelDeleteBtn = document.getElementById('cancel-delete-proj-btn');
  const confirmDeleteBtn = document.getElementById('confirm-delete-proj-btn');

  // Project Type Select Handlers (Show/Hide Custom Input)
  const newTypeSelect = document.getElementById('proj-type-select');
  const newTypeCustom = document.getElementById('proj-type-custom');
  bindCustomTypeToggle(newTypeSelect, newTypeCustom);

  const editTypeSelect = document.getElementById('edit-proj-type-select');
  const editTypeCustom = document.getElementById('edit-proj-type-custom');
  bindCustomTypeToggle(editTypeSelect, editTypeCustom);

  if (openProjBtn) {
    openProjBtn.onclick = () => {
      if (newProjModal) {
        newProjModal.style.display = 'flex';
        // Reset fields
        if (newTypeSelect) newTypeSelect.value = 'مشروع سكني';
        if (newTypeCustom) { newTypeCustom.value = ''; newTypeCustom.style.display = 'none'; }

        // Populate team checkboxes (none checked initially)
        populateModalTeams('new-proj', []);
      }
    };
  }
  if (closeProjBtn) closeProjBtn.onclick = () => { if (newProjModal) newProjModal.style.display = 'none'; };
  if (cancelProjBtn) cancelProjBtn.onclick = () => { if (newProjModal) newProjModal.style.display = 'none'; };

  if (closeEditBtn) closeEditBtn.onclick = () => { if (editProjModal) editProjModal.style.display = 'none'; };
  if (cancelEditBtn) cancelEditBtn.onclick = () => { if (editProjModal) editProjModal.style.display = 'none'; };

  if (closeDeleteBtn) closeDeleteBtn.onclick = () => { if (deleteProjModal) deleteProjModal.style.display = 'none'; };
  if (cancelDeleteBtn) cancelDeleteBtn.onclick = () => { if (deleteProjModal) deleteProjModal.style.display = 'none'; };

  // New Project Form Submit
  const newProjForm = document.getElementById('new-project-form');
  if (newProjForm) {
    newProjForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const saveBtn = document.getElementById('save-proj-btn');
      if (saveBtn) { saveBtn.disabled = true; saveBtn.textContent = 'جارٍ الإنشاء...'; }

      const projectName = document.getElementById('proj-name').value;
      const projectType = getSelectedTypeValue(newTypeSelect, newTypeCustom);
      const projectAddress = document.getElementById('proj-address').value;
      const startDate = document.getElementById('proj-start-date').value;
      const expectedEndDate = document.getElementById('proj-end-date').value;
      const assignedUserIds = getSelectedStaffIds('#project-modal');

      try {
        const res = await fetch('/api/erp/development', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'create_project',
            projectName,
            projectType,
            projectAddress,
            startDate,
            expectedEndDate,
            assignedUserIds
          })
        });
        const data = await res.json();
        if (data.success) {
          if (newProjModal) newProjModal.style.display = 'none';
          newProjForm.reset();
          if (newTypeSelect) newTypeSelect.value = 'مشروع سكني';
          if (newTypeCustom) newTypeCustom.style.display = 'none';
          showToast('تم إنشاء المشروع بنجاح 🏢✨', 'success');
          loadDevelopmentProjects();
        } else {
          showToast(data.error || 'فشل إنشاء المشروع', 'error');
        }
      } catch (err) {
        showToast('حدث خطأ في الاتصال بالخادم', 'error');
      } finally {
        if (saveBtn) { saveBtn.disabled = false; saveBtn.textContent = 'تأكيد وبدء التفريع'; }
      }
    });
  }

  // Edit Project Form Submit
  if (editProjForm) {
    editProjForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const saveBtn = document.getElementById('save-edit-proj-btn');
      if (saveBtn) { saveBtn.disabled = true; saveBtn.textContent = 'جارٍ الحفظ...'; }

      const projectId = document.getElementById('edit-proj-id').value;
      const projectName = document.getElementById('edit-proj-name').value;
      const projectType = getSelectedTypeValue(editTypeSelect, editTypeCustom);
      const projectAddress = document.getElementById('edit-proj-address').value;
      const status = document.getElementById('edit-proj-status').value;
      const locationCoordinates = document.getElementById('edit-proj-coordinates').value;
      const startDate = document.getElementById('edit-proj-start-date').value;
      const expectedEndDate = document.getElementById('edit-proj-end-date').value;
      const assignedUserIds = getSelectedStaffIds('#edit-project-modal');

      try {
        const res = await fetch('/api/erp/development', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'update_project',
            projectId,
            projectName,
            projectType,
            projectAddress,
            status,
            locationCoordinates,
            startDate,
            expectedEndDate,
            assignedUserIds
          })
        });
        const data = await res.json();
        if (data.success) {
          if (editProjModal) editProjModal.style.display = 'none';
          showToast('تم حفظ التعديلات وتحديث فريق العمل بنجاح ✅', 'success');
          loadDevelopmentProjects();
        } else {
          showToast(data.error || 'فشل في حفظ التعديلات', 'error');
        }
      } catch (err) {
        showToast('حدث خطأ في الاتصال أثناء حفظ التعديلات', 'error');
      } finally {
        if (saveBtn) {
          saveBtn.disabled = false;
          saveBtn.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            حفظ التعديلات
          `;
        }
      }
    });
  }

  // Delete Project Confirmation Click
  if (confirmDeleteBtn) {
    confirmDeleteBtn.addEventListener('click', async () => {
      const projectId = document.getElementById('delete-proj-id').value;
      if (!projectId) return;

      confirmDeleteBtn.disabled = true;
      confirmDeleteBtn.textContent = 'جارٍ الحذف...';

      try {
        const res = await fetch('/api/erp/development', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'delete_project',
            projectId
          })
        });
        const data = await res.json();
        if (data.success) {
          if (deleteProjModal) deleteProjModal.style.display = 'none';
          showToast('تم حذف المشروع نهائياً بنجاح 🗑️', 'success');
          loadDevelopmentProjects();
        } else {
          showToast(data.error || 'تعذر حذف المشروع', 'error');
        }
      } catch (err) {
        showToast('حدث خطأ أثناء محاولة حذف المشروع', 'error');
      } finally {
        confirmDeleteBtn.disabled = false;
        confirmDeleteBtn.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
          تأكيد الحذف النهائي
        `;
      }
    });
  }

  // Filter Pills (النشطة - المؤرشفة - الكل)
  document.querySelectorAll('.filter-pill-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      document.querySelectorAll('.filter-pill-btn').forEach(b => b.classList.remove('active'));
      e.currentTarget.classList.add('active');
      currentFilter = e.currentTarget.getAttribute('data-filter') || 'active';
      loadDevelopmentProjects();
    });
  });

  // Real-time Search Input
  const searchInput = document.getElementById('project-search-input');
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchQuery = e.target.value.trim().toLowerCase();
      renderProjects();
    });
  }

</script>

