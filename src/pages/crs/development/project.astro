            </button>
          `;
        } else {
          let paidPct = 0;
          if (activeRes) {
            const dp = activeRes.downPayment || 0;
            const instPaid = (activeRes.scheduledInstallments || []).reduce((sum, i) => sum + (i.paidAmount || (i.status === 'paid' ? i.amount : 0)), 0);
            const totalPaid = dp + instPaid;
            paidPct = activeRes.totalPrice > 0 ? Math.round((totalPaid / activeRes.totalPrice) * 100) : 0;
          }
          installmentActionBtn = `
            <button type="button" class="btn-statement-open" data-unit-id="${u.id}" title="كشف حساب الأقساط والتحصيل">
