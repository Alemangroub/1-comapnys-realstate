<script>
  import { checkAuth } from '../../../lib/auth.js';

  let currentProject = null;
  let allUnits = [];
  let allBuildings = [];
  let allProjectsList = [];
  let generatedUnitsBatch = [];
  let currentViewMode = 'table'; // 'table' or 'grid'

  // Extract projectId from URL search params
  const urlParams = new URLSearchParams(window.location.search);
  const projectId = urlParams.get('id');

  const authLoading = document.getElementById('auth-loading-message');
  const loginContainer = document.getElementById('admin-login-container');
  const mainContent = document.getElementById('main-content');

  // Verify Admin Auth
  (async () => {
    try {
      const user = await checkAuth();
      if (authLoading) authLoading.style.display = 'none';

      if (user && user.role === 'admin') {
        if (!projectId) {
          alert('معرف المشروع مفقود');
          window.location.href = '/crs/development';
          return;
        }

        if (mainContent) mainContent.style.display = 'block';
        await loadProjectDetails(projectId);
        await loadAllProjectsForBuildingModal();
      } else {
        if (loginContainer) loginContainer.style.display = 'block';
      }
    } catch (e) {
      if (authLoading) authLoading.style.display = 'none';
      if (loginContainer) loginContainer.style.display = 'block';
    }
  })();

  // Load all projects for building dropdown
  async function loadAllProjectsForBuildingModal() {
    try {
      const res = await fetch('/api/erp/development?archived=false');
      const data = await res.json();
      if (data.success && data.projects) {
        allProjectsList = data.projects;
        populateBuildingProjectSelect();
      }
    } catch (e) {
      console.error('Failed to load projects for building select:', e);
    }
  }

  function populateBuildingProjectSelect() {
    const projSelect = document.getElementById('bld-project-select');
    if (!projSelect) return;
    projSelect.innerHTML = allProjectsList.map(p => `
      <option value="${p.id}" ${p.id === projectId ? 'selected' : ''}>
        ${p.projectName}
      </option>
    `).join('');
  }

  // Fetch Project Details with Buildings and Units
  async function loadProjectDetails(id) {
    try {
      const res = await fetch(`/api/erp/development?projectId=${id}`);
      const data = await res.json();
      if (data.success && data.project) {
        currentProject = data.project;
        allBuildings = currentProject.buildings || [];
        allUnits = currentProject.units || [];

        renderProjectHeader();
        populateBuildingSelects();
        renderUnits();
      } else {
        alert(data.error || 'فشل تحميل بيانات المشروع');
      }
    } catch (err) {
      console.error('Failed to load project details:', err);
    }
  }

  // Render Project Identity & KPI Ribbon
  function renderProjectHeader() {
    if (!currentProject) return;

    document.getElementById('crumb-project-name').textContent = currentProject.projectName;
    document.getElementById('hero-project-name').textContent = currentProject.projectName;
    document.getElementById('hero-project-address').textContent = currentProject.projectAddress || 'الموقع الجغرافي قيد التحديث';

    // Buildings Chips
    const chipsContainer = document.getElementById('project-buildings-chips');
    if (chipsContainer) {
      chipsContainer.innerHTML = allBuildings.map(bld => `
        <span class="bld-chip-badge">
          🏢 ${bld.name} (${bld.units ? bld.units.length : 0} وحدة)
        </span>
      `).join('');
    }

    // Calculate Unit KPIs
    const totalCount = allUnits.length;
    let availableCount = 0;
    let reservedCount = 0;
    let soldCount = 0;
    let portfolioSum = 0;

    allUnits.forEach(u => {
      const status = u.status || 'available';
      if (status === 'available') availableCount++;
      else if (status === 'reserved') reservedCount++;
      else if (status === 'sold') soldCount++;

      portfolioSum += (u.totalPrice || 0);
    });

    document.getElementById('kpi-total-units').textContent = totalCount;
    document.getElementById('kpi-available-units').textContent = availableCount;
    document.getElementById('kpi-reserved-units').textContent = reservedCount;
    document.getElementById('kpi-sold-units').textContent = soldCount;
    document.getElementById('kpi-total-portfolio-val').textContent = portfolioSum.toLocaleString('ar-EG') + ' ج.م';
  }

  // Populate Building Dropdowns in Filter & Unit Modal
  function populateBuildingSelects() {
    const filterSelect = document.getElementById('filter-building-select');
    const modalSelect = document.getElementById('unit-bld-select');

    const optionsHtml = allBuildings.map(b => `<option value="${b.id}">${b.name}</option>`).join('');

    if (filterSelect) {
      filterSelect.innerHTML = `<option value="all">جميع المباني والمكونات</option>` + optionsHtml;
    }

    if (modalSelect) {
      modalSelect.innerHTML = allBuildings.length > 0 
        ? optionsHtml 
        : `<option value="">-- لا يوجد مباني مسجلة (أضف مبنى أولاً) --</option>`;
    }
  }

  // Filter Units based on Controls
  function getFilteredUnits() {
    const bldFilter = document.getElementById('filter-building-select')?.value || 'all';
    const statusFilter = document.getElementById('filter-status-select')?.value || 'all';
    const typeFilter = document.getElementById('filter-type-select')?.value || 'all';
    const searchFilter = (document.getElementById('filter-search-input')?.value || '').trim().toLowerCase();

    return allUnits.filter(u => {
      if (bldFilter !== 'all' && u.buildingId !== bldFilter) return false;
      if (statusFilter !== 'all' && (u.status || 'available') !== statusFilter) return false;
      if (typeFilter !== 'all' && u.unitType !== typeFilter) return false;
      if (searchFilter && !u.unitNumber.toLowerCase().includes(searchFilter)) return false;
      return true;
    });
  }

  // Render Units in Table and Grid
  function renderUnits() {
    const filtered = getFilteredUnits();
    const tableContainer = document.getElementById('units-table-container');
    const gridContainer = document.getElementById('units-grid-container');
    const emptyState = document.getElementById('units-empty-state');
    const tbody = document.getElementById('units-tbody');

    if (filtered.length === 0) {
      if (tableContainer) tableContainer.style.display = 'none';
      if (gridContainer) gridContainer.style.display = 'none';
      if (emptyState) emptyState.style.display = 'block';
      return;
    }

    if (emptyState) emptyState.style.display = 'none';

    if (currentViewMode === 'table') {
      if (tableContainer) tableContainer.style.display = 'block';
      if (gridContainer) gridContainer.style.display = 'none';
    } else {
      if (tableContainer) tableContainer.style.display = 'none';
      if (gridContainer) gridContainer.style.display = 'grid';
    }

    // Render Table Body
    if (tbody) {
      tbody.innerHTML = filtered.map(u => {
        const bld = allBuildings.find(b => b.id === u.buildingId);
        const bldName = bld ? bld.name : 'غير محدد';
        const status = u.status || 'available';
        const isChecked = selectedUnitIds.has(u.id);

        let statusTag = '';
        if (status === 'available') statusTag = `<span class="status-tag tag-available">🟢 متاح</span>`;
        else if (status === 'reserved') statusTag = `<span class="status-tag tag-reserved">🟡 محجوز</span>`;
        else if (status === 'sold') statusTag = `<span class="status-tag tag-sold">🔴 مباع</span>`;

        const typeLabels = {
          residential: 'شقة سكنية',
          duplex: 'دوبلكس',
          penthouse: 'بنتهاوس',
          commercial: 'محل تجاري',
          administrative: 'مكتب إداري',
          villa: 'فيلا'
        };

        const planBtn = u.planImage
          ? `<button type="button" class="btn-plan-view open-plan-btn" data-unit-id="${u.id}">📐 معاينة وطباعة</button>`
          : `<button type="button" class="btn-plan-none open-edit-plan-btn" data-unit-id="${u.id}">+ إضافة</button>`;

        const gardenBadge = u.gardenArea && u.gardenArea > 0
          ? `<span class="garden-sub-tag">🏡 جنينة: ${u.gardenArea} م²</span>`
          : '';

        const activeRes = u.reservations && u.reservations.length > 0 ? u.reservations[0] : null;
        let installmentActionBtn = '';
        if (status === 'available') {
          installmentActionBtn = `
            <button type="button" class="btn-contract-wizard-open" data-unit-id="${u.id}" title="حجز الشقة وجدولة الأقساط">
