    const startDate = document.getElementById('contract-start-date')?.value;

    try {
      const res = await fetch('/api/erp/collection', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'preview_schedule',
          totalPrice,
          downPaymentAmount,
          installmentYears,
          frequency,
          startDate,
          maintenancePercent
        })
      });

      const data = await res.json();
      if (data.success) {
        currentGeneratedSchedule = data.schedule;
