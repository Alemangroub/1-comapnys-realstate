  });

  // ========================================================
  // 📊 كشف الحساب والمتابعة المالية الشاملة للوحدة
  // ========================================================

  async function openUnitStatement(unitId) {
    try {
      const res = await fetch(`/api/erp/collection?unitId=${unitId}`);
      const data = await res.json();

      if (!data.success || !data.hasReservation) {
        alert(data.error || 'لا يوجد تعاقد نشط مسجل لهذه الوحدة بعد. يمكنك النقر على "حجز وتقسيط" لإنشاء عقد وجدول أقساط.');
        return;
      }

      currentStatementData = data;
      renderStatementModal();
      if (statementModal) statementModal.style.display = 'flex';
    } catch (err) {
      console.error('Error fetching statement:', err);
      alert('فشل تحميل كشف حساب الوحدة');
    }
  }

  function renderStatementModal() {
    if (!currentStatementData) return;

    const { unit, reservation, installments, summary, treasuries } = currentStatementData;
    const bld = allBuildings.find(b => b.id === unit.buildingId);
    const bldName = bld ? bld.name : 'العمارة';

    // Header info
    document.getElementById('stmt-unit-title').textContent = `${unit.unitNumber} (${bldName})`;
    document.getElementById('stmt-client-name').textContent = reservation.clientName || 'عميل كريم';
    document.getElementById('stmt-client-phone').textContent = reservation.clientPhone || '--';

    // Print header info
    document.getElementById('stmt-print-date').textContent = new Date().toLocaleDateString('ar-EG');
    document.getElementById('stmt-print-unit').textContent = `${unit.unitNumber} - ${bldName}`;
    document.getElementById('stmt-print-project').textContent = currentProject?.projectName || 'مشروع سكني';

    // KPIs
    document.getElementById('stmt-total-price').textContent = `${(summary.totalPrice || 0).toLocaleString('ar-EG')} ج.م`;
    document.getElementById('stmt-down-payment-sub').textContent = `المقدم: ${(summary.downPayment || 0).toLocaleString('ar-EG')} ج.م`;

    document.getElementById('stmt-total-paid').textContent = `${(summary.totalPaid || 0).toLocaleString('ar-EG')} ج.م`;
    document.getElementById('stmt-paid-count-sub').textContent = `${summary.paidCount || 0} أقساط مسددة بالكامل`;

    document.getElementById('stmt-total-remaining').textContent = `${(summary.totalRemaining || 0).toLocaleString('ar-EG')} ج.م`;
    document.getElementById('stmt-pending-count-sub').textContent = `${summary.pendingCount || 0} أقساط متبقية`;

    // Overdue Indicator
    const overdueCard = document.getElementById('stmt-overdue-card');
    const statusIndicator = document.getElementById('stmt-status-indicator');
    const overdueSub = document.getElementById('stmt-overdue-sub');

    if (summary.overdueCount > 0) {
      overdueCard.className = 'stmt-kpi-card card-overdue';
      statusIndicator.textContent = 'متأخر في السداد 🔴';
      statusIndicator.className = 'kpi-val text-danger';
      overdueSub.textContent = `${summary.overdueCount} قسط متأخر بقيمة ${summary.overdueAmount.toLocaleString('ar-EG')} ج.م`;
    } else {
      overdueCard.className = 'stmt-kpi-card card-paid';
      statusIndicator.textContent = 'ملتزم بالسداد 🟢';
      statusIndicator.className = 'kpi-val text-success';
      overdueSub.textContent = 'لا توجد أقساط متأخرة حالياً';
    }

    // Progress Bar
    const pct = summary.paidPercentage || 0;
    document.getElementById('stmt-progress-pct-text').textContent = `${pct}%`;
    const fillBar = document.getElementById('stmt-progress-bar');
    if (fillBar) fillBar.style.width = `${pct}%`;

    // Counts for filter chips
    document.getElementById('count-all-inst').textContent = installments.length;
    document.getElementById('count-pending-inst').textContent = installments.filter(i => i.status !== 'paid').length;
    document.getElementById('count-paid-inst').textContent = installments.filter(i => i.status === 'paid').length;
    document.getElementById('count-overdue-inst').textContent = summary.overdueCount || 0;

    renderStatementTable();
  }

  function renderStatementTable() {
    if (!currentStatementData) return;
    const { installments, reservation, unit } = currentStatementData;
    const tbody = document.getElementById('statement-tbody');
    if (!tbody) return;

    let filtered = installments;
    if (statementActiveFilter === 'pending') {
      filtered = installments.filter(i => i.status !== 'paid');
    } else if (statementActiveFilter === 'paid') {
      filtered = installments.filter(i => i.status === 'paid');
    } else if (statementActiveFilter === 'overdue') {
      filtered = installments.filter(i => i.isOverdue);
    }

    if (filtered.length === 0) {
      tbody.innerHTML = `<tr><td colspan="7" style="text-align: center; padding: 2rem; color: #94a3b8;">لا توجد أقساط مطابقة لهذا الفلتر</td></tr>`;
      return;
    }

    const cleanPhone = (reservation.clientPhone || '').replace(/\D/g, '').replace(/^0/, '');
    const projectName = currentProject?.projectName || 'مشروعنا';

    tbody.innerHTML = filtered.map(inst => {
      const isPaid = inst.status === 'paid';
      const isPartiallyPaid = inst.status === 'partially_paid';
      const isOverdue = inst.isOverdue;
      const isDueThisMonth = inst.isDueThisMonth;

      let statusBadge = '';
      if (isPaid) {
        statusBadge = `<span class="status-badge badge-paid">🟢 مسدد بالكامل</span>`;
      } else if (isOverdue) {
        statusBadge = `<span class="status-badge badge-overdue">🔴 متأخر ⚠️</span>`;
      } else if (isDueThisMonth) {
        statusBadge = `<span class="status-badge badge-due">🟡 مستحق هذا الشهر</span>`;
      } else {
        statusBadge = `<span class="status-badge" style="background: #f1f5f9; color: #475569;">مستحق</span>`;
      }

      const dueFormatted = new Date(inst.dueDate).toLocaleDateString('ar-EG');
      const paidFormatted = inst.paidDate ? new Date(inst.paidDate).toLocaleDateString('ar-EG') : '';

      // Compose Polite Arabic WhatsApp Reminder
      const waMessage = `عزيزنا العميل/ ${reservation.clientName}،
تحية طيبة من شركة إنجاز للتطوير العقاري.
نود تذكير سيادتكم باستحقاق (${inst.title}) الخاص بالوحدة رقم (${unit.unitNumber}) بمشروع (${projectName}).
المبلغ المطلوب: ${inst.amount.toLocaleString('ar-EG')} جنيه مصري
تاريخ الاستحقاق: ${dueFormatted}
شاكرين لسيادتكم حسن تعاونكم والالتزام بمواعيد السداد.
للاستفسار أو تأكيد التحويل نرجو التواصل معنا على هذا الرقم.`;

      const waUrl = `https://wa.me/20${cleanPhone}?text=${encodeURIComponent(waMessage)}`;

      return `
        <tr style="${isOverdue ? 'background: #fffbfa;' : ''}">
          <td><strong>${inst.installmentNumber}</strong></td>
          <td><strong>${inst.title}</strong></td>
          <td><span style="font-family: monospace; font-weight: 700;">${dueFormatted}</span></td>
          <td><strong style="color: #059669; font-size: 0.95rem;">${inst.amount.toLocaleString('ar-EG')} ج.م</strong></td>
          <td>
            ${isPaid || isPartiallyPaid ? `
              <div>
                <strong style="color: #15803d;">${(inst.paidAmount || inst.amount).toLocaleString('ar-EG')} ج.م</strong>
                <div style="font-size: 0.72rem; color: #64748b;">بتاريخ ${paidFormatted} (${inst.receiptNumber || 'إيصال'})</div>
              </div>
            ` : `<span style="color: #94a3b8;">لم يسدد</span>`}
          </td>
          <td>${statusBadge}</td>
          <td class="no-print">
            <div class="stmt-actions-cell">
              ${!isPaid ? `
                <button type="button" class="btn-stmt-pay btn-open-quick-pay" data-inst-id="${inst.id}">
                  سداد القسط 💳
                </button>
                <a href="${waUrl}" target="_blank" class="btn-whatsapp-remind" title="إرسال رسالة تذكير عبر واتساب للعميل">
                  💬 تذكير واتساب
                </a>
              ` : `
                <button type="button" class="btn-plan-view btn-show-receipt" data-inst-id="${inst.id}" title="عرض إيصال السداد">
                  🧾 الإيصال
                </button>
              `}
            </div>
          </td>
        </tr>
      `;
    }).join('');
  }

  // Filter Chips in Statement
  document.querySelectorAll('.stmt-chip').forEach(chip => {
    chip.addEventListener('click', (e) => {
      document.querySelectorAll('.stmt-chip').forEach(c => c.classList.remove('active'));
      e.currentTarget.classList.add('active');
      statementActiveFilter = e.currentTarget.getAttribute('data-filter');
      renderStatementTable();
    });
  });

  // Delegate Statement Actions (Open Quick Pay or Show Receipt)
  document.addEventListener('click', (e) => {
    const payBtn = e.target.closest('.btn-open-quick-pay');
    if (payBtn) {
      const instId = payBtn.getAttribute('data-inst-id');
      openQuickPayModal(instId);
      return;
    }

    const receiptBtn = e.target.closest('.btn-show-receipt');
    if (receiptBtn) {
      const instId = receiptBtn.getAttribute('data-inst-id');
      showReceiptModal(instId);
      return;
    }
  });

  // Open Quick Pay Modal
  function openQuickPayModal(installmentId) {
    if (!currentStatementData) return;
    const inst = currentStatementData.installments.find(i => i.id === installmentId);
    if (!inst) return;

    const { reservation, unit, treasuries } = currentStatementData;

    document.getElementById('quick-pay-installment-id').value = inst.id;
    document.getElementById('quick-pay-inst-title').textContent = inst.title;
    document.getElementById('quick-pay-unit-code').textContent = unit.unitNumber;
    document.getElementById('quick-pay-client-name').textContent = reservation.clientName;

    const remainingDue = Math.max(0, inst.amount - (inst.paidAmount || 0));
    document.getElementById('quick-pay-due-amount').textContent = `${remainingDue.toLocaleString('ar-EG')} ج.م`;
    document.getElementById('quick-pay-actual-amount').value = remainingDue;
    document.getElementById('quick-pay-penalty').value = 0;
    document.getElementById('quick-pay-notes').value = '';

    // Populate Treasuries
    const treasurySelect = document.getElementById('quick-pay-treasury-select');
    if (treasuries && treasuries.length > 0) {
      treasurySelect.innerHTML = treasuries.map(tr => `
        <option value="${tr.id}">خزينة المشروع (${(tr.balance || 0).toLocaleString('ar-EG')} ج.م)</option>
      `).join('');
    } else {
      treasurySelect.innerHTML = `<option value="">الخزينة الرئيسية للمركز المالي</option>`;
    }

    if (quickPayModal) quickPayModal.style.display = 'flex';
  }

  // Submit Quick Pay Form
  document.getElementById('quick-pay-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const saveBtn = document.getElementById('btn-confirm-pay');
    const originalContent = saveBtn ? saveBtn.innerHTML : '';
    if (saveBtn) saveBtn.textContent = 'جارٍ تسجيل السداد وإصدار الإيصال...';

    const installmentId = document.getElementById('quick-pay-installment-id')?.value;
    const paidAmount = document.getElementById('quick-pay-actual-amount')?.value;
    const latePenalty = document.getElementById('quick-pay-penalty')?.value;
    const paymentMethod = document.getElementById('quick-pay-method')?.value;
    const treasuryId = document.getElementById('quick-pay-treasury-select')?.value;
    const notes = document.getElementById('quick-pay-notes')?.value;

    try {
      const res = await fetch('/api/erp/collection', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'pay_installment',
          installmentId,
          paidAmount,
          latePenalty,
          paymentMethod,
          treasuryId: treasuryId || null,
          notes
        })
      });

      const data = await res.json();
      if (data.success) {
        if (quickPayModal) quickPayModal.style.display = 'none';

        // Refresh Statement in background
        if (currentStatementData?.unit?.id) {
          const stmtRes = await fetch(`/api/erp/collection?unitId=${currentStatementData.unit.id}`);
          const stmtData = await stmtRes.json();
          if (stmtData.success) {
            currentStatementData = stmtData;
            renderStatementModal();
          }
        }

        // Show Printable Receipt
        if (data.receipt) {
          displayReceiptData(data.receipt);
        }

        // Refresh project list KPIs
        await loadProjectDetails(projectId);
      } else {
        alert(data.error || 'فشل تسجيل السداد');
      }
    } catch (err) {
      console.error('Error submitting payment:', err);
      alert('حدث خطأ أثناء الاتصال بالخادم');
    } finally {
      if (saveBtn) saveBtn.innerHTML = originalContent;
    }
  });

  // Show Printable Receipt Data
  function displayReceiptData(rc) {
    document.getElementById('receipt-modal-num').textContent = rc.receiptNumber || 'REC-000000';
    document.getElementById('receipt-modal-client').textContent = rc.clientName || 'العميل';
    document.getElementById('receipt-modal-phone').textContent = rc.clientPhone || '--';
    document.getElementById('receipt-modal-unit-project').textContent = `وحدة ${rc.unitNumber} - ${rc.projectName}`;
    document.getElementById('receipt-modal-title').textContent = rc.title || 'سداد قسط';

    const methodLabels = {
      cash: 'نقداً في مقر الشركة',
      bank_transfer: 'تحويل بنكي',
      vodafone_cash: 'محفظة إلكترونية (فودافون كاش)',
      cheque: 'شيك بنكي مقبول الدفع',
      online_card: 'بطاقة بنكية'
    };
    document.getElementById('receipt-modal-method').textContent = methodLabels[rc.paymentMethod] || rc.paymentMethod || 'نقداً';
    document.getElementById('receipt-modal-amount').textContent = `${(rc.amount || rc.actualAmount || 0).toLocaleString('ar-EG')} ج.م`;
    document.getElementById('receipt-modal-date').textContent = new Date(rc.date || Date.now()).toLocaleString('ar-EG');

    if (receiptModal) receiptModal.style.display = 'flex';
  }

  // Show existing receipt from statement table
  function showReceiptModal(installmentId) {
    if (!currentStatementData) return;
    const inst = currentStatementData.installments.find(i => i.id === installmentId);
    if (!inst) return;

    displayReceiptData({
      receiptNumber: inst.receiptNumber,
      clientName: currentStatementData.reservation?.clientName,
      clientPhone: currentStatementData.reservation?.clientPhone,
      unitNumber: currentStatementData.unit?.unitNumber,
      projectName: currentProject?.projectName,
      title: inst.title,
      paymentMethod: inst.paymentMethod,
      amount: inst.paidAmount || inst.amount,
      date: inst.paidDate
    });
  }
</script>
