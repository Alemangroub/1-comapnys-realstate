        const previewBox = document.getElementById('contract-schedule-preview-box');
        if (previewBox) previewBox.style.display = 'block';

        const countBadge = document.getElementById('prev-installments-count-badge');
        if (countBadge) countBadge.textContent = `${summary.totalInstallmentsCount} قسط (${summary.frequency === 'monthly' ? 'شهري' : summary.frequency === 'quarterly' ? 'ربع سنوي' : summary.frequency === 'semi_annual' ? 'نصف سنوي' : 'سنوي'})`;

        const amountText = document.getElementById('prev-installment-amount-text');
        if (amountText) amountText.textContent = `قيمة القسط: ${summary.perInstallmentAmount.toLocaleString('ar-EG')} ج.م`;

        const maintTag = document.getElementById('prev-maintenance-tag');
        if (maintTag) {
          maintTag.textContent = summary.maintenanceAmount > 0
            ? `وديعة الصيانة: ${summary.maintenanceAmount.toLocaleString('ar-EG')} ج.م`
