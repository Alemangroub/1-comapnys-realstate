            <td><strong class="unit-code-badge">${u.unitNumber}</strong></td>
            <td>🏢 ${bldName}</td>
            <td><span class="unit-type-pill">${typeLabels[u.unitType] || u.unitType}</span></td>
            <td>الدور ${u.floor === 0 ? 'الأرضي' : u.floor}</td>
            <td>
              <span style="font-weight: 700; color: #1e293b;">🛏️ ${u.roomsCount || 1} نوم</span>
              <span style="color: #64748b; font-size: 0.8rem; margin-right: 0.25rem;">· 🚿 ${u.bathroomsCount || 1} حمام</span>
            </td>
            <td>
              <span class="view-tag-badge">${u.view || 'على جنينة'}</span>
              <span class="finishing-tag-badge" style="margin-top: 0.2rem; display: block;">${u.finishingType || 'نصف تشطيب'}</span>
            </td>
            <td>
              <strong>${u.area}</strong> م²
              ${gardenBadge}
            </td>
            <td>${(u.pricePerMeter || 0).toLocaleString('ar-EG')} ج.م</td>
            <td><strong style="color: #059669; font-size: 1rem;">${(u.totalPrice || 0).toLocaleString('ar-EG')} ج.م</strong></td>
            <td>${planBtn}</td>
            <td>
              <select class="status-quick-select" data-unit-id="${u.id}">
                <option value="available" ${status === 'available' ? 'selected' : ''}>متاح 🟢</option>
                <option value="reserved" ${status === 'reserved' ? 'selected' : ''}>محجوز 🟡</option>
                <option value="sold" ${status === 'sold' ? 'selected' : ''}>مباع 🔴</option>
              </select>
            </td>
            <td>
              ${installmentActionBtn}
            </td>
            <td>
              <div class="unit-row-actions">
                <button type="button" class="btn-row-action btn-edit-unit" data-unit-id="${u.id}" title="تعديل مواصفات وتسعير الشقة">✏️</button>
                <button type="button" class="btn-row-action action-delete btn-del-unit" data-unit-id="${u.id}" title="حذف الشقة">🗑️</button>
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }

    // Render Grid Cards
    if (gridContainer) {
      gridContainer.innerHTML = filtered.map(u => {
        const bld = allBuildings.find(b => b.id === u.buildingId);
        const bldName = bld ? bld.name : 'البرج';
        const status = u.status || 'available';
        const isChecked = selectedUnitIds.has(u.id);

        let statusTag = '';
        if (status === 'available') statusTag = `<span class="status-tag tag-available">🟢 متاح</span>`;
        else if (status === 'reserved') statusTag = `<span class="status-tag tag-reserved">🟡 محجوز</span>`;
        else if (status === 'sold') statusTag = `<span class="status-tag tag-sold">🔴 مباع</span>`;

        const typeLabels = {
          residential: 'شقة سكنية',
          duplex: 'دوبلكس',
          penthouse: 'بنتهاوس',
          commercial: 'محل تجاري',
          administrative: 'مكتب إداري',
          villa: 'فيلا'
        };

        const planBtn = u.planImage
          ? `<button type="button" class="btn-plan-view open-plan-btn" data-unit-id="${u.id}">📐 البلان</button>`
          : `<button type="button" class="btn-plan-none open-edit-plan-btn" data-unit-id="${u.id}">+ رفع بلان</button>`;

        const gardenBadge = u.gardenArea && u.gardenArea > 0
          ? `<span class="garden-sub-tag">🏡 جنينة ${u.gardenArea} م²</span>`
          : '';

        const activeRes = u.reservations && u.reservations.length > 0 ? u.reservations[0] : null;
        let installmentActionBtn = '';
        if (status === 'available') {
          installmentActionBtn = `
            <button type="button" class="btn-contract-wizard-open" data-unit-id="${u.id}" title="حجز الشقة وجدولة الأقساط">
              💳 حجز وتقسيط
            </button>
          `;
        } else {
          let paidPct = 0;
          if (activeRes) {
            const dp = activeRes.downPayment || 0;
            const instPaid = (activeRes.scheduledInstallments || []).reduce((sum, i) => sum + (i.paidAmount || (i.status === 'paid' ? i.amount : 0)), 0);
            const totalPaid = dp + instPaid;
            paidPct = activeRes.totalPrice > 0 ? Math.round((totalPaid / activeRes.totalPrice) * 100) : 0;
          }
          installmentActionBtn = `
            <button type="button" class="btn-statement-open" data-unit-id="${u.id}" title="كشف حساب الأقساط والتحصيل">
              📊 الأقساط (${paidPct}%)
            </button>
          `;
        }

        return `
          <div class="unit-card status-${status} ${isChecked ? 'card-selected' : ''}">
            <div class="unit-card-header">
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <input type="checkbox" class="unit-row-chk" data-unit-id="${u.id}" ${isChecked ? 'checked' : ''} style="cursor: pointer; width: 17px; height: 17px;" />
                <div>
                  <h4 class="card-unit-title">${u.unitNumber}</h4>
                  <p class="card-bld-name">🏢 ${bldName} · ${typeLabels[u.unitType] || u.unitType}</p>
                </div>
              </div>
              ${statusTag}
            </div>

            <div class="unit-specs-row">
              <div class="spec-item">
                <span class="spec-lbl">المساحة</span>
                <span class="spec-val">${u.area} م²</span>
              </div>
              <div class="spec-item">
                <span class="spec-lbl">الدور</span>
                <span class="spec-val">${u.floor === 0 ? 'أرضي' : u.floor}</span>
              </div>
              <div class="spec-item">
                <span class="spec-lbl">التقسيم</span>
                <span class="spec-val">${u.roomsCount || 3}غ · ${u.bathroomsCount || 2}ح</span>
              </div>
            </div>

            <div style="display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.75rem;">
              <span class="view-tag-badge">${u.view || 'على جنينة'}</span>
              <span class="finishing-tag-badge">${u.finishingType || 'نصف تشطيب'}</span>
              ${gardenBadge}
            </div>

            <div class="unit-card-price-pod">
              <div class="price-lbl-group">
                <span class="price-lbl">سعر المتر: ${(u.pricePerMeter || 0).toLocaleString('ar-EG')} ج.م</span>
                <span class="price-total-str" style="color: #059669;">${(u.totalPrice || 0).toLocaleString('ar-EG')} ج.م</span>
              </div>
              <div style="display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;">
                ${installmentActionBtn}
                ${planBtn}
                <button type="button" class="btn-row-action btn-edit-unit" data-unit-id="${u.id}" title="تعديل الشقة">✏️</button>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    // Attach event listeners for checkboxes
    document.querySelectorAll('.unit-row-chk').forEach(chk => {
      chk.addEventListener('change', (e) => {
        const id = e.target.getAttribute('data-unit-id');
        if (e.target.checked) {
          selectedUnitIds.add(id);
        } else {
          selectedUnitIds.delete(id);
        }
        updateBulkBarState();
      });
    });

    // Attach quick status change listeners
    document.querySelectorAll('.status-quick-select').forEach(sel => {
      sel.addEventListener('change', async (e) => {
        const unitId = e.target.getAttribute('data-unit-id');
        const newStatus = e.target.value;
        await updateUnitStatus(unitId, newStatus);
      });
    });

    // Attach Edit button listeners
    document.querySelectorAll('.btn-edit-unit, .open-edit-plan-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = e.currentTarget.getAttribute('data-unit-id');
        openUnitModalForEdit(id);
      });
    });

    // Attach Delete button listeners
    document.querySelectorAll('.btn-del-unit').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = e.currentTarget.getAttribute('data-unit-id');
        const unit = allUnits.find(u => u.id === id);
        const code = unit ? unit.unitNumber : '';
        if (confirm(`هل أنت متأكد من حذف الشقة [${code}] نهائياً؟`)) {
          await deleteUnit(id);
        }
      });
    });

    // Attach Plan View Modal listeners
    document.querySelectorAll('.open-plan-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const id = e.currentTarget.getAttribute('data-unit-id');
        openPlanViewModal(id);
      });
    });

    updateBulkBarState();
  }

  // ========================================================
  // BULK SELECTION & BULK UPDATE LOGIC
  // ========================================================
  let selectedUnitIds = new Set();

  function updateBulkBarState() {
    const bar = document.getElementById('bulk-actions-bar');
    const countBadge = document.getElementById('selected-units-count');
    const selectAllChk = document.getElementById('select-all-units-chk');
    const filtered = getFilteredUnits();

    const count = selectedUnitIds.size;
    if (countBadge) countBadge.textContent = count;

    if (bar) {
      bar.style.display = count > 0 ? 'flex' : 'none';
    }

    if (selectAllChk && filtered.length > 0) {
      selectAllChk.checked = filtered.every(u => selectedUnitIds.has(u.id));
    }
  }

  // Select All Checkbox Handler
  document.getElementById('select-all-units-chk')?.addEventListener('change', (e) => {
    const isChecked = e.target.checked;
    const filtered = getFilteredUnits();
    if (isChecked) {
      filtered.forEach(u => selectedUnitIds.add(u.id));
    } else {
      filtered.forEach(u => selectedUnitIds.delete(u.id));
    }
    renderUnits();
  });

  // Clear Selection
  document.getElementById('btn-clear-selection')?.addEventListener('click', () => {
    selectedUnitIds.clear();
    renderUnits();
  });

  // Open Bulk Edit Modal
  const bulkModal = document.getElementById('bulk-edit-modal');
  document.getElementById('btn-open-bulk-edit')?.addEventListener('click', () => {
    if (selectedUnitIds.size === 0) return;
    const countBadge = document.getElementById('bulk-modal-count-badge');
    if (countBadge) countBadge.textContent = `${selectedUnitIds.size} شقة`;
    updateBulkAutoCalculatedTotal();
    if (bulkModal) bulkModal.style.display = 'flex';
  });

  document.getElementById('close-bulk-modal')?.addEventListener('click', () => {
    if (bulkModal) bulkModal.style.display = 'none';
  });
  document.getElementById('btn-cancel-bulk-edit')?.addEventListener('click', () => {
    if (bulkModal) bulkModal.style.display = 'none';
  });

  // Live Auto-calc for Bulk Modal
  const bulkAreaInput = document.getElementById('bulk-area-input');
  const bulkPpmInput = document.getElementById('bulk-ppm-input');
  const bulkAutoTotalText = document.getElementById('bulk-auto-total-text');

  function updateBulkAutoCalculatedTotal() {
    const area = parseFloat(bulkAreaInput?.value) || 0;
    const ppm = parseFloat(bulkPpmInput?.value) || 0;
    const total = area * ppm;
    if (bulkAutoTotalText) {
      bulkAutoTotalText.textContent = total.toLocaleString('ar-EG');
    }
  }

  bulkAreaInput?.addEventListener('input', updateBulkAutoCalculatedTotal);
  bulkPpmInput?.addEventListener('input', updateBulkAutoCalculatedTotal);

  // Submit Bulk Edit Form
  document.getElementById('bulk-edit-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('btn-submit-bulk-edit');
    const originalText = btn ? btn.textContent : '';
    if (btn) btn.textContent = 'جارٍ تطبيق المواصفات والتسعير على الشقق...';

    const unitIds = Array.from(selectedUnitIds);
    const area = parseFloat(document.getElementById('bulk-area-input')?.value);
    const pricePerMeter = parseFloat(document.getElementById('bulk-ppm-input')?.value);
    const gardenArea = parseFloat(document.getElementById('bulk-garden-input')?.value) || 0;
    const unitType = document.getElementById('bulk-type-select')?.value;
    const roomsCount = document.getElementById('bulk-rooms-input')?.value;
    const bathroomsCount = document.getElementById('bulk-baths-input')?.value;
    const view = document.getElementById('bulk-view-select')?.value;
    const finishingType = document.getElementById('bulk-finishing-select')?.value;

    try {
      const res = await fetch('/api/erp/development', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'bulk_update_units',
          unitIds,
          specs: {
            area,
            pricePerMeter,
            gardenArea,
            unitType,
            roomsCount,
            bathroomsCount,
            view,
            finishingType
          }
        })
      });

      const data = await res.json();
      if (data.success) {
        if (bulkModal) bulkModal.style.display = 'none';
        selectedUnitIds.clear();
        alert(data.message || 'تم تحديث مواصفات وتسعير الشقق المحددة بنجاح! ⚡');
        await loadProjectDetails(projectId);
      } else {
        alert(data.error || 'فشل تحديث الشقق');
      }
    } catch (err) {
      console.error('Error in bulk update:', err);
      alert('حدث خطأ أثناء تطبيق التعديل الجماعي');
    } finally {
      if (btn) btn.textContent = originalText;
    }
  });

  // ========================================================
  // FLOOR PLAN PRINT & PREVIEW MODAL
  // ========================================================
  const planModal = document.getElementById('plan-view-modal');

  function openPlanViewModal(unitId) {
    const u = allUnits.find(x => x.id === unitId);
    if (!u) return;

    const bld = allBuildings.find(b => b.id === u.buildingId);
    const bldName = bld ? bld.name : 'غير محدد';

    const projNameEl = document.getElementById('plan-modal-proj-name');
    const unitCodeEl = document.getElementById('plan-modal-unit-code');
    const bldNameEl = document.getElementById('plan-modal-bld-name');
    const areaEl = document.getElementById('plan-modal-area');
    const floorEl = document.getElementById('plan-modal-floor');
    const roomsEl = document.getElementById('plan-modal-rooms');
    const viewEl = document.getElementById('plan-modal-view');
    const finishingEl = document.getElementById('plan-modal-finishing');
    const priceEl = document.getElementById('plan-modal-price');
    const imgEl = document.getElementById('plan-modal-img');
    const noImgEl = document.getElementById('plan-modal-no-img');

    if (projNameEl && currentProject) projNameEl.textContent = currentProject.projectName;
    if (unitCodeEl) unitCodeEl.textContent = u.unitNumber;
    if (bldNameEl) bldNameEl.textContent = `عمارة: ${bldName}`;
    if (areaEl) areaEl.textContent = `${u.area} م²` + (u.gardenArea ? ` (+ ${u.gardenArea} م² جنينة)` : '');
    if (floorEl) floorEl.textContent = u.floor === 0 ? 'الدور الأرضي' : `الدور ${u.floor}`;
    if (roomsEl) roomsEl.textContent = `${u.roomsCount || 3} غرف + ${u.bathroomsCount || 2} حمام`;
    if (viewEl) viewEl.textContent = u.view || 'فيو مفتوح';
    if (finishingEl) finishingEl.textContent = u.finishingType || 'نصف تشطيب';
    if (priceEl) priceEl.textContent = `${(u.totalPrice || 0).toLocaleString('ar-EG')} ج.م`;

    if (u.planImage) {
      if (imgEl) {
        imgEl.src = u.planImage;
        imgEl.style.display = 'block';
      }
      if (noImgEl) noImgEl.style.display = 'none';
    } else {
      if (imgEl) imgEl.style.display = 'none';
      if (noImgEl) noImgEl.style.display = 'block';
    }

    if (planModal) planModal.style.display = 'flex';
  }

  document.getElementById('close-plan-modal')?.addEventListener('click', () => {
    if (planModal) planModal.style.display = 'none';
  });
  document.getElementById('btn-close-plan')?.addEventListener('click', () => {
    if (planModal) planModal.style.display = 'none';
  });

  document.getElementById('btn-print-plan')?.addEventListener('click', () => {
    window.print();
  });

  // ========================================================
  // SINGLE UNIT MODAL (ADD & EDIT)
  // ========================================================
  const unitModal = document.getElementById('unit-modal');
  const unitFileInp = document.getElementById('unit-plan-file-input');
  const planDataInp = document.getElementById('unit-plan-data');
  const planPreviewWrap = document.getElementById('plan-preview-wrapper');
  const planPreviewImg = document.getElementById('unit-plan-preview-img');
  const btnRemovePlan = document.getElementById('btn-remove-plan');

  // Trigger file upload dialog
  document.getElementById('btn-trigger-plan-upload')?.addEventListener('click', () => {
    unitFileInp?.click();
  });
  document.getElementById('plan-drop-zone')?.addEventListener('click', (e) => {
    if (e.target.id !== 'btn-trigger-plan-upload') {
      unitFileInp?.click();
    }
  });

  // Read uploaded file as Data URL
  unitFileInp?.addEventListener('change', (e) => {
    const file = e.target.files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (loadEvt) => {
        const base64 = loadEvt.target.result;
        if (planDataInp) planDataInp.value = base64;
        if (planPreviewImg) planPreviewImg.src = base64;
        if (planPreviewWrap) planPreviewWrap.style.display = 'block';
      };
      reader.readAsDataURL(file);
    }
  });

  // Remove plan image
  btnRemovePlan?.addEventListener('click', () => {
    if (planDataInp) planDataInp.value = '';
    if (planPreviewImg) planPreviewImg.src = '';
    if (planPreviewWrap) planPreviewWrap.style.display = 'none';
    if (unitFileInp) unitFileInp.value = '';
  });

  // Open Unit Modal for Adding New Unit
  document.getElementById('open-new-unit-btn')?.addEventListener('click', () => {
    if (allBuildings.length === 0) {
      alert('يرجى إضافة مبنى أو مكون أولاً قبل إضافة الوحدات');
      if (bldModal) bldModal.style.display = 'flex';
      return;
    }
    document.getElementById('new-unit-form')?.reset();
    document.getElementById('unit-id-input').value = '';
    document.getElementById('unit-modal-heading').textContent = 'إضافة وحدة جديدة وتسعيرها';
    document.getElementById('unit-modal-subheading').textContent = 'حساب السعر الإجمالي تلقائياً (المساحة × سعر المتر)';
    document.getElementById('save-unit-btn-text').textContent = 'تأكيد وإضافة الوحدة';

    if (planDataInp) planDataInp.value = '';
    if (planPreviewWrap) planPreviewWrap.style.display = 'none';

    document.getElementById('unit-area-input').value = '150';
    document.getElementById('unit-ppm-input').value = '20000';
    document.getElementById('unit-garden-input').value = '0';
    updateAutoCalculatedTotal();

    if (unitModal) unitModal.style.display = 'flex';
  });

  // Open Unit Modal for Editing
  function openUnitModalForEdit(unitId) {
    const u = allUnits.find(x => x.id === unitId);
    if (!u) return;

    document.getElementById('unit-id-input').value = u.id;
    document.getElementById('unit-modal-heading').textContent = `تعديل مواصفات وتسعير الشقة [${u.unitNumber}]`;
    document.getElementById('unit-modal-subheading').textContent = 'تعديل الفيو ونوع التشطيب والمساحات وسعر المتر';
    document.getElementById('save-unit-btn-text').textContent = 'حفظ التعديلات على الشقة 💾';

    document.getElementById('unit-bld-select').value = u.buildingId || '';
    document.getElementById('unit-num-input').value = u.unitNumber;
    document.getElementById('unit-floor-input').value = u.floor;
    document.getElementById('unit-status-select').value = u.status || 'available';

    document.getElementById('unit-type-select').value = u.unitType || 'residential';
    document.getElementById('unit-rooms-input').value = u.roomsCount || 3;
    document.getElementById('unit-baths-input').value = u.bathroomsCount || 2;
    document.getElementById('unit-view-select').value = u.view || 'على جنينة';
    document.getElementById('unit-finishing-select').value = u.finishingType || 'نص تشطيب';

    document.getElementById('unit-area-input').value = u.area || 150;
    document.getElementById('unit-ppm-input').value = u.pricePerMeter || 20000;
    document.getElementById('unit-garden-input').value = u.gardenArea || 0;
    document.getElementById('unit-notes-input').value = u.notes || '';

    if (u.planImage) {
      if (planDataInp) planDataInp.value = u.planImage;
      if (planPreviewImg) planPreviewImg.src = u.planImage;
      if (planPreviewWrap) planPreviewWrap.style.display = 'block';
    } else {
      if (planDataInp) planDataInp.value = '';
      if (planPreviewWrap) planPreviewWrap.style.display = 'none';
    }

    updateAutoCalculatedTotal();
    if (unitModal) unitModal.style.display = 'flex';
  }

  // Close Unit Modal
  document.getElementById('close-unit-modal')?.addEventListener('click', () => {
    if (unitModal) unitModal.style.display = 'none';
  });
  document.getElementById('cancel-unit-btn')?.addEventListener('click', () => {
    if (unitModal) unitModal.style.display = 'none';
  });

  // Auto Calculation for Unit Modal
  const areaInput = document.getElementById('unit-area-input');
  const ppmInput = document.getElementById('unit-ppm-input');
  const autoTotalText = document.getElementById('auto-total-price-text');

  function updateAutoCalculatedTotal() {
    const area = parseFloat(areaInput?.value) || 0;
    const ppm = parseFloat(ppmInput?.value) || 0;
    const total = area * ppm;

    if (autoTotalText) {
      autoTotalText.textContent = total.toLocaleString('ar-EG');
    }
  }

  areaInput?.addEventListener('input', updateAutoCalculatedTotal);
  ppmInput?.addEventListener('input', updateAutoCalculatedTotal);

  // Submit Unit Form (Add or Edit)
  document.getElementById('new-unit-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const saveBtn = document.getElementById('save-unit-btn');
    const originalText = saveBtn ? saveBtn.innerHTML : '';
    if (saveBtn) saveBtn.textContent = 'جارٍ الحفظ...';

    const unitId = document.getElementById('unit-id-input')?.value;
    const isEditing = Boolean(unitId);

    const buildingId = document.getElementById('unit-bld-select').value;
    const unitType = document.getElementById('unit-type-select').value;
    const unitNumber = document.getElementById('unit-num-input').value;
    const floor = document.getElementById('unit-floor-input').value;
    const roomsCount = document.getElementById('unit-rooms-input').value;
    const bathroomsCount = document.getElementById('unit-baths-input').value;
    const view = document.getElementById('unit-view-select').value;
