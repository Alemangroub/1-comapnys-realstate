---
import Layout from '../../../layouts/Layout.astro';
import AdminLogin from '../../../components/AdminLogin.astro';
---

<Layout title="إدارة المباني والوحدات | نظام التطوير العقاري ERP">
  <div class="project-details-root">
    
    <!-- Auth Loading State -->
    <div id="auth-loading-message" class="loading-state">
      <div class="spinner"></div>
      <p>جارٍ تحميل بيانات المشروع والوحدات...</p>
    </div>

    <!-- Auth Login Container -->
    <div id="admin-login-container" style="display: none;">
      <AdminLogin />
    </div>

    <!-- Main Container -->
    <main id="main-content" class="erp-container" style="display: none;">
      
      <!-- Top Navigation Header -->
      <header class="erp-topbar">
        <div class="brand-crumb">
          <a href="/crs" class="back-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
            الرئيسية
          </a>
          <span class="sep">/</span>
          <a href="/crs/development" class="back-link">نظام التطوير العقاري</a>
          <span class="sep">/</span>
          <span class="active-crumb" id="crumb-project-name">تفاصيل المشروع والوحدات</span>
        </div>

        <div class="topbar-actions">
          <a href="/crs/development" class="btn btn-outline">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            العودة للمشروعات
          </a>
          <button id="open-new-building-btn" class="btn btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><line x1="9" y1="22" x2="9" y2="22.01"></line><line x1="15" y1="22" x2="15" y2="22.01"></line><line x1="9" y1="6" x2="9" y2="6.01"></line><line x1="15" y1="6" x2="15" y2="6.01"></line><line x1="9" y1="10" x2="9" y2="10.01"></line><line x1="15" y1="10" x2="15" y2="10.01"></line><line x1="9" y1="14" x2="9" y2="14.01"></line><line x1="15" y1="14" x2="15" y2="14.01"></line><line x1="9" y1="18" x2="9" y2="18.01"></line><line x1="15" y1="18" x2="15" y2="18.01"></line></svg>
            + إضافة مبنى/مكون جديد
          </button>
          <button id="open-new-unit-btn" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            + إضافة وحدة جديدة
          </button>
        </div>
      </header>

      <!-- Project Hero Summary Banner -->
      <section class="project-hero-summary">
        <div class="hero-main-row">
          <div class="project-identity">
            <span class="project-tag-pill">مشروع قيد التطوير</span>
            <h1 id="hero-project-name">جاري تحميل المشروع...</h1>
            <p id="hero-project-address" class="project-sub-address">...</p>
          </div>
          <div class="project-buildings-pills" id="project-buildings-chips">
            <!-- Buildings Chips will be injected here -->
          </div>
        </div>

        <!-- Quick Summary Metrics (ملخص سريع للمشروع بألوان الحالة) -->
        <div class="summary-kpi-ribbon">
          <!-- Total Units -->
          <div class="kpi-metric-box box-total">
            <span class="kpi-lbl">إجمالي الوحدات</span>
            <div class="kpi-num" id="kpi-total-units">0</div>
            <span class="kpi-sub-text">بالمشروع ككل</span>
          </div>

          <!-- Available Units (الأخضر) -->
          <div class="kpi-metric-box box-available">
            <div class="kpi-head-row">
              <span class="kpi-lbl">وحدات متاحة</span>
              <span class="status-indicator-dot dot-available"></span>
            </div>
            <div class="kpi-num text-available" id="kpi-available-units">0</div>
            <span class="kpi-sub-text">جاهزة للبيع والتعاقد</span>
          </div>

          <!-- Reserved Units (الأصفر) -->
          <div class="kpi-metric-box box-reserved">
            <div class="kpi-head-row">
              <span class="kpi-lbl">وحدات محجوزة</span>
              <span class="status-indicator-dot dot-reserved"></span>
            </div>
            <div class="kpi-num text-reserved" id="kpi-reserved-units">0</div>
            <span class="kpi-sub-text">حجز مبدئي وفترة تعاقد</span>
          </div>

          <!-- Sold Units (الأحمر) -->
          <div class="kpi-metric-box box-sold">
            <div class="kpi-head-row">
              <span class="kpi-lbl">وحدات مباعة</span>
              <span class="status-indicator-dot dot-sold"></span>
            </div>
            <div class="kpi-num text-sold" id="kpi-sold-units">0</div>
            <span class="kpi-sub-text">تم تحرير العقود الرسمية</span>
          </div>

          <!-- Total Portfolio Value -->
          <div class="kpi-metric-box box-value">
            <span class="kpi-lbl">القيمة الإجمالية للوحدات</span>
            <div class="kpi-num kpi-price" id="kpi-total-portfolio-val">0 ج.م</div>
            <span class="kpi-sub-text">إجمالي تقييم المبيعات</span>
          </div>
        </div>
      </section>

      <!-- Units Filter Toolbar & View Toggle -->
      <section class="units-control-toolbar">
        <div class="filters-wrap">
          
          <!-- Filter by Building -->
          <div class="filter-group">
            <label>المبنى / المكون:</label>
            <select id="filter-building-select">
              <option value="all">جميع المباني والمكونات</option>
            </select>
          </div>

          <!-- Filter by Status -->
          <div class="filter-group">
            <label>حالة الوحدة:</label>
            <select id="filter-status-select">
              <option value="all">جميع الحالات</option>
              <option value="available">🟢 متاحة (Available)</option>
              <option value="reserved">🟡 محجوزة (Reserved)</option>
              <option value="sold">🔴 مباعة (Sold)</option>
            </select>
          </div>

          <!-- Filter by Unit Type -->
          <div class="filter-group">
            <label>نوع الوحدة:</label>
            <select id="filter-type-select">
              <option value="all">جميع الأنواع</option>
              <option value="residential">سكني (شقة)</option>
              <option value="commercial">تجاري (محل)</option>
              <option value="administrative">إداري (مكتب)</option>
              <option value="villa">فيلا مستقلة</option>
            </select>
          </div>

          <!-- Search by Unit Number -->
          <div class="filter-group search-group">
            <label>بحث برقم الوحدة:</label>
            <input type="text" id="filter-search-input" placeholder="مثال: شقة 101 أو G-01" />
          </div>

        </div>

        <!-- View Switcher (Table vs Grid Cards) -->
        <div class="view-switch-box">
          <button id="view-mode-table" class="view-btn active" title="عرض جدول تفصيلي">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
            جدول
          </button>
          <button id="view-mode-grid" class="view-btn" title="عرض شبكة بطاقات ملونة">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
            بطاقات ملونة
          </button>
        </div>
      </section>

      <!-- Units Container (Table View & Grid View) -->
      <section class="units-display-section">
        
        <!-- Bulk Action Floating Bar (الحركة الذكية لتسعير وتعديل الشقق المحددة) -->
        <div id="bulk-actions-bar" class="bulk-actions-floating-bar" style="display: none;">
          <div class="bulk-stats-group">
            <span class="bulk-badge-count" id="selected-units-count">0</span>
            <span class="bulk-lbl-text">شقة محددة في المشروع</span>
          </div>
          <div class="bulk-buttons-group">
            <button type="button" id="btn-open-bulk-edit" class="btn-magic-bulk">
              ⚡ تطبيق التسعير والمواصفات على الشقق المحددة
            </button>
            <button type="button" id="btn-clear-selection" class="btn-ghost-clear">
              إلغاء التحديد
            </button>
          </div>
        </div>

        <!-- Table View Container -->
        <div id="units-table-container" class="units-table-wrap">
          <table class="erp-units-table">
            <thead>
              <tr>
                <th style="width: 44px; text-align: center;">
                  <input type="checkbox" id="select-all-units-chk" title="تحديد جميع الشقق المعروضة" style="cursor: pointer; width: 17px; height: 17px;" />
                </th>
                <th>رقم الشقة</th>
                <th>المبنى / العمارة</th>
                <th>النوع</th>
                <th>الدور</th>
                <th>المواصفات (غرف / حمام)</th>
                <th>الفيو والتشطيب</th>
                <th>المساحة</th>
                <th>سعر المتر</th>
                <th>السعر الإجمالي 💰</th>
                <th>البلان</th>
                <th>الحالة</th>
                <th>الأقساط والتحصيل 💳</th>
                <th>الإجراءات</th>
              </tr>
            </thead>
            <tbody id="units-tbody">
              <!-- Dynamically rendered -->
            </tbody>
          </table>
        </div>

        <!-- Grid Cards View Container (شبكة بطاقات ملونة) -->
        <div id="units-grid-container" class="units-cards-grid" style="display: none;">
          <!-- Dynamically rendered -->
        </div>

        <!-- Empty State -->
        <div id="units-empty-state" class="empty-state-notice" style="display: none;">
          <div class="empty-icon">🏢</div>
          <h3>لا توجد وحدات مطابقة للبحث أو التصفية</h3>
          <p>يمكنك تغيير شروط التصفية أو النقر على "+ إضافة وحدة جديدة" لإدراج وحدات بالمشروع.</p>
        </div>

      </section>

    </main>

    <!-- ========================================================
         MODAL 1: إضافة مبنى / مكون جديد مع التوليد التلقائي للشقق
         ======================================================== -->
    <div id="building-modal" class="modal-backdrop" style="display: none;">
      <div class="modal-card modal-large">
        <div class="modal-header">
          <div class="modal-title-pod">
            <div class="pod-icon icon-bld">🏢</div>
            <div>
              <h3>إضافة مبنى / مكون جديد</h3>
              <p>تسجيل العمارة وتقسيم أدوارها وتوليد الشقق تلقائياً</p>
            </div>
          </div>
          <button class="close-modal-btn" id="close-bld-modal">&times;</button>
        </div>

        <form id="new-building-form" class="modal-body-form">
          <!-- 1. تابعة لأي مشروع؟ -->
          <div class="form-group">
            <label>تابعة لأي مشروع؟ *</label>
            <select id="bld-project-select" required>
              <!-- Dynamically populated with projects list -->
            </select>
          </div>

          <!-- 2. اسم أو رقم العمارة -->
          <div class="form-group">
            <label>اسم أو رقم العمارة *</label>
            <input type="text" id="bld-name-input" placeholder="مثال: عمارة B1 أو البرج السكني 1" required />
          </div>

          <!-- 3. عدد الأدوار و 4. كل دور فيه كام شقة؟ -->
          <div class="form-row">
            <div class="form-group">
              <label>عدد الأدوار في العمارة * <span class="hint-small">(بخلاف الدور الأرضي)</span></label>
              <input type="number" id="bld-floors-input" value="5" min="1" max="50" placeholder="مثال: 5" required />
            </div>

            <div class="form-group">
              <label>كل دور فيه كام شقة؟ *</label>
              <input type="number" id="bld-apts-per-floor-input" value="4" min="1" max="20" placeholder="مثال: 4" required />
            </div>
          </div>

          <!-- 💡 الحركة الذكية في الصفحة (زرار "اعمل الشقق لوحدك") -->
          <div class="smart-generator-pod">
            <div class="smart-pod-header">
              <div class="smart-pod-title">
                <span class="sparkle-icon">💡</span>
                <span>الحركة الذكية: إنشاء شقق العمارة تلقائياً</span>
              </div>
              <span class="smart-pod-badge">توفير الوقت والمجهود</span>
            </div>
            <p class="smart-pod-desc">
              بدلاً من إدخال الشقق شقة شقة يدوياً، انقر على الزر ليقوم السيستم بحساب (الأرضي + الأدوار المتكررة × عدد الشقق) وتوليد وترقيم كافة الشقق كودياً بترتيب تسلسلي دقيق في ثانية واحدة!
            </p>

            <div class="default-specs-row">
              <div class="form-group">
                <label>مساحة الشقة الافتراضية (م²)</label>
                <input type="number" id="bld-def-area" value="130" step="any" placeholder="130" />
              </div>
              <div class="form-group">
                <label>سعر المتر الافتراضي (ج.م)</label>
                <input type="number" id="bld-def-ppm" value="20000" step="any" placeholder="20000" />
              </div>
            </div>

            <button type="button" id="btn-smart-generate-units" class="btn-magic-action">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
              <span>إنشاء شقق العمارة تلقائياً ⚡</span>
            </button>
          </div>

          <!-- Generated Units Preview Box -->
          <div id="generated-units-preview-box" class="generated-preview-box" style="display: none;">
            <div class="preview-box-header">
              <div class="preview-header-stats">
                <span class="preview-badge-success" id="gen-stats-badge">0 شقة جاهزة</span>
                <span class="preview-sub-text" id="gen-stats-text">...</span>
              </div>
              <button type="button" id="btn-clear-generated" class="btn-clear-ghost">إعادة ضبط</button>
            </div>

            <div class="preview-units-table-wrap">
              <table class="preview-units-table">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>كود ورقم الشقة</th>
                    <th>الدور</th>
                    <th>النوع</th>
                    <th>المساحة</th>
                    <th>سعر المتر</th>
                    <th>الإجمالي المحسوب</th>
                  </tr>
                </thead>
                <tbody id="generated-units-tbody">
                  <!-- Dynamically populated with generated unit rows -->
                </tbody>
              </table>
            </div>
          </div>

          <div class="modal-footer-actions">
            <button type="submit" class="btn btn-primary" id="save-bld-btn">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span id="save-bld-btn-text">حفظ المبنى والمتابعة</span>
            </button>
            <button type="button" class="btn btn-secondary" id="cancel-bld-btn">إلغاء</button>
          </div>
        </form>
      </div>
    </div>

    <!-- ========================================================
         MODAL 2: إضافة أو تعديل مواصفات وتسعير الشقة
         ======================================================== -->
    <div id="unit-modal" class="modal-backdrop" style="display: none;">
      <div class="modal-card modal-large">
        <div class="modal-header">
          <div class="modal-title-pod">
            <div class="pod-icon icon-unit">🔑</div>
            <div>
              <h3 id="unit-modal-heading">مواصفات وتسعير الشقة</h3>
              <p id="unit-modal-subheading">تسجيل المواصفات التسويقية وحساب إجمالي السعر تلقائياً</p>
            </div>
          </div>
          <button class="close-modal-btn" id="close-unit-modal">&times;</button>
        </div>

        <form id="new-unit-form" class="modal-body-form">
          <input type="hidden" id="unit-id-input" value="" />

          <!-- الجزء الأول: بيانات الوحدة والمبنى الأساسية -->
          <div class="modal-section-pod">
            <div class="section-pod-title">
              <span class="step-num">1</span>
              <span>بيانات الموقع والعمارة</span>
            </div>

            <div class="form-row">
              <div class="form-group" style="flex: 1.5;">
                <label>المبنى / المكون التابع له *</label>
                <select id="unit-bld-select" required>
                  <!-- Dynamically populated -->
                </select>
              </div>

              <div class="form-group" style="flex: 1;">
                <label>رقم أو كود الشقة *</label>
                <input type="text" id="unit-num-input" placeholder="مثال: NKH-B1-101" required />
              </div>

              <div class="form-group" style="flex: 0.8;">
                <label>رقم الدور *</label>
                <input type="number" id="unit-floor-input" value="1" min="0" max="100" required />
              </div>

              <div class="form-group" style="flex: 1.2;">
                <label>حالة الشقة *</label>
                <select id="unit-status-select" required>
                  <option value="available" selected>🟢 متاحة للبيع (Available)</option>
                  <option value="reserved">🟡 محجوزة مبدئياً (Reserved)</option>
                  <option value="sold">🔴 مباعة رسمياً (Sold)</option>
                </select>
              </div>
            </div>
          </div>

          <!-- الجزء الثاني: مواصفات الشقة (عشان العميل يسأل عليها) -->
          <div class="modal-section-pod">
            <div class="section-pod-title">
              <span class="step-num">2</span>
              <span>مواصفات الشقة (بيانات العرض التسويقي للعميل)</span>
            </div>

            <div class="form-row">
              <!-- نوع الوحدة -->
              <div class="form-group" style="flex: 1.2;">
                <label>نوع الوحدة *</label>
                <select id="unit-type-select" required>
                  <option value="residential" selected>🏢 شقة سكنية (Apartment)</option>
                  <option value="duplex">🏛️ دوبلكس (Duplex)</option>
                  <option value="penthouse">🌆 بنتهاوس (Penthouse)</option>
                  <option value="commercial">🏪 محل تجاري (Commercial)</option>
                  <option value="administrative">💼 مكتب إداري (Administrative)</option>
                  <option value="villa">🏡 فيلا مستقلة / تاون هاوس (Villa)</option>
                </select>
              </div>

              <!-- عدد الغرف والحمامات -->
              <div class="form-group" style="flex: 0.9;">
                <label>عدد غرف النوم</label>
                <input type="number" id="unit-rooms-input" value="3" min="1" max="20" placeholder="مثال: 3" />
              </div>

              <div class="form-group" style="flex: 0.9;">
                <label>عدد الحمامات</label>
                <input type="number" id="unit-baths-input" value="2" min="1" max="10" placeholder="مثال: 2" />
              </div>

              <!-- الفيو (بتبص على إيه؟) -->
              <div class="form-group" style="flex: 1.2;">
                <label>الفيو (الإطلالة)</label>
                <select id="unit-view-select">
                  <option value="على جنينة">🌳 على جنينة (Garden View)</option>
                  <option value="على حمام سباحة">🏊‍♂️ على حمام سباحة (Pool View)</option>
                  <option value="على الشارع الرئيسي">🛣️ على الشارع الرئيسي (Main Street)</option>
                  <option value="فيو داخلي / خلفي">🏢 فيو داخلي / خلفي</option>
                  <option value="واجهة بحرية مفتوحة">🌊 واجهة بحرية مفتوحة</option>
                </select>
              </div>

              <!-- نوع التشطيب -->
              <div class="form-group" style="flex: 1.2;">
                <label>نوع التشطيب</label>
                <select id="unit-finishing-select">
                  <option value="طوب أحمر">🧱 طوب أحمر</option>
                  <option value="نص تشطيب" selected>🔨 نصف تشطيب (محارة وحلوق)</option>
                  <option value="متشطبة بالكامل">✨ متشطبة بالكامل (سوبر لوكس)</option>
                  <option value="ألترا سوبر لوكس">🌟 ألترا سوبر لوكس</option>
                </select>
              </div>
            </div>
          </div>

          <!-- الجزء الثالث: المساحة والفلوس (السيستم هو اللي بيحسب!) 💰 -->
          <div class="modal-section-pod">
            <div class="section-pod-title">
              <span class="step-num">3</span>
              <span>المساحة والفلوس (حساب لحظي أوتوماتيك 💰)</span>
            </div>

            <div class="pricing-calc-box">
              <div class="calc-inputs-row">
                <div class="form-group">
                  <label>مساحة الشقة (م²) *</label>
