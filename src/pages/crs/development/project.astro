  function getProjectCodePrefix(selectedProj) {
    if (selectedProj?.projectCode && selectedProj.projectCode.trim()) {
      return selectedProj.projectCode.trim().toUpperCase().replace(/[^A-Z0-9]/g, '');
    }
    const name = (selectedProj?.projectName || '').trim();
    if (name.includes('النخيل') || name.includes('نخيل')) return 'NKH';
    if (name.includes('الياسمين') || name.includes('ياسمين')) return 'YAS';
    if (name.includes('الزهور') || name.includes('زهور')) return 'ZHR';
    if (name.includes('الشروق') || name.includes('شروق')) return 'SHR';
    if (name.includes('الصفوة') || name.includes('صفوة')) return 'SAF';

    // Fallback: extract english or derive PRJ code
    const latinMatch = name.match(/[a-zA-Z]+/g);
    if (latinMatch && latinMatch.length > 0) {
      return latinMatch.join('').slice(0, 4).toUpperCase();
    }
    return 'PRJ';
  }

  function getBuildingCodePrefix(name) {
    if (!name) return 'B1';
    const trimmed = name.trim();
    const alphaNumMatch = trimmed.match(/[a-zA-Z]+-?[0-9]*/);
    if (alphaNumMatch) {
      return alphaNumMatch[0].toUpperCase().replace('-', '');
    }
    const numMatch = trimmed.match(/[0-9]+/);
    if (numMatch) {
      return 'B' + numMatch[0];
    }
    return 'B1';
  }

  // Smart Units Auto Generator Click Handler (زرار "اعمل الشقق لوحدك")
  document.getElementById('btn-smart-generate-units')?.addEventListener('click', () => {
    const selectedProjId = document.getElementById('bld-project-select')?.value || projectId;
    const selectedProj = allProjectsList.find(p => p.id === selectedProjId) || currentProject;
    const bldName = document.getElementById('bld-name-input')?.value?.trim();

    if (!bldName) {
      alert('يرجى كتابة اسم أو رقم العمارة أولاً (مثال: عمارة B1)');
      document.getElementById('bld-name-input')?.focus();
      return;
    }

    const floorsCount = parseInt(document.getElementById('bld-floors-input')?.value) || 0;
    const aptsPerFloor = parseInt(document.getElementById('bld-apts-per-floor-input')?.value) || 0;
    const defArea = parseFloat(document.getElementById('bld-def-area')?.value) || 150;
    const defPpm = parseFloat(document.getElementById('bld-def-ppm')?.value) || 20000;

    if (floorsCount <= 0 || aptsPerFloor <= 0) {
      alert('يرجى تحديد عدد الأدوار وعدد الشقق لكل دور بشكل صحيح');
      return;
    }

    const projPrefix = getProjectCodePrefix(selectedProj);
    const bldPrefix = getBuildingCodePrefix(bldName);

    generatedUnitsBatch = [];

    // Loop through Ground Floor (floor = 0) and Repeated Floors (1 to floorsCount)
    for (let floor = 0; floor <= floorsCount; floor++) {
      const isGround = floor === 0;
      const floorLabel = isGround ? 'الدور الأرضي' : `الدور ${floor}`;

      for (let apt = 1; apt <= aptsPerFloor; apt++) {
        const aptPadded = apt < 10 ? `0${apt}` : `${apt}`;
        const unitCode = isGround
          ? `${projPrefix}-${bldPrefix}-G${aptPadded}`
          : `${projPrefix}-${bldPrefix}-${floor}${aptPadded}`;

        generatedUnitsBatch.push({
          unitNumber: unitCode,
          unitType: 'residential',
          floor: floor,
          floorLabel: floorLabel,
          roomsCount: 3,
          bathroomsCount: 2,
          view: 'على جنينة',
          finishingType: 'نص تشطيب',
          area: defArea,
          gardenArea: isGround ? 40 : 0,
          pricePerMeter: defPpm,
          totalPrice: defArea * defPpm,
          status: 'available'
        });
      }
    }

    // Render Live Preview
    const previewBox = document.getElementById('generated-units-preview-box');
    const tbody = document.getElementById('generated-units-tbody');
    const statsBadge = document.getElementById('gen-stats-badge');
    const statsText = document.getElementById('gen-stats-text');
    const saveBtnText = document.getElementById('save-bld-btn-text');

    if (previewBox) previewBox.style.display = 'block';
    if (statsBadge) statsBadge.textContent = `${generatedUnitsBatch.length} شقة جاهزة ⚡`;
    if (statsText) {
      statsText.textContent = `(أرضي + ${floorsCount} أدوار متكررة × ${aptsPerFloor} شقق)`;
    }

    if (tbody) {
      tbody.innerHTML = generatedUnitsBatch.map((u, idx) => `
        <tr>
          <td>${idx + 1}</td>
          <td><span class="unit-code-badge">${u.unitNumber}</span></td>
          <td><span class="floor-badge">${u.floorLabel}</span></td>
          <td>شقة سكنية</td>
