<script>
  import { checkAuth, logout } from '../lib/auth.js';

  const authLoadingMessage = document.getElementById('auth-loading-message');
  const loginContainer = document.getElementById('admin-login-container');
  const dashboardContainer = document.getElementById('admin-dashboard-container');
  const logoutButton = document.getElementById('logout-button');
  const topUserName = document.getElementById('top-user-name');
  const welcomeMessage = document.getElementById('welcome-message');
  const mobileToggle = document.getElementById('mobile-sidebar-toggle');
  const sidebar = document.getElementById('main-sidebar');

  if (mobileToggle && sidebar) {
    mobileToggle.addEventListener('click', () => {
      sidebar.classList.toggle('mobile-open');
    });
  }

  const timeout = setTimeout(() => {
    if (authLoadingMessage) authLoadingMessage.style.display = 'none';
    if (loginContainer) loginContainer.style.display = 'block';
  }, 5000);

  async function loadErpSummary() {
    try {
      const res = await fetch('/api/erp/summary');
      const data = await res.json();
      if (data.success && data.stats) {
        const stats = data.stats;
        
        const pElem = document.getElementById('stat-projects');
        if (pElem) pElem.textContent = stats.totalProjects || 0;

        const uElem = document.getElementById('stat-units');
        const uSub = document.getElementById('stat-units-sub');
        if (uElem) uElem.textContent = stats.units.total || 0;
        if (uSub) uSub.textContent = `${stats.units.available || 0} متاحة · ${stats.units.reserved || 0} محجوزة · ${stats.units.sold || 0} مباعة`;

        const tElem = document.getElementById('stat-treasury');
        const tSub = document.getElementById('stat-treasury-sub');
        if (tElem) tElem.textContent = (stats.treasury.totalBalance || 0).toLocaleString('ar-EG') + ' ج.م';
        if (tSub) tSub.textContent = `${stats.treasury.accountsCount || 0} حسابات خزينة مسجلة`;

        const cElem = document.getElementById('stat-collection');
        const cSub = document.getElementById('stat-collection-sub');
        if (cElem) cElem.textContent = (stats.collection.pending || 0) + (stats.collection.late || 0);
        if (cSub) cSub.textContent = `${stats.collection.late || 0} أقساط متأخرة · ${stats.collection.pending || 0} قيد التحصيل`;
      }
    } catch (err) {
      console.warn('Could not load ERP summary metrics:', err);
    }
  }

  (async () => {
    try {
      const user = await checkAuth();
      clearTimeout(timeout);
      if (authLoadingMessage) authLoadingMessage.style.display = 'none';

      if (user) {
        if (user.role === 'admin') {
          if (dashboardContainer) dashboardContainer.style.display = 'flex';
          if (loginContainer) loginContainer.style.display = 'none';
          
          if (user.name) {
            if (topUserName) topUserName.textContent = user.name;
            if (welcomeMessage) {
              welcomeMessage.textContent = `مرحباً بك يا ${user.name} في لوحة التحكم المركزية لمنظومة التطوير العقاري. جميع الإدارات السبعة وقواعد البيانات متزامنة ومستعدة للعمل.`;
            }
          }

          // Fetch real-time KPI metrics
          loadErpSummary();
        } else if (user.role === 'sales') {
          window.location.href = '/sales-dashboard';
        } else if (user.role === 'accountant') {
          window.location.href = '/accounting-dashboard';
        } else if (user.role === 'supervisor' || user.role === 'engineer') {
          window.location.href = '/engineer-dashboard';
        } else {
          if (loginContainer) loginContainer.style.display = 'block';
        }
      } else {
        if (dashboardContainer) dashboardContainer.style.display = 'none';
        if (loginContainer) loginContainer.style.display = 'block';
      }
    } catch (error) {
      console.error('Auth check failed:', error);
      clearTimeout(timeout);
      if (authLoadingMessage) authLoadingMessage.style.display = 'none';
      if (loginContainer) loginContainer.style.display = 'block';
    }
  })();

  if (logoutButton) {
    logoutButton.addEventListener('click', async () => {
      await logout();
    });
  }
</script>